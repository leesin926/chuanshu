<template>
	<!-- 和旧的那一版一样，根节点必须是限高滚动容器：鸿蒙上页面容器按内容撑开，只给 flex:1 或只给
	     height:100% 都滚不动，两个一起给才等于视口高度。 -->
	<scroll-view class="page" scroll-y="true">
		<!-- 设计图这一页没有导航条，「传书」是页面里最重的一个字，所以整页从一个大标题开始。 -->
		<text class="title">传书</text>

		<!-- 「连上了没有」是这一页要回答的第一个问题，做成整宽的渐变条 + 右上一颗点。点它去连接页。 -->
		<view class="banner" :class="linked ? '' : 'bannerwait'" @click="goConnect">
			<text class="bannertext">{{ headline }}</text>
			<view class="dot" :class="linked ? '' : 'dotoff'"></view>
		</view>

		<view class="grid">
			<view class="cell" @click="goSend">
				<view class="tile iconRun"></view>
				<text class="celllabel">发送文件</text>
			</view>
			<view class="cell" @click="goFiles">
				<view class="tile iconOk"></view>
				<text class="celllabel">收到的文件</text>
			</view>
			<view class="cell" @click="goConnect">
				<view class="tile iconWait"></view>
				<text class="celllabel">扫码连接</text>
			</view>
			<view class="cell" @click="goDetail">
				<view class="tile iconBad"></view>
				<text class="celllabel">传输详情</text>
			</view>
		</view>

		<!-- 有人在等这台设备点头，这件事必须出现在打开应用就能看到的地方，而不是藏在某个列表页里。
		     设计图里没有这个状态（它假设传输都是自动接受的），但这一端不是，所以照同一套卡片语言补上。 -->
		<view class="card" v-if="s.recvAsk != ''">
			<view class="head">
				<text class="h">有一个传输在等你决定</text>
				<text class="badge">等你决定</text>
			</view>
			<text class="note mt8">{{ s.recvAsk }}</text>
			<view class="row mt8 wrap">
				<button class="primary col1" @click="accept">接受</button>
				<button class="mini" @click="refuse">拒绝</button>
			</view>
		</view>

		<text class="h mt16">最近传输</text>
		<view class="card mt8">
			<text class="sub" v-if="s.names.length == 0 && s.recvNames.length == 0">这一台还没有过传输。连上对端以后可以往外发，对方也能往这台手机里发。</text>
			<view class="filerow" v-for="(n, i) in s.names" :key="'s' + i.toString()">
				<view class="tile tilegap" :class="iconOf(s.stateClass[i])"></view>
				<view class="rowmain">
					<text class="fname">{{ n }}</text>
					<text class="fsize">{{ s.meta[i] }}</text>
				</view>
				<view class="rowright">
					<text class="fstate" :class="s.stateClass[i]">{{ shortOf(s.states[i]) }}</text>
					<view class="barthin mt8" v-if="s.running && i == s.names.length - 1">
						<view class="fillthin" :style="{ width: s.fillWidth }"></view>
					</view>
				</view>
			</view>
			<view class="divider" v-if="s.names.length > 0 && s.recvNames.length > 0"></view>
			<view class="filerow" v-for="(n, i) in s.recvNames" :key="'r' + i.toString()">
				<view class="tile tilegap" :class="iconOf(s.recvStateClass[i])"></view>
				<view class="rowmain">
					<text class="fname">{{ n }}</text>
					<text class="fsize">{{ s.recvMeta[i] }}</text>
				</view>
				<view class="rowright">
					<text class="fstate" :class="s.recvStateClass[i]">{{ shortOf(s.recvStates[i]) }}</text>
				</view>
			</view>
		</view>
		<text class="sub mt8" v-if="s.mocked">{{ s.netLabel }}</text>
	</scroll-view>
</template>

<script setup lang="uts">
	import { s, initSession, refreshReceive, onRecvAccept, onRecvRefuse } from '@/store/session.uts'

	initSession()

	const linked = computed((): boolean => {
		return s.connected || s.peerAttached
	})

	const headline = computed((): string => {
		if (s.connecting) {
			return '正在连接对端…'
		}
		if (!linked.value) {
			return '还没有连上对端'
		}
		const who = s.peerName == '' ? '对端' : s.peerName
		return s.connected ? '已连接到 ' + who : who + ' 正连着这台设备'
	})

	/** 设计图的行图标是一颗按状态着色的色块，状态样式串本来就带在 stateClass 里，这里只做一次映射。 */
	function iconOf(cls: string): string {
		if (cls == 'stateOk') {
			return 'iconOk'
		}
		if (cls == 'stateRun') {
			return 'iconRun'
		}
		if (cls == 'stateBad') {
			return 'iconBad'
		}
		return 'iconWait'
	}

	/** 首页右列只放一个词（已完成 / 传输中 / 已收到），整句留给传输详情页，否则一行会被撑成三行。 */
	function shortOf(text: string): string {
		if (text.indexOf('已校验') == 0) {
			return '已收到'
		}
		if (text.indexOf('收到 ') == 0 || text.indexOf('收齐了') == 0) {
			return '传输中'
		}
		if (text.indexOf('对方已收下') == 0) {
			return '已完成'
		}
		if (text.indexOf('等你决定') == 0) {
			return '等你决定'
		}
		if (text.indexOf('失败') == 0 || text.indexOf('没过') > 0) {
			return '没通过'
		}
		return text == '' ? '等待中' : text
	}

	/** The store's ticker is the fallback, not the source of truth: a suspended app freezes it, so the
	 *  screen is re-read every time the user comes back to this tab. */
	onShow(() => {
		refreshReceive()
	})

	/* 模板只能点本页自己的函数：只被模板引用的 store 动作会被摇树丢掉，Kotlin 那头报“找不到名称
	   invoke”。下面这一层薄壳既是那份引用，也是这一页允许用户做的事的清单。 */
	function accept() {
		onRecvAccept()
	}

	function refuse() {
		onRecvRefuse()
	}

	function goSend() {
		uni.navigateTo({ url: '/pages/send/send' })
	}

	function goDetail() {
		uni.switchTab({ url: '/pages/detail/detail' })
	}

	function goFiles() {
		uni.switchTab({ url: '/pages/files/files' })
	}

	function goConnect() {
		uni.navigateTo({ url: '/pages/scan/scan' })
	}
</script>
