<template>
	<scroll-view class="page" scroll-y="true">
		<!-- 设计图这一页的第一块是蓝→紫渐变的用户卡。这一端的「用户」就是这台设备本身，所以卡里放的
		     是设备名和它的身份指纹，而不是一个假的账号。 -->
		<view class="avatarcard">
			<view class="avatar">
				<image class="icoAvatar" src="/static/icons/user-94a3b8.png"></image>
			</view>
			<view class="col1">
				<text class="avatarname">{{ s.selfName }}</text>
				<text class="avatarsub">指纹 {{ s.selfFpShort }}</text>
			</view>
			<text class="badge" v-if="s.mocked">对端是模拟的</text>
		</view>

		<!-- 设计图这一页是三张卡（1 行 / 2 行 / 2 行），每行都是「灰线性图标 + 名字 + 右端值 + ›」。
		     行内容按这一端真实有的功能排：账号、主题、通知这些这一端没有的东西不占行，免得做成点了没反应的开关。 -->
		<view class="card16 card">
			<view class="setrow" @click="copyPair">
				<image class="icoMe" src="/static/icons/key-6b7280.png"></image>
				<text class="setlabel">配对码</text>
				<text class="setval">{{ s.recvCodeText }}</text>
				<text class="chevron">›</text>
			</view>
			<view class="divider"></view>
			<view class="setrow" @click="copyPair">
				<image class="icoMe" src="/static/icons/lock-6b7280.png"></image>
				<text class="setlabel">密码</text>
				<text class="setval">{{ s.recvPassText }}</text>
				<text class="chevron">›</text>
			</view>
			<text class="note">配对码固定不变，只有点「更换配对码和密码」才会换一组；已经固定过的对端不受影响。</text>
		</view>

		<view class="card16 card">
			<view class="setrow" @click="rotatePair">
				<image class="icoMe" src="/static/icons/swap-6b7280.png"></image>
				<text class="setlabel">更换配对码和密码</text>
				<text class="chevron">›</text>
			</view>
			<!-- #ifdef APP-ANDROID || APP-HARMONY || APP-IOS -->
			<view class="divider"></view>
			<view class="setrow" @click="toggleListen">
				<image class="icoMe" src="/static/icons/listen-6b7280.png"></image>
				<text class="setlabel">监听对端发来</text>
				<view class="switch" :class="s.recvListening ? 'switchon' : ''">
					<view class="knob" :class="s.recvListening ? 'knobon' : ''"></view>
				</view>
			</view>
			<text class="sub" :class="s.recvListenClass">{{ s.recvListen }}</text>
			<text class="sub" v-for="(a, i) in s.recvAddrs" :key="i">本机地址 {{ a }}</text>
			<!-- #endif -->
			<text class="note" v-if="s.recvNote != ''">{{ s.recvNote }}</text>
		</view>

		<view class="card16 card">
			<view class="setrow" @click="goConnect">
				<image class="icoMe" src="/static/icons/pc-6b7280.png"></image>
				<text class="setlabel">当前对端</text>
				<text class="setval">{{ s.connected ? '已连接' : '未连接' }}</text>
				<text class="chevron">›</text>
			</view>
			<text class="sub">{{ s.sessionLabel }}</text>
			<text class="sub">{{ s.pinnedLabel }}</text>
			<text class="sub" :class="s.netClass">{{ s.netLabel }}</text>
			<view class="row mt8 wrap">
				<button class="mini" @click="disconnect" v-if="s.connected">断开</button>
			</view>
			<view class="divider"></view>
			<view class="setrow" @click="goDetail">
				<image class="icoMe" src="/static/icons/doc-6b7280.png"></image>
				<text class="setlabel">传输详情与日志</text>
				<text class="chevron">›</text>
			</view>
			<view class="divider"></view>
			<view class="setrow" @click="openProbe">
				<image class="icoMe" src="/static/icons/hexagon-6b7280.png"></image>
				<text class="setlabel">平台能力探针</text>
				<text class="chevron">›</text>
			</view>
			<view class="divider"></view>
			<view class="setrow">
				<image class="icoMe" src="/static/icons/about-6b7280.png"></image>
				<text class="setlabel">关于传书</text>
				<text class="setval">v1.0.0</text>
			</view>
			<text class="note" v-if="s.note != ''">{{ s.note }}</text>
		</view>

		<!-- #ifdef WEB -->
		<view class="card">
			<text class="h">演示 PC 端</text>
			<view class="row mt8 wrap">
				<button class="mini" @click="fillDemo">填入演示配对码</button>
				<button class="mini" @click="mockScan">模拟扫码结果</button>
				<button class="mini" @click="expireToken">会话失效</button>
				<button class="mini" @click="mockRestart">模拟重启</button>
				<button class="mini" @click="dropPin">解除固定</button>
			</view>
			<text class="sub mt8">故障注入：当前 {{ s.faultLabel }}</text>
			<view class="row mt8 wrap">
				<button class="mini" @click="fault('')">正常</button>
				<button class="mini" @click="fault('BAD_PAIR_CODE')">配对码</button>
				<button class="mini" @click="fault('DECLINED')">拒收</button>
				<button class="mini" @click="fault('CHUNK_DIGEST_MISMATCH')">分块</button>
				<button class="mini" @click="fault('FILE_DIGEST_MISMATCH')">整文件</button>
			</view>
		</view>

		<view class="card">
			<text class="h">演示 PC → 本机（接收方向）</text>
			<text class="sub mt8">这一端在浏览器里没法真的监听 43720，所以让同页面的 PC 角色走同一套发送状态机，把请求直接交给接收内核。</text>
			<view class="row mt8 wrap">
				<button class="mini" @click="pcGood">PC 配对（配对码对）</button>
				<button class="mini" @click="pcWrong">PC 配对（配对码错）</button>
				<button class="mini" @click="pcResume">PC 重连（配对码留空）</button>
				<button class="mini" @click="pcSendFiles">PC 发两个文件</button>
				<button class="mini" @click="pcDrop" v-if="s.pcIn">PC 断开</button>
			</view>
			<text class="sub mt8">发送端故障：{{ s.sendFaultLabel }}　接收端故障：{{ s.recvFaultLabel }}</text>
			<view class="row mt8 wrap">
				<button class="mini" @click="sendFault('')">发送正常</button>
				<button class="mini" @click="sendFault('BAD_CHUNK')">发坏一块</button>
				<button class="mini" @click="sendFault('BAD_FILE')">发坏整文件</button>
				<button class="mini" @click="sendFault('SWALLOW_REPLY')">吞一次回复</button>
				<button class="mini" @click="recvFault('')">接收正常</button>
				<button class="mini" @click="recvFault('STORAGE_FULL')">空间不足</button>
				<button class="mini" @click="recvFault('WRITE_FAIL')">写入失败</button>
			</view>
			<button class="mini mt8" @click="recvSelfCheck">接收内核自检</button>
			<button class="mini mt8" @click="sendSelfCheck">发送内核自检</button>
			<button class="mini mt8" @click="discSelfCheck">发现内核自检</button>
		</view>
		<!-- #endif -->
	</scroll-view>
</template>

<script setup lang="uts">
	import { s, initSession, refreshReceive, copyPairing, onRotatePairing, onDisconnect } from '@/store/session.uts'
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	import { onRecvListen, onRecvListenStop } from '@/store/session.uts'
	// #endif
	// #ifdef WEB
	import { loadDemo, pasteDemoQr, expireDemoToken, restartDemo, unpin, setFault, pcPairGood, pcPairWrong, pcPairResume, pcSend, pcBreak, pickSendFault, pickRecvFault, runRecvSelf, runSendSelf, runDiscSelf } from '@/store/session.uts'
	// #endif

	initSession()

	onShow(() => {
		refreshReceive()
	})

	/* 模板只点本页的函数：只被模板引用的 store 动作会被摇树丢掉，编译报“找不到名称 invoke”。 */
	function copyPair() {
		copyPairing()
	}

	function rotatePair() {
		onRotatePairing()
	}

	function disconnect() {
		onDisconnect()
	}

	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	function toggleListen() {
		if (s.recvListening) {
			onRecvListenStop()
		} else {
			onRecvListen()
		}
	}
	// #endif

	// #ifdef WEB
	function fillDemo() {
		loadDemo()
	}

	function mockScan() {
		pasteDemoQr()
	}

	function expireToken() {
		expireDemoToken()
	}

	function mockRestart() {
		restartDemo()
	}

	function dropPin() {
		unpin()
	}

	function fault(kind: string) {
		setFault(kind)
	}

	function pcGood() {
		pcPairGood()
	}

	function pcWrong() {
		pcPairWrong()
	}

	function pcResume() {
		pcPairResume()
	}

	function pcSendFiles() {
		pcSend()
	}

	function pcDrop() {
		pcBreak()
	}

	function sendFault(kind: string) {
		pickSendFault(kind)
	}

	function recvFault(kind: string) {
		pickRecvFault(kind)
	}

	function recvSelfCheck() {
		runRecvSelf()
	}

	function sendSelfCheck() {
		runSendSelf()
	}

	function discSelfCheck() {
		runDiscSelf()
	}
	// #endif

	function openProbe() {
		uni.navigateTo({ url: '/pages/probe/probe' })
	}

	function goConnect() {
		uni.navigateTo({ url: '/pages/scan/scan' })
	}

	function goDetail() {
		uni.switchTab({ url: '/pages/detail/detail' })
	}
</script>

<style>
	/* 头像里的「传」字和设置行的图标色块都是 App.uvue 的公共令牌，这一页没有自己的样式。 */
</style>
