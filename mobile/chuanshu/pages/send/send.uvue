<template>
	<scroll-view class="page pagepad" scroll-y="true">
		<!-- 设计图这一页顶上是三枚胶囊分段控件，点哪一类就去选哪一类。这里不拿它当装饰：
		     uni.chooseFile 的 type 在 Android / 鸿蒙 / Web 三端都支持，透传下去就是真筛选。 -->
		<view class="seg">
			<view class="segitem" :class="kind == 'image' ? 'segOn' : ''" @click="pick('image')">
				<view class="seginner">
					<image class="icoChip" :src="kind == 'image' ? '/static/icons/picture-ffffff.png' : '/static/icons/picture-6b7280.png'"></image>
					<text class="seglabel" :class="kind == 'image' ? 'seglabelon' : ''">相册</text>
				</view>
			</view>
			<view class="segitem" :class="kind == 'file' ? 'segOn' : ''" @click="pick('file')">
				<view class="seginner">
					<image class="icoChip" :src="kind == 'file' ? '/static/icons/doc-ffffff.png' : '/static/icons/doc-6b7280.png'"></image>
					<text class="seglabel" :class="kind == 'file' ? 'seglabelon' : ''">文档</text>
				</view>
			</view>
			<view class="segitem last" :class="kind == 'video' ? 'segOn' : ''" @click="pick('video')">
				<view class="seginner">
					<image class="icoChip" :src="kind == 'video' ? '/static/icons/video-ffffff.png' : '/static/icons/video-6b7280.png'"></image>
					<text class="seglabel" :class="kind == 'video' ? 'seglabelon' : ''">视频</text>
				</view>
			</view>
		</view>

		<view class="card mt16">
			<view class="head">
				<text class="h">待发送</text>
				<text class="sub">{{ s.names.length }} 个</text>
			</view>
			<text class="note" v-if="s.names.length == 0">还没有选文件。点上面任意一类去选，一次最多 20 个，按下面的顺序一个个发过去。</text>
			<view class="grid mt8">
				<view class="filecell" v-for="(n, i) in s.names" :key="i" @click="dropFile(i)">
					<image class="icoRow" :src="typeIcon(n)"></image>
					<text class="cname">{{ n }}</text>
					<text class="fsize">{{ s.meta[i] }}</text>
					<text class="fstate" :class="s.stateClass[i]">{{ s.states[i] }}</text>
					<text class="tick">✓</text>
				</view>
			</view>
			<text class="sub mt8" v-if="s.names.length > 0">点一个文件可以取消选择。</text>
		</view>

		<text class="h mt16">选择目标设备</text>
		<view class="devcard mt8" :class="linked ? 'selected' : ''" @click="goConnect">
			<image class="icoRow devtile" :src="peerIcon()"></image>
			<view class="rowmain">
				<text class="fname">{{ peerTitle }}</text>
				<view class="row mt8">
					<view class="dot" :class="linked ? '' : 'dotoff'"></view>
					<text class="onoff" :class="linked ? 'onlive' : ''">{{ linked ? '在线' : '未连接' }}</text>
				</view>
			</view>
			<text class="chevron" v-if="!linked">›</text>
		</view>
		<text class="note" v-if="linked">{{ s.recvPeers }}</text>
		<text class="note">传书 v1 一次只跟一个对端说话：连上以后其他设备要等这条连接断开才排得进来，所以这里只会有一张卡。</text>

		<view class="card mt16" v-if="s.running">
			<text class="h">正在发送</text>
			<view class="row mt8">
				<view class="bar"><view class="fill" :style="{ width: s.fillWidth }"></view></view>
				<text class="pct">{{ s.progressPct }}</text>
			</view>
			<text class="sub mt8">{{ s.progressLabel }}</text>
			<button class="mini mt8" @click="goDetail">看传输详情</button>
		</view>

		<view class="floatbar">
			<view class="rowmain">
				<text class="fname">{{ s.names.length }} 个文件</text>
				<text class="fsize">{{ sendHint }}</text>
			</view>
			<button class="sendbtn" :disabled="s.running || !s.canSend" @click="sendNow">{{ s.sendLabel }}</button>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { s, initSession, chooseKind, removeFile, onSend } from '@/store/session.uts'

	initSession()

	const kind = ref('image')

	const linked = computed((): boolean => {
		return s.connected || s.peerAttached
	})

	const peerTitle = computed((): string => {
		if (!linked.value) {
			return '还没有连上对端'
		}
		return s.peerName == '' ? '对端' : s.peerName
	})

	/* 设备卡说「在线」而发送条说「先连对端」是同一种状态的两面，得说清楚：v1 里这一端只会往外拨，
	   对端拨进来那条连接它拨不回去，所以在线也不等于能发。 */
	const sendHint = computed((): string => {
		if (s.canSend) {
			return '可以发送'
		}
		if (s.running) {
			return '传输中'
		}
		if (s.connected) {
			return '先选文件'
		}
		if (s.peerAttached) {
			return '这台对端是从它那一头连过来的，这一端拨不回去：要发文件请在对端那台设备上操作'
		}
		return '先连对端'
	})

	/* 设计图里文件方块和设备的图标是有形状的，不是一个色块；<image> 换不了色，所以一种类型一张 PNG。 */
	function typeIcon(name: string): string {
		const dot = name.indexOf('.')
		const ext = dot < 0 ? '' : name.substring(dot + 1).toLowerCase()
		if (ext == 'jpg' || ext == 'jpeg' || ext == 'png' || ext == 'gif' || ext == 'webp' || ext == 'heic') {
			return '/static/icons/picture-2f7cf6.png'
		}
		if (ext == 'mp4' || ext == 'mov' || ext == 'mkv' || ext == 'avi') {
			return '/static/icons/video-2f7cf6.png'
		}
		if (ext == 'zip' || ext == 'rar' || ext == '7z' || ext == 'gz') {
			return '/static/icons/zipbox-2f7cf6.png'
		}
		return '/static/icons/doc-2f7cf6.png'
	}

	/** 设备卡分「电脑」和「手机」两种形状（设计图就是这么画的）。对端名字是它自己上报的，
	    认不出来就按电脑画——这一端目前唯一能连的就是 PC 客户端。 */
	function peerIcon(): string {
		if (!linked.value) {
			return '/static/icons/pc-6b7280.png'
		}
		const n = s.peerName.toLowerCase()
		if (n.indexOf('phone') >= 0 || n.indexOf('手机') >= 0 || n.indexOf('iphone') >= 0
			|| n.indexOf('mate') >= 0 || n.indexOf('pura') >= 0 || n.indexOf('harmony') >= 0) {
			return '/static/icons/phone-2f7cf6.png'
		}
		return '/static/icons/pc-2f7cf6.png'
	}

	/* 模板只能点本页自己的函数：只被模板引用的 store 动作会被摇树丢掉，编译报“找不到名称 invoke”。 */
	function pick(at: string) {
		kind.value = at
		chooseKind(at)
	}

	function dropFile(at: number) {
		removeFile(at)
	}

	function sendNow() {
		onSend()
	}

	function goConnect() {
		if (!linked.value) {
			uni.navigateTo({ url: '/pages/scan/scan' })
		}
	}

	function goDetail() {
		uni.switchTab({ url: '/pages/detail/detail' })
	}
</script>

<style>
	/* 这一页滚到底会被浮动的发送条压住最后一张卡，所以比公共 .page 多留一段底部空间。 */
	.pagepad {
		padding-bottom: 110px;
	}

	.seg {
		flex-direction: row;
		margin-top: 4px;
	}

	.segitem {
		flex: 1;
		height: 48px;
		border-radius: 24px;
		background-color: #eef0f4;
		align-items: center;
		justify-content: center;
		margin-right: 10px;
	}

	.last {
		margin-right: 0;
	}

	.segOn {
		background-color: #2f7cf6;
	}

	/* 设计图的分段控件是「图标 + 字」横着排，.segitem 自己是竖排居中的，所以里面再套一层横排。 */
	.seginner {
		flex-direction: row;
		align-items: center;
	}

	.seglabel {
		font-size: 16px;
		color: #374151;
	}

	.seglabelon {
		color: #ffffff;
	}

	/* 设计图的文件区是两列方块，不是单列长表：一屏能看到的文件数差一倍。 */
	.filecell {
		position: relative;
		width: 48%;
		background-color: #f7f8fa;
		border-radius: 16px;
		padding: 14px;
		margin-bottom: 12px;
	}

	.cname {
		margin-top: 10px;
		font-size: 15px;
		color: #1f2937;
		lines: 1;
		text-overflow: ellipsis;
	}

	.tick {
		position: absolute;
		right: 10px;
		bottom: 10px;
		width: 24px;
		height: 24px;
		border-radius: 12px;
		background-color: #2f7cf6;
		color: #ffffff;
		font-size: 13px;
		line-height: 24px;
		text-align: center;
	}

	.devcard {
		flex-direction: row;
		align-items: center;
		background-color: #ffffff;
		border-radius: 16px;
		padding: 18px;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
	}

	.devtile {
		margin-right: 14px;
	}

	.onoff {
		margin-left: 8px;
		font-size: 15px;
		color: #9ca3af;
	}

	.onlive {
		color: #16a34a;
	}

	/* 发送条是浮的：设计图里它压在所有内容上面，滚动时不动。 */
	.floatbar {
		position: fixed;
		left: 20px;
		right: 20px;
		bottom: 16px;
		flex-direction: row;
		align-items: center;
		height: 72px;
		background-color: #ffffff;
		border-radius: 20px;
		padding: 0 16px;
		box-shadow: 0 6px 20px rgba(15, 23, 42, 0.16);
		z-index: 10;
	}

	.sendbtn {
		width: 120px;
		height: 46px;
		line-height: 46px;
		font-size: 17px;
		background-color: #2f7cf6;
		color: #ffffff;
		border-radius: 23px;
		border-width: 0;
	}
</style>
