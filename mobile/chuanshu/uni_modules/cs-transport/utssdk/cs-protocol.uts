/** Values mirrored from shared/protocol/protocol.json v1. That file is the contract both ends
 *  share; changing a number here without changing it there is a protocol fork. */
export const PROTOCOL_VERSION: number = 1
export const TRANSPORT_PORT: number = 43720
export const CHUNK_SIZE: number = 4194304
export const MAX_FILES_PER_OFFER: number = 2000
export const MAX_NAME_BYTES: number = 255
export const MAX_PATH_DEPTH: number = 16
export const PREFIX_CHARS: number = 16
/** A whole SPKI SHA-256 in hex. The QR carries all 64 of it; only the first PREFIX_CHARS are ever
 *  shown to a human. */
const FINGERPRINT_HEX_CHARS: number = 64
export const PAIR_CODE_DIGITS: number = 6
export const PAIR_CODE_TTL_S: number = 120
/** True means this device keeps ONE code and passphrase until the user rotates them by hand, so
 *  PAIR_CODE_TTL_S is only what a build that ignores this flag would rotate on. */
export const PAIR_CODE_STATIC: boolean = true
export const PASSPHRASE_CHARS: number = 8
/** How long a stalled peer may keep the one session slot, and how long an accepted offer may go
 *  without a chunk, in seconds. Both are floors (spec §3, §4): this device may reclaim later than
 *  they say, never sooner. A phone has the same problem a PC has - a sender that pairs and then
 *  dies would otherwise lock the receiver until somebody opens 我的页 and un-pins it by hand. */
export const SESSION_IDLE_S: number = 900
export const OFFER_IDLE_S: number = 3600
/** How long a sender keeps re-sending the same manifest while the peer's user has not decided
 *  (spec §4 待决应答). The PC reads the same number out of protocol.json. */
export const OFFER_WAIT_S: number = 60
export const QR_SCHEME: string = 'chuanshu://p'
/** Broadcast has no other way to be found, so this one port may not fall back the way
 *  TRANSPORT_PORT does (contract ports.note). A device that had to rebind its TLS port still
 *  announces the real one through this datagram. */
export const DISCOVERY_PORT: number = 43721
export const ANNOUNCE_INTERVAL_S: number = 3
/** How long a candidate may stay silent before it is no longer shown. Kept in step with the PC so
 *  the same machine disappears from both screens at the same moment. */
export const PEER_EXPIRY_S: number = 15
/** spec §2: the DNS-SD service type, and the short form iOS's Info.plist demands for
 *  NSBonjourServices. Registering under one while browsing the other is a discovery layer that
 *  finds nothing and says nothing. */
export const MDNS_SERVICE_TYPE: string = '_chuanshu._tcp.local.'
export const MDNS_SERVICE_SHORT: string = '_chuanshu._tcp'

const HEX_DIGITS = '0123456789abcdef'
/** No I/O/0/1: this is read out loud to another person and typed on a phone keypad. */
const PASSPHRASE_ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'
const RESERVED_HEADS = 'CON|PRN|AUX|NUL'

/** UTF-8 byte length without touching a platform encoder, because the receiver compares this
 *  against max_name_bytes and both ends have to count the same way. */
export function utf8Len(text: string): number {
	let n = 0
	for (let i = 0; i < text.length; i++) {
		// charCodeAt answers null past the end of the string, and UTS's Kotlin side will not compare a
		// nullable Number at all - so the guard is part of the contract here, not decoration.
		const maybe = text.charCodeAt(i)
		if (maybe == null) {
			continue
		}
		const c = maybe!
		if (c < 128) {
			n = n + 1
		} else if (c < 2048) {
			n = n + 2
		} else if (c >= 55296 && c <= 56319) {
			n = n + 4
			i = i + 1
		} else {
			n = n + 3
		}
	}
	return n
}

/** Ids are hex so they survive both JSON and a URL path segment. Built by hand rather than with
 *  number.toString(16), which on Android runs on a Double. */
export function randomHex(byteLen: number): string {
	let out = ''
	for (let i = 0; i < byteLen; i++) {
		const v = Math.floor(Math.random() * 256)
		const hi = Math.floor(v / 16)
		out = out + HEX_DIGITS.charAt(hi) + HEX_DIGITS.charAt(v - hi * 16)
	}
	return out
}

/** The second secret, minted alongside the pair code (spec §3). Same hand-built pick as randomHex
 *  for the same reason: Math.random() answers a Double and toString on Android is not portable. */
export function newPassphrase(chars: number): string {
	let out = ''
	for (let i = 0; i < chars; i++) {
		out = out + PASSPHRASE_ALPHABET.charAt(Math.floor(Math.random() * PASSPHRASE_ALPHABET.length))
	}
	return out
}

/** The exact bytes POST /v1/pair's signature covers, built in one place the way app/net/spec.py
 *  does it. Whether the fourth field rides along is the whole difference between a peer whose TLS
 *  leaf is its identity key and one whose leaf is a different key, and both ends have to agree on
 *  three-versus-four from the request body alone. */
export function pairMessage(peerId: string, nonce: string, tlsFingerprint: string): string {
	if (tlsFingerprint.length == 0) {
		return 'pair|' + peerId + '|' + nonce
	}
	return 'pair|' + peerId + '|' + nonce + '|' + tlsFingerprint
}

function isReservedName(part: string): boolean {
	const upper = part.toUpperCase()
	const dot = upper.indexOf('.')
	const head = dot >= 0 ? upper.substring(0, dot) : upper
	const heads = RESERVED_HEADS.split('|')
	for (let i = 0; i < heads.length; i++) {
		if (head == heads[i]) {
			return true
		}
	}
	if (head.length == 4 && (head.startsWith('COM') || head.startsWith('LPT'))) {
		const digit = head.substring(3, 4)
		if (digit >= '1' && digit <= '9') {
			return true
		}
	}
	return false
}

/** Mirrors app/net/receive.py:sanitize_relpath. A rejected name is a PATH_REJECTED on the wire,
 *  never a quiet fix-up, so the sender learns the name is unusable. */
export function pathReject(relpath: string): string {
	if (relpath == '' || relpath.startsWith('/') || relpath.indexOf('\\') >= 0 || relpath.indexOf(':') >= 0) {
		return '路径不合法：' + relpath
	}
	const parts = relpath.split('/')
	if (parts.length > MAX_PATH_DEPTH) {
		return '层级超过 ' + MAX_PATH_DEPTH.toString()
	}
	for (let i = 0; i < parts.length; i++) {
		const part = parts[i]
		if (part == '' || part == '.' || part == '..' || part.startsWith('.')) {
			return '文件名被拒绝：' + part
		}
		if (utf8Len(part) > MAX_NAME_BYTES) {
			return '文件名过长：' + part
		}
		if (isReservedName(part)) {
			return 'Windows 保留名：' + part
		}
		if (part.endsWith('.') || part.endsWith(' ')) {
			return '文件名结尾不合法：' + part
		}
	}
	return ''
}

export function chunkCount(size: number): number {
	if (size <= 0) {
		return 0
	}
	return Math.floor((size + CHUNK_SIZE - 1) / CHUNK_SIZE)
}

export function chunkSizeAt(size: number, index: number): number {
	if (index < 0 || index >= chunkCount(size)) {
		return 0
	}
	const rest = size - index * CHUNK_SIZE
	return rest < CHUNK_SIZE ? rest : CHUNK_SIZE
}

/** The value of `X-Chunk-Escape` this end writes when it hides a zero byte (spec §4). */
export const CHUNK_ESCAPE_VALUE: string = 'stu'

/** A chunk as it leaves this device: the bytes, plus the header that says how to read them ('' means
 *  the body is the chunk itself, exactly as it was before this encoding existed). */
export class ChunkBody {
	bytes: ArrayBuffer = new ArrayBuffer(0)
	escape: string = ''
}

/** spec §4 零字节转义: a Harmony peer's TLS server hands JavaScript only the bytes in front of the
 *  first 0x00 and then stops reading that connection, so a real file chunk cannot cross to that end
 *  as it is. `0x1B → 0x1B 0x1B`, `0x00 → 0x1B B`, everything else literal; `X-Sha256` stays the
 *  digest of the original bytes, which is why the caller digests before asking for this.
 *  A body with no zero is returned untouched - no copy, no header, no change for a peer that can
 *  take the raw bytes. */
export function escapeChunk(buf: ArrayBuffer): ChunkBody {
	const out = new ChunkBody()
	out.bytes = buf
	const src = new Uint8Array(buf)
	let extra = 0
	for (let i = 0; i < src.length; i++) {
		const byte = src[i]
		// Both escapes replace one byte with two, so each one costs exactly one more byte. Counting a zero
		//  as two made the packed body longer than the bytes it holds: the request declared those extra
		//  bytes, the tail arrived as NULs the digest was never taken over, and the peer waited for the
		//  rest of a body that did not exist.
		if (byte == 0 || byte == 0x1B) {
			extra = extra + 1
		}
	}
	if (extra == 0) {
		return out
	}
	const packed = new ArrayBuffer(src.length + extra)
	const dst = new Uint8Array(packed)
	let at = 0
	for (let i = 0; i < src.length; i++) {
		const byte = src[i]
		if (byte == 0) {
			dst[at] = 0x1B
			at = at + 1
			dst[at] = 0x42
			at = at + 1
			continue
		}
		if (byte == 0x1B) {
			dst[at] = 0x1B
			at = at + 1
			dst[at] = 0x1B
			at = at + 1
			continue
		}
		dst[at] = byte
		at = at + 1
	}
	out.bytes = packed
	out.escape = CHUNK_ESCAPE_VALUE
	return out
}

/** Read a body back the way its sender meant it: untouched when no `X-Chunk-Escape` came with it, the
 *  undoing of `escapeChunk` when one did. A receiver decides this from the header alone - never by
 *  guessing from the bytes, because a chunk that happens to start with 0x1B is a chunk, not an escape.
 *  An encoding this end does not know is passed through as it arrived: the length and digest checks
 *  that follow are the ones that say what it was, and quietly dropping bytes here would hide that. */
export function unescapeChunk(buf: ArrayBuffer, escape: string): ArrayBuffer {
	if (escape != CHUNK_ESCAPE_VALUE) {
		return buf
	}
	const src = new Uint8Array(buf)
	const packed = new ArrayBuffer(src.length)
	const dst = new Uint8Array(packed)
	let at = 0
	let i = 0
	while (i < src.length) {
		if (src[i] == 0x1B && i + 1 < src.length) {
			if (src[i + 1] == 0x1B) {
				dst[at] = 0x1B
				at = at + 1
				i = i + 2
				continue
			}
			if (src[i + 1] == 0x42) {
				at = at + 1
				i = i + 2
				continue
			}
		}
		dst[at] = src[i]
		at = at + 1
		i = i + 1
	}
	const out = new ArrayBuffer(at)
	const view = new Uint8Array(out)
	for (let i = 0; i < at; i++) {
		view[i] = dst[i]
	}
	return out
}

export class CsFile {
	/** path stays local - it is how this device reads the bytes; the peer only ever sees relpath. */
	path: string = ''
	relpath: string = ''
	id: string = ''
	size: number = 0
	sha256: string = ''
	mtime: number = 0
	type: string = 'application/octet-stream'
}

function manifestOf(file: CsFile): UTSJSONObject {
	const item: UTSJSONObject = {
		id: file.id,
		relpath: file.relpath,
		size: file.size,
		sha256: file.sha256,
		mtime: file.mtime,
		type: file.type
	}
	return item
}

export function offerJson(offerId: string, files: CsFile[], peerId: string, name: string): string {
	const items: UTSJSONObject[] = []
	let total = 0
	for (let i = 0; i < files.length; i++) {
		items.push(manifestOf(files[i]))
		total = total + files[i].size
	}
	const from: UTSJSONObject = { peer_id: peerId, name: name }
	const body: UTSJSONObject = {
		offer_id: offerId,
		protocol_version: PROTOCOL_VERSION,
		total_size: total,
		from: from,
		files: items
	}
	return JSON.stringify(body)
}

export function pairJson(peerId: string, name: string, nonce: string, publicKeyB64: string, signature: string, code: string, secret: string, tlsFingerprint: string): string {
	const body: UTSJSONObject = {
		peer_id: peerId,
		name: name,
		protocol_version: PROTOCOL_VERSION,
		nonce: nonce,
		public_key: publicKeyB64,
		signature: signature,
		code: code
	}
	// Both keys are optional on the wire, and leaving a key off is not the same as sending it empty:
	// an absent 'secret' means "this sender has no passphrase to offer" and an absent
	// 'tls_fingerprint' means "the certificate I serve is signed by the key that signed this".
	if (secret.length > 0) {
		body['secret'] = secret
	}
	if (tlsFingerprint.length > 0) {
		body['tls_fingerprint'] = tlsFingerprint
	}
	return JSON.stringify(body)
}

export function parseJson(text: string): UTSJSONObject | null {
	return JSON.parse(text) as UTSJSONObject | null
}

export function codeOf(text: string): string {
	const obj = parseJson(text)
	if (obj == null) {
		return ''
	}
	return obj.getString('code', '')
}

export function detailOf(text: string): string {
	const obj = parseJson(text)
	if (obj == null) {
		return ''
	}
	const detail = obj.getJSON('detail')
	if (detail != null) {
		return JSON.stringify(detail)
	}
	// Android writes the platform exception straight into `detail`, Harmony wraps it as
	// {"reason":"…"}; reading only the object shape made every Android detail come back empty, so a
	// refused connect said 「协议错误：IO」 with the one sentence that explains it thrown away.
	return obj.getString('detail', '')
}

/** Error codes come off the wire; the wording stays in one place on this end too. */
export function errorText(code: string): string {
	if (code == 'UNSUPPORTED_PROTOCOL') {
		return '对端版本不兼容'
	}
	if (code == 'NOT_PAIRED') {
		return '尚未与这台设备配对'
	}
	if (code == 'BAD_PAIR_CODE') {
		return '配对码不正确或已过期'
	}
	if (code == 'DECLINED') {
		return '对方拒绝了这次传输'
	}
	if (code == 'OFFER_UNKNOWN') {
		return '传输请求不存在或已结束'
	}
	if (code == 'BAD_CHUNK_INDEX') {
		return '分块序号超出文件范围'
	}
	if (code == 'CHUNK_DIGEST_MISMATCH') {
		return '分块校验失败'
	}
	if (code == 'FILE_DIGEST_MISMATCH') {
		return '文件校验失败'
	}
	if (code == 'PATH_REJECTED') {
		return '文件名被接收方拒绝'
	}
	if (code == 'STORAGE_FULL') {
		return '接收方存储空间不足'
	}
	if (code == 'PEER_BUSY') {
		return '对方正在处理另一个传输'
	}
	// Not a wire code from the peer but one of the transport's own, named the same way on both
	// phones: Android says it when the platform cannot resolve the host, and Harmony now asks the
	// resolver before it blames the handshake.
	if (code == 'HOST_UNKNOWN') {
		return '这个名字解析不出来'
	}
	return '协议错误：' + code
}

/** Indices arrive through JSON, where an Android number is a Double, so every read goes through
 *  Math.floor before it is used as an index. The list is read with a typed getArray rather than a
 *  bare `get`, because Harmony's ArkTS rejects `any` anywhere in the program - and a list of numbers
 *  is what the wire actually carries here, so nothing is being given up to satisfy the compiler. */
export function numList(value: number[] | null): number[] {
	const out: number[] = []
	if (value == null) {
		return out
	}
	for (let i = 0; i < value.length; i++) {
		out.push(Math.floor(value[i]))
	}
	return out
}

export class ChunkPlan {
	id: string = ''
	received: number = 0
	missing: number[] = []
}

/** One entry per file, as GET /v1/offer/{id}/state answers it. */
export function statePlans(text: string): ChunkPlan[] {
	const out: ChunkPlan[] = []
	const obj = parseJson(text)
	if (obj == null) {
		return out
	}
	const files = obj.getArray<UTSJSONObject>('files')
	if (files == null) {
		return out
	}
	for (let i = 0; i < files.length; i++) {
		const entry = files[i]
		const plan = new ChunkPlan()
		plan.id = entry.getString('id', '')
		plan.received = entry.getNumber('received', 0)
		plan.missing = numList(entry.getArray<number>('missing'))
		out.push(plan)
	}
	return out
}

export class VerifyResult {
	id: string = ''
	ok: boolean = false
	missing: number[] = []
	path: string = ''
}

export function finalizeResults(text: string): VerifyResult[] {
	const out: VerifyResult[] = []
	const obj = parseJson(text)
	if (obj == null) {
		return out
	}
	const list = obj.getArray<UTSJSONObject>('verified')
	if (list == null) {
		return out
	}
	for (let i = 0; i < list.length; i++) {
		const entry = list[i]
		const item = new VerifyResult()
		item.id = entry.getString('id', '')
		item.ok = entry.getBoolean('ok', false)
		item.missing = numList(entry.getArray<number>('missing'))
		item.path = entry.getString('path', '')
		out.push(item)
	}
	return out
}

export function formatSize(bytes: number): string {
	if (bytes >= 1048576) {
		return (bytes / 1048576).toFixed(2) + ' MB'
	}
	if (bytes >= 1024) {
		return (bytes / 1024).toFixed(1) + ' KB'
	}
	return bytes.toString() + ' B'
}

export function isDigits(text: string): boolean {
	if (text.length == 0) {
		return false
	}
	for (let i = 0; i < text.length; i++) {
		const c = text.charAt(i)
		if (c < '0' || c > '9') {
			return false
		}
	}
	return true
}

/** What the user may type into the pair-code field: digits, and only as many as the contract has. */
export function digitsOnly(text: string): string {
	let out = ''
	for (let i = 0; i < text.length; i++) {
		const c = text.charAt(i)
		if (c >= '0' && c <= '9' && out.length < PAIR_CODE_DIGITS) {
			out = out + c
		}
	}
	return out
}

/** '' when the code is worth sending, otherwise what to tell the user before wasting a round trip.
 *  The receiver only ever compares it for equality, so this is pure input hygiene. */
export function codeReject(code: string): string {
	if (code.length == 0) {
		return '还缺配对码'
	}
	if (!isDigits(code)) {
		return '配对码只能是数字'
	}
	if (code.length != PAIR_CODE_DIGITS) {
		return '配对码是 ' + PAIR_CODE_DIGITS.toString() + ' 位数字'
	}
	return ''
}

/** An empty passphrase is a legitimate answer - it means the key is left off the wire and the peer
 *  pairs on the code alone, which is how a build without one still connects. Anything typed is
 *  checked for shape only, never for where it came from. */
export function passReject(secret: string): string {
	if (secret.length == 0) {
		return ''
	}
	if (secret.length != PASSPHRASE_CHARS) {
		return '连接密码是 ' + PASSPHRASE_CHARS.toString() + ' 位'
	}
	for (let i = 0; i < secret.length; i++) {
		// Case-sensitive on purpose: the peer compares these bytes for equality, so a lowercase
		// typo would surface as an unexplained pairing failure instead of a message here.
		if (PASSPHRASE_ALPHABET.indexOf(secret.charAt(i)) < 0) {
			return '连接密码只有大写字母和数字：' + secret.charAt(i)
		}
	}
	return ''
}

function hexValue(c: string): number {
	return HEX_DIGITS.indexOf(c.toLowerCase())
}

export function isFullFingerprint(text: string): boolean {
	if (text.length != FINGERPRINT_HEX_CHARS) {
		return false
	}
	for (let i = 0; i < text.length; i++) {
		if (hexValue(text.charAt(i)) < 0) {
			return false
		}
	}
	return true
}

/** The payload is built with urlencode on the PC, so read the escapes back. Hosts, ports, versions
 *  and fingerprints are all ASCII, which is why byte-by-byte decoding is enough here. */
function decodeField(text: string): string {
	if (text.indexOf('%') < 0 && text.indexOf('+') < 0) {
		return text
	}
	let out = ''
	let i = 0
	while (i < text.length) {
		const c = text.charAt(i)
		if (c == '+') {
			out = out + ' '
			i = i + 1
		} else if (c == '%' && i + 2 < text.length) {
			const hi = hexValue(text.charAt(i + 1))
			const lo = hexValue(text.charAt(i + 2))
			if (hi >= 0 && lo >= 0) {
				out = out + String.fromCharCode(hi * 16 + lo)
				i = i + 3
			} else {
				out = out + c
				i = i + 1
			}
		} else {
			out = out + c
			i = i + 1
		}
	}
	return out
}

export class PairTarget {
	host: string = ''
	port: string = ''
	version: string = ''
	fingerprint: string = ''
	code: string = ''
	/** The other side's passphrase, read straight off its pairing text; '' when it has none. */
	secret: string = ''
	/** '' once the payload is usable; anything else is the sentence the UI shows instead. */
	reject: string = ''
}

/** Read a pairing payload - a scanned QR or a pasted string - the way app/net/spec.py:parse_qr does.
 *  Order-independent, unknown keys ignored (spec §7: fields only grow), and h+f are mandatory: the
 *  address tells us where to knock and the fingerprint is the only thing that makes the answer
 *  trustworthy, so a payload missing either is not a peer we may pin. */
export function parsePairUrl(text: string): PairTarget {
	const out = new PairTarget()
	const trimmed = text.trim()
	const head = QR_SCHEME + '?'
	if (!trimmed.startsWith(head)) {
		out.reject = '不是传书的配对二维码或链接'
		return out
	}
	const fields = trimmed.substring(head.length).split('&')
	for (let i = 0; i < fields.length; i++) {
		const entry = fields[i]
		const eq = entry.indexOf('=')
		if (eq <= 0) {
			continue
		}
		const key = entry.substring(0, eq)
		const value = decodeField(entry.substring(eq + 1))
		if (key == 'h') {
			out.host = value
		} else if (key == 'p') {
			out.port = value
		} else if (key == 'v') {
			out.version = value
		} else if (key == 'f') {
			out.fingerprint = value
		} else if (key == 'c') {
			out.code = value
		} else if (key == 'k') {
			out.secret = value
		}
	}
	if (out.host.length == 0 || out.fingerprint.length == 0) {
		out.reject = '配对信息里没有地址或指纹，无法安全连接'
	} else if (!isFullFingerprint(out.fingerprint)) {
		out.reject = '配对信息里的指纹不是完整的 64 位十六进制，可能被截断了'
	} else if (!isDigits(out.version) || parseFloat(out.version) != PROTOCOL_VERSION) {
		out.reject = '对端协议版本 v' + out.version + ' 本机听不懂'
	} else if (out.port.length > 0 && !isDigits(out.port)) {
		out.reject = '配对信息里的端口不合法'
	} else if (out.code.length > 0) {
		out.reject = codeReject(out.code)
	} else {
		out.reject = passReject(out.secret)
	}
	return out
}

