/** Web half of the transport. A browser has no TLS socket to a LAN peer, so this file stands in
 *  for the PC: it really checks the pair code, really digests every chunk and really reassembles and
 *  verifies the whole file. The state machine in utssdk/cs-client.uts cannot tell the difference,
 *  which is the point - what it cannot prove from a browser is the TLS pinning and the real file
 *  system, and those stay marked as device-only work.
 *
 *  The same file now stands in for both directions: the browser is the phone (its receiver runs
 *  utssdk/cs-receive.uts over an in-memory byte store) and the PC is a peer inside this tab that
 *  runs utssdk/cs-client.uts against it. Nothing on the wire knows the difference. */

const DEMO_CHUNK_SIZE = 4194304

const SHA_K: number[] = [
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

function rotr(x: number, n: number): number {
	return ((x >>> n) | (x << (32 - n))) >>> 0
}

function sha256Bytes(data: Uint8Array): Uint8Array {
	const len = data.length
	const total = (((len + 9 + 63) >> 6) << 6)
	const padded = new Uint8Array(total)
	padded.set(data)
	padded[len] = 0x80
	const bitLen = len * 8
	const view = new DataView(padded.buffer)
	view.setUint32(total - 8, Math.floor(bitLen / 4294967296))
	view.setUint32(total - 4, bitLen >>> 0)

	const h: number[] = [
		0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
	]
	const w = new Uint32Array(64)
	for (let off = 0; off < total; off += 64) {
		for (let i = 0; i < 16; i++) {
			w[i] = view.getUint32(off + i * 4)
		}
		for (let i = 16; i < 64; i++) {
			const a15 = w[i - 15]
			const a2 = w[i - 2]
			const s0 = (rotr(a15, 7) ^ rotr(a15, 18) ^ (a15 >>> 3)) >>> 0
			const s1 = (rotr(a2, 17) ^ rotr(a2, 19) ^ (a2 >>> 10)) >>> 0
			w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0
		}
		let a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7]
		for (let i = 0; i < 64; i++) {
			const S1 = (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) >>> 0
			const ch = ((e & f) ^ ((~e) & g)) >>> 0
			const temp1 = (hh + S1 + ch + SHA_K[i] + w[i]) >>> 0
			const S0 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) >>> 0
			const maj = ((a & b) ^ (a & c) ^ (b & c)) >>> 0
			const temp2 = (S0 + maj) >>> 0
			hh = g
			g = f
			f = e
			e = (d + temp1) >>> 0
			d = c
			c = b
			b = a
			a = (temp1 + temp2) >>> 0
		}
		h[0] = (h[0] + a) >>> 0
		h[1] = (h[1] + b) >>> 0
		h[2] = (h[2] + c) >>> 0
		h[3] = (h[3] + d) >>> 0
		h[4] = (h[4] + e) >>> 0
		h[5] = (h[5] + f) >>> 0
		h[6] = (h[6] + g) >>> 0
		h[7] = (h[7] + hh) >>> 0
	}
	const out = new Uint8Array(32)
	const outView = new DataView(out.buffer)
	for (let i = 0; i < 8; i++) {
		outView.setUint32(i * 4, h[i])
	}
	return out
}

function hexOf(bytes: Uint8Array): string {
	const digits = '0123456789abcdef'
	let out = ''
	for (let i = 0; i < bytes.length; i++) {
		const v = bytes[i]
		out = out + digits.charAt(v >> 4) + digits.charAt(v & 15)
	}
	return out
}

function randomBytes(len: number): Uint8Array {
	// The browser's cryptographic generator (§3): the page's stand-in key, its ids and - through
	// `harnessRand` below - the three secrets the shared kernel mints all come from here. `btoa` two
	// functions down is the same kind of Web API, so this target does pass browser globals through.
	const out = new Uint8Array(len)
	crypto.getRandomValues(out)
	return out
}

/** §3: the function each host hands to `newInbox`. On this target the host is the tab. */
const harnessRand: RandFn = (byteLen: number): string => {
	return hexOf(randomBytes(byteLen))
}

/* Four scripted sources for §3's self-check legs below. A hand that mints a secret cannot be watched,
 *  but it can be *replaced* - and then the secret itself says which hand made it. */

/** Thirty-two bytes as hex: `0a`..`19` twice. Six of them read as digits, eight as passphrase letters,
 *  and all thirty-two as the session token. */
const SCRIPTED_HEX = '0a0b0c0d0e0f101112131415161718190a0b0c0d0e0f10111213141516171819'
const scriptedRand: RandFn = (byteLen: number): string => {
	return SCRIPTED_HEX
}

/** `fa`..`fe` - the five values a byte has that ten digits do not divide into - then `01`..`09`. Long
 *  enough for a six-digit code, too short for eight passphrase symbols on purpose. */
const DROPPED_HEX = 'fafbfcfdfe010203040506070809'
const droppedRand: RandFn = (byteLen: number): string => {
	return DROPPED_HEX
}

/** The same five, sixteen bytes deep: a 32-letter alphabet divides 256, so none of these is dropped. */
const DROPPED16_HEX = 'fafbfcfdfe0102030405060708090a0b'
const dropped16Rand: RandFn = (byteLen: number): string => {
	return DROPPED16_HEX
}

/** The host that armed nothing. */
const emptyRand: RandFn = (byteLen: number): string => {
	return ''
}

function b64(bytes: Uint8Array): string {
	let binary = ''
	for (let i = 0; i < bytes.length; i++) {
		binary = binary + String.fromCharCode(bytes[i])
	}
	return btoa(binary)
}

/* ------------------------------------------------------------------ our own identity */

let myPeerId = ''
let myName = ''
let myPub = new Uint8Array(0)
let myRaw = new Uint8Array(32)
let myFp = ''

function ensureSelf(): void {
	if (myPeerId != '') {
		return
	}
	myPeerId = hexOf(randomBytes(16))
	// §1's shape, the same sixteen random bytes the three real ends mint: nothing on the wire reads a
	// peer_id as a label, so this page's stand-in carries no prefix.
	// A browser cannot hold an Ed25519 key the way java.security does, so this is a stand-in
	// keypair: 44 bytes shaped like a SubjectPublicKeyInfo, digesting to a fingerprint that
	// behaves like a real one for the demo peer.
	const raw = randomBytes(32)
	myRaw = raw
	const spki = spkiOfRaw(raw)
	myPub = spki
	myFp = hexOf(sha256Bytes(spki))
}

/** §1's fallback on this target: a browser tab has no hardware name, so the stand-in for
 *  `Build.MODEL` is the browser itself. */
function hardwareName(): string {
	const info = uni.getSystemInfoSync()
	return '浏览器 · ' + info.browserName
}

/** The name this page answers with - the user's once they have given one. It lives in this module rather
 *  than in a file because the browser target has no private directory: like the stand-in keypair above,
 *  it is born with the page and goes with it, which is why nothing here can be proven about a restart. */
function myNameText(): string {
	return nameWithDefault(myName, hardwareName())
}

export function deviceNameSave(name: string, cb: (message: string) => void): void {
	myName = name.trim()
	cb('')
}

export function selfInfo(cb: (peerId: string, name: string, fingerprint: string) => void): void {
	ensureSelf()
	cb(myPeerId, myNameText(), myFp)
}

/** The page has to say plainly which peer it is talking to, so the answer lives next to the
 *  transport that decides it rather than in a compile-time branch the reader cannot verify. */
export function transportMocked(): boolean {
	return true
}

export function transportNote(): string {
	return '浏览器没有 TLS socket，也没有真实文件系统：对端由本页内的模拟 PC 代答，但它会真的逐块算校验和、重组并整文件复算。' +
		'证书固定与落盘仍然只算真机工作，这里的结果不能替它们作证。'
}

/** The browser cannot enumerate this machine's interfaces, and the stand-in peer has no address to
 *  begin with, so the honest answer is "unknown" - never a pass that makes the demo look checked. */
export function lanCheck(host: string, cb: (level: string, text: string) => void): void {
	cb('unknown', host == ''
		? '还没有对端地址'
		: '浏览器查不到本机网卡，' + host + ' 是否在同一网络要在手机上核对')
}

/** The browser's substitute for the identity key: it signs whatever bytes it is handed, because
 *  which message carries the signature is spec §3's decision and cs-client.uts makes it. */
export function signPair(message: string, cb: (publicKeyB64: string, signatureB64: string) => void): void {
	ensureSelf()
	// The wire carries base64 of the raw 32-byte key, the way app/net/receive.py reads it with
	// Ed25519PublicKey.from_public_bytes - not the 44-byte SPKI. Getting this shape wrong is the
	// difference between a peer the PC can verify and one it rejects as unreadable.
	cb(b64(myRaw), b64(sha256Bytes(utf8(message))))
}

function utf8(text: string): Uint8Array {
	const enc = new TextEncoder()
	return enc.encode(text)
}

/* ------------------------------------------------------------------ key shapes */

const SPKI_HEAD: number[] = [0x30, 0x2a, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x03, 0x21, 0x00]

/** Re-encode a raw Ed25519 key as the SubjectPublicKeyInfo whose digest is the trust anchor. This
 *  is the whole reason the pair request carries the raw key: both ends must reach the same 44 bytes
 *  or the fingerprint each side computes is about a different object. */
function spkiOfRaw(raw: Uint8Array): Uint8Array {
	if (raw.length != 32) {
		return new Uint8Array(0)
	}
	const spki = new Uint8Array(44)
	for (let i = 0; i < 12; i++) {
		spki[i] = SPKI_HEAD[i]
	}
	for (let i = 0; i < 32; i++) {
		spki[12 + i] = raw[i]
	}
	return spki
}

const B64_ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

/** base64 without a platform decoder: `atob` is not typed in UTS, and a receiver that cannot decode
 *  a key would have to either trust it or refuse every peer. */
function fromBase64(text: string): Uint8Array | null {
	let clean = text
	while (clean.length > 0 && clean.charAt(clean.length - 1) == '=') {
		clean = clean.substring(0, clean.length - 1)
	}
	if (clean.length == 0 || clean.length > 128) {
		return null
	}
	const out = new Uint8Array(Math.floor(clean.length * 3 / 4))
	let acc = 0
	let bits = 0
	let at = 0
	for (let i = 0; i < clean.length; i++) {
		const v = B64_ALPHABET.indexOf(clean.charAt(i))
		if (v < 0) {
			return null
		}
		acc = (acc << 6) | v
		bits = bits + 6
		if (bits >= 8) {
			bits = bits - 8
			out[at] = (acc >> bits) & 0xff
			at = at + 1
			acc = acc & ((1 << bits) - 1)
		}
	}
	if (at == out.length) {
		return out
	}
	return out.subarray(0, at)
}

export function digestHex(buf: ArrayBuffer, cb: (hex: string) => void): void {
	cb(hexOf(sha256Bytes(new Uint8Array(buf))))
}

/* --------------------------------------------------------------------- digest self-check */

/** The padding boundaries - 55/56, 63/64/65, 119/120, 127/128/129 - are where a hand-written
 *  SHA-256 actually breaks, so these are hashlib outputs for the same byte pattern, kept here as
 *  an oracle. 'abc' is the published NIST vector. */
function pattern(n: number): Uint8Array {
	const out = new Uint8Array(n)
	for (let i = 0; i < n; i++) {
		out[i] = (i * 7 + 3) % 256
	}
	return out
}

const VECTOR_LEN: number[] = [0, 1, 3, 55, 56, 57, 63, 64, 65, 119, 120, 127, 128, 129, 1000]
const VECTOR_HEX: string[] = [
	'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855',
	'084fed08b978af4d7d196a7446a86b58009e636b611db16211b65a9aadff29c5',
	'6ab0dba1f4f1dfbb37b4f9eeb092c09fca4900ad32bdcd147d8dde35d6c87c35',
	'e7313d333c272e639f790978283f9eb392e843d0f29b7016828bb1daa4aac70b',
	'4324d65f3c103567f5589c710bc08f8523f929a9272e3af36fc968e52abc6c27',
	'35df609437dcfea3279283ab79fd554e2bf78f8f7ae2de532d8ee300b09e8f73',
	'81c80242132f230c3bd41b3e63bbcff16107339549214a99614ff26664625055',
	'39e3d7b6b5d075d37d053ad89b24b41bef4f3c29760c84447cab3f3be1882241',
	'aacca6ff74fdbb296d165a45cecfa04e5127bc008770fbbdd48006f2d2fae95e',
	'9ce7368e4daf32341631b492e80359dc9f594b48453cd0dd5bf0b19279cc177e',
	'7836b787757e95e58b3ca5aec90b1b004e8deba1e50e9675af9cabf1a13a04b5',
	'a8d23e75d936f303d248888d9b165ee543f4cbafcad3c9dd2a79bd84faa11d07',
	'd2742f1f4ac6bb7ca2b239ee18402ba8b3f9f8e652d2a72973c2b9ba11c08cf6',
	'307f8fc2c1622b92762e818d39a185d4d667ad49a4b07ceae1f4afa008a93ec4',
	'1e9bc38cbf860b9ec31918b065f9b52476c549a782e0e7990bed8ce3868d2371'
]

export function shaSelfTest(): string {
	const out: string[] = []
	let bad = 0
	for (let i = 0; i < VECTOR_LEN.length; i++) {
		const mine = hexOf(sha256Bytes(pattern(VECTOR_LEN[i])))
		if (mine == VECTOR_HEX[i]) {
			out.push(VECTOR_LEN[i].toString() + ' 字节 一致')
		} else {
			bad = bad + 1
			out.push(VECTOR_LEN[i].toString() + ' 字节 不符：' + mine)
		}
	}
	const abc = hexOf(sha256Bytes(utf8('abc')))
	if (abc == 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad') {
		out.push('abc 一致（NIST 公开向量）')
	} else {
		bad = bad + 1
		out.push('abc 不符：' + abc)
	}
	out.push(bad == 0 ? 'SHA-256 自检 16/16 通过' : 'SHA-256 自检失败 ' + bad.toString() + ' 项')
	return out.join('\n')
}

/* ------------------------------------------------------------------------ file access */

const fileCache = new Map<string, Uint8Array>()

function nameType(name: string): string {
	const dot = name.lastIndexOf('.')
	if (dot < 0) {
		return 'application/octet-stream'
	}
	const ext = name.substring(dot + 1).toLowerCase()
	if (ext == 'txt' || ext == 'md' || ext == 'log') {
		return 'text/plain'
	}
	if (ext == 'png' || ext == 'jpg' || ext == 'jpeg' || ext == 'gif' || ext == 'webp') {
		return 'image/' + (ext == 'jpeg' ? 'jpg' : ext)
	}
	if (ext == 'zip') {
		return 'application/zip'
	}
	if (ext == 'json') {
		return 'application/json'
	}
	return 'application/octet-stream'
}

function loadFile(path: string, cb: (bytes: Uint8Array | null, message: string) => void): void {
	const cached = fileCache.get(path)
	if (cached != null) {
		cb(cached, '')
		return
	}
	const req = fetch(path)
	if (req == null) {
		cb(null, '浏览器未能打开这个文件地址')
		return
	}
	req.then((res: Response): Promise<ArrayBuffer> => {
		return res.arrayBuffer()
	}).then((buf: ArrayBuffer): void => {
		const bytes = new Uint8Array(buf)
		fileCache.set(path, bytes)
		cb(bytes, '')
	}).catch((err: any): void => {
		cb(null, '' + err)
	})
}

export function prepareFile(
	path: string,
	relpath: string,
	cb: (ok: boolean, id: string, size: number, sha256: string, mtime: number, type: string, message: string) => void
): void {
	loadFile(path, function (bytes: Uint8Array | null, message: string) {
		if (bytes == null) {
			cb(false, '', 0, '', 0, '', message)
			return
		}
		const id = hexOf(randomBytes(8))
		const sha = hexOf(sha256Bytes(bytes))
		const mtime = Math.floor(Date.now() / 1000)
		cb(true, id, bytes.length, sha, mtime, nameType(relpath), '')
	})
}

export function readChunk(path: string, offset: number, length: number, cb: (buf: ArrayBuffer | null, message: string) => void): void {
	loadFile(path, function (bytes: Uint8Array | null, message: string) {
		if (bytes == null) {
			cb(null, message)
			return
		}
		const end = offset + length
		const slice = bytes.subarray(offset, end > bytes.length ? bytes.length : end)
		const copy = new Uint8Array(slice.length)
		copy.set(slice)
		cb(copy.buffer as ArrayBuffer, '')
	})
}

/* -------------------------------------------------------------------- the stand-in peer */

class DemoOffer {
	offerId: string = ''
	files: UTSJSONObject[] = []
	chunks: Map<string, Map<number, Uint8Array>> = new Map()
}

class DemoPeer {
	code: string = ''
	passphrase: string = ''
	fingerprint: string = ''
	token: string = ''
	paired: boolean = false
	/** Whose session this stand-in currently holds, so a refusal can name the holder like the PC does. */
	pairedName: string = ''
	offers: Map<string, DemoOffer> = new Map()
	fault: string = ''
	chunkFaultUsed: boolean = false
}

const peer = new DemoPeer()
/** The key that was trusted at the last successful pairing - the stand-in for the phone's trust
 *  store, and it survives a peer restart exactly like the real one does. */
let pinnedFp = ''
/** The other half of the trust story: what the *demo PC* pinned about this browser. It is the pair
 *  request's base64 SPKI, the only identity a stand-in with no TLS handshake has. */
let trustedKey = ''

function resetPeer(): void {
	// §3's two printable secrets, minted by the same two functions the shared kernel uses and off this
	// tab's generator: the demo PC and a phone answer a stranger with the same promise.
	peer.code = newPairCode(harnessRand, PAIR_CODE_DIGITS)
	peer.passphrase = newPassphrase(harnessRand, PASSPHRASE_CHARS)
	peer.fingerprint = hexOf(sha256Bytes(utf8('chuanshu-demo-pc|' + peer.code)))
	peer.token = ''
	peer.paired = false
	peer.offers = new Map()
	peer.fault = ''
	peer.chunkFaultUsed = false
}

export function demoPeer(): UTSJSONObject {
	if (peer.code == '') {
		resetPeer()
	}
	const out: UTSJSONObject = { host: '127.0.0.1', port: 43720, code: peer.code, passphrase: peer.passphrase, fingerprint: peer.fingerprint, name: 'PC 演示机' }
	return out
}

/** The pairing payload a real PC paints as a QR, so pasting in a browser does what scanning does on
 *  a phone. Same fields, same order: h, p, v, f, c, k. */
export function demoQrUrl(): string {
	if (peer.code == '') {
		resetPeer()
	}
	return 'chuanshu://p?h=127.0.0.1&p=43720&v=1&f=' + peer.fingerprint + '&c=' + peer.code + '&k=' + peer.passphrase
}

export function setDemoFault(fault: string): void {
	if (peer.code == '') {
		resetPeer()
	}
	peer.fault = fault
	peer.chunkFaultUsed = false
}

/** Restarting the peer rotates its key and code but deliberately keeps our pin, which is what a
 *  real rekey looks like from this side: the next connection is refused before any endpoint runs. */
export function demoRestart(): void {
	resetPeer()
}

/** A restart that keeps the key: the token dies, every authed endpoint answers NOT_PAIRED, and the
 *  sender is meant to repair it by signature alone. spec §3 says the user must not see this. */
export function demoExpireToken(): void {
	peer.token = ''
	peer.paired = false
	peer.offers = new Map()
}

/** What the PC app's "撤销已配对设备" does, so a demo restart can be undone. */
export function demoUnpin(): void {
	pinnedFp = ''
	trustedKey = ''
}

export function pinnedFingerprint(): string {
	return pinnedFp
}

function reply(status: number, body: UTSJSONObject, cb: (status: number, body: string) => void): void {
	cb(status, JSON.stringify(body))
}

function failure(code: string, detail: UTSJSONObject | null, status: number, cb: (status: number, body: string) => void): void {
	const body: UTSJSONObject = detail == null ? { code: code } : { code: code, detail: detail }
	reply(status, body, cb)
}

function chunkCountOf(size: number): number {
	if (size <= 0) {
		return 0
	}
	return Math.floor((size + DEMO_CHUNK_SIZE - 1) / DEMO_CHUNK_SIZE)
}

function offerPayload(offer: DemoOffer): UTSJSONObject {
	const list: UTSJSONObject[] = []
	for (let i = 0; i < offer.files.length; i++) {
		const file = offer.files[i]
		const id = file.getString('id', '')
		const size = file.getNumber('size', 0)
		const stored = offer.chunks.get(id)
		const have = stored == null ? 0 : stored.size
		const missing: number[] = []
		for (let k = 0; k < chunkCountOf(size); k++) {
			if (stored == null || !stored.has(k)) {
				missing.push(k)
			}
		}
		const entry: UTSJSONObject = { id: id, received: have, missing: missing }
		list.push(entry)
	}
	return { offer_id: offer.offerId, accepted: true, files: list } as UTSJSONObject
}

function routeOffer(body: UTSJSONObject, cb: (status: number, body: string) => void): void {
	const offerId = body.getString('offer_id', '')
	const files = body.getArray('files')
	if (offerId == '' || files == null || files.length == 0) {
		failure('UNSUPPORTED_PROTOCOL', { reason: 'offer has no id or files' } as UTSJSONObject, 400, cb)
		return
	}
	const known = peer.offers.get(offerId)
	if (known != null) {
		reply(200, offerPayload(known), cb)
		return
	}
	if (peer.fault == 'DECLINED') {
		failure('DECLINED', null, 403, cb)
		return
	}
	const list: UTSJSONObject[] = []
	for (let i = 0; i < files.length; i++) {
		list.push(files[i] as UTSJSONObject)
	}
	const offer = new DemoOffer()
	offer.offerId = offerId
	offer.files = list
	peer.offers.set(offerId, offer)
	reply(200, offerPayload(offer), cb)
}

function sameBytes(a: Uint8Array, b: Uint8Array): boolean {
	if (a.length != b.length) {
		return false
	}
	for (let i = 0; i < a.length; i++) {
		if (a[i] != b[i]) {
			return false
		}
	}
	return true
}

function routeChunk(parts: string[], body: ArrayBuffer, sha: string, cb: (status: number, body: string) => void): void {
	const offerId = parts[3]
	const fileId = parts[5]
	const index = Math.floor(parseFloat(parts[6]))
	const offer = peer.offers.get(offerId)
	if (offer == null) {
		failure('OFFER_UNKNOWN', { offer_id: offerId } as UTSJSONObject, 404, cb)
		return
	}
	let file: UTSJSONObject | null = null
	for (let i = 0; i < offer.files.length; i++) {
		if (offer.files[i].getString('id', '') == fileId) {
			file = offer.files[i]
		}
	}
	if (file == null) {
		failure('OFFER_UNKNOWN', { file_id: fileId } as UTSJSONObject, 404, cb)
		return
	}
	const size = file!.getNumber('size', 0)
	const count = chunkCountOf(size)
	if (index < 0 || index >= count) {
		failure('BAD_CHUNK_INDEX', { index: index, count: count } as UTSJSONObject, 400, cb)
		return
	}
	const data = new Uint8Array(body)
	const want = Math.min(DEMO_CHUNK_SIZE, size - index * DEMO_CHUNK_SIZE)
	if (data.length != want) {
		failure('CHUNK_DIGEST_MISMATCH', { reason: 'length', got: data.length, want: want } as UTSJSONObject, 422, cb)
		return
	}
	const digest = hexOf(sha256Bytes(data))
	if (sha != '' && sha != digest) {
		failure('CHUNK_DIGEST_MISMATCH', { index: index, expected: sha } as UTSJSONObject, 422, cb)
		return
	}
	// One injected failure, then it behaves: the client's retry path is what this tests.
	if (peer.fault == 'CHUNK_DIGEST_MISMATCH' && !peer.chunkFaultUsed) {
		peer.chunkFaultUsed = true
		failure('CHUNK_DIGEST_MISMATCH', { index: index, injected: true } as UTSJSONObject, 422, cb)
		return
	}
	let stored = offer.chunks.get(fileId)
	if (stored == null) {
		stored = new Map()
		offer.chunks.set(fileId, stored)
	}
	const kept = stored!.get(index)
	if (kept != null && sameBytes(kept!, data)) {
		// §4 的幂等那一支：这一条请求整体与已经收下的那份一致，就省掉一次重写，答复多带一个键。
		// 与 cs-receive.uts:1015-1018 同一句，只是这里的台账存的是字节而不是摘要。
		reply(200, { index: index, stored: true, idempotent: true } as UTSJSONObject, cb)
		return
	}
	stored!.set(index, data)
	reply(200, { index: index, stored: true } as UTSJSONObject, cb)
}

function routeFinalize(offerId: string, cb: (status: number, body: string) => void): void {
	const offer = peer.offers.get(offerId)
	if (offer == null) {
		failure('OFFER_UNKNOWN', { offer_id: offerId } as UTSJSONObject, 404, cb)
		return
	}
	const verified: UTSJSONObject[] = []
	for (let i = 0; i < offer.files.length; i++) {
		const file = offer.files[i]
		const id = file.getString('id', '')
		const relpath = file.getString('relpath', '')
		const size = file.getNumber('size', 0)
		const count = chunkCountOf(size)
		const stored = offer.chunks.get(id)
		const missing: number[] = []
		for (let k = 0; k < count; k++) {
			if (stored == null || !stored.has(k)) {
				missing.push(k)
			}
		}
		let ok = missing.length == 0
		if (ok) {
			const joined = new Uint8Array(size)
			let cursor = 0
			for (let k = 0; k < count; k++) {
				const part = stored!.get(k)!
				joined.set(part, cursor)
				cursor = cursor + part.length
			}
			ok = hexOf(sha256Bytes(joined)) == file.getString('sha256', '')
		}
		if (ok && peer.fault == 'FILE_DIGEST_MISMATCH') {
			ok = false
		}
		const entry: UTSJSONObject = { id: id, ok: ok, missing: missing, path: ok ? '/模拟接收目录/' + relpath : null }
		verified.push(entry)
	}
	reply(200, { offer_id: offerId, verified: verified } as UTSJSONObject, cb)
}

function routePair(json: string, cb: (status: number, body: string) => void): void {
	const body = JSON.parse(json) as UTSJSONObject | null
	if (body == null) {
		failure('NOT_PAIRED', { reason: 'body is not a JSON object' } as UTSJSONObject, 403, cb)
		return
	}
	const peerId = body!.getString('peer_id', '')
	const nonce = body!.getString('nonce', '')
	const key = body!.getString('public_key', '')
	const signature = body!.getString('signature', '')
	const code = body!.getString('code', '')
	if (peerId == '' || nonce == '' || key == '' || signature == '') {
		failure('NOT_PAIRED', { reason: 'pair request is incomplete' } as UTSJSONObject, 403, cb)
		return
	}
	if (peer.fault == 'BAD_PAIR_CODE') {
		failure('BAD_PAIR_CODE', null, 403, cb)
		return
	}
	// spec §3: a key this receiver already pinned may re-pair on its signature alone, with no code,
	// which is how a lost token is repaired without ever asking the user to look at the PC again.
	const known = trustedKey != '' && trustedKey == key
	// One peer at a time: while a session is live, a different key is refused before it gets to
	// guess anything. The stand-in has one slot, so this is the rule rather than a simulation of it.
	if (!known && peer.paired && trustedKey != '') {
		failure('PEER_BUSY', { reason: 'one peer at a time', peer: peer.pairedName } as UTSJSONObject, 429, cb)
		return
	}
	if (!known && code != peer.code) {
		failure('BAD_PAIR_CODE', null, 403, cb)
		return
	}
	// An absent key means a sender with no passphrase to offer, which is a build from before it
	// existed and is authenticated by the code alone.
	if (!known && body!.get('secret') != null && body!.getString('secret', '') != peer.passphrase) {
		failure('BAD_PAIR_CODE', { reason: 'passphrase' } as UTSJSONObject, 403, cb)
		return
	}
	const resumed = known
	peer.token = hexOf(sha256Bytes(utf8(peerId + '|' + nonce)))
	peer.paired = true
	peer.pairedName = body!.getString('name', '')
	pinnedFp = peer.fingerprint
	trustedKey = key
	reply(200, {
		token: peer.token,
		peer_id: 'pc-demo-01',
		name: 'PC 演示机',
		protocol_version: 1,
		fingerprint: peer.fingerprint,
		resumed: resumed
	} as UTSJSONObject, cb)
}

export function request(
	method: string,
	host: string,
	port: number,
	path: string,
	jsonBody: string,
	token: string,
	pinFpHex: string,
	body: ArrayBuffer,
	sha: string,
	escape: string,
	cb: (status: number, resBody: string) => void
): void {
	if (peer.code == '') {
		resetPeer()
	}
	// The browser cannot pin, but the client still has to survive a peer whose key does not match: refuse
	// the same way a failed SPKI comparison would on the phone - which is also how an announced prefix is
	// honoured now, because the phone hands that prefix to its trust manager and this file is the browser's
	// stand-in for that socket (`pinAccepts`, spec §2).
	if (!pinAccepts(pinFpHex, peer.fingerprint)) {
		failure('TLS_PIN_MISMATCH', { expected: pinFpHex, got: peer.fingerprint } as UTSJSONObject, 0, cb)
		return
	}
	if (!pinAccepts(pinnedFp, peer.fingerprint)) {
		failure('TLS_PIN_MISMATCH', { pinned: pinnedFp, got: peer.fingerprint } as UTSJSONObject, 0, cb)
		return
	}
	const parts = path.split('?')[0].split('/')
	if (method == 'GET' && path == '/v1/hello') {
		reply(200, {
			peer_id: 'pc-demo-01',
			name: 'PC 演示机',
			protocol_version: PROTOCOL_VERSION,
			compatible_versions: COMPATIBLE_VERSIONS,
			features: HELLO_FEATURES,
			port: port,
			fingerprint: peer.fingerprint
		} as UTSJSONObject, cb)
		return
	}
	if (method == 'POST' && path == '/v1/pair') {
		routePair(jsonBody, cb)
		return
	}
	if (token != peer.token || token == '') {
		failure('NOT_PAIRED', null, 403, cb)
		return
	}
	if (method == 'POST' && path == '/v1/offer') {
		const parsed = JSON.parse(jsonBody) as UTSJSONObject | null
		if (parsed == null) {
			failure('UNSUPPORTED_PROTOCOL', { reason: 'body is not a JSON object' } as UTSJSONObject, 400, cb)
			return
		}
		routeOffer(parsed!, cb)
		return
	}
	if (parts[0] == '' && parts[1] == 'v1' && parts[2] == 'offer') {
		if (method == 'GET' && parts[4] == 'state') {
			const offer = peer.offers.get(parts[3])
			if (offer == null) {
				failure('OFFER_UNKNOWN', { offer_id: parts[3] } as UTSJSONObject, 404, cb)
				return
			}
			reply(200, offerPayload(offer!), cb)
			return
		}
		if (method == 'POST' && parts[4] == 'finalize') {
			routeFinalize(parts[3], cb)
			return
		}
		if (method == 'PUT' && parts[4] == 'chunk' && parts.length == 7) {
			// The demo peer stands in for a receiver that got the chunk over a wire which cannot carry a
			// zero byte, so it stores what the sender meant, not how it was encoded to get here.
			routeChunk(parts, unescapeChunk(body, escape), sha, cb)
			return
		}
		if (method == 'DELETE') {
			peer.offers.delete(parts[3])
			reply(200, { offer_id: parts[3], dropped: true } as UTSJSONObject, cb)
			return
		}
	}
	failure('OFFER_UNKNOWN', { path: method + ' ' + path } as UTSJSONObject, 404, cb)
}

/* ================================================== this device as a receiver */

const recvInbox = newInbox(harnessRand)
/** The stand-in for filesDir. A chunk written here is only as durable as the tab, which is enough to
 *  drive the state machine and nowhere near enough to prove the file system - so the offset writes
 *  and the whole-file re-read are the parts worth reading carefully, and the durability they claim is
 *  still device work. */
const recvStore = new Map<string, Uint8Array>()

/** Where an offer's bytes sit in this target's inbox: the shared state machine hands the store the
 *  offer's own directory plus the sent name, so a probe that wants to look at a file has to ask for the
 *  same path (#128). */
const landOf = (offerId: string, relpath: string): string => {
	return offerId + '/' + relpath
}
let recvFault = ''

function nowSeconds(): number {
	return Math.floor(Date.now() / 1000)
}

function receiverSelf(): LocalPeer {
	ensureSelf()
	const self = new LocalPeer()
	self.peerId = myPeerId
	self.name = myNameText()
	self.fingerprint = myFp
	self.port = TRANSPORT_PORT
	return self
}

const recvHex: HexFn = (buf: ArrayBuffer): string => {
	return hexOf(sha256Bytes(new Uint8Array(buf)))
}

const recvKeyFp: KeyFpFn = (publicKeyB64: string): string => {
	const raw = fromBase64(publicKeyB64)
	if (raw == null) {
		return ''
	}
	const spki = spkiOfRaw(raw!)
	if (spki.length != 44) {
		return ''
	}
	return hexOf(sha256Bytes(spki))
}

/** The one assertion a browser can make about a signature: it is the digest of exactly the message
 *  the sender claimed to sign, under a key that decodes. Real Ed25519 verification is app-android
 *  work and this stand-in must never be described as if it proved the crypto. */
const recvVerify: VerifyFn = (publicKeyB64: string, message: string, signatureB64: string): boolean => {
	if (recvKeyFp(publicKeyB64) == '') {
		return false
	}
	const sig = fromBase64(signatureB64)
	if (sig == null || sig!.length != 32) {
		return false
	}
	const want = sha256Bytes(utf8(message))
	for (let i = 0; i < 32; i++) {
		if (sig![i] != want[i]) {
			return false
		}
	}
	return true
}

const recvPrepare: PrepareFn = (relpath: string, size: number): string => {
	if (recvFault == 'STORAGE_FULL') {
		return ''
	}
	recvStore.set(relpath, new Uint8Array(size))
	return '/模拟接收目录/' + relpath
}

/** How many times the store actually got a write. §4's `idempotent` answer claims a rewrite was skipped,
 *  and the only witness for "skipped" in this tier is a counter beside the one function that writes. */
let recvWrites: number = 0

const recvWrite: WriteFn = (relpath: string, offset: number, buf: ArrayBuffer): string => {
	if (recvFault == 'WRITE_FAIL') {
		return '写入失败（注入）'
	}
	recvWrites = recvWrites + 1
	const src = new Uint8Array(buf)
	// The Map is this target's file: an offer's allocation was made at the declared length, so a chunk
	// that finds nothing there is the repair after a ledger the digest denied (#127), not a wrong
	// offset. Grow it the way `RandomAccessFile` does on a phone - the sender fills from chunk 0, so the
	// length the manifest declared is what ends up hashed.
	let have = recvStore.get(relpath)
	if (have == null) {
		have = new Uint8Array(offset + src.length)
	} else if (have!.length < offset + src.length) {
		const grown = new Uint8Array(offset + src.length)
		for (let i = 0; i < have!.length; i++) {
			grown[i] = have![i]
		}
		have = grown
	}
	for (let i = 0; i < src.length; i++) {
		have![offset + i] = src[i]
	}
	recvStore.set(relpath, have!)
	return ''
}

const recvDigestFile: DigestFileFn = (relpath: string): string => {
	const bytes = recvStore.get(relpath)
	if (bytes == null) {
		return ''
	}
	return hexOf(sha256Bytes(bytes!))
}

const recvDrop: DropFn = (relpath: string): void => {
	recvStore.delete(relpath)
}

function askOn(inbox: Inbox, client: string, method: string, path: string, jsonBody: string, token: string, body: ArrayBuffer, sha: string): WireReply {
	const req = new Req()
	req.method = method
	req.path = path
	req.json = jsonBody
	req.token = token
	req.body = body
	req.sha = sha
	req.client = client
	return handleReceive(inbox, receiverSelf(), nowSeconds(), req, recvHex, recvKeyFp, recvVerify, recvPrepare, recvWrite, recvDigestFile, recvDrop)
}

const noopCb: ReplyCallback = (status: number, body: string): void => {}

/** The offer is the only endpoint that can wait for a person, so it is the only one that can leave a
 *  sender's reply callback parked here. One slot: a second concurrent offer is answered PEER_BUSY,
 *  which is what the contract's own vocabulary says about a receiver with its hands full. */
let pendingOfferId = ''
let pendingCb: ReplyCallback = noopCb

/* --------------------------------------------- the peer that sends *to* this device */

const SIM_PEER_ID = 'pc-demo-01'
const SIM_NAME = 'PC 演示机'
const SIM_TEXT = 'pc-备忘.txt'
const SIM_BIG = 'pc-大块.bin'

let simRaw = new Uint8Array(32)
let simFp = ''
const simBytes = new Map<string, Uint8Array>()

function ensureSimPc(): void {
	if (simFp != '') {
		return
	}
	simRaw = randomBytes(32)
	simFp = hexOf(sha256Bytes(spkiOfRaw(simRaw)))
}

const simTakeSelf: (cb: SelfCallback) => void = (cb: SelfCallback): void => {
	ensureSimPc()
	cb(SIM_PEER_ID, SIM_NAME, simFp)
}

const simSignPair: (message: string, cb: SignCallback) => void = (message: string, cb: SignCallback): void => {
	ensureSimPc()
	cb(b64(simRaw), b64(sha256Bytes(utf8(message))))
}

function simFileOf(relpath: string): Uint8Array {
	const cached = simBytes.get(relpath)
	if (cached != null) {
		return cached!
	}
	let out = new Uint8Array(0)
	if (relpath.indexOf('大块') >= 0) {
		// Deliberately one chunk plus a tail, so chunkSizeAt's odd last size is exercised and not
		// just the round case.
		out = new Uint8Array(CHUNK_SIZE + 1000)
		for (let i = 0; i < out.length; i++) {
			out[i] = (i * 31 + 7) % 256
		}
	} else {
		const line = utf8('传书接收自测：这一行重复十二次，凑成一个不到一个分块的小文件。\n')
		out = new Uint8Array(line.length * 12)
		for (let k = 0; k < 12; k++) {
			for (let i = 0; i < line.length; i++) {
				out[k * line.length + i] = line[i]
			}
		}
	}
	simBytes.set(relpath, out)
	return out
}

let senderFault = ''
let chunkDigestFaultLeft = 0
/** One chunk write whose answer is taken back after the bytes were served - the browser's hand on the
 *  same throat the fport tunnel uses on a phone (#120). The self-test drives it three ways; this counter
 *  is only for the 发送端故障 button, which stops at the shape a person can see in the log. */
let demoSwallowLeft = 0

const simPrepareFile: (path: string, relpath: string, cb: MetaCallback) => void = (path: string, relpath: string, cb: MetaCallback): void => {
	const bytes = simFileOf(path)
	cb(true, hexOf(randomBytes(8)), bytes.length, hexOf(sha256Bytes(bytes)), Math.floor(Date.now() / 1000), nameType(relpath), '')
}

const simReadChunk: (path: string, offset: number, length: number, cb: BufferCallback) => void = (path: string, offset: number, length: number, cb: BufferCallback): void => {
	const all = simFileOf(path)
	const end = offset + length
	const src = all.subarray(offset, end > all.length ? all.length : end)
	const copy = new Uint8Array(src.length)
	copy.set(src)
	// One flipped byte under an honest chunk digest: every chunk then verifies, and only the
	// whole-file re-read at finalize can catch it. That is exactly the case FILE_DIGEST_MISMATCH
	// exists for, and the only way to show a receiver catching a corruption no single chunk admits.
	if (senderFault == 'BAD_FILE' && offset == 0 && copy.length > 0) {
		copy[0] = (copy[0] + 1) % 256
	}
	cb(copy.buffer as ArrayBuffer, '')
}

const simDigestHex: (buf: ArrayBuffer, cb: HexCallback) => void = (buf: ArrayBuffer, cb: HexCallback): void => {
	const h = hexOf(sha256Bytes(new Uint8Array(buf)))
	if (chunkDigestFaultLeft > 0) {
		chunkDigestFaultLeft = chunkDigestFaultLeft - 1
		const alt = h.charAt(0) == '0' ? '1' : '0'
		cb(alt + h.substring(1))
		return
	}
	cb(h)
}

const simCall: Caller = (method: string, path: string, jsonBody: string, token: string, body: ArrayBuffer, sha: string, escape: string, cb: ReplyCallback): void => {
	// Same rule as the browser's own peer: the header says whether these bytes are a chunk or an encoding
	// of one, and the receive kernel below only ever counts and digests the chunk.
	const reply = askOn(recvInbox, SIM_PEER_ID, method, path, jsonBody, token, unescapeChunk(body, escape), sha)
	if (!reply.pending) {
		if (demoSwallowLeft > 0 && method == 'PUT' && path.indexOf('/chunk/') >= 0) {
			demoSwallowLeft = demoSwallowLeft - 1
			cb(0, swallowed('故障注入：这一块已经落进对端收件箱，回复被吞掉'))
			return
		}
		cb(reply.status, reply.body)
		return
	}
	if (path != '/v1/offer') {
		cb(429, JSON.stringify({ code: 'PEER_BUSY', detail: { reason: 'only an offer can await a decision' } } as UTSJSONObject))
		return
	}
	const parsed = parseJson(jsonBody)
	const offerId = parsed == null ? '' : parsed!.getString('offer_id', '')
	if (pendingOfferId != '' && pendingOfferId != offerId) {
		cb(429, JSON.stringify({ code: 'PEER_BUSY', detail: { reason: 'another offer still awaits a decision' } } as UTSJSONObject))
		return
	}
	pendingOfferId = offerId
	pendingCb = cb
}

let simSession: PeerSession | null = null

export function setSenderFault(fault: string): void {
	senderFault = fault
	chunkDigestFaultLeft = 0
	demoSwallowLeft = 0
}

/** Receiver-side faults, so the 507 path and its rollback are not left untested just because a
 *  browser never runs out of memory. */
export function setReceiveFault(fault: string): void {
	recvFault = fault
}

export function demoPcConnected(): boolean {
	return simSession != null
}

export function receiveCode(): string {
	return currentPairCode(recvInbox, nowSeconds())
}

export function receivePassphrase(): string {
	return passphraseOf(recvInbox, nowSeconds())
}

/** Fresh code and passphrase, by the user's hand only. Pinned peers and live sessions are untouched.
 *  Same name and return shape as the phone hosts, because the page calls it without asking which
 *  platform it is on. */
export function receiveRotatePairing(): string {
	rotatePairing(recvInbox, nowSeconds())
	return '已换一组配对码和密码'
}

/** Say who this device dialled, so the one-session rule guards the door it goes out of as well as
 *  the one it is dialled in through (spec §3). The page calls it on connect and on disconnect. */
export function receiveHoldSlot(fingerprint: string): void {
	holdSlotFor(recvInbox, fingerprint, nowSeconds())
}

/** Take one peer's session away (spec §3, 持有方点「断开」). Same name and shape on every platform:
 *  the page calls it when the user closes a connection, whatever door that peer came through. */
export function receiveRelease(fingerprint: string): boolean {
	return releaseSession(recvInbox, fingerprint)
}

/** Closing the receiver gives everybody's slot back (spec §3, 接收服务重启). A browser harness has no
 *  port to close, so this is here because the page asks the same question on every platform - and
 *  because it is the one leg that can prove a phone's 不再监听 does not leave a stranger holding the
 *  single session. */
export function receiveReleaseAll(): number {
	return releaseSessions(recvInbox)
}

/** The sender's heartbeat: the peer this device dialled never shows up in an inbound request, so this
 *  is the only way its half of the slot can be kept honest (spec §3). */
export function receiveSeen(fingerprint: string): void {
	seenNow(recvInbox, fingerprint, nowSeconds())
}

/** The code with its last digit changed: guaranteed different, so the wrong-code path is testable
 *  without a text box the user has to mis-type on purpose. */
export function receiveWrongCode(): string {
	const code = currentPairCode(recvInbox, nowSeconds())
	const last = code.charAt(code.length - 1)
	const alt = last == '9' ? '8' : '9'
	return code.substring(0, code.length - 1) + alt
}

/** Every read of the card is also the local tick spec §3 and §4 need: a peer that stopped talking
 *  sends no request for the wire to sweep against, so only this timer can notice it. */
export function receiveSnapshot(): ReceiveSnapshot {
	const now = nowSeconds()
	sweep(recvInbox, now, recvDrop, recvDigestFile)
	return snapshot(recvInbox, now)
}

export function demoPcConnect(useCode: string, write: Writer, done: ConnectDone): void {
	ensureSimPc()
	const opts = new TransferOptions()
	opts.host = '本机接收端'
	opts.port = TRANSPORT_PORT
	opts.code = useCode
	// The stand-in PC knows this device's passphrase the way a paired peer does: it reads it off
	// the same screen. Wrong-passphrase behaviour is the receiver's self-check's job to prove.
	opts.secret = passphraseOf(recvInbox, nowSeconds())
	connectPeer(opts, simTakeSelf, simSignPair, simCall, write, function (ok: boolean, message: string, session: PeerSession | null): void {
		if (ok && session != null) {
			simSession = session
		}
		done(ok, message, session)
	})
}

export function demoPcDisconnect(): void {
	simSession = null
}

export function demoPcSend(write: Writer, progress: ProgressCallback, fileEvent: FileEvent, finish: FinishCallback): void {
	const session = simSession
	if (session == null) {
		finish(false, 'PC 还没有和这台手机配对')
		return
	}
	const opts = new TransferOptions()
	opts.host = '本机接收端'
	opts.port = TRANSPORT_PORT
	opts.paths = [SIM_TEXT, SIM_BIG]
	opts.relpaths = [SIM_TEXT, SIM_BIG]
	chunkDigestFaultLeft = senderFault == 'BAD_CHUNK' ? 1 : 0
	demoSwallowLeft = senderFault == 'SWALLOW_REPLY' ? 1 : 0
	sendFiles(session, opts, simTakeSelf, simSignPair, simCall, simPrepareFile, simReadChunk, simDigestHex, write, progress, fileEvent, function (ok: boolean, summary: string): void {
		chunkDigestFaultLeft = 0
		demoSwallowLeft = 0
		finish(ok, summary)
	})
}

/** The user's answer. Whatever the sender was waiting on gets its reply here, which is the moment the
 *  wire has been holding open for. */
export function receiveDecide(accepted: boolean): string {
	const snap = snapshot(recvInbox, nowSeconds())
	if (snap.pendingOfferIds.length == 0) {
		return '现在没有等待决定的传输'
	}
	const offerId = snap.pendingOfferIds[0]
	const who = snap.pendingFrom[0]
	const reply = resolveOffer(recvInbox, offerId, accepted, recvPrepare, recvDrop)
	if (pendingOfferId == offerId) {
		const cb = pendingCb
		pendingOfferId = ''
		pendingCb = noopCb
		cb(reply.status, reply.body)
	}
	if (accepted && reply.status == 200) {
		return '已接受来自 ' + (who == '' ? '对端' : who) + ' 的传输，PC 那边现在开始推分块'
	}
	if (!accepted) {
		return '已拒绝：PC 那边收到 DECLINED，这次传输没有落盘'
	}
	return '接受失败：' + codeOf(reply.body) + ' ' + reply.body
}

/* ------------------------------------------------------------------ receiver self-check */

/** One pair request as the receiver's self-check sees it. The key is a parameter because the
 *  refusals are about *whose* session is being asked for, and a stand-in with only one key cannot
 *  test a second device. */
function askPairOn(box: Inbox, client: string, useCode: string, useSecret: string, withKey: string): WireReply {
	const nonce = randomHex(16)
	const signature = b64(sha256Bytes(utf8(pairMessage(SIM_PEER_ID, nonce, ''))))
	return askOn(box, client, 'POST', '/v1/pair', pairJson(SIM_PEER_ID, SIM_NAME, nonce, withKey, signature, useCode, useSecret, ''), '', new ArrayBuffer(0), '')
}

/** The same pair request, handed to the receiver at a clock reading of the caller's choosing.
 *  §3's throttle is a sliding window, and a window cannot be measured from inside a page by waiting
 *  sixty seconds - so the sixty seconds go on the ruler instead of on the wall. `askOn` takes the
 *  wall clock; the kernel's own `now` parameter is what makes this leg possible at all. */
function askPairAt(box: Inbox, client: string, useCode: string, useSecret: string, withKey: string, at: number): WireReply {
	const nonce = randomHex(16)
	const signature = b64(sha256Bytes(utf8(pairMessage(SIM_PEER_ID, nonce, ''))))
	const req = new Req()
	req.method = 'POST'
	req.path = '/v1/pair'
	req.json = pairJson(SIM_PEER_ID, SIM_NAME, nonce, withKey, signature, useCode, useSecret, '')
	req.token = ''
	req.body = new ArrayBuffer(0)
	req.sha = ''
	req.client = client
	return handleReceive(box, receiverSelf(), at, req, recvHex, recvKeyFp, recvVerify,
		recvPrepare, recvWrite, recvDigestFile, recvDrop)
}

/** One value `pairJson` writes on purpose, so the harness can find that slot again afterwards.
 *  The string is long and contains no JSON punctuation; the splice below checks it landed. */
const SLOT_MARK = 'R26SecretSlot'

/** A pair body whose `secret` (and optionally `tls_fingerprint`) slot says exactly what a sender writes.
 *  §3's 「没有它」 is a claim about this one slot, and `pairJson` cannot produce the bodies the round needed:
 *  it omits an empty value, so null and `""` have to be pasted in over the value the harness just wrote.
 *  A splice that misses returns the body untouched, so the leg goes red instead of quietly measuring
 *  whatever else came back. */
function pairBodySlots(withKey: string, code: string, secretRaw: string, leafRaw: string): string {
	const nonce = randomHex(16)
	const signature = b64(sha256Bytes(utf8(pairMessage(SIM_PEER_ID, nonce, ''))))
	const baked = pairJson(SIM_PEER_ID, SIM_NAME, nonce, withKey, signature, code, SLOT_MARK, '')
	const mark = '"secret":"' + SLOT_MARK + '"'
	const at = baked.indexOf(mark)
	const head = at < 0 ? '' : baked.substring(0, at)
	const tail = at < 0 ? '' : baked.substring(at + mark.length)
	if (at < 0 || tail != '}') {
		return baked
	}
	let body = ''
	if (secretRaw == '') {
		const comma = head.lastIndexOf(',')
		if (comma < 0) {
			return baked
		}
		body = head.substring(0, comma) + tail
	} else {
		body = head + secretRaw + tail
	}
	if (leafRaw != '') {
		body = body.substring(0, body.length - 1) + ',"tls_fingerprint":' + leafRaw + '}'
	}
	return body
}

/** The same pair request with a body the shared sender could never have built. */
function askPairRawAt(box: Inbox, client: string, jsonBody: string, at: number): WireReply {
	const req = new Req()
	req.method = 'POST'
	req.path = '/v1/pair'
	req.json = jsonBody
	req.token = ''
	req.body = new ArrayBuffer(0)
	req.sha = ''
	req.client = client
	return handleReceive(box, receiverSelf(), at, req, recvHex, recvKeyFp, recvVerify,
		recvPrepare, recvWrite, recvDigestFile, recvDrop)
}

/** How many failures this source has left in the receiver's window. Read out of the same list the
 *  kernel counts, because the claim being measured is about that list's shape, not about a reply. */
function failsOf(box: Inbox, client: string): number {
	for (let i = 0; i < box.fails.length; i++) {
		if (box.fails[i].client == client) {
			return box.fails[i].times.length
		}
	}
	return 0
}

function jsonOf(reply: WireReply): UTSJSONObject | null {
	return parseJson(reply.body)
}

/** The shape test §4's two reply blocks need: the names on the wire are exactly the names on the paper,
 *  so a key that drifts in either direction is a finding rather than a typo. `[]`-vs-list order is not a
 *  contract fact, so this compares sets, not strings. */
function sameKeys(found: string[], names: string[]): boolean {
	if (found.length != names.length) {
		return false
	}
	for (let i = 0; i < names.length; i++) {
		if (found.indexOf(names[i]) < 0) {
			return false
		}
	}
	return true
}

function firstVerifiedOk(reply: WireReply): boolean {
	const obj = jsonOf(reply)
	if (obj == null) {
		return false
	}
	const list = obj!.getArray('verified')
	if (list == null || list.length == 0) {
		return false
	}
	let all = true
	for (let i = 0; i < list.length; i++) {
		const entry = list[i] as UTSJSONObject
		if (!entry.getBoolean('ok', false)) {
			all = false
		}
	}
	return all
}

function missingOf(reply: WireReply, fileId: string): number[] {
	const out: number[] = []
	const obj = jsonOf(reply)
	if (obj == null) {
		return out
	}
	const list = obj!.getArray('files')
	if (list == null) {
		return out
	}
	for (let i = 0; i < list.length; i++) {
		const entry = list[i] as UTSJSONObject
		if (entry.getString('id', '') == fileId) {
			const raw = entry.get('missing')
			if (raw == null) {
				return out
			}
			const items = raw as any[]
			for (let k = 0; k < items.length; k++) {
				out.push(Math.floor(parseFloat(items[k].toString())))
			}
		}
	}
	return out
}

/** The scratch pair of files the self-check transfers. Kept under different names than the offers the
 *  UI shows because both write into the same stand-in store, and a test that deletes the user's
 *  received files would report a clean run on top of a wrecked inbox. */
const SCRATCH_TEXT = '自测-备忘.txt'
const SCRATCH_BIG = '自测-大块.bin'
/** The idle-reclaim checks delete the files they hand over, so they get names of their own: a test
 *  that reuses the scratch names would report a clean run on top of a deleted transfer. */
const STALL_TEXT = '停摆-备忘.txt'
const STALL_BIG = '停摆-大块.bin'

function simFilesFor(textName: string, bigName: string): CsFile[] {
	const list: CsFile[] = []
	const names: string[] = [textName, bigName]
	for (let i = 0; i < names.length; i++) {
		const bytes = simFileOf(names[i])
		const file = new CsFile()
		file.path = names[i]
		file.relpath = names[i]
		file.id = hexOf(randomBytes(8))
		file.size = bytes.length
		file.sha256 = hexOf(sha256Bytes(bytes))
		file.mtime = Math.floor(Date.now() / 1000)
		file.type = nameType(names[i])
		list.push(file)
	}
	return list
}

function sliceOf(file: Uint8Array, start: number, length: number): Uint8Array {
	const out = new Uint8Array(length)
	out.set(file.subarray(start, start + length))
	return out
}

/** Runs the receiver's own semantics against a scratch inbox so nothing it proves here depends on the
 *  offers shown in the UI. Every line is an assertion the page can be checked against. */
export function receiveSelfReport(): string {
	ensureSimPc()
	const out: string[] = []
	const box = newInbox(harnessRand)
	let token = ''
	let pass = 0
	let fail = 0
	const check = (label: string, ok: boolean, extra: string = '') => {
		if (ok) {
			pass = pass + 1
			out.push('通过 · ' + label)
		} else {
			fail = fail + 1
			out.push('不符 · ' + label + (extra == '' ? '' : '：' + extra))
		}
	}
	const ask = (method: string, path: string, jsonBody: string, body: ArrayBuffer, sha: string): WireReply => {
		return askOn(box, SIM_PEER_ID, method, path, jsonBody, token, body, sha)
	}
	const codeOfReply = (reply: WireReply): string => {
		return codeOf(reply.body)
	}

	const code = currentPairCode(box, nowSeconds())
	const secret = passphraseOf(box, nowSeconds())
	const wrongCode = code == '000000' ? '111111' : '000000'
	// '!' is outside the passphrase alphabet, so it can never collide with a real one by accident.
	const wrongSecret = '!' + secret.substring(0, PASSPHRASE_CHARS - 1)
	const simKey = b64(simRaw)
	// 1. five wrong codes from an unknown peer, then the lockout the PC enforces too.
	let lockout = ''
	for (let i = 0; i < 6; i++) {
		lockout = codeOfReply(askPairOn(box, '203.0.113.9', wrongCode, secret, simKey))
	}
	check('错配对码五次后进入 PEER_BUSY', lockout == 'PEER_BUSY')

	// 2. this peer's wrong code is refused, the right one pins it.
	check('错配对码被拒 BAD_PAIR_CODE', codeOfReply(askPairOn(box, SIM_PEER_ID, wrongCode, secret, simKey)) == 'BAD_PAIR_CODE')
	// 2b. the code alone is not enough any more: right code, wrong passphrase is the same mistake.
	check('对的码配错的密码仍然被拒', codeOfReply(askPairOn(box, '203.0.113.11', code, wrongSecret, b64(randomBytes(32)))) == 'BAD_PAIR_CODE')
	const first = askPairOn(box, SIM_PEER_ID, code, secret, simKey)
	const firstObj = jsonOf(first)
	token = firstObj == null ? '' : firstObj!.getString('token', '')
	check('正确配对码换来会话', first.status == 200 && token != '')
	check('首次配对 resumed=false', firstObj != null && !firstObj!.getBoolean('resumed', true))
	check('配对回复的指纹就是本机', firstObj != null && firstObj!.getString('fingerprint', '') == receiverSelf().fingerprint)
	// 2c. one peer at a time: while that session is live, a different key is refused in words.
	const stranger = askPairOn(box, '203.0.113.12', code, secret, b64(randomBytes(32)))
	check('一次只连一台：第三方被拒 PEER_BUSY',
		codeOfReply(stranger) == 'PEER_BUSY' && detailOf(stranger.body).indexOf('one peer at a time') >= 0)

	// 3. an unauthenticated request costs nothing but a 403.
	check('无令牌请求 403 NOT_PAIRED', codeOfReply(askOn(box, SIM_PEER_ID, 'GET', '/v1/offer/x/state', '', '', new ArrayBuffer(0), '')) == 'NOT_PAIRED')

	// 4. a path this end would refuse is rejected before the user is ever asked.
	const smallBytes = simFileOf(SCRATCH_TEXT)
	const smuggle = new CsFile()
	smuggle.path = SCRATCH_TEXT
	smuggle.relpath = '../坏名字.txt'
	smuggle.id = hexOf(randomBytes(8))
	smuggle.size = smallBytes.length
	smuggle.sha256 = hexOf(sha256Bytes(smallBytes))
	smuggle.mtime = Math.floor(Date.now() / 1000)
	smuggle.type = 'text/plain'
	const badOffer = ask('POST', '/v1/offer', offerJson(hexOf(randomBytes(8)), [smuggle], SIM_PEER_ID, SIM_NAME), new ArrayBuffer(0), '')
	check('越界路径 PATH_REJECTED 且没有弹确认', codeOfReply(badOffer) == 'PATH_REJECTED' && !badOffer.pending)

	// 5. the real offer waits for the user, then allocates and starts.
	const files = simFilesFor(SCRATCH_TEXT, SCRATCH_BIG)
	const offerId = hexOf(randomBytes(8))
	const offerJsonText = offerJson(offerId, files, SIM_PEER_ID, SIM_NAME)
	const offer = ask('POST', '/v1/offer', offerJsonText, new ArrayBuffer(0), '')
	check('清单等待用户决定（pending）', offer.pending)
	const decided = resolveOffer(box, offerId, true, recvPrepare, recvDrop)
	check('接受后回 200 清单', decided.status == 200 && !decided.pending)
	// The same offer re-sent after the decision comes back as progress, not as a second dialog.
	const again = ask('POST', '/v1/offer', offerJsonText, new ArrayBuffer(0), '')
	check('重复清单直接回当前进度', again.status == 200 && !again.pending)

	// 5b. spec §7 is a set on each side, and a receiver reads the sender's only from this body - it never
	// dials back for a hello. These two legs run on their own box, because an extra pending offer in the
	// one below would move every count of it.
	const vBox = newInbox(harnessRand)
	const vPaired = askPairOn(vBox, SIM_PEER_ID, currentPairCode(vBox, nowSeconds()), passphraseOf(vBox, nowSeconds()), simKey)
	const vObj = jsonOf(vPaired)
	const vToken = vObj == null ? '' : vObj!.getString('token', '')
	const vAsk = (text: string): WireReply => {
		return askOn(vBox, SIM_PEER_ID, 'POST', '/v1/offer', text, vToken, new ArrayBuffer(0), '')
	}
	const strays = parseJson(offerJson(hexOf(randomBytes(8)), files, SIM_PEER_ID, SIM_NAME))
	if (strays != null) {
		const onlyTwo: number[] = [2]
		strays!.set('compatible_versions', onlyTwo)
		const strayReply = vAsk(JSON.stringify(strays))
		check('清单报的版本集合里没有我们这一版：拒（线上 400）',
			codeOfReply(strayReply) == 'UNSUPPORTED_PROTOCOL' && strayReply.status == 400)
	}
	const noSet = parseJson(offerJson(hexOf(randomBytes(8)), files, SIM_PEER_ID, SIM_NAME))
	if (noSet != null) {
		const nothing: number[] = []
		noSet!.set('compatible_versions', nothing)
		check('清单没报版本集合时按它自己那一个数判，照样等人决定', vAsk(JSON.stringify(noSet)).pending)
	}

	// 5c. §5 的另一句：一单里两个同名文件不许抢同一个落点（#163）。
	// 发送方按文件名取名是合法的（PC 的 `plan()` 不传 base 就只取文件名，
	// `send C:\a\report.txt D:\b\report.txt` 就是这么把两个 id 报成同一个名字的），#128 让每一单
	// 有自己的目录，管的是两「单」之间；同一份清单里的两个同名条目，这一端此前把 land 记了两次同一个
	// 字符串，后一条的字节直接盖在前一条身上。改之前这一腿是红的：前一条 finalize 过不了。
	const twinBox = newInbox(harnessRand)
	const twinPair = askPairOn(twinBox, SIM_PEER_ID, currentPairCode(twinBox, nowSeconds()), passphraseOf(twinBox, nowSeconds()), simKey)
	const twinPairObj = jsonOf(twinPair)
	const twinToken = twinPairObj == null ? '' : twinPairObj!.getString('token', '')
	const twinTexts: string[] = ['甲：这一份和下面那份同名。\n', '乙：这一份该落在另一个名字上。\n']
	const twinFiles: CsFile[] = []
	for (let i = 0; i < twinTexts.length; i++) {
		const twinBytes = utf8(twinTexts[i])
		const twin = new CsFile()
		twin.path = '同名-备忘.txt'
		twin.relpath = '同名-备忘.txt'
		twin.id = hexOf(randomBytes(8))
		twin.size = twinBytes.length
		twin.sha256 = hexOf(sha256Bytes(twinBytes))
		twin.mtime = Math.floor(Date.now() / 1000)
		twin.type = 'text/plain'
		twinFiles.push(twin)
	}
	const twinId = hexOf(randomBytes(8))
	const twinOffer = askOn(twinBox, SIM_PEER_ID, 'POST', '/v1/offer', offerJson(twinId, twinFiles, SIM_PEER_ID, SIM_NAME), twinToken, new ArrayBuffer(0), '')
	check('同名两条先登记、等人决定', twinOffer.pending)
	resolveOffer(twinBox, twinId, true, recvPrepare, recvDrop)
	let twinWritten = 0
	for (let i = 0; i < twinFiles.length; i++) {
		const twinPart = utf8(twinTexts[i])
		const twinPut = askOn(twinBox, SIM_PEER_ID, 'PUT', '/v1/offer/' + twinId + '/chunk/' + twinFiles[i].id + '/0', '', twinToken, twinPart.buffer as ArrayBuffer, hexOf(sha256Bytes(twinPart)))
		if (twinPut.status == 200) {
			twinWritten = twinWritten + 1
		}
	}
	check('同名两条都收下了自己那一块', twinWritten == 2)
	const twinDone = askOn(twinBox, SIM_PEER_ID, 'POST', '/v1/offer/' + twinId + '/finalize', '{}', twinToken, new ArrayBuffer(0), '')
	const twinObj = jsonOf(twinDone)
	const twinList = twinObj == null ? null : twinObj!.getArray<UTSJSONObject>('verified')
	let twinPassed = twinList != null && twinList!.length == 2
	let twinFirst = ''
	let twinSecond = ''
	if (twinList != null) {
		for (let i = 0; i < twinList!.length; i++) {
			const twinEntry = twinList![i]
			if (!twinEntry.getBoolean('ok', false)) {
				twinPassed = false
			}
			const twinPath = twinEntry.getString('path', '')
			if (i == 0) {
				twinFirst = twinPath
			} else {
				twinSecond = twinPath
			}
		}
	}
	check('同名两条都过了整文件摘要', twinPassed, twinFirst + ' | ' + twinSecond)
	check('两条落在两个不同的名字上', twinFirst != twinSecond && twinFirst != '' && twinSecond != '', twinFirst + ' | ' + twinSecond)
	check('后拿到的那一条改名成 §5 说的「 (2)」', twinSecond.indexOf('同名-备忘 (2).txt') >= 0, twinFirst + ' | ' + twinSecond)

	// 5d. 第九轮巡检（#174）：§5 那三个数字各自在边界上量一次。两端写的都是 `>`，所以只有「正好卡在数上
	// 还得收」和「多一段 / 多一字节必须拒」凑成一对，才分得出 `>` 与 `>=`；`max_path_depth` 此前只躺在
	// `protocol.json` 里，纸面那份清单没有它，三个数字也一条行为腿都没有（`check_protocol.py` 比的是常量相等）。
	// 点开头的段与保留名这两条，合同现在写的是「一律拒、不分平台」，腿就在共用状态机上量这一端的读法。
	const limitBox = newInbox(harnessRand)
	const limitPair = askPairOn(limitBox, SIM_PEER_ID, currentPairCode(limitBox, nowSeconds()), passphraseOf(limitBox, nowSeconds()), simKey)
	const limitPairObj = jsonOf(limitPair)
	const limitToken = limitPairObj == null ? '' : limitPairObj!.getString('token', '')
	const mkLimitFile = (rel: string): CsFile => {
		const body = utf8(rel)
		const f = new CsFile()
		f.path = rel
		f.relpath = rel
		f.id = hexOf(randomBytes(8))
		f.size = body.length
		f.sha256 = hexOf(sha256Bytes(body))
		f.mtime = Math.floor(Date.now() / 1000)
		f.type = 'text/plain'
		return f
	}
	const askLimitOffer = (files: CsFile[]): WireReply => {
		return askOn(limitBox, SIM_PEER_ID, 'POST', '/v1/offer', offerJson(hexOf(randomBytes(8)), files, SIM_PEER_ID, SIM_NAME), limitToken, new ArrayBuffer(0), '')
	}
	// 段数：16 段（15 层目录 + 文件名）是合同说的「超过 16 才拒」里最后还能收的那一条。
	let deepOkRel = ''
	for (let i = 0; i < MAX_PATH_DEPTH - 1; i++) {
		deepOkRel = deepOkRel + (i == 0 ? '' : '/') + 'd' + i.toString()
	}
	deepOkRel = deepOkRel + '/x.txt'
	const deepBadRel = deepOkRel.substring(0, deepOkRel.length - '/x.txt'.length) + '/d15/x.txt'
	const deepOkReply = askLimitOffer([mkLimitFile(deepOkRel)])
	check('§5 深度：正好 16 段的清单收下了、先问人', deepOkReply.pending, deepOkRel + ' 回 ' + codeOfReply(deepOkReply))
	const deepBadReply = askLimitOffer([mkLimitFile(deepBadRel)])
	check('§5 深度：多一段的清单 PATH_REJECTED（400）且没有弹确认',
		codeOfReply(deepBadReply) == 'PATH_REJECTED' && deepBadReply.status == 400 && !deepBadReply.pending, deepBadRel)
	const longOkRel = 'a'.repeat(MAX_NAME_BYTES)
	const longBadRel = 'a'.repeat(MAX_NAME_BYTES + 1)
	check('§5 名字：255 字节的段收下了', askLimitOffer([mkLimitFile(longOkRel)]).pending, longOkRel.length.toString())
	const longBadReply = askLimitOffer([mkLimitFile(longBadRel)])
	check('§5 名字：256 字节 PATH_REJECTED（400）且没有弹确认',
		codeOfReply(longBadReply) == 'PATH_REJECTED' && longBadReply.status == 400 && !longBadReply.pending, longBadRel.length.toString())
	const dotReply = askLimitOffer([mkLimitFile('.env')])
	check('§5 点开头：一律拒，不看它是不是列出来的那两个（400）',
		codeOfReply(dotReply) == 'PATH_REJECTED' && dotReply.status == 400 && !dotReply.pending)
	const dotInnerReply = askLimitOffer([mkLimitFile('sub/.git/config')])
	check('§5 点开头：嵌在中间的段也算（400）',
		codeOfReply(dotInnerReply) == 'PATH_REJECTED' && dotInnerReply.status == 400 && !dotInnerReply.pending)
	const conReply = askLimitOffer([mkLimitFile('CON')])
	const nulReply = askLimitOffer([mkLimitFile('nul.txt')])
	check('§5 保留名：不看自己跑在什么系统上（CON / nul.txt 都拒，都回 400）',
		codeOfReply(conReply) == 'PATH_REJECTED' && conReply.status == 400
		&& codeOfReply(nulReply) == 'PATH_REJECTED' && nulReply.status == 400 && !conReply.pending && !nulReply.pending)
	// 规模那一条拦的是这一单，不是这个名字，所以它回的是 `UNSUPPORTED_PROTOCOL`（v1 的码表没有「太大」这一格）。
	const bulkFiles: CsFile[] = []
	for (let i = 0; i < MAX_FILES_PER_OFFER + 1; i++) {
		bulkFiles.push(mkLimitFile('bulk/' + i.toString() + '.txt'))
	}
	const bulkReply = askLimitOffer(bulkFiles)
	const pendingBeforeSize = snapshot(limitBox, nowSeconds()).pendingOfferIds.length
	const sizeBox = newInbox(harnessRand)
	const sizePair = askPairOn(sizeBox, SIM_PEER_ID, currentPairCode(sizeBox, nowSeconds()), passphraseOf(sizeBox, nowSeconds()), simKey)
	const sizePairObj = jsonOf(sizePair)
	const sizeToken = sizePairObj == null ? '' : sizePairObj!.getString('token', '')
	const sizeReply = askOn(sizeBox, SIM_PEER_ID, 'POST', '/v1/offer', offerJson(hexOf(randomBytes(8)), bulkFiles.slice(0, MAX_FILES_PER_OFFER), SIM_PEER_ID, SIM_NAME), sizeToken, new ArrayBuffer(0), '')
	check('§5 规模：多一个文件就被拒（400），且没登记进账上',
		codeOfReply(bulkReply) == 'UNSUPPORTED_PROTOCOL' && bulkReply.status == 400 && !bulkReply.pending
		&& snapshot(limitBox, nowSeconds()).pendingOfferIds.length == pendingBeforeSize,
		codeOfReply(bulkReply) + ' | ' + detailOf(bulkReply.body))
	check('§5 规模：正好 2000 个文件的清单收下', sizeReply.pending, codeOfReply(sizeReply))

	// 5e. 第十轮巡检（#176）：这张错误码表在手机这一端是第三份抄本。§7 只在纸上写了一个号（「否则回 400
	// UNSUPPORTED_PROTOCOL」），其余十一格的号只活在 `protocol.json` 的 `error_codes` 里，而 `cs-receive.uts`
	// 的 `statusOf` 把它们又抄了一遍成 if 链、`cs-protocol.uts` 的 `errorText` 把话术又抄了一遍。上面那些腿
	// 全都只判码名：把 403 改成 400，一条都不会红。号本身错了在手机上是有代价的——宿主把 `reply.status` 原样
	// 写进线上响应（`app-android/index.uts` 的 `replyJson(reply.status, …)`），对面 PC 按合同表读它。
	// 这里量的是四格还没被号判过的码；422/507/403(DECLINED) 三格各自的腿本来就带着号，400 那几格刚在 5b/5d 补上。
	const errBox = newInbox(harnessRand)
	const errPair = askPairOn(errBox, SIM_PEER_ID, currentPairCode(errBox, nowSeconds()), passphraseOf(errBox, nowSeconds()), simKey)
	const errPairObj = jsonOf(errPair)
	const errToken = errPairObj == null ? '' : errPairObj!.getString('token', '')
	const noToken = askOn(errBox, SIM_PEER_ID, 'GET', '/v1/offer/x/state', '', '', new ArrayBuffer(0), '')
	check('§7 码表：NOT_PAIRED 线上回 403', codeOfReply(noToken) == 'NOT_PAIRED' && noToken.status == 403, noToken.status.toString())
	const unknown = askOn(errBox, SIM_PEER_ID, 'GET', '/v1/offer/no-such-offer/state', '', errToken, new ArrayBuffer(0), '')
	check('§7 码表：OFFER_UNKNOWN 线上回 404', codeOfReply(unknown) == 'OFFER_UNKNOWN' && unknown.status == 404, unknown.status.toString())
	const busy = askPairOn(errBox, '203.0.113.41', currentPairCode(errBox, nowSeconds()), passphraseOf(errBox, nowSeconds()), b64(randomBytes(32)))
	check('§7 码表：PEER_BUSY 线上回 429', codeOfReply(busy) == 'PEER_BUSY' && busy.status == 429, busy.status.toString())
	// 错的配对码要落在一台干净的盒子上：`box` 在第 1 组已经被五次尝试打过锁，那一格回的是 429 不是 403。
	const codeBox = newInbox(harnessRand)
	const codeNow = currentPairCode(codeBox, nowSeconds())
	const wrongOn = codeNow == '000000' ? '111111' : '000000'
	const badCode = askPairOn(codeBox, SIM_PEER_ID, wrongOn, passphraseOf(codeBox, nowSeconds()), simKey)
	check('§7 码表：BAD_PAIR_CODE 线上回 403', codeOfReply(badCode) == 'BAD_PAIR_CODE' && badCode.status == 403, badCode.status.toString())
	// hello 那一格：§7 现在说 `features` 原样来自 `transport.hello_features`，v1 里它不决定这一单的去留。
	// 这条腿判的是「这一端念的名单就是那三个数」，不是「名单里有 resume」——PC 的老腿只判后者，抄错一个词它不红。
	const helloReply = askOn(errBox, SIM_PEER_ID, 'GET', '/v1/hello', '', '', new ArrayBuffer(0), '')
	const helloObj = jsonOf(helloReply)
	const sameStrings = (a: string[], b: string[]): boolean => {
		if (a.length != b.length) {
			return false
		}
		for (let i = 0; i < a.length; i++) {
			if (a[i] != b[i]) {
				return false
			}
		}
		return true
	}
	const sameNumbers = (a: number[], b: number[]): boolean => {
		if (a.length != b.length) {
			return false
		}
		for (let i = 0; i < a.length; i++) {
			if (a[i] != b[i]) {
				return false
			}
		}
		return true
	}
	const theFeatures: string[] = []
	const theVersions: number[] = []
	let helloVersion = 0
	if (helloObj != null) {
		const rawVersion = helloObj!.getNumber('protocol_version')
		if (rawVersion != null) {
			helloVersion = rawVersion
		}
		const rawFeatures = helloObj!.getArray<string>('features')
		if (rawFeatures != null) {
			for (let i = 0; i < rawFeatures.length; i++) {
				theFeatures.push(rawFeatures[i])
			}
		}
		const rawVersions = helloObj!.getArray<number>('compatible_versions')
		if (rawVersions != null) {
			for (let k = 0; k < rawVersions.length; k++) {
				theVersions.push(rawVersions[k])
			}
		}
	}
	check('§7 hello：这一端念的能力名单就是合同那一份，一个词不多一个词不少',
		helloReply.status == 200 && helloVersion == PROTOCOL_VERSION && sameStrings(theFeatures, HELLO_FEATURES),
		helloVersion.toString() + ' | ' + theFeatures.join(','))
	check('§7 hello：能力名单不许偷偷变成第二套兼容规则——版本集合仍然是那一个数',
		theVersions.length == COMPATIBLE_VERSIONS.length && sameNumbers(theVersions, COMPATIBLE_VERSIONS),
		theVersions.join(','))

	// 5f. 第十二轮巡检（#178）：§9 那条冻结标准的链条里，「多文件含目录」这一格在共用接收内核上一直没人量过。
	// PC 有 `nested chinese path preserved`（落点真的带着 `相册/2026/` 两级），这一端此前只有 5d 那道深度闸门——
	// 它判的是清单收不收，从没成一单带目录的文件，也没读过落点。这一组把链条走完一次：配对 → 两个文件
	//（一个嵌两层中文目录、一个平名）→ 逐块 PUT → finalize，然后按 §9 的口径读屏：两条都过整文件摘要，
	// 且落点把目录段留着，没有被 basename 摊平。
	const dirBox = newInbox(harnessRand)
	const dirPair = askPairOn(dirBox, SIM_PEER_ID, currentPairCode(dirBox, nowSeconds()), passphraseOf(dirBox, nowSeconds()), simKey)
	const dirPairObj = jsonOf(dirPair)
	const dirToken = dirPairObj == null ? '' : dirPairObj!.getString('token', '')
	const dirRels: string[] = ['传书/备忘/甲.txt', '乙.txt']
	const dirTexts: string[] = ['甲：这一份该带着两级目录落下来。\n', '乙：这一份就落在单子目录里。\n']
	const dirFiles: CsFile[] = []
	const dirBodies: Uint8Array[] = []
	for (let i = 0; i < dirRels.length; i++) {
		const body = utf8(dirTexts[i])
		const one = new CsFile()
		one.path = dirRels[i]
		one.relpath = dirRels[i]
		one.id = hexOf(randomBytes(8))
		one.size = body.length
		one.sha256 = hexOf(sha256Bytes(body))
		one.mtime = Math.floor(Date.now() / 1000)
		one.type = 'text/plain'
		dirFiles.push(one)
		dirBodies.push(body)
	}
	const dirId = hexOf(randomBytes(8))
	const dirOffer = askOn(dirBox, SIM_PEER_ID, 'POST', '/v1/offer', offerJson(dirId, dirFiles, SIM_PEER_ID, SIM_NAME), dirToken, new ArrayBuffer(0), '')
	check('§9 冻结链「多文件含目录」：一条嵌两层目录、一条平名的清单先等人决定', dirOffer.pending, codeOfReply(dirOffer))
	resolveOffer(dirBox, dirId, true, recvPrepare, recvDrop)
	let dirWritten = 0
	for (let i = 0; i < dirFiles.length; i++) {
		const dirPut = askOn(dirBox, SIM_PEER_ID, 'PUT', '/v1/offer/' + dirId + '/chunk/' + dirFiles[i].id + '/0', '', dirToken, dirBodies[i].buffer as ArrayBuffer, hexOf(sha256Bytes(dirBodies[i])))
		if (dirPut.status == 200) {
			dirWritten = dirWritten + 1
		}
	}
	check('§9 冻结链：两个文件各一块都收下', dirWritten == 2, dirWritten.toString())
	const dirDone = askOn(dirBox, SIM_PEER_ID, 'POST', '/v1/offer/' + dirId + '/finalize', '{}', dirToken, new ArrayBuffer(0), '')
	const dirDoneObj = jsonOf(dirDone)
	const dirList = dirDoneObj == null ? null : dirDoneObj!.getArray<UTSJSONObject>('verified')
	let dirAllOk = dirList != null && dirList!.length == 2
	let dirFirst = ''
	let dirSecond = ''
	if (dirList != null) {
		for (let i = 0; i < dirList!.length; i++) {
			const dirEntry = dirList![i]
			if (!dirEntry.getBoolean('ok', false)) {
				dirAllOk = false
			}
			const dirPath = dirEntry.getString('path', '')
			if (i == 0) {
				dirFirst = dirPath
			} else {
				dirSecond = dirPath
			}
		}
	}
	check('§9 冻结链：两条都过了整文件摘要（finalize 读的是落点上的字节）', dirAllOk, dirFirst + ' | ' + dirSecond)
	check('§9 冻结链「含目录」：嵌两层的那条落点带着两个目录段，没被摊平成文件名',
		dirFirst.indexOf('传书/备忘/甲.txt') >= 0 && dirFirst.indexOf(dirId) >= 0, dirFirst)
	check('§9 冻结链：平名那条也在同一单的目录里，两条落点不是一个字符串',
		dirSecond.indexOf('乙.txt') >= 0 && dirSecond.indexOf(dirId) >= 0 && dirFirst != dirSecond, dirFirst + ' | ' + dirSecond)

	// 5g. 第十四轮巡检（#180）：§4 那一块摊开就是三端真发的字节，其中 `total_size` 说好了「接收方不拿它判任何事」。
	// 那不能只写在纸上：拿一个谎报的总数投一单——条目自己说 7 字节，总数说 987654321——如果这一端偷偷信了那个数，
	// 要么整单被拒，要么预先开档开出九个多亿。两头都量：登记照旧，落盘的字节按条目自己的 size。
	const totalBox = newInbox(harnessRand)
	const totalPair = askPairOn(totalBox, SIM_PEER_ID, currentPairCode(totalBox, nowSeconds()), passphraseOf(totalBox, nowSeconds()), simKey)
	const totalPairObj = jsonOf(totalPair)
	const totalToken = totalPairObj == null ? '' : totalPairObj!.getString('token', '')
	const fakeText = '就七个字节。\n'
	const fakeBody = utf8(fakeText)
	const fakeSha = hexOf(sha256Bytes(fakeBody))
	const fakeId = hexOf(randomBytes(8))
	const fakeFileId = hexOf(randomBytes(8))
	const fakeRel = '丙.txt'
	const bogusOffer = askOn(totalBox, SIM_PEER_ID, 'POST', '/v1/offer',
		'{"offer_id":"' + fakeId + '","protocol_version":' + PROTOCOL_VERSION.toString()
			+ ',"compatible_versions":[' + PROTOCOL_VERSION.toString() + ']'
			+ ',"from":{"peer_id":"' + SIM_PEER_ID + '","name":"' + SIM_NAME + '"}'
			+ ',"total_size":987654321,"files":[{"id":"' + fakeFileId + '","relpath":"' + fakeRel
			+ '","size":' + fakeBody.length.toString() + ',"sha256":"' + fakeSha
			+ '","mtime":0,"type":"text/plain"}]}',
		totalToken, new ArrayBuffer(0), '')
	check('§4 total_size：总数谎报九个多亿，这一单照样登记、照样等人决定', bogusOffer.pending, codeOfReply(bogusOffer))
	resolveOffer(totalBox, fakeId, true, recvPrepare, recvDrop)
	const openedBytes = recvStore.get(fakeId + '/' + fakeRel)
	check('§4 total_size：接收方开档按条目自己的 size，没有拿那个谎报的总数当尺寸',
		openedBytes != null && openedBytes!.length == fakeBody.length,
		openedBytes == null ? '没有这份开档' : openedBytes!.length.toString())
	const fakePut = askOn(totalBox, SIM_PEER_ID, 'PUT', '/v1/offer/' + fakeId + '/chunk/' + fakeFileId + '/0', '', totalToken, fakeBody.buffer as ArrayBuffer, fakeSha)
	const fakeDone = askOn(totalBox, SIM_PEER_ID, 'POST', '/v1/offer/' + fakeId + '/finalize', '{}', totalToken, new ArrayBuffer(0), '')
	const fakeDoneObj = jsonOf(fakeDone)
	const fakeList = fakeDoneObj == null ? null : fakeDoneObj!.getArray<UTSJSONObject>('verified')
	const fakeVerified = fakeList != null && fakeList!.length == 1 && fakeList![0].getBoolean('ok', false)
	check('§4 total_size：那一块照常收下、整单照常过摘要（总数没挡路，也没被拿去判）',
		fakePut.status == 200 && fakeVerified, fakePut.status.toString() + ' | ' + codeOfReply(fakeDone))

	// 5h. 第十五轮巡检（#181）：§4 那句「任一项 ok: false 时发送方可只补传该文件的问题分块」只有一个读数来源——
	// 这条应答里的 `missing`。纸上原来画的是 `{"verified": [{"id","ok"}]}`，等于合同让发送方补传它读不到的东西
	//（同一节上面讲落点时却已经把 `path` 算进来了，两处对同一条应答各说各话）。这一组先把这一端回的形状钉住，
	// 再量那句句子管不到的那一格：`size: 0` 的条目分块数就是 0，被摘要推翻时也只会回一个空的缺块表。
	const zeroBox = newInbox(harnessRand)
	const zeroPair = askPairOn(zeroBox, SIM_PEER_ID, currentPairCode(zeroBox, nowSeconds()), passphraseOf(zeroBox, nowSeconds()), simKey)
	const zeroPairObj = jsonOf(zeroPair)
	const zeroToken = zeroPairObj == null ? '' : zeroPairObj!.getString('token', '')
	const zeroSha = hexOf(sha256Bytes(new Uint8Array(0)))
	const zeroReply = (offerId: string, fileId: string, rel: string): WireReply => {
		const body = '{"offer_id":"' + offerId + '","protocol_version":' + PROTOCOL_VERSION.toString()
			+ ',"compatible_versions":[' + PROTOCOL_VERSION.toString() + ']'
			+ ',"from":{"peer_id":"' + SIM_PEER_ID + '","name":"' + SIM_NAME + '"}'
			+ ',"total_size":0,"files":[{"id":"' + fileId + '","relpath":"' + rel
			+ '","size":0,"sha256":"' + zeroSha + '","mtime":0,"type":"text/plain"}]}'
		const asked = askOn(zeroBox, SIM_PEER_ID, 'POST', '/v1/offer', body, zeroToken, new ArrayBuffer(0), '')
		resolveOffer(zeroBox, offerId, true, recvPrepare, recvDrop)
		return asked
	}
	const zeroId = hexOf(randomBytes(8))
	const zeroFileId = hexOf(randomBytes(8))
	const zeroRel = '零字节.txt'
	const zeroAsked = zeroReply(zeroId, zeroFileId, zeroRel)
	const zeroOpened = recvStore.get(landOf(zeroId, zeroRel))
	check('§4 零字节的条目：一块都没有，也照样按 §4 的开档规则开出 0 字节',
		zeroAsked.pending && zeroOpened != null && zeroOpened!.length == 0,
		zeroOpened == null ? '没有这份开档' : zeroOpened!.length.toString())
	const zeroDone = askOn(zeroBox, SIM_PEER_ID, 'POST', '/v1/offer/' + zeroId + '/finalize', '{}', zeroToken, new ArrayBuffer(0), '')
	const zeroDoneObj = jsonOf(zeroDone)
	const zeroTop: string[] = zeroDoneObj == null ? [] : UTSJSONObject.keys(zeroDoneObj!)
	const zeroList = zeroDoneObj == null ? null : zeroDoneObj!.getArray<UTSJSONObject>('verified')
	const zeroEntry = zeroList != null && zeroList!.length == 1 ? zeroList![0] : null
	check('§4 finalize 的形状：这一端回的是顶层 offer_id+verified、条目 id/ok/missing/path 四个键',
		sameKeys(zeroTop, ['offer_id', 'verified']) && zeroEntry != null
		&& sameKeys(UTSJSONObject.keys(zeroEntry!), ['id', 'ok', 'missing', 'path']),
		zeroTop.join(',') + ' | ' + (zeroEntry == null ? '没有那一条' : UTSJSONObject.keys(zeroEntry!).join(',')))
	const zeroHoles = zeroEntry == null ? [-1] : numList(zeroEntry!.getArray<number>('missing'))
	check('§4 零字节的条目：一块没传也过整文件摘要（0 字节的落点就是它的全部内容），落点照常报回',
		zeroEntry != null && zeroEntry!.getBoolean('ok', false) && zeroHoles.length == 0
		&& zeroEntry!.getString('path', '').indexOf(zeroRel) >= 0,
		codeOfReply(zeroDone) + ' | ' + zeroHoles.join(','))
	// 那份 0 字节的落点被人从盘上拿掉：台账无从作废（它本来就没记任何一块），答复也就点不出任何问题分块。
	const goneZero = hexOf(randomBytes(8))
	const goneZeroFile = hexOf(randomBytes(8))
	const goneZeroRel = '零字节被删.txt'
	zeroReply(goneZero, goneZeroFile, goneZeroRel)
	recvDrop(landOf(goneZero, goneZeroRel))
	const goneDone = askOn(zeroBox, SIM_PEER_ID, 'POST', '/v1/offer/' + goneZero + '/finalize', '{}', zeroToken, new ArrayBuffer(0), '')
	const goneObj = jsonOf(goneDone)
	const goneList = goneObj == null ? null : goneObj!.getArray<UTSJSONObject>('verified')
	const goneEntry = goneList != null && goneList!.length == 1 ? goneList![0] : null
	const goneHoles = goneEntry == null ? [-1] : numList(goneEntry!.getArray<number>('missing'))
	check('§4 那一格量出来了：零字节的条目被摘要推翻时回 ok:false、缺块表是空的、落点是 null',
		goneEntry != null && !goneEntry!.getBoolean('ok', true) && goneHoles.length == 0
		&& goneDone.body.replace(/ /g, '').indexOf('"path":null') >= 0,
		goneEntry == null ? '没有那一条' : (goneEntry!.getBoolean('ok', true).toString() + ' | ' + goneHoles.join(',') + ' | ' + goneDone.body))

	// 6. chunks: store, reject a lying digest, reject the wrong length, and be idempotent.
	const bigId = files[1].id
	const bigSize = files[1].size
	const bigCount = chunkCount(bigSize)
	const all = simFileOf(SCRATCH_BIG)
	const chunkPath = (fid: string, index: number): string => {
		return '/v1/offer/' + offerId + '/chunk/' + fid + '/' + index.toString()
	}
	const c0 = sliceOf(all, 0, chunkSizeAt(bigSize, 0))
	const tail = sliceOf(all, CHUNK_SIZE, chunkSizeAt(bigSize, 1))
	check('最后一个分块是不足整块的尾巴', tail.length == 1000 && bigCount == 2)
	const good = ask('PUT', chunkPath(bigId, 0), '', c0.buffer as ArrayBuffer, hexOf(sha256Bytes(c0)))
	check('首个分块收下', good.status == 200)
	const lied = ask('PUT', chunkPath(bigId, 1), '', tail.buffer as ArrayBuffer, hexOf(sha256Bytes(c0)))
	check('校验和不符的分块被拒', lied.status == 422 && codeOfReply(lied) == 'CHUNK_DIGEST_MISMATCH')
	const tooLong = ask('PUT', chunkPath(bigId, 1), '', c0.buffer as ArrayBuffer, '')
	check('长度不符的分块被拒', tooLong.status == 422 && tooLong.body.indexOf('length') >= 0)
	const outOfDay = ask('PUT', chunkPath(bigId, bigCount + 5), '', c0.buffer as ArrayBuffer, '')
	check('越界序号 BAD_CHUNK_INDEX（400）', codeOfReply(outOfDay) == 'BAD_CHUNK_INDEX' && outOfDay.status == 400,
		outOfDay.status.toString())
	const repeat = ask('PUT', chunkPath(bigId, 0), '', c0.buffer as ArrayBuffer, hexOf(sha256Bytes(c0)))
	const repeatObj = jsonOf(repeat)
	check('重发同一分块标记幂等', repeat.status == 200 && repeatObj != null && repeatObj!.getBoolean('idempotent', false))

	// 7. resume: the state a restart would re-adopt is the state the sender resumes from.
	const before = ask('GET', '/v1/offer/' + offerId + '/state', '', new ArrayBuffer(0), '')
	const beforeMissing = missingOf(before, bigId)
	const kept = stateAll(box)
	restartLike(box)
	const adopted = adoptAll(box, kept, nowSeconds())
	check('重启后重新接管传输', adopted == 1)
	// §4 的空闲窗口量的是"最后一次落块"，不是"这台设备上次开机"。台账里没有这两个钟的话，
	// 每次重启都给一单死掉的传输续上一小时，卡片就能永远写着「还没收到分块」。
	const ledger = JSON.parse(kept[0]) as UTSJSONObject | null
	check('续传台账带着落块的时刻', ledger != null && ledger!.getNumber('touched', 0) > 0 && ledger!.getNumber('created', 0) > 0)
	if (ledger != null) {
		ledger!.set('touched', nowSeconds() - OFFER_IDLE_S - 5)
		const agedBox = newInbox(harnessRand)
		check('过了点的台账照样接管', adoptAll(agedBox, [JSON.stringify(ledger)], nowSeconds()) == 1)
		const agedNames: string[] = []
		sweep(agedBox, nowSeconds(), (path: string): void => { agedNames.push(path) }, recvDigestFile)
		check('重启不再给停摆的传输续命', agedNames.length > 0 && snapshot(agedBox, nowSeconds()).rows.length == 0, agedNames.join('、'))
	}
	check('重启后会话失效 NOT_PAIRED', codeOfReply(askOn(box, SIM_PEER_ID, 'GET', '/v1/offer/' + offerId + '/state', '', '旧令牌', new ArrayBuffer(0), '')) == 'NOT_PAIRED')
	const repair = askPairOn(box, SIM_PEER_ID, '', '', simKey)
	const repairObj = jsonOf(repair)
	token = repairObj == null ? '' : repairObj!.getString('token', '')
	check('留空配对码靠签名恢复会话', repair.status == 200 && repairObj != null && repairObj!.getBoolean('resumed', false))
	// 7b. #141: the address bridge on a phone hands the receiver a number for a peer it met on the way
	// *out*. Since #47/#106 every end signs with an identity key and serves a different certificate, so
	// what is pinned at an address is the leaf, while pairReply matches a peer only by the identity -
	// the one number its signature can be checked against. Adopting the leaf therefore left the caller
	// that legitimately comes back without a code in the stranger branch. A bridge has to hand over the
	// identity, and a box that only ever learned the leaf must still cost a code: that is the refusal
	// which proves nothing here is trusted on an address alone.
	const bridge = newInbox(harnessRand)
	const bridgeLeaf = hexOf(sha256Bytes(utf8('served-leaf-of-' + SIM_PEER_ID)))
	adoptPin(bridge, simFp, '', '', bridgeLeaf)
	const healed = askPairOn(bridge, '203.0.113.20', '', '', simKey)
	const healedObj = jsonOf(healed)
	check('桥接交身份摘要：回拨的一台不配码也能resume',
		healed.status == 200 && healedObj != null && healedObj!.getBoolean('resumed', false))
	const leafOnly = newInbox(harnessRand)
	adoptPin(leafOnly, bridgeLeaf, '', '', bridgeLeaf)
	check('只按叶摘要桥接仍然要配对码 BAD_PAIR_CODE',
		codeOfReply(askPairOn(leafOnly, '203.0.113.21', '', '', simKey)) == 'BAD_PAIR_CODE')
	// The entry the bridge adopted with no key has to be the one that grows: pairReply fills in the
	// public key only after the signature verified, and the leaf stays beside it, because spec §1's two
	// digests name one machine and the single-session slot has to recognise it from either side.
	const grown = healedObj == null || bridge.trusted.length == 0 ? null : bridge.trusted[0]
	check('验签后补上密钥，叶摘要仍留在同一条上',
		grown != null && grown!.publicKeyB64 == simKey && grown!.tlsFingerprint == bridgeLeaf)
	const after = ask('GET', '/v1/offer/' + offerId + '/state', '', new ArrayBuffer(0), '')
	const afterMissing = missingOf(after, bigId)
	check('续传缺块与重启前一致', beforeMissing.length == afterMissing.length && beforeMissing.length == 1)

	// 7c. 第四轮巡检（#165）改掉了 §4 的另一句：原来写的是「状态文件损坏或缺失时，接收方按已落盘字节 /
	// chunk_size 重算缺块」，可这一条三端都量不出来——用户在 #128 那一手「接受」里点下头的那一刻，这一端
	// 就把文件开档并截到清单声明的长度（PC 的 receive.py:898、鸿蒙 app-harmony/index.uts:1049、安卓
	// CsStore.kt:52，这里的 recvPrepare 走同一条规则），所以一块没落和刚落一块，落盘字节数都回「整个文件」。
	// 一个量不出区别的数不能当答案，于是真行为成了合同：读坏的台账一单也不认领，发送方那份清单再投一次
	// 就是全缺登记的一单，finalize 仍然是唯一的结论。丢的只是那几块本来要重传的字节。
	const lostBox = newInbox(harnessRand)
	let lostToken = ''
	const lostPair = jsonOf(askPairOn(lostBox, SIM_PEER_ID, currentPairCode(lostBox, nowSeconds()), passphraseOf(lostBox, nowSeconds()), simKey))
	lostToken = lostPair == null ? '' : lostPair!.getString('token', '')
	const lostAsk = (method: string, path: string, jsonBody: string): WireReply => {
		return askOn(lostBox, SIM_PEER_ID, method, path, jsonBody, lostToken, new ArrayBuffer(0), '')
	}
	const lostPut = (path: string, part: Uint8Array): WireReply => {
		return askOn(lostBox, SIM_PEER_ID, 'PUT', path, '', lostToken, part.buffer as ArrayBuffer, hexOf(sha256Bytes(part)))
	}
	const lostId = hexOf(randomBytes(8))
	const lostManifest = offerJson(lostId, files, SIM_PEER_ID, SIM_NAME)
	const lostBig = landOf(lostId, files[1].relpath)
	lostAsk('POST', '/v1/offer', lostManifest)
	resolveOffer(lostBox, lostId, true, recvPrepare, recvDrop)
	check('丢台账这一腿：会话在，先落一块', lostPut('/v1/offer/' + lostId + '/chunk/' + bigId + '/0', sliceOf(all, 0, chunkSizeAt(bigSize, 0))).status == 200)
	check('一块刚落，落点已经量成整个文件的长度——字节数说不出哪块落了',
		recvStore.has(lostBig) && recvStore.get(lostBig)!.length == bigSize, lostBig)
	const lostLedger = stateAll(lostBox)
	check('落一块就重写台账，此刻盘上有一份', lostLedger.length == 1)
	// 崩在重写台账的中途，留下的就是这半个 JSON——上一秒它还在，下一秒就读不出来了。
	const torn = lostLedger.length == 1 ? lostLedger[0].substring(0, Math.floor(lostLedger[0].length / 2)) : ''
	restartLike(lostBox)
	check('读坏的台账一单也不认领', adoptAll(lostBox, [torn], nowSeconds()) == 0)
	const lostRepair = jsonOf(askPairOn(lostBox, SIM_PEER_ID, '', '', simKey))
	lostToken = lostRepair == null ? '' : lostRepair!.getString('token', '')
	// 会话是重启后新配的那一个，问的却是同一单：这一端手里没有台账，就没有这一单可说。
	check('认领不到就没有这一单：state 回 OFFER_UNKNOWN', codeOfReply(lostAsk('GET', '/v1/offer/' + lostId + '/state', '')) == 'OFFER_UNKNOWN')
	const reposted = lostAsk('POST', '/v1/offer', lostManifest)
	check('这一端不记得那一单，同一份清单再投就重新问用户一次', reposted.pending)
	resolveOffer(lostBox, lostId, true, recvPrepare, recvDrop)
	const lostState = lostAsk('GET', '/v1/offer/' + lostId + '/state', '')
	const bigMissing = missingOf(lostState, bigId)
	let everyIndex = bigMissing.length == bigCount
	for (let i = 0; i < bigCount; i++) {
		if (bigMissing.indexOf(i) < 0) {
			everyIndex = false
		}
	}
	check('再投的清单按全缺登记，不拿落盘字节猜', everyIndex && missingOf(lostState, files[0].id).length == 1, bigMissing.join('、'))
	let repushed = 0
	for (let k = 0; k < bigCount; k++) {
		const part = sliceOf(all, k * CHUNK_SIZE, chunkSizeAt(bigSize, k))
		if (lostPut('/v1/offer/' + lostId + '/chunk/' + bigId + '/' + k.toString(), part).status == 200) {
			repushed = repushed + 1
		}
	}
	check('全缺登记以后每块都真写得进去，一块也没被幂等挡回', repushed == bigCount, repushed.toString() + '/' + bigCount.toString())
	check('小文件也照样重写', lostPut('/v1/offer/' + lostId + '/chunk/' + files[0].id + '/0', smallBytes).status == 200)
	const lostDone = lostAsk('POST', '/v1/offer/' + lostId + '/finalize', '{}')
	check('那一单照样传得完——finalize 才是结论', lostDone.status == 200 && firstVerifiedOk(lostDone))
	check('台账丢了重发的字节，逐块填回后整文件摘要等于清单那一份', recvDigestFile(lostBig) == files[1].sha256)

	// 7d. 第五轮巡检（#167）的两支都在 §4 那句零字节转义上：「体里没有零就不转义」，以及收货这一端认的是
	// 头的「值」还是「头在不在」。发货这一端以前只要数得出转义就打包抬头，于是整整一块 0x1B、一个零也没有
	// 的体，手机翻倍而桌面原样发出——PC 的 `app/net/spec.py:escape_chunk` 从一开始就只看有没有零。收货那
	// 两端更贵：老分支写的是「头非空就反解」，对面发来一个它不认识的编码值，字节会被当成编码过的读掉，凭空
	// 少一截；合同要的是原样交给后面的长度与摘要去判（`unescapeChunk` 上面那句注释）。三端现在都只认那一个值。
	const hasZero = (src: Uint8Array): boolean => {
		for (let i = 0; i < src.length; i++) {
			if (src[i] == 0) {
				return true
			}
		}
		return false
	}
	const sameBytes = (a: Uint8Array, b: Uint8Array): boolean => {
		if (a.length != b.length) {
			return false
		}
		for (let i = 0; i < a.length; i++) {
			if (a[i] != b[i]) {
				return false
			}
		}
		return true
	}
	const plainOnly = new Uint8Array([0x1B, 0x41, 0x1B, 0x1B, 0x20, 0x1B])
	const plainPacked = escapeChunk(plainOnly.buffer as ArrayBuffer)
	check('整块都是 0x1B、一个零也没有：不打包，也不抬头——「体里没有零就不转义」',
		plainPacked.escape == '' && sameBytes(new Uint8Array(plainPacked.bytes), plainOnly))
	const mixedBytes = new Uint8Array([0x41, 0x00, 0x1B, 0x00, 0x42])
	const mixedPacked = escapeChunk(mixedBytes.buffer as ArrayBuffer)
	check('有零才抬头，报的就是合同那一个值；打包以后线上一个零也不剩',
		mixedPacked.escape == CHUNK_ESCAPE_VALUE && !hasZero(new Uint8Array(mixedPacked.bytes)))
	check('解回来逐字节等于原来那五个字节',
		sameBytes(new Uint8Array(unescapeChunk(mixedPacked.bytes, mixedPacked.escape)), mixedBytes))
	check('头不是那一个值就一个字节也不动——未知编码留给长度与摘要去判',
		sameBytes(new Uint8Array(unescapeChunk(mixedPacked.bytes, 'stu2')), new Uint8Array(mixedPacked.bytes)))
	// 上机那一支要的是「按值判」和「按有没有判」唯一能被区分出来的那两条腿：同一份打包后的字节，配正确的头
	// 要落回原文，配一个不认识的头必须被拒——老分支在第二条上会把它反解成原文收下，屏上一切正常。
	const eBox = newInbox(harnessRand)
	const ePair = jsonOf(askPairOn(eBox, SIM_PEER_ID, currentPairCode(eBox, nowSeconds()), passphraseOf(eBox, nowSeconds()), simKey))
	const eToken = ePair == null ? '' : ePair!.getString('token', '')
	const eAsk = (method: string, path: string, jsonBody: string): WireReply => {
		return askOn(eBox, SIM_PEER_ID, method, path, jsonBody, eToken, new ArrayBuffer(0), '')
	}
	const eId = hexOf(randomBytes(8))
	eAsk('POST', '/v1/offer', offerJson(eId, files, SIM_PEER_ID, SIM_NAME))
	resolveOffer(eBox, eId, true, recvPrepare, recvDrop)
	const eChunk = sliceOf(all, 0, chunkSizeAt(bigSize, 0))
	const eDigest = hexOf(sha256Bytes(eChunk))
	const eWire = escapeChunk(eChunk.buffer as ArrayBuffer)
	const ePath = '/v1/offer/' + eId + '/chunk/' + bigId + '/0'
	// 三个 host 都在内核看到字节之前做这一次反解，判据是头的值；这里走同一条管线。
	const ePut = (body: ArrayBuffer, head: string): WireReply => {
		return askOn(eBox, SIM_PEER_ID, 'PUT', ePath, '', eToken, unescapeChunk(body, head), eDigest)
	}
	check('这一块原文里确实又有零又有 0x1B——转义在这一腿不是摆设',
		hasZero(eChunk) && eWire.escape == CHUNK_ESCAPE_VALUE)
	check('X-Sha256 报的是原块的摘要：打包后的字节自己 dig 出来是另一个',
		eDigest != hexOf(sha256Bytes(new Uint8Array(eWire.bytes))))
	const eGood = ePut(eWire.bytes, eWire.escape)
	const eLanded = recvStore.get(landOf(eId, files[1].relpath))
	check('打包的体配上合同那一个头值：落点逐字节回到原文',
		eGood.status == 200 && eLanded != null && sameBytes(sliceOf(eLanded!, 0, eChunk.length), eChunk))
	check('同一块原样再发一次（空头）也认：没有头，体就是块', ePut(eChunk.buffer as ArrayBuffer, '').status == 200)
	check('同一块配一个不认识的头：原样进内核，被长度/摘要拒掉而不是偷偷反解',
		codeOfReply(ePut(eWire.bytes, 'stu2')) == 'CHUNK_DIGEST_MISMATCH')

	// 8. finish it: the rest of the chunks, then the whole-file digest over the reassembled bytes.
	for (let k = 1; k < bigCount; k++) {
		const part = sliceOf(all, k * CHUNK_SIZE, chunkSizeAt(bigSize, k))
		const pushed = ask('PUT', chunkPath(bigId, k), '', part.buffer as ArrayBuffer, hexOf(sha256Bytes(part)))
		if (pushed.status != 200) {
			check('补齐剩余分块', false)
		}
	}
	const smallPath = '/v1/offer/' + offerId + '/chunk/' + files[0].id + '/0'
	const smallReply = ask('PUT', smallPath, '', smallBytes.buffer as ArrayBuffer, hexOf(sha256Bytes(smallBytes)))
	check('小文件一次成块', smallReply.status == 200)
	const done = ask('POST', '/v1/offer/' + offerId + '/finalize', '{}', new ArrayBuffer(0), '')
	check('整文件校验通过', done.status == 200 && firstVerifiedOk(done))
	const doneObj = jsonOf(done)
	const verifiedList = doneObj == null ? null : doneObj!.getArray('verified')
	let dest = ''
	if (verifiedList != null && verifiedList.length > 0) {
		dest = (verifiedList[0] as UTSJSONObject).getString('path', '')
	}
	check('校验通过的文件带回落点', dest.indexOf(SCRATCH_TEXT) >= 0)

	// 那份过了点的台账说的是同一单、同一个落点。这一端现在和 PC 一样一单一个目录，所以回收它只会
	// 碰这一单自己的字节——而这一单的字节刚刚传满并校验过了，落点上的东西还合清单里那个校验和，
	// 于是它不是半个文件。
	if (ledger != null) {
		const staleBox = newInbox(harnessRand)
		adoptAll(staleBox, [JSON.stringify(ledger)], nowSeconds())
		const staleNames: string[] = []
		sweep(staleBox, nowSeconds(), (path: string): void => { staleNames.push(path) }, recvDigestFile)
		const bigName = landOf(offerId, files[1].relpath)
		check('回收停摆清单不删同名收全的文件', bigName != '' && recvStore.has(bigName) && staleNames.indexOf(bigName) < 0 && snapshot(staleBox, nowSeconds()).rows.length == 0, staleNames.join('、'))
	}

	// 8b. 「收到的文件」这张卡的标题问的是这台设备收过什么，不是这个进程收过什么。一单传完，续传
	// 台账就把它去掉了（一份写着不可能续传的清单只会让下一次开机把它当那一单），所以收过的字节
	// 需要自己的那份记录——PC 早就有 arrivals.json，手机一直没有。开机是一个新 inbox，读回这份
	// 记录就是手机做的事；浏览器没有磁盘，收件箱是那个 Map，所以它同样能回答文件还在不在。
	const receipts = arrivalsAll(box)
	check('传完的文件进了收到清单', receipts.length == 2)
	const bootBox = newInbox(harnessRand)
	check('开机读回收到清单', adoptArrivals(bootBox, receipts) == 2)
	const bootSnap = snapshot(bootBox, nowSeconds())
	markLanded(bootSnap.rows, (path: string): boolean => { return recvStore.has(path) })
	check('重启后卡片仍列这两个文件', bootSnap.verifiedFiles == 2 && bootSnap.rows.length == 2
		&& !bootSnap.rows[0].gone && !bootSnap.rows[1].gone)
	// 人可以自己从接收目录里删掉一个收过的文件。那一行不能跟着消失——列表悄悄少一项只能让人猜——
	// 也不能继续说「落到」，那是一句会让人去点开一个不存在的东西的话。
	recvStore.delete(landOf(offerId, files[0].relpath))
	const goneSnap = snapshot(bootBox, nowSeconds())
	markLanded(goneSnap.rows, (path: string): boolean => { return recvStore.has(path) })
	let goneNow = 0
	for (let i = 0; i < goneSnap.rows.length; i++) {
		if (goneSnap.rows[i].gone) {
			goneNow = goneNow + 1
		}
	}
	check('被删掉的还在清单上并说自己不在了', goneSnap.rows.length == 2 && goneNow == 1)

	// 9. an unfinished delivery is cancelled and the bytes go away.
	const halfFiles = simFilesFor(SCRATCH_TEXT, SCRATCH_BIG)
	const halfId = hexOf(randomBytes(8))
	const half = ask('POST', '/v1/offer', offerJson(halfId, halfFiles, SIM_PEER_ID, SIM_NAME), new ArrayBuffer(0), '')
	check('半途传输也能等待决定', half.pending)
	resolveOffer(box, halfId, true, recvPrepare, recvDrop)
	const head = sliceOf(all, 0, chunkSizeAt(halfFiles[1].size, 0))
	ask('PUT', '/v1/offer/' + halfId + '/chunk/' + halfFiles[1].id + '/0', '', head.buffer as ArrayBuffer, hexOf(sha256Bytes(head)))
	check('取消前文件已在收件箱里', recvStore.has(landOf(halfId, halfFiles[1].relpath)))
	const cancelled = ask('DELETE', '/v1/offer/' + halfId, '', new ArrayBuffer(0), '')
	check('取消传输带回 dropped', codeOfReply(cancelled) == '' && cancelled.status == 200)
	check('取消后传输不再存在', codeOfReply(ask('GET', '/v1/offer/' + halfId + '/state', '', new ArrayBuffer(0), '')) == 'OFFER_UNKNOWN')
	check('取消后不留半个文件', !recvStore.has(landOf(halfId, halfFiles[1].relpath)))

	// 10. the user can say no, and a full disk rolls the allocation back.
	const noId = hexOf(randomBytes(8))
	ask('POST', '/v1/offer', offerJson(noId, simFilesFor(SCRATCH_TEXT, SCRATCH_BIG), SIM_PEER_ID, SIM_NAME), new ArrayBuffer(0), '')
	check('拒绝这次传输', codeOfReply(resolveOffer(box, noId, false, recvPrepare, recvDrop)) == 'DECLINED')
	recvFault = 'STORAGE_FULL'
	const fullId = hexOf(randomBytes(8))
	ask('POST', '/v1/offer', offerJson(fullId, simFilesFor(SCRATCH_TEXT, SCRATCH_BIG), SIM_PEER_ID, SIM_NAME), new ArrayBuffer(0), '')
	const full = resolveOffer(box, fullId, true, recvPrepare, recvDrop)
	recvFault = ''
	check('空间不足回 STORAGE_FULL', full.status == 507)
	check('空间不足后没有留下半个传输', snapshot(box, nowSeconds()).pendingOfferIds.length == 0)
	check('空间不足后分配好的文件也回滚了', !recvStore.has(landOf(fullId, SCRATCH_TEXT)))

	// 11. spec §3: a session that stops moving gives the slot back on its own.
	const idle = newInbox(harnessRand)
	const idleCode = currentPairCode(idle, nowSeconds())
	const idleSecret = passphraseOf(idle, nowSeconds())
	const idleAsk = (method: string, path: string, jsonBody: string, useToken: string): WireReply => {
		return askOn(idle, SIM_PEER_ID, method, path, jsonBody, useToken, new ArrayBuffer(0), '')
	}
	const idlePut = (path: string, useToken: string, part: Uint8Array): WireReply => {
		return askOn(idle, SIM_PEER_ID, 'PUT', path, '', useToken, part.buffer as ArrayBuffer, hexOf(sha256Bytes(part)))
	}
	const idlePair = askPairOn(idle, SIM_PEER_ID, idleCode, idleSecret, simKey)
	const idleObj = jsonOf(idlePair)
	const idleToken = idleObj == null ? '' : idleObj!.getString('token', '')
	check('停摆自检：配对换来会话', idleToken != '')
	check('停摆自检：会话活着时第三方被拒', codeOfReply(askPairOn(idle, '203.0.113.30', idleCode, idleSecret, b64(randomBytes(32)))) == 'PEER_BUSY')
	const stalled = nowSeconds() + SESSION_IDLE_S + 1
	const reclaimed = sweep(idle, stalled, recvDrop, recvDigestFile)
	check('沉默满闲置窗口的会话被收回名额', reclaimed.length == 1 && reclaimed[0] == simFp)
	check('收回名额时说得出这台对端的名字', snapshot(idle, stalled).lostName == SIM_NAME)
	check('它自己再发请求吃 NOT_PAIRED', codeOfReply(idleAsk('GET', '/v1/offer/x/state', '', idleToken)) == 'NOT_PAIRED')
	// 名额回来了，而它那一头的密钥还在：重连不需要任何人再报一次码。
	const idleRepair = askPairOn(idle, SIM_PEER_ID, '', '', simKey)
	const idleRepairObj = jsonOf(idleRepair)
	const idleToken2 = idleRepairObj == null ? '' : idleRepairObj!.getString('token', '')
	check('沉默后靠签名重连，不用再报配对码', idleRepair.status == 200 && idleRepairObj != null && idleRepairObj!.getBoolean('resumed', false))
	check('重连后又只允许这一台', codeOfReply(askPairOn(idle, '203.0.113.31', idleCode, idleSecret, b64(randomBytes(32)))) == 'PEER_BUSY')

	// 12. spec §4: an accepted offer nobody finishes is dropped exactly like a cancel would.
	const stallId = hexOf(randomBytes(8))
	const stallFiles = simFilesFor(STALL_TEXT, STALL_BIG)
	idleAsk('POST', '/v1/offer', offerJson(stallId, stallFiles, SIM_PEER_ID, SIM_NAME), idleToken2)
	resolveOffer(idle, stallId, true, recvPrepare, recvDrop)
	const stallHead = sliceOf(simFileOf(STALL_BIG), 0, chunkSizeAt(stallFiles[1].size, 0))
	idlePut('/v1/offer/' + stallId + '/chunk/' + stallFiles[1].id + '/0', idleToken2, stallHead)
	check('停摆前文件已经落在收件箱里', recvStore.has(landOf(stallId, STALL_BIG)))
	// 这一小时里对端别处的请求一直在给会话续命，只有这一单没人填。不先把心跳打到那个时刻，
	// 这次收回会把会话一起收走，测到的是 §3 而不是 §4。
	const offerStallAt = nowSeconds() + OFFER_IDLE_S + 1
	seenNow(idle, simFp, offerStallAt)
	sweep(idle, offerStallAt, recvDrop, recvDigestFile)
	check('没人填的传输到点自己下台', codeOfReply(idleAsk('GET', '/v1/offer/' + stallId + '/state', '', idleToken2)) == 'OFFER_UNKNOWN')
	check('到点后不留半个文件', !recvStore.has(landOf(stallId, STALL_BIG)) && !recvStore.has(landOf(stallId, STALL_TEXT)))

	// 13. a transfer that finished is not a stalled one: its bytes survive the very same window.
	const finId = hexOf(randomBytes(8))
	const finFiles = simFilesFor(STALL_TEXT, STALL_BIG)
	idleAsk('POST', '/v1/offer', offerJson(finId, finFiles, SIM_PEER_ID, SIM_NAME), idleToken2)
	resolveOffer(idle, finId, true, recvPrepare, recvDrop)
	for (let k = 0; k < finFiles.length; k++) {
		const bytes = simFileOf(finFiles[k].relpath)
		for (let c = 0; c < chunkCount(bytes.length); c++) {
			// sliceOf, not subarray: a view's .buffer is the whole file, and the kernel reads the
			// body length as the chunk length.
			idlePut('/v1/offer/' + finId + '/chunk/' + finFiles[k].id + '/' + c.toString(), idleToken2,
				sliceOf(bytes, c * CHUNK_SIZE, chunkSizeAt(bytes.length, c)))
		}
	}
	const finDone = idleAsk('POST', '/v1/offer/' + finId + '/finalize', '{}', idleToken2)
	check('停摆自检里也校验通过', finDone.status == 200 && firstVerifiedOk(finDone))
	check('校验通过的传输不再写续传台账', stateAll(idle).length == 0)
	// 同一个窗口、同一个时钟：唯一差别是这一单写完了。收满的文件必须活下来。
	const finishStallAt = nowSeconds() + OFFER_IDLE_S + 1
	seenNow(idle, simFp, finishStallAt)
	sweep(idle, finishStallAt, recvDrop, recvDigestFile)
	check('收满的文件不会被闲置回收删掉', recvStore.has(landOf(finId, STALL_TEXT)) && recvStore.has(landOf(finId, STALL_BIG)))
	// The ledger that says it is finished must never come back as something to resume - that is the
	// one shape where the reclaim above would be deleting a person's received file.
	const finishedLedger = '{"offer_id":"' + finId + '","complete":true,"files":[{"id":"f1","relpath":"' + STALL_TEXT + '","size":1,"sha256":"00","type":"text/plain","verdict":1}],"received":{},"from_name":"PC"}'
	check('写完的台账不会被当成续传接管', adoptAll(idle, [finishedLedger], nowSeconds()) == 0)

	// 14. spec §4: one offer_id is one question to the person holding this phone. The sender re-posts the
	// same manifest on purpose - a poll whose reply could not be read tries again (#96) - so every answer
	// this end gives has to outlive that re-post. Its own box, for the same reason as 5b.
	const qBox = newInbox(harnessRand)
	const qPaired = askPairOn(qBox, SIM_PEER_ID, currentPairCode(qBox, nowSeconds()), passphraseOf(qBox, nowSeconds()), simKey)
	const qObj = jsonOf(qPaired)
	const qToken = qObj == null ? '' : qObj!.getString('token', '')
	const qAsk = (text: string): WireReply => {
		return askOn(qBox, SIM_PEER_ID, 'POST', '/v1/offer', text, qToken, new ArrayBuffer(0), '')
	}
	const qId = hexOf(randomBytes(8))
	const qManifest = offerJson(qId, simFilesFor(SCRATCH_TEXT, SCRATCH_BIG), SIM_PEER_ID, SIM_NAME)
	const qFirst = qAsk(qManifest)
	const qReask = qAsk(qManifest)
	check('还挂着的那一问，重发只回"还没人决定"', qFirst.pending && qReask.pending)
	const qWaiting = snapshot(qBox, nowSeconds()).pendingOfferIds
	check('重发没有多占一个待决名额', qWaiting.length == 1 && qWaiting[0] == qId)
	const qDeclined = resolveOffer(qBox, qId, false, recvPrepare, recvDrop)
	const qAfterNo = qAsk(qManifest)
	check('答过拒绝的单，重发拿回同一句拒绝',
		codeOfReply(qDeclined) == 'DECLINED' && codeOfReply(qAfterNo) == 'DECLINED' && qAfterNo.status == 403 && !qAfterNo.pending)
	// A window that closes with nobody answering is the same refusal as far as §4 is concerned - the
	// sender's own timeout is DECLINED - so the id keeps that answer instead of opening a second window.
	const qId2 = hexOf(randomBytes(8))
	const qManifest2 = offerJson(qId2, simFilesFor(SCRATCH_TEXT, SCRATCH_BIG), SIM_PEER_ID, SIM_NAME)
	qAsk(qManifest2)
	const qLapsed = nowSeconds() + OFFER_WAIT_S + 1
	sweep(qBox, qLapsed, recvDrop, recvDigestFile)
	check('窗口到点没人答，重发不再问第二遍',
		codeOfReply(qAsk(qManifest2)) == 'DECLINED' && snapshot(qBox, qLapsed).pendingOfferIds.length == 0)
	// …and an id this end is done with because the sender cancelled it is done asking as well.
	const qId3 = hexOf(randomBytes(8))
	const qManifest3 = offerJson(qId3, simFilesFor(SCRATCH_TEXT, SCRATCH_BIG), SIM_PEER_ID, SIM_NAME)
	qAsk(qManifest3)
	resolveOffer(qBox, qId3, true, recvPrepare, recvDrop)
	askOn(qBox, SIM_PEER_ID, 'DELETE', '/v1/offer/' + qId3, '', qToken, new ArrayBuffer(0), '')
	check('对方取消过的单，重发清单不再打扰用户', codeOfReply(qAsk(qManifest3)) == 'OFFER_UNKNOWN')

	// 15. spec §1: of the five identity fields, `name` is the one the user owns. Hello answers with it, so
	// the leg that matters is not that a string got stored but that the word this device says on the wire
	// is the stored one - and that an empty attempt never reaches the storage at all.
	const helloName: () => string = (): string => {
		const said = jsonOf(ask('GET', '/v1/hello', '', new ArrayBuffer(0), ''))
		return said == null ? '' : said!.getString('name', '')
	}
	check('没改名时 hello 的名字就是这端自己的称呼', helloName() == hardwareName())
	check('空名字按规则拒掉，压根不给写', nameReject('') != '' && nameReject('   ') != '' && nameReject('小明') == '')
	check('写过的名字顶掉默认，空的才回落', nameWithDefault(' 存过的 ', '默认') == '存过的' && nameWithDefault('', '默认') == '默认')
	let savedMsg = '没听到回答'
	deviceNameSave('  小字的手机  ', function (why: string): void { savedMsg = why })
	check('改名存进去时把两端空格去掉', savedMsg == '' && helloName() == '小字的手机')
	// The suite has just renamed the device the demo screen speaks as, so the name goes back: a card below
	// this report must show the browser's own word, not a leftover from a test.
	deviceNameSave('', function (why: string): void {})
	check('改完收回，hello 又回落到这端自己的称呼', helloName() == hardwareName())

	// 16. spec §4's three replies, read as the bytes they are (#182). The paper used to show the accepted
	// manifest as `200 {"accepted": true}` and the abort as having no body at all, while this kernel answers
	// both with more than that - and the phone's own sender pushes straight from the manifest reply without
	// ever asking `GET …/state` (`cs-client.uts:610`), so "同一份 `files[]`" is what saves a round trip here
	// rather than a nicety. The half that was missing in code was the *when* of the abort: a pending offer
	// already lives in this end's inbox, so its DELETE is a withdrawal, not an unknown id, and the card has
	// to stop asking instead of allocating files for a peer that walked away.
	const replyBox = newInbox(harnessRand)
	const replyPair = askPairOn(replyBox, SIM_PEER_ID, currentPairCode(replyBox, nowSeconds()),
		passphraseOf(replyBox, nowSeconds()), simKey)
	const replyObj = jsonOf(replyPair)
	const replyToken = replyObj == null ? '' : replyObj!.getString('token', '')
	const replyOffer = (text: string): WireReply => {
		return askOn(replyBox, SIM_PEER_ID, 'POST', '/v1/offer', text, replyToken, new ArrayBuffer(0), '')
	}
	const replyTell = (method: string, path: string): WireReply => {
		return askOn(replyBox, SIM_PEER_ID, method, path, '', replyToken, new ArrayBuffer(0), '')
	}
	const waitId = hexOf(randomBytes(8))
	const waitManifest = offerJson(waitId, simFilesFor(SCRATCH_TEXT, SCRATCH_BIG), SIM_PEER_ID, SIM_NAME)
	const waitReply = replyOffer(waitManifest)
	check('§4 待决那一问不给落点：还没人点头时这一端只说「还没人决定」，一个 files[] 都不摊开',
		waitReply.pending && waitReply.body == ''
		&& snapshot(replyBox, nowSeconds()).pendingOfferIds.length == 1,
		'pending=' + waitReply.pending.toString() + ' 体=' + waitReply.body)
	const waitGone = replyTell('DELETE', '/v1/offer/' + waitId)
	const waitGoneObj = jsonOf(waitGone)
	const waitGoneKeys: string[] = waitGoneObj == null ? [] : UTSJSONObject.keys(waitGoneObj!)
	check('§4 中止覆盖还没人答的那一问：回的就是 offer_id+dropped 这两个键，卡片当场下台',
		waitGone.status == 200 && sameKeys(waitGoneKeys, ['offer_id', 'dropped'])
		&& waitGoneObj!.getBoolean('dropped', false) && waitGoneObj!.getString('offer_id', '') == waitId
		&& snapshot(replyBox, nowSeconds()).pendingOfferIds.length == 0, waitGone.body)
	const lateAccept = resolveOffer(replyBox, waitId, true, recvPrepare, recvDrop)
	check('§4 撤走之后才点下的「接受」不登记这一单，也不替它开一个文件',
		codeOfReply(lateAccept) == 'OFFER_UNKNOWN' && !recvStore.has(landOf(waitId, SCRATCH_TEXT))
		&& !recvStore.has(landOf(waitId, SCRATCH_BIG)), lateAccept.body)
	check('§4 撤走之后重投同一份清单，拿回的还是那句 OFFER_UNKNOWN',
		codeOfReply(replyOffer(waitManifest)) == 'OFFER_UNKNOWN')

	const sameFiles = simFilesFor(SCRATCH_TEXT, SCRATCH_BIG)
	const sameId = hexOf(randomBytes(8))
	replyOffer(offerJson(sameId, sameFiles, SIM_PEER_ID, SIM_NAME))
	const sameAccepted = resolveOffer(replyBox, sameId, true, recvPrepare, recvDrop)
	const sameObj = jsonOf(sameAccepted)
	const sameTop: string[] = sameObj == null ? [] : UTSJSONObject.keys(sameObj!)
	const sameList = sameObj == null ? null : sameObj!.getArray<UTSJSONObject>('files')
	const sameEntry = sameList != null && sameList!.length == 2 ? sameList![0] : null
	check('§4 接受那一条摊开就是纸上这块：顶层 offer_id+accepted+files，每条目 id/received/missing 三个数',
		sameKeys(sameTop, ['offer_id', 'accepted', 'files']) && sameEntry != null
		&& sameKeys(UTSJSONObject.keys(sameEntry!), ['id', 'received', 'missing'])
		&& sameEntry!.getString('id', '') == sameFiles[0].id
		&& sameEntry!.getNumber('received', -1) == 0 && numList(sameEntry!.getArray<number>('missing')).length > 0,
		sameTop.join(',') + ' | ' + (sameEntry == null ? '不到两条' : UTSJSONObject.keys(sameEntry!).join(',')))
	const sameState = replyTell('GET', '/v1/offer/' + sameId + '/state')
	check('§4 那句「与 GET state 同一份 files[]」在这一端也是逐字节的同一份：发送端因此一条 GET 都不用补',
		sameState.status == 200 && sameAccepted.body == sameState.body, sameState.body)
	for (let k = 0; k < sameFiles.length; k++) {
		const bytes = simFileOf(sameFiles[k].relpath)
		for (let c = 0; c < chunkCount(bytes.length); c++) {
			const part = sliceOf(bytes, c * CHUNK_SIZE, chunkSizeAt(bytes.length, c))
			askOn(replyBox, SIM_PEER_ID, 'PUT', '/v1/offer/' + sameId + '/chunk/' + sameFiles[k].id + '/' + c.toString(),
				'', replyToken, part.buffer as ArrayBuffer, hexOf(sha256Bytes(part)))
		}
	}
	const filledObj = jsonOf(replyTell('GET', '/v1/offer/' + sameId + '/state'))
	const filledList = filledObj == null ? null : filledObj!.getArray<UTSJSONObject>('files')
	const filledEntry = filledList != null && filledList!.length == 2 ? filledList![0] : null
	check('§4 落齐之后回的还是同一形状，只是那三个数换成完成后的值：missing 空、received 记满',
		filledEntry != null && numList(filledEntry!.getArray<number>('missing')).length == 0
		&& filledEntry!.getNumber('received', -1) == chunkCount(sameFiles[0].size),
		filledObj == null ? 'state 读不懂' : filledObj!.getString('accepted', 'x'))
	const filledGone = replyTell('DELETE', '/v1/offer/' + sameId)
	const filledObj2 = jsonOf(filledGone)
	const filledKeys: string[] = filledObj2 == null ? [] : UTSJSONObject.keys(filledObj2!)
	check('§4 中止：填完的一单撤掉，回的仍是那两个键',
		filledGone.status == 200 && sameKeys(filledKeys, ['offer_id', 'dropped']), filledGone.body)
	check('§4 中止：撤掉之后 state 说没有这一单，续传台账里也不再留着它',
		codeOfReply(replyTell('GET', '/v1/offer/' + sameId + '/state')) == 'OFFER_UNKNOWN'
		&& stateAll(replyBox).length == 0, '')
	check('§4 中止：撤掉之后重投同一份清单，拿的还是 OFFER_UNKNOWN 而不是重新问一遍',
		codeOfReply(replyOffer(offerJson(sameId, sameFiles, SIM_PEER_ID, SIM_NAME))) == 'OFFER_UNKNOWN')

	// 17. spec §4's chunk replies read as bytes (#183). The paper used to draw none of them: no body for the
	// `200`, no detail for either `422`, and 「最多 3 次」 for what is three writes. The kernel has always
	// answered all of it, so these legs read the exact key sets - the sentence and the bytes cannot drift.
	const ckBox = newInbox(harnessRand)
	const ckPair = jsonOf(askPairOn(ckBox, SIM_PEER_ID, currentPairCode(ckBox, nowSeconds()),
		passphraseOf(ckBox, nowSeconds()), simKey))
	const ckToken = ckPair == null ? '' : ckPair!.getString('token', '')
	const ckId = hexOf(randomBytes(8))
	const ckFiles = simFilesFor(SCRATCH_TEXT, SCRATCH_BIG)
	askOn(ckBox, SIM_PEER_ID, 'POST', '/v1/offer', offerJson(ckId, ckFiles, SIM_PEER_ID, SIM_NAME),
		ckToken, new ArrayBuffer(0), '')
	resolveOffer(ckBox, ckId, true, recvPrepare, recvDrop)
	const ckSize = ckFiles[1].size
	const ckAll = simFileOf(SCRATCH_BIG)
	const ckHead = sliceOf(ckAll, 0, chunkSizeAt(ckSize, 0))
	const ckTail = sliceOf(ckAll, CHUNK_SIZE, chunkSizeAt(ckSize, 1))
	const ckPut = (index: number, part: Uint8Array, sha: string): WireReply => {
		return askOn(ckBox, SIM_PEER_ID, 'PUT', '/v1/offer/' + ckId + '/chunk/' + ckFiles[1].id + '/' + index.toString(),
			'', ckToken, part.buffer as ArrayBuffer, sha)
	}
	const ckFirst = ckPut(0, ckHead, hexOf(sha256Bytes(ckHead)))
	const ckFirstObj = jsonOf(ckFirst)
	check('§4 一块写成的 200 摊开就是纸上这块：只有 index 与 stored 两个键',
		ckFirst.status == 200 && ckFirstObj != null && sameKeys(UTSJSONObject.keys(ckFirstObj!), ['index', 'stored'])
		&& ckFirstObj!.getNumber('index', -1) == 0 && ckFirstObj!.getBoolean('stored', false), ckFirst.body)
	const ckBefore = recvWrites
	const ckRepeat = ckPut(0, ckHead, hexOf(sha256Bytes(ckHead)))
	const ckRepeatObj = jsonOf(ckRepeat)
	check('§4 重复写入同一 index 且这一条请求整体一致：纸上多画的那一个键也在',
		ckRepeat.status == 200 && ckRepeatObj != null
		&& sameKeys(UTSJSONObject.keys(ckRepeatObj!), ['index', 'stored', 'idempotent'])
		&& ckRepeatObj!.getBoolean('idempotent', false), ckRepeat.body)
	check('§4 那一个键换来的是不重写：这一次落盘的口子压根没开', recvWrites == ckBefore,
		ckBefore.toString() + '→' + recvWrites.toString())
	const ckLied = ckPut(1, ckTail, hexOf(sha256Bytes(ckHead)))
	const ckLiedDetail = ckLied.status == 422 ? (jsonOf(ckLied) == null ? null : jsonOf(ckLied)!.getJSON('detail')) : null
	check('§4 摘要与体不符那副 detail 摊开就是纸上这块，而 expected 装的是发送方自己声明的那一份',
		ckLied.status == 422 && codeOfReply(ckLied) == 'CHUNK_DIGEST_MISMATCH' && ckLiedDetail != null
		&& sameKeys(UTSJSONObject.keys(ckLiedDetail!), ['index', 'expected'])
		&& ckLiedDetail!.getString('expected', '') == hexOf(sha256Bytes(ckHead))
		&& ckLiedDetail!.getString('expected', '') != hexOf(sha256Bytes(ckTail)), ckLied.body)
	const ckShort = ckPut(1, sliceOf(ckTail, 0, ckTail.length - 1), hexOf(sha256Bytes(ckTail)))
	const ckShortDetail = ckShort.status == 422 ? (jsonOf(ckShort) == null ? null : jsonOf(ckShort)!.getJSON('detail')) : null
	check('§4 长度不对那副 detail 摊开就是纸上这块：reason/got/want 三个键，want 是这一条该有多长',
		ckShort.status == 422 && ckShortDetail != null
		&& sameKeys(UTSJSONObject.keys(ckShortDetail!), ['reason', 'got', 'want'])
		&& ckShortDetail!.getString('reason', '') == 'length'
		&& ckShortDetail!.getNumber('got', -1) == ckTail.length - 1
		&& ckShortDetail!.getNumber('want', -1) == ckTail.length, ckShort.body)
	const ckOut = ckPut(9, ckHead, hexOf(sha256Bytes(ckHead)))
	const ckOutDetail = ckOut.status == 400 ? (jsonOf(ckOut) == null ? null : jsonOf(ckOut)!.getJSON('detail')) : null
	check('§4 序号越界是 400 BAD_CHUNK_INDEX，detail 只有 index 与 count 两个键，count 是这个文件的块数',
		ckOut.status == 400 && codeOfReply(ckOut) == 'BAD_CHUNK_INDEX' && ckOutDetail != null
		&& sameKeys(UTSJSONObject.keys(ckOutDetail!), ['index', 'count'])
		&& ckOutDetail!.getNumber('count', -1) == chunkCount(ckSize), ckOut.body)
	// 「请求头 X-Sha256 为本块摘要」说的是发送方必发，而三端的接收方都只在它非空时校验：头缺了，块级
	// 这一关就整格跳过（cs-receive.uts:1009 的 `sha != '' && sha != digest`）。下面这一腿把缺头的代价量出来：
	// 七个 `Z` 照落，唯一还说它不对的是 finalize 的整文件摘要，而摘要一推翻台账，好块陪坏块一起重报。
	// （这一腿按浏览器的清单长度放一整块 `Z`：PC 那一份实测用的七个字节，纸面引的是它。）
	const ckZeros = new Uint8Array(chunkSizeAt(ckSize, 1))
	for (let i = 0; i < ckZeros.length; i++) {
		ckZeros[i] = 90
	}
	const ckNaked = ckPut(1, ckZeros, '')
	const ckNakedObj = jsonOf(ckNaked)
	const ckLand = recvStore.get(landOf(ckId, SCRATCH_BIG))
	check('§4 不带 X-Sha256 的 PUT 照收，回的还是那两个键',
		ckNaked.status == 200 && ckNakedObj != null && sameKeys(UTSJSONObject.keys(ckNakedObj!), ['index', 'stored']),
		ckNaked.body)
	check('§4 块级校验被跳过时那一片 `Z` 真的落进偏移：落点上第 4 MiB 往后就是它们',
		ckLand != null && ckLand!.length == ckSize && ckLand![CHUNK_SIZE] == 90 && ckLand![ckSize - 1] == 90,
		ckLand == null ? '落点不在' : ckLand!.length.toString())
	const ckDone = askOn(ckBox, SIM_PEER_ID, 'POST', '/v1/offer/' + ckId + '/finalize', '{}', ckToken, new ArrayBuffer(0), '')
	const ckDoneObj = jsonOf(ckDone)
	const ckList = ckDoneObj == null ? null : ckDoneObj!.getArray<UTSJSONObject>('verified')
	let ckEntry: UTSJSONObject | null = null
	if (ckList != null) {
		for (let i = 0; i < ckList!.length; i++) {
			if (ckList![i].getString('id', '') == ckFiles[1].id) {
				ckEntry = ckList![i]
			}
		}
	}
	check('§4 这一单最后的防线是整文件摘要：它判不过，台账作废后按全缺重报，好块陪坏块一起重写',
		ckEntry != null && !ckEntry!.getBoolean('ok', true)
		&& numList(ckEntry!.getArray<number>('missing')).length == chunkCount(ckSize)
		&& ckEntry!.getString('path', '') == '', ckDone.body)

	// 18. 第十八轮巡检（#184）：§4 的保活陷阱给发送方留的那一句是「看到连接被关要重连重发一次」，而那一趟
	// 重发落在 finalize 上。PC 每一趟 finalize 都会把这一单已验过的文件重新报一次——同一个文件在「收到的
	// 文件」里多出第二行；手机这一端按落点去过重（`hasArrival`）。这一腿量的是那条去过重本身：全绿之后重投
	// finalize，清单不多一行，答复还是同一份字节。
	const rpBox = newInbox(harnessRand)
	const rpPair = jsonOf(askPairOn(rpBox, SIM_PEER_ID, currentPairCode(rpBox, nowSeconds()),
		passphraseOf(rpBox, nowSeconds()), simKey))
	const rpToken = rpPair == null ? '' : rpPair!.getString('token', '')
	const rpId = hexOf(randomBytes(8))
	const rpFiles: CsFile[] = [simFilesFor(SCRATCH_TEXT, SCRATCH_BIG)[0]]
	askOn(rpBox, SIM_PEER_ID, 'POST', '/v1/offer', offerJson(rpId, rpFiles, SIM_PEER_ID, SIM_NAME),
		rpToken, new ArrayBuffer(0), '')
	resolveOffer(rpBox, rpId, true, recvPrepare, recvDrop)
	const rpBytes = simFileOf(SCRATCH_TEXT)
	askOn(rpBox, SIM_PEER_ID, 'PUT', '/v1/offer/' + rpId + '/chunk/' + rpFiles[0].id + '/0', '', rpToken,
		rpBytes.buffer as ArrayBuffer, hexOf(sha256Bytes(rpBytes)))
	const rpFirst = askOn(rpBox, SIM_PEER_ID, 'POST', '/v1/offer/' + rpId + '/finalize', '{}', rpToken,
		new ArrayBuffer(0), '')
	const rpAgain = askOn(rpBox, SIM_PEER_ID, 'POST', '/v1/offer/' + rpId + '/finalize', '{}', rpToken,
		new ArrayBuffer(0), '')
	check('§4 全绿之后重投 finalize：这一端答的还是同一份字节，而不是「没这单」',
		rpFirst.status == 200 && rpAgain.status == 200 && rpAgain.body == rpFirst.body,
		rpFirst.status.toString() + '→' + rpAgain.status.toString() + ' | ' + rpAgain.body)
	check('§4 重投那一趟不再把同一个文件报第二遍：收到的清单只有一行',
		arrivalsAll(rpBox).length == 1, arrivalsAll(rpBox).join('、'))

	// 19. 第二十三轮巡检（#189）：§3 那句「同一来源 5 次失败锁 60s」两种读法都通——滑动窗口，或者"从被
	// 锁住那一刻起再等 60 秒"。它们在第 59 秒给出同一个答案、在第 61 秒给出相反的答案，而三端做的是前者。
	// 这一组把内核的 now 当尺子用，量那件纸面从没写下的事：拒的是次数不是码、被拒的尝试不给自己续期、
	// 密码猜错和配对码猜错共用一个桶、"来源"按地址分桶、开门那一刻由最早那一次失败决定。
	const tBox = newInbox(harnessRand)
	const tAt = nowSeconds()
	const tCode = currentPairCode(tBox, tAt)
	const tSecret = passphraseOf(tBox, tAt)
	const tWrong = tCode == '000000' ? '111111' : '000000'
	const tKey = b64(randomBytes(32))
	for (let i = 0; i < PAIR_CODE_MAX_FAILS; i++) {
		askPairAt(tBox, '203.0.113.41', tWrong, tSecret, tKey, tAt + i)
	}
	const tLocked = askPairAt(tBox, '203.0.113.41', tCode, tSecret, tKey, tAt + PAIR_CODE_LOCK_S - 1)
	check('§3 攒够 5 次以后连猜对也拒：说的是这道锁，不是码不对',
		codeOfReply(tLocked) == 'PEER_BUSY' && detailOf(tLocked.body).indexOf('too many failed codes') >= 0,
		codeOfReply(tLocked) + ' ' + detailOf(tLocked.body))
	for (let i = 0; i < 3; i++) {
		askPairAt(tBox, '203.0.113.41', tCode, tSecret, tKey, tAt + PAIR_CODE_LOCK_S - 1)
	}
	check('§3 被锁住期间的尝试不往清单里添记录：砸得再多也不会把这道锁推远',
		failsOf(tBox, '203.0.113.41') == PAIR_CODE_MAX_FAILS, failsOf(tBox, '203.0.113.41').toString())
	// 五次失败各隔一秒摊开，于是门该在第 61 秒开：最早那一条满 60 秒。要是这句读成"从被锁住那一次
	// （第 5 秒）起算 60 秒"，第 61 秒还差 4 秒——同一次问答把两种读法分开。
	const tOpen = askPairAt(tBox, '203.0.113.41', tCode, tSecret, tKey, tAt + PAIR_CODE_LOCK_S + 1)
	const tOpenObj = jsonOf(tOpen)
	check('§3 门在第 61 秒开：60 秒从最早那一次失败起算，不是从被锁住那一刻起算',
		tOpenObj != null && tOpenObj!.getString('token', '') != '', tOpen.body)

	const uBox = newInbox(harnessRand)
	const uAt = nowSeconds()
	const uCode = currentPairCode(uBox, uAt)
	const uSecret = passphraseOf(uBox, uAt)
	const uWrong = uCode == '000000' ? '111111' : '000000'
	const uWrongSecret = '!' + uSecret.substring(0, PASSPHRASE_CHARS - 1)
	askPairAt(uBox, '203.0.113.42', uWrong, uSecret, b64(randomBytes(32)), uAt)
	askPairAt(uBox, '203.0.113.42', uCode, uWrongSecret, b64(randomBytes(32)), uAt)
	askPairAt(uBox, '203.0.113.42', uWrong, uSecret, b64(randomBytes(32)), uAt)
	askPairAt(uBox, '203.0.113.42', uCode, uWrongSecret, b64(randomBytes(32)), uAt)
	askPairAt(uBox, '203.0.113.42', uWrong, uSecret, b64(randomBytes(32)), uAt)
	const uFifth = askPairAt(uBox, '203.0.113.42', uCode, uSecret, b64(randomBytes(32)), uAt)
	check('§3 密码猜错和配对码猜错记在同一桶里：三次码错加两次密码错，第六次猜全也拒',
		codeOfReply(uFifth) == 'PEER_BUSY' && detailOf(uFifth.body).indexOf('too many failed codes') >= 0,
		failsOf(uBox, '203.0.113.42').toString() + ' ' + detailOf(uFifth.body))
	const uOther = askPairAt(uBox, '203.0.113.43', uCode, uSecret, b64(randomBytes(32)), uAt)
	const uOtherObj = jsonOf(uOther)
	check('§3 「来源」按地址分桶：这一路锁着，另一路照样进',
		uOtherObj != null && uOtherObj!.getString('token', '') != '' && failsOf(uBox, '203.0.113.43') == 0,
		uOther.body)

	// 20. 第二十四轮巡检（#190）：§3 那两句只写了「随机」，而 PC 的三个数一直出自 `secrets`，手机的三个
	// 出自共用内核的 `Math.random()`。这一轮把源交到宿主手里，于是这一组量的不是分布——是把内核的源换成
	// 一只假手，看那三个数跟不跟着变。三样都跟着变，才说明它们真的出自那一个源；不跟着变的，是内核自己
	// 另铸了一份。除不尽要丢哪几个字节（250 以上）也在这组里，因为那五个字节直接决定答案是 `123456`
	// 还是取模糊出来的 `012345`。
	const srcBox = newInbox(scriptedRand)
	const srcAt = nowSeconds()
	const srcCode = currentPairCode(srcBox, srcAt)
	const srcSecret = passphraseOf(srcBox, srcAt)
	const srcPair = askPairAt(srcBox, '203.0.113.44', srcCode, srcSecret, b64(randomBytes(32)), srcAt)
	const srcObj = jsonOf(srcPair)
	const srcToken = srcObj == null ? '' : srcObj!.getString('token', '')
	check('§3 码、密码、token 三样都出自宿主递进来的那一个源：假源给什么就是什么',
		srcCode == '012345' && srcSecret == 'LMNPQRST' && srcToken == SCRIPTED_HEX,
		srcCode + '/' + srcSecret + '/' + srcToken.length.toString())

	const dropCode = currentPairCode(newInbox(droppedRand), nowSeconds())
	check('§3 一个字节除不尽 10：`fa`..`fe` 那五个丢掉再抽下一个，不是拿 250 取模',
		dropCode == '123456', dropCode)
	const keepSecret = passphraseOf(newInbox(dropped16Rand), nowSeconds())
	check('§3 除得尽就一个字节也不浪费：32 个字母的密码把那十六个字节全用完',
		keepSecret == '45678BCD', keepSecret)
	const bareBox = newInbox(emptyRand)
	check('§3 没装源的收件箱不发证：它答空的，而不是一个看着正常的 000000',
		currentPairCode(bareBox, nowSeconds()) == '' && passphraseOf(bareBox, nowSeconds()) == '')

	const liveA = newInbox(harnessRand)
	const liveB = newInbox(harnessRand)
	const liveAt = nowSeconds()
	const liveCodeA = currentPairCode(liveA, liveAt)
	const liveCodeB = currentPairCode(liveB, liveAt)
	const livePair = askPairAt(liveA, '203.0.113.45', liveCodeA, passphraseOf(liveA, liveAt), b64(randomBytes(32)), liveAt)
	const liveObj = jsonOf(livePair)
	const liveToken = liveObj == null ? '' : liveObj!.getString('token', '')
	check('§3 换成真源：两台各铸各的 6 位码，token 是 32 字节的十六进制',
		liveCodeA.length == PAIR_CODE_DIGITS && liveCodeA != liveCodeB && isFullFingerprint(liveToken),
		liveCodeA + '/' + liveCodeB + '/' + liveToken.length.toString())

	// 21. 第二十五轮巡检（#191）：§3 那半句原本写的是「且只在局域网内可达时开放」，读起来像一道按地址段的
	// 门，而三端一处都没有——内核的 `client` 只是一个字符串，谁也没看过它落在哪个网段。这一组只有这一档能跑：
	// 真机的套接字报不出「不是局域网的那个地址」，而这里可以直接喂。第一趟是全新的配对（码与密码都照查），
	// 后三趟走的是已经钉过那一路，量的不是重放，是同一个对端换个来源地址进来答案不变。
	const scopeBox = newInbox(harnessRand)
	const scopeAt = nowSeconds()
	const scopeCode = currentPairCode(scopeBox, scopeAt)
	const scopeSecret = passphraseOf(scopeBox, scopeAt)
	const scopeKey = b64(randomBytes(32))
	const scopeOutsider = askPairAt(scopeBox, '203.0.113.50', scopeCode, scopeSecret, scopeKey, scopeAt)
	const scopeOutsiderObj = jsonOf(scopeOutsider)
	check('§3 来源不是一个网段判据：TEST-NET 那个地址带着全对的码与密码拿到 token',
		scopeOutsiderObj != null && scopeOutsiderObj!.getString('token', '') != '', scopeOutsider.body)
	const scopeLoop = askPairAt(scopeBox, '127.0.0.1', scopeCode, scopeSecret, scopeKey, scopeAt)
	const scopeLoopObj = jsonOf(scopeLoop)
	const scopeForwarded = askPairAt(scopeBox, '10.0.2.2', scopeCode, scopeSecret, scopeKey, scopeAt)
	const scopeForwardedObj = jsonOf(scopeForwarded)
	const scopeBlind = askPairAt(scopeBox, '?', scopeCode, scopeSecret, scopeKey, scopeAt)
	const scopeBlindObj = jsonOf(scopeBlind)
	check('§3 环回、端口转发与读不到地址那一格的答案与网段内完全一样：#149/#154 那两条腿靠的就是这一句',
		scopeLoopObj != null && scopeLoopObj!.getString('token', '') != ''
		&& scopeForwardedObj != null && scopeForwardedObj!.getString('token', '') != ''
		&& scopeBlindObj != null && scopeBlindObj!.getString('token', '') != '',
		scopeLoop.body + '|' + scopeForwarded.body + '|' + scopeBlind.body)

	// 22. 第二十六轮巡检（#192）：§3 那两个可选键的「没有它」——纸面原本写「按请求体里有没有这个键」，PC 的密码
	// 那一格也真就判的是键在不在，而共用内核从第一天起判的是这一格空不空。于是同一条 `{"secret": null}` 在两端
	// 答相反（本轮把 PC 改成与内核一致）。这一组只有这一档能喂出那种体：我们自己的发送方永远省略空值，
	// `pairJson` 造不出 null，所以这里把那一格直接贴上线。每一趟一个新收件箱——第一次配对成功就把单会话名额占了，
	// 下一趟换一把钥匙进来只会撞到 PEER_BUSY，那量的就不是这一格了。
	const optAt = nowSeconds()
	const optBoxA = newInbox(harnessRand)
	const optBoxB = newInbox(harnessRand)
	const optBoxC = newInbox(harnessRand)
	const optBoxD = newInbox(harnessRand)
	const optBoxE = newInbox(harnessRand)
	const optKeyA = b64(randomBytes(32))
	const optKeyB = b64(randomBytes(32))
	const optKeyC = b64(randomBytes(32))
	const optKeyD = b64(randomBytes(32))
	const optKeyE = b64(randomBytes(32))
	const optOmit = askPairRawAt(optBoxA, '203.0.113.60',
		pairBodySlots(optKeyA, currentPairCode(optBoxA, optAt), '', ''), optAt)
	const optNull = askPairRawAt(optBoxB, '203.0.113.61',
		pairBodySlots(optKeyB, currentPairCode(optBoxB, optAt), 'null', ''), optAt)
	const optOmitObj = jsonOf(optOmit)
	const optNullObj = jsonOf(optNull)
	check('§3 这一格的 null 算没有它：密码那一节省略与写成 null，内核答的是同一句「只靠码配上」',
		optOmitObj != null && optOmitObj!.getString('token', '') != ''
		&& optNullObj != null && optNullObj!.getString('token', '') != ''
		&& failsOf(optBoxB, '203.0.113.61') == 0,
		optOmit.body + '|' + optNull.body)
	const optBlank = askPairRawAt(optBoxC, '203.0.113.62',
		pairBodySlots(optKeyC, currentPairCode(optBoxC, optAt), '""', ''), optAt)
	const optBlankObj = jsonOf(optBlank)
	const optBlankDetail = optBlankObj == null ? null : optBlankObj!.getJSON('detail')
	const optAfterBlank = askPairRawAt(optBoxC, '203.0.113.62',
		pairBodySlots(optKeyC, currentPairCode(optBoxC, optAt), 'null', ''), optAt)
	const optAfterBlankObj = jsonOf(optAfterBlank)
	check('§3 空串不是没有它：那一格写空串答 passphrase、并往这个来源的桶里记一次，随后写 null 照样配上',
		optBlankObj != null && optBlankObj!.getString('code', '') == 'BAD_PAIR_CODE'
		&& optBlankDetail != null && optBlankDetail!.getString('reason', '') == 'passphrase'
		&& failsOf(optBoxC, '203.0.113.62') == 1
		&& optAfterBlankObj != null && optAfterBlankObj!.getString('token', '') != '',
		optBlank.body + ' | 桶 ' + failsOf(optBoxC, '203.0.113.62').toString() + ' | ' + optAfterBlank.body)
	const optLeafNull = askPairRawAt(optBoxD, '203.0.113.63',
		pairBodySlots(optKeyD, currentPairCode(optBoxD, optAt), '', 'null'), optAt)
	const optLeafBlank = askPairRawAt(optBoxE, '203.0.113.64',
		pairBodySlots(optKeyE, currentPairCode(optBoxE, optAt), '', '""'), optAt)
	const optLeafNullObj = jsonOf(optLeafNull)
	const optLeafBlankObj = jsonOf(optLeafBlank)
	check('§3 这一格空不空那一读法也管叶指纹：null 与空串都算「我的叶就是签名的这把钥匙」，三段前像配上',
		optLeafNullObj != null && optLeafNullObj!.getString('token', '') != ''
		&& optLeafBlankObj != null && optLeafBlankObj!.getString('token', '') != '',
		optLeafNull.body + '|' + optLeafBlank.body)

	// 23. 第二十七轮巡检（#193）：§3 那三条把名额还给下一台的路，手机这一半原本只有闲置那一条走得通。
	// 「持有方点断开」与「不再监听」这两条本轮才进内核（releaseSession / releaseSessions），量的就是这一份：
	// 一次收回这台对端占着的两半、旧 token 立刻不算话、而信任那一份纹丝不动。
	const rel = newInbox(harnessRand)
	const relAt = nowSeconds()
	const relCode = currentPairCode(rel, relAt)
	const relSecret = passphraseOf(rel, relAt)
	const relKeyA = b64(randomBytes(32))
	const relKeyB = b64(randomBytes(32))
	const relFpA = recvKeyFp(relKeyA)
	const relFpB = recvKeyFp(relKeyB)
	const relPairA = askPairAt(rel, '203.0.113.70', relCode, relSecret, relKeyA, relAt)
	const relPairAObj = jsonOf(relPairA)
	const relTokenA = relPairAObj == null ? '' : relPairAObj!.getString('token', '')
	const relBusyB = askPairAt(rel, '203.0.113.71', relCode, relSecret, relKeyB, relAt)
	check('§3 释放自检摆好格子：这台对端占着名额时第二台只会拿到 PEER_BUSY',
		relTokenA != '' && relFpA != '' && codeOfReply(relBusyB) == 'PEER_BUSY', relBusyB.body)
	holdSlotFor(rel, relFpB, relAt)
	check('§3 一台手机的两半都在同一格名单里：对方拨进来那枚 token 与本机拨出去那一格',
		activePeers(rel).length == 2, activePeers(rel).join(','))
	const relGaveB = releaseSession(rel, relFpB)
	check('§3 本机拨出去那一半也算占着名额：断开它答 true，别人那一格不动',
		relGaveB && activePeers(rel).length == 1 && activePeers(rel)[0] == relFpA,
		relGaveB.toString() + '|' + activePeers(rel).join(','))
	const relMiss = releaseSession(rel, recvKeyFp(b64(randomBytes(32))))
	check('§3 没占着名额的那一台答 false：不顺手把别人的会话一起清掉',
		relMiss == false && activePeers(rel).length == 1, relMiss.toString())
	const relGaveA = releaseSession(rel, relFpA)
	const relStillTrusted = rel.trusted.length
	check('§3 持有方点「断开」这一趟：那枚 token 按名字收回，名额空了而信任那一份没动',
		relGaveA && rel.tokens.length == 0 && activePeers(rel).length == 0 && relStillTrusted > 0,
		relGaveA.toString() + '|' + rel.tokens.length.toString() + '|' + relStillTrusted.toString())
	const relOldToken = askOn(rel, SIM_PEER_ID, 'GET', '/v1/offer/x/state', '', relTokenA, new ArrayBuffer(0), '')
	check('§3 被请出去的那台带旧 token 再请求吃 NOT_PAIRED（它自己会留空码重配对，用户看不见这一句）',
		codeOfReply(relOldToken) == 'NOT_PAIRED', relOldToken.body)
	const relRepair = askPairAt(rel, '203.0.113.70', '', '', relKeyA, relAt)
	const relRepairObj = jsonOf(relRepair)
	check('§3 释放不等于撤销：这台对端留空配对码、只靠签名就配回来，resumed 为真',
		relRepair.status == 200 && relRepairObj != null && relRepairObj!.getBoolean('resumed', false),
		relRepair.status.toString() + '|' + relRepair.body)
	holdSlotFor(rel, relFpB, relAt)
	const relTakenAll = releaseSessions(rel)
	const relNext = askPairAt(rel, '203.0.113.71', relCode, relSecret, relKeyB, relAt)
	const relNextObj = jsonOf(relNext)
	check('§3 「不再监听」按名字一次请走两半：名额空了，下一台这才配得上',
		relTakenAll == 2 && activePeers(rel).length == 0
		&& relNextObj != null && relNextObj!.getString('token', '') != '',
		relTakenAll.toString() + '|' + relNext.body)

	// 24. 第二十八轮巡检（#194）：§3 末尾那句「本机拨出去的那台由发起方自己计时，超时同样登记为已断开」。
	// 计时这一半本来就打得动（`seenNow` 也刷拨出去那一格），本轮量的是「登记」：内核原来只往快照里写一个
	// 名字，而本机只拨出去过的对端在收件箱里压根没有固定项，`nameFor` 只能回「对端 <fp8>…」；页面那句
	// 比的是 hello 里对端自报的名字。两串字对不上，名额早收走了、发送那张卡还挂着「已连接」。
	// 所以内核现在把收回的那一台的指纹也写进快照，登记按指纹问。
	const outBox = newInbox(harnessRand)
	const outAt = nowSeconds()
	const outFp = recvKeyFp(b64(randomBytes(32)))
	holdSlotFor(outBox, outFp, outAt)
	const outBusy = askPairAt(outBox, '203.0.113.80', currentPairCode(outBox, outAt), passphraseOf(outBox, outAt), b64(randomBytes(32)), outAt)
	check('§3 只拨出去过的那台也算占着名额：第三方拨进来只吃到 PEER_BUSY，而这一格没有 token',
		activePeers(outBox).length == 1 && activePeers(outBox)[0] == outFp && outBox.tokens.length == 0
		&& codeOfReply(outBusy) == 'PEER_BUSY',
		activePeers(outBox).join(',') + '|' + outBusy.body)
	seenNow(outBox, outFp, outAt + SESSION_IDLE_S - 5)
	const outEarly = sweep(outBox, outAt + SESSION_IDLE_S, recvDrop, recvDigestFile)
	check('§3 发起方自己的心跳就是这一格的动静：窗口还差五秒时一次 sweep 不收它',
		outEarly.length == 0 && activePeers(outBox).length == 1,
		outEarly.join(',') + '|' + activePeers(outBox).join(','))
	const outLate = sweep(outBox, outAt + 2 * SESSION_IDLE_S, recvDrop, recvDigestFile)
	const outSnap = snapshot(outBox, outAt + 2 * SESSION_IDLE_S)
	check('§3 沉默满窗口后收回这一格，并且说得出收回的是哪一台——按指纹',
		outLate.length == 1 && outLate[0] == outFp && outSnap.lostFp == outFp,
		outLate.join(',') + '|' + outSnap.lostFp)
	check('§3 同一趟的名字量不出这件事：这台对端在收件箱里没有固定项，名字只能是「对端 <fp8>…」那一格兜底',
		outSnap.lostName != SIM_NAME && outSnap.lostName.indexOf('对端 ') == 0 && outBox.trusted.length == 0,
		outSnap.lostName)
	holdSlotFor(outBox, outFp, outAt)
	const outAgain = snapshot(outBox, outAt)
	check('§3 下一次拨出把这一格清干净：登记是一次性的，不替后来的会话说话',
		outAgain.lostFp == '' && outAgain.lostName == '', outAgain.lostFp + '|' + outAgain.lostName)

	out.push(fail == 0 ? '接收自检 ' + pass.toString() + ' 项全部通过' : '接收自检失败 ' + fail.toString() + ' 项，通过 ' + pass.toString() + ' 项')
	return out.join('\n')
}

/* ================================================== sender self-check (#132) */

/** A peer that eats the answer to one chunk write. Three ways to eat it, and the difference is the whole
 *  point of this suite: `peerBlind` also keeps the bytes away from the peer, which turns "the reply
 *  died" into "the body died", and `muteState` takes the sender's only way of telling those apart away
 *  from it. Only the sender's own `GET /state` can read the peer's ledger, so the legs below are
 *  distinguished by *what the sender does after it asks*, not by the error text.
 *
 *  A counter object rather than captured locals: Kotlin forbids a closure mutating a local `let`. */
class ChunkSwallow {
	inbox: Inbox = newInbox(harnessRand)
	/** Which chunk write (1-based) loses its reply; -1 eats every one, 0 eats none. */
	nth: number = 0
	peerBlind: boolean = false
	/** How many `GET /state` questions this peer refuses to answer. Spec §4's third rule is about this
	 *  shape - 问不到答案 - and it is the one leg the phones have evidence for and the browser did not. */
	muteState: number = 0
	/** How many answers to the *manifest* this peer takes back after registering it. Spec §4 ends the
	 *  offer poll on 答案出现 or 等满 `offer_wait_timeout_s`, and a reply that never arrived is neither -
	 *  this end was not refused, it was not heard from. */
	muteOffer: number = 0
	/** How many POST /v1/offer lines this peer was shown. The retry leg below reads it: a manifest re-sent
	 *  after an eaten answer is the same offer, and the count is what says so. */
	offerAsks: number = 0
	/** How many answers to `finalize` this peer takes back after verifying the bytes. Spec §4's keep-alive
	 *  trap ends with 发送方看到连接被关要重连重发一次, and the request that resend reaches is this one:
	 *  a verify answer that never arrived is the same "not heard from" as a swallowed manifest. */
	muteFinalize: number = 0
	/** How many POST .../finalize lines this peer was shown. The count that tells a single re-ask from a
	 *  loop - and the witness that the second pass lives on a timer, not inside this synchronous report. */
	finalizeAsks: number = 0
	/** Replace the version set this peer answers its hello with. `[]` is not an empty set - it is a peer
	 *  that predates the field, so §7 has to read the number it printed instead. spec §7's two directions
	 *  are what the two legs below measure. */
	helloVersions: number[] | null = null
	/** After how many served chunk writes this peer's disk loses the whole file. Spec §4's retry clause
	 *  is read from the `finalize` answer's `missing`, and the only way to make that list non-empty without
	 *  a lost write is a ledger the whole-file read then denies. */
	eraseAfter: number = 0
	eraseRel: string = ''
	/** How many chunk writes this peer refuses with spec §4's `422 CHUNK_DIGEST_MISMATCH` without ever
	 *  serving the bytes (`99` = every one). A peer that answers no to each write is the only way this tier
	 *  can count the shared sender's write budget: §4's 「最多 3 次」 is three *writes*, while the phone's
	 *  own constant spells the same number as two *resends* (`CHUNK_RESEND_MAX`). */
	rejectChunks: number = 0
	/** The offer id inside the manifest this peer was shown - the prefix the landing sits under. */
	offerId: string = ''
	chunksSeen: number = 0
	stateAsks: number = 0
	/** How many request lines this peer was actually shown. A transport that refused the certificate never
	 *  got that far, so the §2 leg below reads this rather than trusting a sentence about order. */
	hellosSeen: number = 0
}

class SenderRun {
	/** connectPeer's session, and where the send ended up. */
	session: PeerSession | null = null
	done: boolean = false
	ok: boolean = false
	summary: string = ''
}

function swallowed(reason: string): string {
	const detail = new UTSJSONObject()
	detail['reason'] = reason
	const out = new UTSJSONObject()
	out['code'] = 'CONN_RESET'
	out['detail'] = detail
	return JSON.stringify(out)
}

function swallowCaller(probe: ChunkSwallow): Caller {
	return (method: string, path: string, jsonBody: string, token: string, body: ArrayBuffer, sha: string, escape: string, cb: ReplyCallback): void => {
		const isChunk = method == 'PUT' && path.indexOf('/chunk/') >= 0
		if (method == 'GET' && path == '/v1/hello') {
			probe.hellosSeen = probe.hellosSeen + 1
		}
		const eat = isChunk && (probe.nth == -1 || probe.chunksSeen + 1 == probe.nth)
		if (isChunk) {
			probe.chunksSeen = probe.chunksSeen + 1
		}
		if (isChunk && probe.rejectChunks > 0) {
			probe.rejectChunks = probe.rejectChunks - 1
			// The refusal §4 draws, with the shape the kernels answer in: `{index, expected}`, and
			// `expected` is the digest the sender itself declared. The bytes are never served.
			const saidDetail = new UTSJSONObject()
			saidDetail['index'] = probe.chunksSeen
			saidDetail['expected'] = sha
			const saidCode = new UTSJSONObject()
			saidCode['code'] = 'CHUNK_DIGEST_MISMATCH'
			saidCode['detail'] = saidDetail
			cb(422, JSON.stringify(saidCode))
			return
		}
		const isOffer = method == 'POST' && path == '/v1/offer'
		if (isOffer) {
			probe.offerAsks = probe.offerAsks + 1
			const announced = parseJson(jsonBody)
			if (announced != null) {
				probe.offerId = announced!.getString('offer_id', '')
			}
		}
		const isFinalize = method == 'POST' && path.indexOf('/finalize') >= 0
		if (isFinalize) {
			probe.finalizeAsks = probe.finalizeAsks + 1
		}
		if (method == 'GET' && path.indexOf('/state') >= 0) {
			probe.stateAsks = probe.stateAsks + 1
			if (probe.muteState > 0) {
				probe.muteState = probe.muteState - 1
				cb(0, swallowed('自检注入：发送方来问这一块的账，这一问本机也不答'))
				return
			}
		}
		if (eat && probe.peerBlind) {
			// Not even a request: the peer never learns these bytes existed.
			cb(0, swallowed('自检注入：这一块没到对端，回复也没回来'))
			return
		}
		const reply = askOn(probe.inbox, SIM_PEER_ID, method, path, jsonBody, token, unescapeChunk(body, escape), sha)
		if (isChunk && probe.eraseAfter > 0 && probe.chunksSeen == probe.eraseAfter && probe.offerId != '' && probe.eraseRel != '') {
			// Served, ledgered, and then the bytes walk away underneath it: the next whole-file read is
			// the only thing that can say so, and what it says is spec §4's `missing`.
			recvDrop(landOf(probe.offerId, probe.eraseRel))
		}
		if (!reply.pending) {
			if (probe.helloVersions != null && method == 'GET' && path == '/v1/hello') {
				// The peer answers with its own set replaced, which is the only way to reach §7 from
				// this side without a second device.
				const said = parseJson(reply.body)
				if (said != null) {
					said!.set('compatible_versions', probe.helloVersions!)
					cb(reply.status, JSON.stringify(said))
					return
				}
			}
			if (eat) {
				// The bytes were served and stored; only the answer is taken back.
				cb(0, swallowed('自检注入：体已落对端，回复被吞掉'))
				return
			}
			if (isOffer && probe.muteOffer > 0) {
				probe.muteOffer = probe.muteOffer - 1
				cb(0, swallowed('自检注入：清单已登记，这一问的回复被吞掉'))
				return
			}
			if (isFinalize && probe.muteFinalize > 0) {
				// Verified and written down on this side; only the answer died on the way back.
				probe.muteFinalize = probe.muteFinalize - 1
				cb(0, swallowed('自检注入：字节都验过了，这一问的回复被吞掉'))
				return
			}
			cb(reply.status, reply.body)
			return
		}
		// The offer is the only request that can await a person. This peer answers on the spot - the
		// legs below are about the chunk writes that come after the decision.
		const parsed = parseJson(jsonBody)
		const offerId = parsed == null ? '' : parsed!.getString('offer_id', '')
		const decided = resolveOffer(probe.inbox, offerId, true, recvPrepare, recvDrop)
		if (isOffer && probe.muteOffer > 0) {
			// Registered, decided, and the answer died on the way back: the sender has not been refused.
			probe.muteOffer = probe.muteOffer - 1
			cb(0, swallowed('自检注入：清单已登记并有人答了，这一问的回复被吞掉'))
			return
		}
		cb(decided.status, decided.body)
	}
}

/** The harness's stand-in for the socket, and the only place a browser can refuse a certificate: the
 *  announced prefix is weighed here, before the request line reaches the peer, exactly as the phones'
 *  TLS trust managers weigh it (`pinAccepts`, spec §2's 核对发生在套接字上). What the legs below then
 *  measure is what the shared client does with a connection that never opened - `hellosSeen` is the
 *  witness that the peer was not even asked. */
function pinnedCaller(probe: ChunkSwallow, pin: string): Caller {
	const wire = swallowCaller(probe)
	return (method: string, path: string, jsonBody: string, token: string, body: ArrayBuffer, sha: string, escape: string, cb: ReplyCallback): void => {
		if (!pinAccepts(pin, myFp)) {
			failure('TLS_PIN_MISMATCH', { expected: pin, got: myFp } as UTSJSONObject, 0, cb)
			return
		}
		wire(method, path, jsonBody, token, body, sha, escape, cb)
	}
}

const noopWrite: Writer = (line: string): void => {}
const noopProgress: ProgressCallback = (done: number, total: number): void => {}
const noopFileEvent: FileEvent = (relpath: string, status: string, done: number, total: number): void => {}

/** One send through the real client, from pairing to finalize. Everything this harness injects answers
 *  inline, so a leg is over when this returns.
 *
 *  `pinPrefix` is what a candidate announced (spec §2): '' stands for a hand-typed address, and a
 *  mismatching one has to stop the run where the contract puts the check - on the connection, before the
 *  peer is shown a request line and long before this end spends a pair on it. */
function runSender(probe: ChunkSwallow, relpath: string, run: SenderRun, pinPrefix: string): void {
	const call = pinnedCaller(probe, pinPrefix)
	const link = new TransferOptions()
	link.host = '自检对端'
	link.port = TRANSPORT_PORT
	link.pinPrefix = pinPrefix
	link.code = currentPairCode(probe.inbox, nowSeconds())
	link.secret = passphraseOf(probe.inbox, nowSeconds())
	connectPeer(link, simTakeSelf, simSignPair, call, noopWrite, function (ok: boolean, message: string, session: PeerSession | null): void {
		if (ok && session != null) {
			run.session = session
			return
		}
		run.done = true
		run.summary = '配对没成：' + message
	})
	const session = run.session
	if (session == null) {
		return
	}
	const opts = new TransferOptions()
	opts.host = link.host
	opts.port = link.port
	opts.paths = [relpath]
	opts.relpaths = [relpath]
	sendFiles(session, opts, simTakeSelf, simSignPair, call, simPrepareFile, simReadChunk, simDigestHex,
		noopWrite, noopProgress, noopFileEvent, function (ok: boolean, summary: string): void {
			run.done = true
			run.ok = ok
			run.summary = summary
		})
}

/** The 发送半边 of the self-test: spec §4's recovery rules (#120, #130) run against a peer that
 *  swallows a chunk reply, so the branch the phones share is measured rather than read. */
export function senderSelfReport(): string {
	const out: string[] = []
	let pass = 0
	let fail = 0
	const check = (label: string, ok: boolean, extra: string): void => {
		if (ok) {
			pass = pass + 1
			out.push('通过 · ' + label)
		} else {
			fail = fail + 1
			out.push('不符 · ' + label + '：' + extra)
		}
	}
	// '大块' is what makes the browser's stand-in file two chunks, so the first one can be lost.
	const big = '自检大块.bin'

	// A. body landed, reply eaten (spec §4: 回复没来不等于体没到).
	const a = new ChunkSwallow()
	a.nth = 1
	const ra = new SenderRun()
	runSender(a, big, ra, '')
	check('吞掉第一块的回复后这单仍然传成', ra.done && ra.ok, ra.summary)
	check('它为那块问过对方一次', a.stateAsks == 1, a.stateAsks.toString())
	// Two writes, one per chunk: the eaten reply did not cost a rewrite.
	check('那块没有重写：对端只收到两次写块', a.chunksSeen == 2, a.chunksSeen.toString())
	check('吞回复这单整文件摘要对上了（落到收到清单）', arrivalsAll(a.inbox).length == 1, arrivalsAll(a.inbox).join('、'))

	// B. reply eaten *and* the bytes never arrived: the peer's answer says "not there", so the only
	// honest reading is a hiccup, and the chunk goes again on what is left of the budget (#130).
	const b = new ChunkSwallow()
	b.nth = 1
	b.peerBlind = true
	const rb = new SenderRun()
	runSender(b, big, rb, '')
	check('对方说没到，这一块重写后这单传成', rb.done && rb.ok, rb.summary)
	check('重写它也只问过对方一次', b.stateAsks == 1, b.stateAsks.toString())
	// Three writes: the blind one, the rewrite, then the second chunk.
	check('缺的那块重写了一次', b.chunksSeen == 3, b.chunksSeen.toString())

	// C. a relay that eats every answer: the budget is what ends this, not a hang and not a loop.
	const c = new ChunkSwallow()
	c.nth = -1
	c.peerBlind = true
	const rc = new SenderRun()
	runSender(c, big, rc, '')
	check('每次都吞掉回复时这单判死', rc.done && !rc.ok, rc.summary)
	// Three writes (spec §4) and one question after each of them: the third answer is the one that says stop.
	check('判死前只写了三次就收手', c.chunksSeen == 3 && c.stateAsks == 3, c.chunksSeen.toString() + '/' + c.stateAsks.toString())
	check('报出去的是那次的真实原因', rc.summary.indexOf('CONN_RESET') >= 0 || rc.summary.indexOf('自检注入') >= 0, rc.summary)

	// D. the body dies *and* the question about it dies too: 问不到答案 is spec §4's third shape, and the
	// honest reading of it is one write and that question's own error - not a rewrite, not the PUT's error.
	const d = new ChunkSwallow()
	d.nth = 1
	d.peerBlind = true
	d.muteState = 1
	const rd = new SenderRun()
	runSender(d, big, rd, '')
	check('那一问也没人答时这单判死', rd.done && !rd.ok, rd.summary)
	check('判死前只问过对方一次', d.stateAsks == 1, d.stateAsks.toString())
	check('问不到答案就不重写：对端只收到一次写块', d.chunksSeen == 1, d.chunksSeen.toString())
	check('报出去的是那一问的错，不是写块自己的错', rd.summary.indexOf('这一问') >= 0, rd.summary)

	// E. spec §2's order and its place: 收到候选后必须先核对前缀再进入 §3 配对, and the 核对 happens on the
	// connection. `pinnedCaller` is this harness's stand-in for the phone's TLS trust manager, so
	// `hellosSeen` is the witness below - a candidate whose announced prefix does not describe the
	// certificate was never even asked. A pair therefore never reaches it, never pins a stranger, and never
	// takes the single session slot the real peer needs (#142 weighed the peer's own sentence about itself
	// in the hello; #150 moved both the number and the place).
	ensureSelf()
	const promised = prefixOf(myFp)
	const e = new ChunkSwallow()
	const re = new SenderRun()
	runSender(e, SIM_TEXT, re, promised)
	check('对得上广播前缀的候选照常配对传成', re.done && re.ok, re.summary)
	check('那一条的钉一路带到写块', e.hellosSeen == 1, e.hellosSeen.toString())
	const f = new ChunkSwallow()
	const rf = new SenderRun()
	runSender(f, SIM_TEXT, rf, 'deadbeefdeadbeef')
	check('前缀对不上时这一单判死', rf.done && !rf.ok, rf.summary)
	check('说的是证书与钉不符，不是配对码的事', rf.summary.indexOf('不符') >= 0, rf.summary)
	check('那一单连 hello 都没打到对方', f.hellosSeen == 0, f.hellosSeen.toString())
	check('那一单一次 pair 都没打到对方的名单上', f.inbox.trusted.length == 0, f.inbox.trusted.length.toString())
	const full = new ChunkSwallow()
	const rfull = new SenderRun()
	runSender(full, SIM_TEXT, rfull, myFp)
	check('二维码那种整摘要的钉照常放行', rfull.done && rfull.ok, rfull.summary)

	// F. spec §7 has two directions, and this end used to ask only one of them. A peer that prints our
	// version while saying it speaks only another set must be refused at the hello; a peer that names no
	// set at all is one that predates the field, and refusing it would turn every older device into a
	// stranger - the number it printed is then the whole set.
	const g = new ChunkSwallow()
	const noSetAtAll: number[] = []
	g.helloVersions = noSetAtAll
	const rg = new SenderRun()
	runSender(g, SIM_TEXT, rg, '')
	check('对端没报版本集合时按它印出的那一个数判，照常传成', rg.done && rg.ok, rg.summary)
	const h = new ChunkSwallow()
	h.helloVersions = [2]
	const rh = new SenderRun()
	runSender(h, SIM_TEXT, rh, '')
	check('对端报的版本集合里没有我们这一版时在 hello 就停', rh.done && !rh.ok, rh.summary)
	check('那一单也没打到对方的名单上', h.inbox.trusted.length == 0, h.inbox.trusted.length.toString())

	// G. spec §4's offer window ends on two facts only - 答案出现, or 等满 `offer_wait_timeout_s`. A poll whose
	// reply never arrived is neither: this end was not refused, it was not heard from. The peer below takes
	// the answer back after registering the manifest and after its user said yes, so what is measured is
	// whether the shared sender keeps the transfer it was already given. The retry itself goes on a one
	// second timer, which a synchronous report cannot wait for; the recovery half is the device leg's job.
	const m = new ChunkSwallow()
	m.muteOffer = 1
	const rm = new SenderRun()
	runSender(m, SIM_TEXT, rm, '')
	check('清单那一问读不到应答时这单没有被判死', !rm.done, rm.done ? ('已经判死：' + rm.summary) : '还活着')
	check('判死的那一行也没落到文件上', rm.summary.indexOf('被拒绝') < 0, rm.summary)
	check('这一趟对方只被出示了一份清单', m.offerAsks == 1, m.offerAsks.toString())
	check('那一份清单已经登记在这一单的账上', m.inbox.offers.length == 1, m.inbox.offers.length.toString())
	check('读不到应答的这一趟一块都没推', m.chunksSeen == 0, m.chunksSeen.toString())

	// H. 第十五轮巡检（#181）：§4 那句「只补传该文件的问题分块」的块号，这一端只可能从 finalize 答复的
	// `missing` 里读。A–D 量的是「回复没来」，这条量的是「回复来了，且说这块不算」：两块都写完以后把落点
	// 从盘上拿掉——台账还替它担保，于是整文件摘要读出的是空的，答复随之改口成全缺。这一端该只 PUT 那两个号，
	// 而且不必再去问一次 state：问了才是拿续传的账顶替那条答复，合同的顺序是反过来写的。
	const denied = new ChunkSwallow()
	denied.eraseAfter = 2
	denied.eraseRel = big
	const rdenied = new SenderRun()
	runSender(denied, big, rdenied, '')
	check('那块被整文件摘要推翻后，这一端按答复点名的块补传，第二次 finalize 就绿', rdenied.done && rdenied.ok, rdenied.summary)
	check('补传写的就是那两个块号（这单一共四次写块）', denied.chunksSeen == 4, denied.chunksSeen.toString())
	check('它没去问 state：那几个块号是 finalize 那条答复给的', denied.stateAsks == 0, denied.stateAsks.toString())

	// I. 第十七轮巡检（#183）：§4 那句「发送方须重传该块（最多 3 次）」数的是**这条 PUT 一共写几次**。
	// 两个发送方把同一个数写成两副样子——PC 是 `retries=3` 的写入次数，这一端（与两台手机共用的
	// `cs-client.uts`）是 `CHUNK_RESEND_MAX = 2` 的重传次数。A–D 量的是「回复没来」，那几种里发送方
	// 先问对方缺不缺；这一腿量的是「回复来了，说的是这一块不算」：对方逢每块必拒，就没有第二问，
	// 只有那三次写。
	const rej = new ChunkSwallow()
	rej.rejectChunks = 99
	const rrej = new SenderRun()
	runSender(rej, big, rrej, '')
	check('每块都被 422 拒掉时这一单判死', rrej.done && !rrej.ok, rrej.summary)
	check('§4 那一块一共写三次：首发一次、重传至多两次（这端的常量写的是那两次）', rej.chunksSeen == 3, rej.chunksSeen.toString())
	check('三次之间它一次 state 都没问：422 说的是这块不算，不是回复没来', rej.stateAsks == 0, rej.stateAsks.toString())
	check('报出去的就是对方那一句分块校验失败', rrej.summary.indexOf('分块校验失败') >= 0, rrej.summary)

	// J. 第十八轮巡检（#184）：§4 保活陷阱那句「发送方看到连接被关要重连重发一次」落在 finalize 上就是这一腿。
	// 这一端（两台手机共用的 `cs-client.uts`）以前把读不到 finalize 应答直接判死：字节都落齐、对面也验过了，
	// 人看到的却是一次失败。现在它一秒后再问一次，且只问那一次。这一档只能量到「没被判死」与「此刻对方只被
	// 出示过一次 finalize」——第二趟在 setTimeout 上，同步的报告等不到它自己发生；等得到它的是设备档，
	// §6 第 35 条把那一档记着。
	const k = new ChunkSwallow()
	k.muteFinalize = 1
	const rk = new SenderRun()
	runSender(k, SIM_TEXT, rk, '')
	check('finalize 那一问读不到应答时这一单没被判死', !rk.done, rk.done ? ('已经判死：' + rk.summary) : '还活着')
	check('它没有把已经落齐的字节重写一遍：这一单只写过一次块', k.chunksSeen == 1, k.chunksSeen.toString())
	check('此刻对方只被出示过一次 finalize：第二趟在那一秒之后', k.finalizeAsks == 1, k.finalizeAsks.toString())

	// K. 第二十轮巡检（#186）欠的那条腿：§5 那句「发送方（PC 与手机）也按段拦」在手机这一半问的是**整条
	// relpath**（`cs-client.uts:127-141` 逐条问 `pathReject`），而 `pathReject` 的按段行为早在第九轮那组 5d
	// 里量过——**没量过的是这个调用点**：一条带点段的清单是不是真的在本地就停住、一个请求都不打到对面。
	// 合同写的是「违规整单不发」（PC 那一半是「那一份不进清单，其余照发」），所以这里判的是整单停住。
	const hidden = new ChunkSwallow()
	const rhidden = new SenderRun()
	runSender(hidden, 'sub/.git/config', rhidden, '')
	check('relpath 中间那一段以点开头时，这一单在本地就停住', rhidden.done && !rhidden.ok, rhidden.summary)
	check('说的是本地拦下，不是对面那句版本或路径不兼容', rhidden.summary.indexOf('本地就拦下') >= 0, rhidden.summary)
	check('那一单一个清单都没打到对面', hidden.offerAsks == 0, hidden.offerAsks.toString())
	const hiddenLeaf = new ChunkSwallow()
	const rhiddenLeaf = new SenderRun()
	runSender(hiddenLeaf, '.env', rhiddenLeaf, '')
	check('叶子名自己以点开头的那一条同样在本地停住', rhiddenLeaf.done && !rhiddenLeaf.ok, rhiddenLeaf.summary)
	check('它也没能把清单发出去', hiddenLeaf.offerAsks == 0, hiddenLeaf.offerAsks.toString())

	// L. 第二十九轮巡检（#195）：§3 给这两个 secret 定的形状——`c` 是那 6 位数字，`k` 是去掉 I/O/0/1
	// 的 32 个符号。接收方拿它们只做一件事：逐字相等。所以一个多抄的第 7 位、一个带小写的密码，都不是
	// 一个更弱的承诺，而是对面那一格来源 5 次名额里的一次。改前这一端 `parsePairUrl` 把两个字段写成
	// if/else 互斥，于是带 `c` 的那一串（现在每一张二维码都带）从来没量过 `k`；PC 那一半两个都不量。
	// 合同这一轮把「发送方上线前按形状自己拦」写成句子，下面量的就是那一句的四种读法。
	const base = QR_SCHEME + '?h=192.0.2.1&p=' + TRANSPORT_PORT.toString() + '&v=' + PROTOCOL_VERSION.toString() + '&f=' + myFp
	const whyPair = (tail: string): string => parsePairUrl(base + tail).reject
	check('照着屏幕抄对的码和密码不会被本地拦下', whyPair('&c=123456&k=K7QMXZ2P') == '', whyPair('&c=123456&k=K7QMXZ2P'))
	check('密码留空是一个答案而不是错误（§3：省略这个键 = 只用码配）', passReject('') == '', passReject(''))
	check('串里没有 c 与 k 时不因缺码被拒：那是手输地址那一格的形状', whyPair('') == '', whyPair(''))
	check('密码抄成小写时这一串在本地就停住', whyPair('&c=123456&k=k7qmxz2p') != '', '这一串被放行了')
	check('说的是连接密码的字母表，不是配对码的事', whyPair('&c=123456&k=k7qmxz2p').indexOf('连接密码') >= 0, whyPair('&c=123456&k=k7qmxz2p'))
	check('码多抄了一位时同样在本地停住，原因是那 6 位', whyPair('&c=1234567&k=K7QMXZ2P').indexOf('6 位') >= 0, whyPair('&c=1234567&k=K7QMXZ2P'))
	check('两个都抄错时先答码那一句：这里没有"第二个字段只在第一个没带时才问"那回事', whyPair('&c=12a456&k=k7qmxz2p').indexOf('数字') >= 0, whyPair('&c=12a456&k=k7qmxz2p'))
	check('扫码/粘贴那一趟与手输那一格答的是同一句话', codeReject('12a456') != '' && codeReject('12a456') == whyPair('&c=12a456&k=K7QMXZ2P'), codeReject('12a456') + ' / ' + whyPair('&c=12a456&k=K7QMXZ2P'))

	out.push(fail == 0 ? '发送自检 ' + pass.toString() + ' 项全部通过' : '发送自检失败 ' + fail.toString() + ' 项，通过 ' + pass.toString() + ' 项')
	return out.join('\n')
}

/* ================================================== discovery self-check */

/** The roster's rules are pure, so the assertions live in cs-discovery.uts and every host runs the
 *  same 22 of them - this page today, and a phone once #90/#91 land. What stays here is only the
 *  name the page calls. */
export function discoverySelfReport(): string {
	return selfReport()
}
