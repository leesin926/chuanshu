/** The receiving half of the protocol, written once with no platform in it. The byte store, the
 *  digests and the signature check all arrive as parameters, so a browser can hold an offer in
 *  memory today and app-android can hold the same offer in filesDir against a real TLS listener
 *  later without one line of this file changing.
 *
 *  It mirrors app/net/receive.py endpoint for endpoint - same statuses, same rejections, same
 *  resume shape - because the sender on the other end is the PC and cannot be talked into
 *  accepting a different answer.
 *
 *  One thing the shared code cannot do is wait for a human inside a return statement. The PC blocks
 *  in its offer handler for as long as 60 s; a phone's UI cannot block a request thread and a
 *  browser certainly cannot block its own. So handleReceive registers the offer, answers
 *  `pending`, and the host - which owns the reply callback - resolves it later through
 *  resolveOffer(). On the wire nothing differs: the sender's POST /v1/offer simply takes longer. */
import {
	PROTOCOL_VERSION,
	COMPATIBLE_VERSIONS,
	CHUNK_SIZE,
	TRANSPORT_PORT,
	MAX_FILES_PER_OFFER,
	PREFIX_CHARS,
	PAIR_CODE_DIGITS,
	PAIR_CODE_TTL_S,
	PAIR_CODE_STATIC,
	PASSPHRASE_CHARS,
	SESSION_IDLE_S,
	OFFER_IDLE_S,
	OFFER_WAIT_S,
	chunkCount,
	chunkSizeAt,
	isFullFingerprint,
	newPassphrase,
	numList,
	pairMessage,
	parseJson,
	pathReject,
	randomHex,
	versionsOverlap
} from './cs-protocol.uts'

/** Constants from the PC receiver: the anti-replay window, and the lockout that stops a peer
 *  brute-forcing a six-digit code (10^6 guesses is not a theoretical risk on a LAN). */
const REPLAY_WINDOW_S: number = 300
const CODE_LOCK_S: number = 60
const CODE_MAX_FAILS: number = 5

export type HexFn = (buf: ArrayBuffer) => string
/** base64 of the raw 32-byte Ed25519 key -> hex SHA-256 of its SPKI DER, '' when the key is
 *  unreadable. The trust anchor is the SPKI digest, so this is the one primitive that decides
 *  whether pairing means anything. */
export type KeyFpFn = (publicKeyB64: string) => string
export type VerifyFn = (publicKeyB64: string, message: string, signatureB64: string) => boolean
/** Allocate the final file before a single chunk arrives. Returns the path the user will be shown,
 *  or '' when there is no room - which the wire answers as STORAGE_FULL, not as a quiet truncate. */
export type PrepareFn = (relpath: string, size: number) => string
export type WriteFn = (relpath: string, offset: number, buf: ArrayBuffer) => string
export type DigestFileFn = (relpath: string) => string
export type DropFn = (relpath: string) => void
/** Whether a file this device received is still where it was put. The card uses it to say so instead
 *  of quietly dropping the row, which is what the PC's arrival record does with `Path.exists()`. */
export type ExistsFn = (relpath: string) => boolean

/** What this device says about itself in /v1/hello and in a pair reply. */
export class LocalPeer {
	peerId: string = ''
	name: string = ''
	fingerprint: string = ''
	/** The digest of the certificate this device's listener actually hands out. Spec §3: it is a second
	 *  number, because no platform can serve its own Ed25519 identity key - Android and Harmony sign an
	 *  RSA-2048 leaf, and since #106 the PC does too. A peer dialling from a QR pins *this* one on the
	 *  socket and keeps `fingerprint` as who the machine is. '' means the platform never filled it in,
	 *  which is only ever true of a build whose leaf is its identity. */
	served: string = ''
	port: number = TRANSPORT_PORT
	/** How slowly a sender should write a body larger than one TLS record at this device, in milliseconds
	 *  per 4 KiB record. 0 (or absent from the answer) means "as fast as you can". A Harmony peer needs 40:
	 *  faster than that a 4 MiB chunk arrives with the right byte count and the wrong content, or the
	 *  connection dies mid-body; see protocol/spec.md §4. */
	chunkPaceMs: number = 0
}

/** One request as the transport read it off the socket. `client` is whatever identifies the
 *  connection for the code lockout - the PC uses the peer IP, and a phone has that too. */
export class Req {
	method: string = ''
	path: string = ''
	json: string = ''
	token: string = ''
	body: ArrayBuffer | null = null
	sha: string = ''
	client: string = ''
}

export class WireReply {
	pending: boolean = false
	status: number = 0
	body: string = ''
}

class RFile {
	id: string = ''
	relpath: string = ''
	size: number = 0
	sha256: string = ''
	mtime: number = 0
	type: string = 'application/octet-stream'
	/** Where this file goes inside the receive root: the offer's own directory plus the sent name. The
	 *  only path the store primitives are ever handed - `relpath` alone was one flat namespace, where a
	 *  second offer for the same name allocated over bytes the first one had already verified (#128). */
	land: string = ''
	/** Where the bytes actually went, only known once the offer was accepted. */
	dest: string = ''
	chunks: Map<number, string> = new Map()
	/** 0 undecided, 1 verified whole, 2 rejected by finalize. */
	verdict: number = 0
	missingAt: number = 0
}

class ROffer {
	offerId: string = ''
	files: RFile[] = []
	fromName: string = ''
	fromFingerprint: string = ''
	awaiting: boolean = true
	created: number = 0
	/** The last evidence that this transfer is still being pursued: a chunk that landed, or - while
	 *  nobody has decided yet - the sender re-delivering the same manifest. Both windows of spec §4 count
	 *  from here, not from `created`: a transfer that keeps moving is never idle, and an offer the sender
	 *  stopped asking about is gone however new its first delivery looks. */
	touched: number = 0
	/** Set by a finalize that found every file whole. It is the difference between an offer that can
	 *  still be resumed - and one whose bytes must survive the next restart. */
	complete: boolean = false
}

/** One file that landed and was verified, kept for as long as the receive root keeps it. This is the
 *  phone's arrival record - what app/ui/transfer.py writes to arrivals.json - and it exists because a
 *  completed offer is deliberately absent from the resume ledger: a document of a transfer that cannot
 *  be resumed only invites the next run to treat it as one. Without this list the card titled
 *  收到的文件 describes this process rather than this device. */
class RArrival {
	relpath: string = ''
	/** The path this file was laid at, kept so the card can still find it - and so a second offer for the
	 *  same name reads as the second file it is, not as the first one arriving again. */
	land: string = ''
	size: number = 0
	dest: string = ''
	fromName: string = ''
	/** When the finalize that verified it ran, in the same seconds the offers use. */
	at: number = 0
}

class Trust {
	fingerprint: string = ''
	peerId: string = ''
	name: string = ''
	publicKeyB64: string = ''
	/** Set only for a peer whose served certificate is signed by another key (spec §3). It is what
	 *  makes the device this end dialled and the device that dialled in one machine. */
	tlsFingerprint: string = ''
}

class TokenEntry {
	fingerprint: string = ''
	token: string = ''
	/** The last request this peer put its token on (spec §3). A session that never says anything is
	 *  not a session - it is a held slot nobody can release except by restarting. */
	seen: number = 0
}

class NonceEntry {
	nonce: string = ''
	at: number = 0
}

class FailEntry {
	client: string = ''
	times: number[] = []
}

/** Everything a receiver has to remember between requests. Offers survive a process restart through
 *  stateJson()/adopt(); sessions deliberately do not, which is what makes the silent re-pair in
 *  cs-client.uts the recovery path rather than an edge case. */
export class SettledOffer {
	id: string = ''
	status: number = 403
	body: string = ''
}

export class Inbox {
	offers: ROffer[] = []
	/** What this device received and verified, oldest first. It sits beside the offers and not inside
	 *  them because an offer goes away once it is finished and the file it delivered stays. */
	arrivals: RArrival[] = []
	tokens: TokenEntry[] = []
	nonces: NonceEntry[] = []
	fails: FailEntry[] = []
	trusted: Trust[] = []
	pairCode: string = ''
	pairCodeUntil: number = 0
	/** The second secret, minted with the code and kept as long as it is (spec §3). '' on a build
	 *  that has no passphrase concept, which is also what makes it send none. */
	passphrase: string = ''
	/** Which peer this device dialled out to. The receiver is not involved in that handshake, so
	 *  without this the one-session rule would only ever guard the door that opens inward. */
	heldBy: string = ''
	/** When the session this device dialled out last moved. One number because one peer at a time can
	 *  hold it; the inbound half keeps its own stamp per token. */
	heldSeen: number = 0
	/** The name of the peer whose session the idle reclaim took back (spec §3). The card that only
	 *  says "现在没有对端连着" makes a person hunt for the button they forgot to press; this says
	 *  whose window closed. A new pair, or this end dialling somebody, replaces it. */
	lostName: string = ''
	/** Answers a person already gave, kept by offer id and only for this session. A sender that has to
	 *  ask again on a new connection cannot tell a decline from a delivery nobody has looked at yet, so
	 *  without this a decline would reopen the same dialog every poll. */
	settled: SettledOffer[] = []
}

export function newInbox(): Inbox {
	return new Inbox()
}

export class FileRow {
	offerId: string = ''
	fromName: string = ''
	relpath: string = ''
	/** Where the bytes of this row sit inside the receive root; `markLanded` probes this, not `relpath`. */
	land: string = ''
	size: number = 0
	type: string = ''
	dest: string = ''
	awaiting: boolean = false
	verdict: number = 0
	have: number = 0
	count: number = 0
	missingAt: number = 0
	/** True once this offer has been silent for a full session window of spec §3 with nobody having
	 *  decided to stop it. The bytes are still the sender's to deliver - it can come back on the same
	 *  offer id and finish - but `还没收到分块` describing a peer that has gone reads as a transfer that
	 *  is about to move, and a person decides differently on that sentence than on the true one. */
	senderGone: boolean = false
	/** This row is an arrival record rather than an offer still in memory: the bytes were verified, the
	 *  offer is finished, and only the card's host can say whether the file is still where it was put. */
	landed: boolean = false
	/** A landed row whose file is no longer in the receive root. Set by markLanded, which is the only
	 *  place the shared machine learns about the disk - the card must say so rather than drop the row,
	 *  because a list that forgets files the user deleted is a list that cannot be trusted. */
	gone: boolean = false
}

export class ReceiveSnapshot {
	pairCode: string = ''
	/** The second half of the promise shown on this device's own screen. */
	passphrase: string = ''
	/** False means this code expires and the page has to count down; true means it does not. */
	staticCode: boolean = true
	codeSecondsLeft: number = 0
	/** The offers waiting on the user, oldest first. The UI decides; this end only says there is one. */
	pendingOfferIds: string[] = []
	pendingFrom: string[] = []
	rows: FileRow[] = []
	verifiedFiles: number = 0
	rejectedFiles: number = 0
	peers: number = 0
	/** The peers holding a session right now - in either direction - named as they introduced
	 *  themselves. A card that lists pinned devices and a card that lists connected ones say
	 *  different things, and the desktop shows the connected ones. */
	connectedNames: string[] = []
	/** Whose session the idle reclaim of spec §3 took back, or '' when nothing has been taken back
	 *  since. A card that only says 现在没有对端连着 makes a person hunt for a button nobody forgot
	 *  to press. */
	lostName: string = ''
}

/** spec.json error_codes carries the HTTP status for every code; the sender checks nothing else,
 *  so the table has to agree with it exactly. */
function statusOf(code: string): number {
	if (code == 'OFFER_UNKNOWN') {
		return 404
	}
	if (code == 'CHUNK_DIGEST_MISMATCH' || code == 'FILE_DIGEST_MISMATCH') {
		return 422
	}
	if (code == 'STORAGE_FULL') {
		return 507
	}
	if (code == 'PEER_BUSY') {
		return 429
	}
	if (code == 'NOT_PAIRED' || code == 'BAD_PAIR_CODE' || code == 'DECLINED') {
		return 403
	}
	return 400
}

function reply(status: number, body: string): WireReply {
	const out = new WireReply()
	out.status = status
	out.body = body
	return out
}

function okWith(body: UTSJSONObject): WireReply {
	return reply(200, JSON.stringify(body))
}

function failWith(code: string, detail: UTSJSONObject | null): WireReply {
	const body: UTSJSONObject = detail == null ? { code: code } : { code: code, detail: detail }
	return reply(statusOf(code), JSON.stringify(body))
}

function pendingReply(): WireReply {
	const out = new WireReply()
	out.pending = true
	return out
}

function newPairCode(): string {
	const digits = '0123456789'
	let out = ''
	for (let i = 0; i < PAIR_CODE_DIGITS; i++) {
		out = out + digits.charAt(Math.floor(Math.random() * 10))
	}
	return out
}

/** Generated on demand rather than on a timer: a phone that spends most of its life backgrounded has
 *  no business keeping a timer alive, and the PC's current_pair_code() uses the same lazy shape.
 *  With PAIR_CODE_STATIC the pair minted here is kept for good - the code and the passphrase are a
 *  printable promise, not a one-time token - and only rotatePairing() below replaces them. */
export function currentPairCode(inbox: Inbox, now: number): string {
	if (inbox.pairCode == '' || inbox.passphrase == '') {
		inbox.pairCode = newPairCode()
		inbox.passphrase = newPassphrase(PASSPHRASE_CHARS)
		inbox.pairCodeUntil = now + PAIR_CODE_TTL_S
	} else if (!PAIR_CODE_STATIC && now > inbox.pairCodeUntil) {
		inbox.pairCode = newPairCode()
		inbox.pairCodeUntil = now + PAIR_CODE_TTL_S
	}
	return inbox.pairCode
}

export function passphraseOf(inbox: Inbox, now: number): string {
	currentPairCode(inbox, now)
	return inbox.passphrase
}

/** New material for both secrets. Pins and live sessions are untouched: this only changes what a
 *  stranger has to get right before it is allowed to pin us. */
export function rotatePairing(inbox: Inbox, now: number): void {
	inbox.pairCode = newPairCode()
	inbox.passphrase = newPassphrase(PASSPHRASE_CHARS)
	inbox.pairCodeUntil = now + PAIR_CODE_TTL_S
}

function codeSecondsLeft(inbox: Inbox, now: number): number {
	if (PAIR_CODE_STATIC) {
		return 0
	}
	if (inbox.pairCode == '') {
		return PAIR_CODE_TTL_S
	}
	const left = inbox.pairCodeUntil - now
	return left < 0 ? 0 : Math.floor(left)
}

/** The peers this device is committed to: one that holds a token it was handed, plus the one this
 *  end dialled out to. Both directions take the same single slot (spec §3). */
export function activePeers(inbox: Inbox): string[] {
	const out: string[] = []
	for (let i = 0; i < inbox.tokens.length; i++) {
		if (out.indexOf(inbox.tokens[i].fingerprint) < 0) {
			out.push(inbox.tokens[i].fingerprint)
		}
	}
	if (inbox.heldBy != '' && out.indexOf(inbox.heldBy) < 0) {
		out.push(inbox.heldBy)
	}
	return out
}

/** Say who this machine already talks to, so the door it dials out of is guarded like the one it is
 *  dialled in through. '' gives the slot back. The UI owns this: the receiver never sees an
 *  outgoing handshake. */
export function holdSlotFor(inbox: Inbox, fingerprint: string, now: number): void {
	const changed = inbox.heldBy != fingerprint
	inbox.heldBy = fingerprint
	if (fingerprint == '') {
		inbox.heldSeen = 0
		return
	}
	inbox.lostName = ''
	// Only taking the slot starts the clock. This is called from every roster repaint, and stamping
	// it each time would keep a stalled outbound session alive forever.
	if (changed) {
		inbox.heldSeen = now
	}
}

/** Say that a session is still moving, so its idle clock starts again from now.
 *
 *  The peer this device dialled never appears in an inbound request, so this is the only way its half
 *  of the slot can be kept honest - the sender calls it as chunks land. */
export function seenNow(inbox: Inbox, fingerprint: string, now: number): void {
	if (fingerprint == '') {
		return
	}
	if (inbox.heldBy == fingerprint) {
		inbox.heldSeen = now
	}
	for (let i = 0; i < inbox.tokens.length; i++) {
		if (inbox.tokens[i].fingerprint == fingerprint) {
			inbox.tokens[i].seen = now
		}
	}
}

/** The name this device gives a peer: the pinned one if there is one, and the short fingerprint
 *  otherwise. A phone that lost a session to silence still has to say whose it was. */
function nameFor(inbox: Inbox, fingerprint: string): string {
	for (let i = 0; i < inbox.trusted.length; i++) {
		const pin = inbox.trusted[i]
		if (pin.fingerprint == fingerprint || (pin.tlsFingerprint != '' && pin.tlsFingerprint == fingerprint)) {
			if (pin.name != '') {
				return pin.name
			}
		}
	}
	return '对端 ' + fingerprint.substring(0, 8) + '…'
}

/** Every offer gets its own directory inside the receive root - the shape `app/net/receive.py` has used
 *  from the start (`root/<offer_id>/<relpath>`). Laying all offers flat on `relpath` meant a second
 *  sender naming a file the first one had already delivered landed on the same bytes, and accepting it
 *  allocates at the declared length: the earlier delivery was truncated to a sparse file under a resume
 *  ledger that still vouched for it (#128, witnessed while building #127's second leg). */
function landingOf(offerId: string, relpath: string): string {
	return offerId == '' ? relpath : offerId + '/' + relpath
}

/** A stored `land` that is empty means the document predates per-offer directories: those bytes lie flat
 *  under the sent name, and that is where the card and the resume have to keep looking for them. */
function landingOr(land: string, relpath: string): string {
	return land == '' ? relpath : land
}

/** Give back the bytes a transfer that is going away leaves in this device's receive folder.
 *
 *  Only what does not hash to what this offer asked for is garbage, and a file this end already
 *  verified keeps its place: the sender that gave up and re-sent the same name is the usual way an
 *  offer stalls, and the bytes a person has are worth more than the sparse allocation being cleaned
 *  up. Inside the offer's own directory nothing of anybody else's can be reached either way. */
function releaseFiles(offer: ROffer, drop: DropFn, digestFile: DigestFileFn): void {
	for (let k = 0; k < offer.files.length; k++) {
		const file = offer.files[k]
		if (file.verdict == 1) {
			continue
		}
		// Bytes that hash to what this offer was asked for stay; anything else is this offer's own
		// half-written allocation, and its directory is nobody else's.
		if (file.sha256 != '' && digestFile(file.land) == file.sha256) {
			continue
		}
		drop(file.land)
	}
}

/** Reclaim what has stopped moving: a silent peer's slot, and an offer nobody is filling.
 *
 *  Cheap and idempotent, because it runs from a request thread and from the card's tick. Both windows
 *  are floors from the contract, and a peer whose clock runs out is not lost: it re-pairs without a
 *  code (spec §3), and a finished transfer keeps every byte it verified.
 *
 *  An offer the user has not answered is closed on one clock only - the sender's own asking. §4 gives
 *  the sender `offer_wait_timeout_s` to get a decision and it re-delivers the manifest every second
 *  inside that window, so "nobody has asked about this in a full window" is the only reading of §4 that
 *  cannot be undone by the next request. Inside the window nothing here touches it: closing a live
 *  dialog behind a person is a different promise from timing out a stalled transfer. Past it the
 *  manifest has nobody left to write it, so a 接受 tap would be a decision about a transfer that cannot
 *  happen, and the one offer slot it holds would keep refusing the next sender. */
export function sweep(inbox: Inbox, now: number, drop: DropFn, digestFile: DigestFileFn): string[] {
	const lost: string[] = []
	for (let i = inbox.tokens.length - 1; i >= 0; i--) {
		const entry = inbox.tokens[i]
		if (now - entry.seen < SESSION_IDLE_S) {
			continue
		}
		inbox.tokens.splice(i, 1)
		if (inbox.heldBy == entry.fingerprint) {
			inbox.heldBy = ''
			inbox.heldSeen = 0
		}
		inbox.lostName = nameFor(inbox, entry.fingerprint)
		lost.push(entry.fingerprint)
	}
	if (inbox.heldBy != '' && now - inbox.heldSeen >= SESSION_IDLE_S) {
		const stalled = inbox.heldBy
		inbox.lostName = nameFor(inbox, stalled)
		inbox.heldBy = ''
		inbox.heldSeen = 0
		lost.push(stalled)
	}
	for (let i = inbox.offers.length - 1; i >= 0; i--) {
		const offer = inbox.offers[i]
		if (offer.awaiting) {
			if (now - offer.touched < OFFER_WAIT_S) {
				continue
			}
			// Never accepted, so nothing was allocated and there is no half-written batch to release -
			// this is the one offer the card is allowed to stop showing on its own. The answer it
			// stopped with is recorded too (§4): a sender that re-posts on a fresh connection gets
			// the same refusal instead of a second card for a window nobody answered.
			const lapsed = failWith('DECLINED', null)
			settleOffer(inbox, offer.offerId, lapsed.status, lapsed.body)
			inbox.offers.splice(i, 1)
			continue
		}
		if (now - offer.touched < OFFER_IDLE_S) {
			continue
		}
		if (!offer.complete) {
			// Same thing the sender's own 取消 does: the half-written batch is nobody's file, and
			// leaving it would keep the space the offer reserved when it was accepted.
			releaseFiles(offer, drop, digestFile)
		}
		// This id is done asking, in either case: recorded so a manifest that still arrives under it
		// hears that rather than waking the user again.
		const ended = failWith('OFFER_UNKNOWN', { offer_id: offer.offerId } as UTSJSONObject)
		settleOffer(inbox, offer.offerId, ended.status, ended.body)
		inbox.offers.splice(i, 1)
	}
	return lost
}

/** Say that the machine at an address this device dialled is one it already trusts, so the door that
 *  same machine dials *in* through opens on the signature alone.
 *
 *  One trust answer for both directions is what the PC has always had, and its absence here is what
 *  makes a resumed pair deadlock: the caller keeps its pin over a restart, so it sends no code, while
 *  this receiver - which met that caller on the way out, not on the way in - asks for one it cannot get.
 *  `publicKeyB64` stays empty on purpose: an address being known says nothing about the key behind it,
 *  and the code only ever stops demanding one after that key has signed something.
 *
 *  `fingerprint` is the *identity* digest, because that is the only number pairReply ever looks a
 *  peer up by: it is the hash of the key the pair message signs with (cs-receive.uts pairReply ->
 *  keyFp(declared)), never the certificate the socket handed out. A caller that only knows the leaf
 *  has to pass '' here and let the peer redeem a code - adopting by the leaf used to be exactly what
 *  made this bridge miss, because since #47/#106 no end signs the certificate it serves with its
 *  identity key, so the two digests are two different numbers. `leaf`, when known, is recorded on the
 *  entry so samePeer can still tell the two halves of one machine apart for the single-session slot. */
export function adoptPin(inbox: Inbox, fingerprint: string, peerId: string, name: string, leaf: string): void {
	if (fingerprint.length != 64) {
		return
	}
	const known = trustByFp(inbox, fingerprint)
	if (known != null) {
		if (peerId != '') known.peerId = peerId
		if (name != '') known.name = name
		if (leaf != '' && known.tlsFingerprint == '') known.tlsFingerprint = leaf
		return
	}
	const entry = new Trust()
	entry.fingerprint = fingerprint
	entry.peerId = peerId
	entry.name = name
	entry.publicKeyB64 = ''
	entry.tlsFingerprint = leaf
	inbox.trusted.push(entry)
}

/** Two numbers, one device: the identity key a peer signs with and the certificate it serves can be
 *  different keys, and only the §3 declaration says they belong to the same machine. */
function samePeer(inbox: Inbox, a: string, b: string): boolean {
	if (a == '' || b == '') {
		return false
	}
	if (a == b) {
		return true
	}
	for (let i = 0; i < inbox.trusted.length; i++) {
		const entry = inbox.trusted[i]
		const leaf = entry.tlsFingerprint
		if (leaf != '' && ((entry.fingerprint == a && leaf == b) || (entry.fingerprint == b && leaf == a))) {
			return true
		}
	}
	return false
}

function offerById(inbox: Inbox, offerId: string): ROffer | null {
	for (let i = 0; i < inbox.offers.length; i++) {
		if (inbox.offers[i].offerId == offerId) {
			return inbox.offers[i]
		}
	}
	return null
}

function fileById(offer: ROffer, fileId: string): RFile | null {
	for (let i = 0; i < offer.files.length; i++) {
		if (offer.files[i].id == fileId) {
			return offer.files[i]
		}
	}
	return null
}

function trustByFp(inbox: Inbox, fingerprint: string): Trust | null {
	for (let i = 0; i < inbox.trusted.length; i++) {
		if (inbox.trusted[i].fingerprint == fingerprint) {
			return inbox.trusted[i]
		}
	}
	return null
}

function fpOfToken(inbox: Inbox, token: string): string {
	if (token == '') {
		return ''
	}
	for (let i = 0; i < inbox.tokens.length; i++) {
		if (inbox.tokens[i].token == token) {
			return inbox.tokens[i].fingerprint
		}
	}
	return ''
}

function setToken(inbox: Inbox, fingerprint: string, token: string, now: number): void {
	// A session that just started has nothing to do with the one that went silent before it.
	inbox.lostName = ''
	for (let i = 0; i < inbox.tokens.length; i++) {
		if (inbox.tokens[i].fingerprint == fingerprint) {
			inbox.tokens[i].token = token
			inbox.tokens[i].seen = now
			return
		}
	}
	const entry = new TokenEntry()
	entry.fingerprint = fingerprint
	entry.token = token
	entry.seen = now
	inbox.tokens.push(entry)
}

/** Mirrors _prune(): both windows are sliding, and an unbounded nonce list is a memory leak an
 *  attacker can grow by re-pairing forever. */
function prune(inbox: Inbox, now: number): void {
	const keptNonces: NonceEntry[] = []
	for (let i = 0; i < inbox.nonces.length; i++) {
		if (now - inbox.nonces[i].at < REPLAY_WINDOW_S) {
			keptNonces.push(inbox.nonces[i])
		}
	}
	inbox.nonces = keptNonces

	const keptFails: FailEntry[] = []
	for (let i = 0; i < inbox.fails.length; i++) {
		const keptTimes: number[] = []
		const times = inbox.fails[i].times
		for (let k = 0; k < times.length; k++) {
			if (now - times[k] < CODE_LOCK_S) {
				keptTimes.push(times[k])
			}
		}
		if (keptTimes.length > 0) {
			const entry = new FailEntry()
			entry.client = inbox.fails[i].client
			entry.times = keptTimes
			keptFails.push(entry)
		}
	}
	inbox.fails = keptFails
}

function failCount(inbox: Inbox, client: string): number {
	for (let i = 0; i < inbox.fails.length; i++) {
		if (inbox.fails[i].client == client) {
			return inbox.fails[i].times.length
		}
	}
	return 0
}

function pushFail(inbox: Inbox, client: string, now: number): void {
	for (let i = 0; i < inbox.fails.length; i++) {
		if (inbox.fails[i].client == client) {
			const times = inbox.fails[i].times
			times.push(now)
			return
		}
	}
	const entry = new FailEntry()
	entry.client = client
	entry.times = [now]
	inbox.fails.push(entry)
}

function nonceSeen(inbox: Inbox, nonce: string): boolean {
	for (let i = 0; i < inbox.nonces.length; i++) {
		if (inbox.nonces[i].nonce == nonce) {
			return true
		}
	}
	return false
}

function addNonce(inbox: Inbox, nonce: string, now: number): void {
	const entry = new NonceEntry()
	entry.nonce = nonce
	entry.at = now
	inbox.nonces.push(entry)
}

function payloadOf(offer: ROffer): UTSJSONObject {
	const list: UTSJSONObject[] = []
	for (let i = 0; i < offer.files.length; i++) {
		const file = offer.files[i]
		const count = chunkCount(file.size)
		const missing: number[] = []
		for (let k = 0; k < count; k++) {
			if (!file.chunks.has(k)) {
				missing.push(k)
			}
		}
		const entry: UTSJSONObject = { id: file.id, received: file.chunks.size, missing: missing }
		list.push(entry)
	}
	return { offer_id: offer.offerId, accepted: true, files: list } as UTSJSONObject
}

/** Compared without short-circuiting, which is what the spec's constant-time promise means here.
 *  A length mismatch is still visible, but the alphabet is fixed-width and generated, so that leak
 *  says nothing a wrong guess would not already say. */
function secretMatches(a: string, b: string): boolean {
	if (a.length != b.length) {
		return false
	}
	let diff = 0
	for (let i = 0; i < a.length; i++) {
		const ca = a.charCodeAt(i)
		const cb = b.charCodeAt(i)
		if (ca == null || cb == null) {
			return false
		}
		diff = diff | (ca! ^ cb!)
	}
	return diff == 0
}

/* ------------------------------------------------------------------------ endpoints */

function pairReply(
	inbox: Inbox,
	self: LocalPeer,
	now: number,
	client: string,
	json: string,
	keyFp: KeyFpFn,
	verify: VerifyFn
): WireReply {
	const body = parseJson(json)
	if (body == null) {
		return failWith('NOT_PAIRED', { reason: 'body is not a JSON object' } as UTSJSONObject)
	}
	const peerId = body.getString('peer_id', '')
	const name = body.getString('name', '')
	const nonce = body.getString('nonce', '')
	const declared = body.getString('public_key', '')
	const signature = body.getString('signature', '')
	const code = body.getString('code', '')
	// Absent means "my certificate is signed by the key that signed this"; present means the peer
	// serves a leaf under another key and says so. Both are off the wire as an empty value, so an
	// empty string reads the same way the missing key does.
	const declaredLeaf = body.getString('tls_fingerprint', '')
	if (declaredLeaf != '' && !isFullFingerprint(declaredLeaf)) {
		return failWith('NOT_PAIRED', { reason: 'tls_fingerprint is not a full SPKI digest' } as UTSJSONObject)
	}
	const version = Math.floor(body.getNumber('protocol_version', 0))
	// §7 is a set on each side, and this body is the only place a receiver can read the sender's set:
	// it never dials back to ask for a hello.
	const theirs = numList(body.getArray<number>('compatible_versions'))
	if (!versionsOverlap(COMPATIBLE_VERSIONS, theirs, version)) {
		return failWith('UNSUPPORTED_PROTOCOL', { peer_version: version, peer_compatible: theirs } as UTSJSONObject)
	}
	if (peerId == '' || nonce == '' || declared == '' || signature == '') {
		return failWith('NOT_PAIRED', { reason: 'pair request is incomplete' } as UTSJSONObject)
	}
	prune(inbox, now)
	if (nonceSeen(inbox, nonce)) {
		return failWith('NOT_PAIRED', { reason: 'replayed nonce' } as UTSJSONObject)
	}
	const fingerprint = keyFp(declared)
	if (fingerprint == '') {
		return failWith('NOT_PAIRED', { reason: 'public key is not base64 raw ed25519' } as UTSJSONObject)
	}
	const message = pairMessage(peerId, nonce, declaredLeaf)
	if (!verify(declared, message, signature)) {
		return failWith('NOT_PAIRED', { reason: 'signature does not match the key' } as UTSJSONObject)
	}
	const pinned = trustByFp(inbox, fingerprint)
	if (pinned != null && pinned.publicKeyB64 != '' && pinned.publicKeyB64 != declared) {
		// Same digest, different bytes: a collision of identity. It must never pass quietly.
		return failWith('NOT_PAIRED', { reason: 'pinned key mismatch' } as UTSJSONObject)
	}
	// Only now, with the key proven to own its own claim, is it safe to say anything about who else
	// is connected - and "who else" counts the peer this device dialled too.
	let busyWith = ''
	const holders = activePeers(inbox)
	for (let i = 0; i < holders.length; i++) {
		if (!samePeer(inbox, holders[i], fingerprint)) {
			busyWith = holders[i]
			break
		}
	}
	if (busyWith != '') {
		const holder = trustByFp(inbox, busyWith)
		const who = holder == null ? busyWith.substring(0, PREFIX_CHARS) : holder!.name
		return failWith('PEER_BUSY', { reason: 'one peer at a time', peer: who } as UTSJSONObject)
	}
	let resumed = true
	if (pinned == null) {
		resumed = false
		if (failCount(inbox, client) >= CODE_MAX_FAILS) {
			return failWith('PEER_BUSY', { reason: 'too many failed codes' } as UTSJSONObject)
		}
		if (code != currentPairCode(inbox, now)) {
			pushFail(inbox, client, now)
			return failWith('BAD_PAIR_CODE', null)
		}
		// A missing key means a sender that has no passphrase to offer; it is authenticated by the
		// code alone, exactly as it was before this field existed.
		if (body.get('secret') != null && !secretMatches(body.getString('secret', ''), passphraseOf(inbox, now))) {
			pushFail(inbox, client, now)
			return failWith('BAD_PAIR_CODE', { reason: 'passphrase' } as UTSJSONObject)
		}
		const entry = new Trust()
		entry.fingerprint = fingerprint
		entry.peerId = peerId
		entry.name = name
		entry.publicKeyB64 = declared
		entry.tlsFingerprint = declaredLeaf
		inbox.trusted.push(entry)
	} else {
		// A key already pinned re-pairs on its signature alone; the code is not part of this branch,
		// which is what lets a lost token heal without the user ever looking at the other screen.
		if (pinned.publicKeyB64 == '') {
			// Adopted from an address this device dialled, so this signed request is the first sight of
			// the key behind it. The signature above has already vouched for these bytes, which is the
			// only reason recording them here is safe.
			pinned.publicKeyB64 = declared
		}
		pinned.peerId = peerId
		pinned.name = name
		if (declaredLeaf != '') {
			pinned.tlsFingerprint = declaredLeaf
		}
	}
	addNonce(inbox, nonce, now)
	const token = randomHex(32)
	setToken(inbox, fingerprint, token, now)
	return okWith({
		token: token,
		peer_id: self.peerId,
		name: self.name,
		protocol_version: PROTOCOL_VERSION,
		// The pair reply restates what hello says (§3), and §7 needs the set: a sender that adopts this
		// peer without a second hello would otherwise have one number to go on.
		compatible_versions: COMPATIBLE_VERSIONS,
		fingerprint: self.fingerprint,
		resumed: resumed
	} as UTSJSONObject)
}

/** POST /v1/offer. Registers the manifest and then stops: the decision belongs to a person. */
function offerReply(inbox: Inbox, now: number, json: string, caller: string): WireReply {
	const body = parseJson(json)
	if (body == null) {
		return failWith('UNSUPPORTED_PROTOCOL', { reason: 'body is not a JSON object' } as UTSJSONObject)
	}
	const version = Math.floor(body.getNumber('protocol_version', 0))
	const theirs = numList(body.getArray<number>('compatible_versions'))
	if (!versionsOverlap(COMPATIBLE_VERSIONS, theirs, version)) {
		return failWith('UNSUPPORTED_PROTOCOL', { peer_version: version, peer_compatible: theirs } as UTSJSONObject)
	}
	const offerId = body.getString('offer_id', '')
	const files = body.getArray<UTSJSONObject>('files')
	if (offerId == '' || files == null || files.length == 0) {
		return failWith('UNSUPPORTED_PROTOCOL', { reason: 'offer has no id or files' } as UTSJSONObject)
	}
	if (files.length > MAX_FILES_PER_OFFER) {
		return failWith('UNSUPPORTED_PROTOCOL', { reason: 'too many files' } as UTSJSONObject)
	}
	const known = offerById(inbox, offerId)
	if (known != null) {
		// A sender that lost its reply re-sends the whole manifest. If the user has not decided yet
		// the answer is still "wait", not a second dialog for the same delivery. Every one of those
		// re-deliveries is proof the sender is still asking, so the window of §4 moves with it - the
		// last poll is the one that used to arrive exactly as a window counted from `created` closed,
		// which re-registered the same offer and started the clock again behind a card nobody answers.
		if (known.awaiting) {
			known.touched = now
			return pendingReply()
		}
		return okWith(payloadOf(known))
	}
	const settled = settledOf(inbox, offerId)
	if (settled != null) {
		return reply(settled!.status, settled!.body)
	}

	const offer = new ROffer()
	offer.offerId = offerId
	offer.created = now
	offer.touched = now
	for (let i = 0; i < files.length; i++) {
		const entry = files[i]
		const relpath = entry.getString('relpath', '')
		// Sanitised before the human is asked, so nobody confirms a name this end would refuse.
		const why = pathReject(relpath)
		if (why != '') {
			return failWith('PATH_REJECTED', { relpath: relpath, reason: why } as UTSJSONObject)
		}
		const file = new RFile()
		file.id = entry.getString('id', '')
		file.relpath = relpath
		file.land = landingOf(offerId, relpath)
		file.size = Math.floor(entry.getNumber('size', 0))
		file.sha256 = entry.getString('sha256', '')
		file.mtime = Math.floor(entry.getNumber('mtime', 0))
		file.type = entry.getString('type', 'application/octet-stream')
		if (file.id == '' || file.sha256 == '' || file.size < 0) {
			return failWith('UNSUPPORTED_PROTOCOL', { reason: 'file entry is incomplete' } as UTSJSONObject)
		}
		offer.files.push(file)
	}
	const pinned = trustByFp(inbox, caller)
	// The manifest may claim any name it likes; only the pinned one is shown to the user.
	offer.fromName = pinned == null ? '' : pinned!.name
	offer.fromFingerprint = caller
	inbox.offers.push(offer)
	return pendingReply()
}

function chunkReply(
	inbox: Inbox,
	now: number,
	offerId: string,
	fileId: string,
	index: number,
	body: ArrayBuffer | null,
	sha: string,
	hexOf: HexFn,
	writeAt: WriteFn
): WireReply {
	const offer = offerById(inbox, offerId)
	if (offer == null) {
		return failWith('OFFER_UNKNOWN', { offer_id: offerId } as UTSJSONObject)
	}
	const file = fileById(offer, fileId)
	if (file == null) {
		return failWith('OFFER_UNKNOWN', { file_id: fileId } as UTSJSONObject)
	}
	const count = chunkCount(file!.size)
	if (index < 0 || index >= count) {
		return failWith('BAD_CHUNK_INDEX', { index: index, count: count } as UTSJSONObject)
	}
	const data = body == null ? new ArrayBuffer(0) : body!
	const want = chunkSizeAt(file!.size, index)
	if (data.byteLength != want) {
		return failWith('CHUNK_DIGEST_MISMATCH', { reason: 'length', got: data.byteLength, want: want } as UTSJSONObject)
	}
	const digest = hexOf(data)
	if (sha != '' && sha != digest) {
		return failWith('CHUNK_DIGEST_MISMATCH', { index: index, expected: sha } as UTSJSONObject)
	}
	// Even a re-send of a chunk already on disk is proof the transfer is still moving, so the idle
	// window of spec §4 restarts here - before the idempotent answer and before the write.
	offer!.touched = now
	if (file!.chunks.get(index) == digest) {
		// Idempotent on purpose: a re-send costs a hash, not a rewrite.
		return okWith({ index: index, stored: true, idempotent: true } as UTSJSONObject)
	}
	const why = writeAt(file!.land, index * CHUNK_SIZE, data)
	if (why != '') {
		return failWith('STORAGE_FULL', { relpath: file!.relpath, reason: why } as UTSJSONObject)
	}
	file!.chunks.set(index, digest)
	return okWith({ index: index, stored: true } as UTSJSONObject)
}

function stateReply(inbox: Inbox, offerId: string): WireReply {
	const offer = offerById(inbox, offerId)
	if (offer == null) {
		return failWith('OFFER_UNKNOWN', { offer_id: offerId } as UTSJSONObject)
	}
	return okWith(payloadOf(offer))
}

/* ------------------------------------------------------------------ the arrival record */

/** How far back 收到的文件 reaches. The PC caps its arrivals.json at 500 for the same reason: a list
 *  that only grows is a file that eventually cannot be read on a phone. */
const ARRIVALS_KEPT: number = 500

/** Whether these bytes are already written down, so the card gets one row for them and not two. */
function hasArrival(inbox: Inbox, land: string): boolean {
	if (land == '') {
		return false
	}
	for (let k = 0; k < inbox.arrivals.length; k++) {
		if (inbox.arrivals[k].land == land) {
			return true
		}
	}
	return false
}

/** Write down what a finished offer delivered, so the card can still answer the question after the
 *  offer itself is gone. Keyed by destination: a sender that re-finalizes on a resumed connection
 *  does not receive a second row, and the first arrival keeps its date. */
function recordArrivals(inbox: Inbox, offer: ROffer): void {
	for (let i = 0; i < offer.files.length; i++) {
		const file = offer.files[i]
		if (file.verdict != 1 || file.relpath == '' || hasArrival(inbox, file.land)) {
			continue
		}
		const arrival = new RArrival()
		arrival.relpath = file.relpath
		arrival.land = file.land
		arrival.size = file.size
		arrival.dest = file.dest
		arrival.fromName = offer.fromName
		arrival.at = offer.touched
		inbox.arrivals.push(arrival)
	}
	if (inbox.arrivals.length > ARRIVALS_KEPT) {
		const kept: RArrival[] = []
		for (let i = inbox.arrivals.length - ARRIVALS_KEPT; i < inbox.arrivals.length; i++) {
			kept.push(inbox.arrivals[i])
		}
		inbox.arrivals = kept
	}
}

/** POST /v1/offer/{id}/finalize: missing chunks are one answer, a wrong whole-file digest another. */
function finalizeReply(inbox: Inbox, offerId: string, digestFile: DigestFileFn): WireReply {
	const offer = offerById(inbox, offerId)
	if (offer == null) {
		return failWith('OFFER_UNKNOWN', { offer_id: offerId } as UTSJSONObject)
	}
	const verified: UTSJSONObject[] = []
	let whole = true
	for (let i = 0; i < offer.files.length; i++) {
		const file = offer.files[i]
		const count = chunkCount(file.size)
		const missing: number[] = []
		for (let k = 0; k < count; k++) {
			if (!file.chunks.has(k)) {
				missing.push(k)
			}
		}
		let ok = missing.length == 0
		if (ok) {
			// Re-read what is on disk rather than trusting the per-chunk digests: chunks that each
			// hash correctly can still sit at the wrong offset.
			ok = digestFile(file.land) == file.sha256
			if (!ok) {
				// And when that read disagrees, the ledger stops being evidence of anything: forget the
				// chunks it recorded. A re-pushed chunk whose digest is still written down would be
				// answered "already stored" and thrown away, so the sender's whole-file resend - its last
				// move - would rewrite zero bytes and the offer could never come back. That is what the
				// emulator measured (#127 leg 2: the file deleted under a ledger holding both chunks;
				// finalize refused it, the resend changed nothing, FILE_DIGEST_MISMATCH was the last
				// word, and the card went on saying 已校验过，这个文件已经不在了).
				// A file with chunks genuinely still missing is left alone: there the ledger is not
				// contradicted, merely unfinished, and its list is the whole point of the resume.
				file.chunks.clear()
			}
		}
		// Read back after that decision, so a ledger just erased here and the answer the sender gets
		// cannot disagree: the reply says what this end can still show, which after a contradiction is
		// nothing.
		const holes: number[] = []
		for (let k = 0; k < count; k++) {
			if (!file.chunks.has(k)) {
				holes.push(k)
			}
		}
		file.verdict = ok ? 1 : 2
		file.missingAt = holes.length
		if (!ok) {
			whole = false
		}
		const entry: UTSJSONObject = { id: file.id, ok: ok, missing: holes, path: ok ? file.dest : null }
		verified.push(entry)
	}
	if (whole) {
		// Nothing is left to resume. Say so before the ledger goes away: a crash between these two
		// steps still tells the next run the truth, and unfinished is the only state the reclaim of
		// spec §4 is allowed to delete.
		offer!.complete = true
		recordArrivals(inbox, offer!)
	}
	return okWith({ offer_id: offerId, verified: verified } as UTSJSONObject)
}

function abortReply(inbox: Inbox, offerId: string, drop: DropFn, digestFile: DigestFileFn): WireReply {
	const offer = offerById(inbox, offerId)
	if (offer == null) {
		return failWith('OFFER_UNKNOWN', { offer_id: offerId } as UTSJSONObject)
	}
	releaseFiles(offer!, drop, digestFile)
	dropOffer(inbox, offerId)
	// The sender walked away from this id, which is the same fact the reclaim records: a manifest that
	// still turns up under it - §4's closed connection resends once - gets that answer, not a new card.
	const gone = failWith('OFFER_UNKNOWN', { offer_id: offerId } as UTSJSONObject)
	settleOffer(inbox, offerId, gone.status, gone.body)
	return okWith({ offer_id: offerId, dropped: true } as UTSJSONObject)
}

function dropOffer(inbox: Inbox, offerId: string): void {
	const kept: ROffer[] = []
	for (let i = 0; i < inbox.offers.length; i++) {
		if (inbox.offers[i].offerId != offerId) {
			kept.push(inbox.offers[i])
		}
	}
	inbox.offers = kept
}

/** The answer this session already gave for an offer id, if any. */
function settledOf(inbox: Inbox, offerId: string): SettledOffer | null {
	for (let i = inbox.settled.length - 1; i >= 0; i--) {
		if (inbox.settled[i].id == offerId) {
			return inbox.settled[i]
		}
	}
	return null
}

/** Record a person's answer so the sender's next POST gets the same one. The host owns the moment this
 *  happens, because on the platform that cannot hold a connection open the decision arrives after the
 *  request that asked for it is gone. */
export function settleOffer(inbox: Inbox, offerId: string, status: number, body: string): void {
	if (settledOf(inbox, offerId) != null) {
		return
	}
	const entry = new SettledOffer()
	entry.id = offerId
	entry.status = status
	entry.body = body
	inbox.settled.push(entry)
	while (inbox.settled.length > 24) {
		inbox.settled.splice(0, 1)
	}
}

/* ---------------------------------------------------------------------- the dispatcher */

/** The whole server side, one call per request. Returns pending when the answer needs a human; the
 *  host keeps the reply callback and calls resolveOffer() when the user taps. */
export function handleReceive(
	inbox: Inbox,
	self: LocalPeer,
	now: number,
	req: Req,
	hexOf: HexFn,
	keyFp: KeyFpFn,
	verify: VerifyFn,
	prepare: PrepareFn,
	writeAt: WriteFn,
	digestFile: DigestFileFn,
	drop: DropFn
): WireReply {
	const parts = req.path.split('?')[0].split('/')
	if (req.method == 'GET' && req.path == '/v1/hello') {
		return okWith({
			peer_id: self.peerId,
			name: self.name,
			protocol_version: PROTOCOL_VERSION,
			compatible_versions: COMPATIBLE_VERSIONS,
			features: ['resume', 'chunk-hash', 'directory'],
			port: self.port,
			fingerprint: self.fingerprint,
			// The number a scanner checks its QR prefix against. Answering with the identity digest here
			// is what made a phone undiallable from its own pairing string (#115): the socket presents the
			// leaf, so that is the digest the prefix has to describe. A platform that never filled `served`
			// in is one whose leaf *is* its identity, and the two numbers are then the same by definition.
			served: self.served == '' ? self.fingerprint : self.served,
			chunk_pace_ms: self.chunkPaceMs
		} as UTSJSONObject)
	}
	if (req.method == 'POST' && req.path == '/v1/pair') {
		// A peer that went silent must not be the reason a live one gets PEER_BUSY, so the slot is
		// swept for silence before it is counted - this is the moment it matters.
		sweep(inbox, now, drop, digestFile)
		return pairReply(inbox, self, now, req.client, req.json, keyFp, verify)
	}
	// Everything else is authenticated the same way: no session token, no transfer.
	const caller = fpOfToken(inbox, req.token)
	if (caller == '') {
		return failWith('NOT_PAIRED', null)
	}
	// Every authenticated request is a heartbeat: it resets the peer's idle clock, and it is the
	// cheapest place to sweep - a stalled offer and a silent session both stop moving here.
	seenNow(inbox, caller, now)
	sweep(inbox, now, drop, digestFile)
	if (req.method == 'POST' && req.path == '/v1/offer') {
		return offerReply(inbox, now, req.json, caller)
	}
	if (parts.length > 2 && parts[1] == 'v1' && parts[2] == 'offer') {
		const offerId = parts[3]
		const tail = parts.length > 4 ? parts[4] : ''
		if (req.method == 'GET' && tail == 'state') {
			return stateReply(inbox, offerId)
		}
		if (req.method == 'POST' && tail == 'finalize') {
			return finalizeReply(inbox, offerId, digestFile)
		}
		if (req.method == 'PUT' && tail == 'chunk' && parts.length == 7) {
			return chunkReply(inbox, now, offerId, parts[5], Math.floor(parseFloat(parts[6])), req.body, req.sha, hexOf, writeAt)
		}
		if (req.method == 'DELETE') {
			return abortReply(inbox, offerId, drop, digestFile)
		}
	}
	return failWith('OFFER_UNKNOWN', { path: req.method + ' ' + req.path } as UTSJSONObject)
}

/** The user's answer to one pending offer. Accepting allocates every file up front, exactly like the
 *  PC does, so a full disk is refused before a single chunk crosses the wire. */
export function resolveOffer(inbox: Inbox, offerId: string, accepted: boolean, prepare: PrepareFn, drop: DropFn): WireReply {
	const offer = offerById(inbox, offerId)
	if (offer == null || !offer!.awaiting) {
		return failWith('OFFER_UNKNOWN', { offer_id: offerId } as UTSJSONObject)
	}
	if (!accepted) {
		const refused = failWith('DECLINED', null)
		// Recorded here rather than only by whoever delivers it: the answer belongs to the offer id,
		// and a host that answered the sender and forgot to write it down would ask the user again.
		settleOffer(inbox, offerId, refused.status, refused.body)
		dropOffer(inbox, offerId)
		return refused
	}
	for (let i = 0; i < offer!.files.length; i++) {
		const file = offer!.files[i]
		const dest = prepare(file.land, file.size)
		if (dest == '') {
			// Roll back what was already allocated: a half-accepted offer would strand files the
			// sender was just told do not exist.
			for (let k = 0; k < i; k++) {
				drop(offer!.files[k].land)
			}
			const full = failWith('STORAGE_FULL', { relpath: file.relpath } as UTSJSONObject)
			settleOffer(inbox, offerId, full.status, full.body)
			dropOffer(inbox, offerId)
			return full
		}
		file.dest = dest
	}
	offer!.awaiting = false
	return okWith(payloadOf(offer!))
}

/** The offer list plus the code, as data - the page owns every word shown from this. */
export function snapshot(inbox: Inbox, now: number): ReceiveSnapshot {
	const out = new ReceiveSnapshot()
	out.pairCode = currentPairCode(inbox, now)
	out.passphrase = inbox.passphrase
	out.staticCode = PAIR_CODE_STATIC
	out.codeSecondsLeft = codeSecondsLeft(inbox, now)
	out.peers = inbox.trusted.length
	out.lostName = inbox.lostName
	const active = activePeers(inbox)
	for (let i = 0; i < active.length; i++) {
		// The name came in on the pair request and lives in the pin entry; a peer this end dialled
		// out to has one too, because helloPeer pins it by the same number.
		let name = ''
		for (let k = 0; k < inbox.trusted.length; k++) {
			const pin = inbox.trusted[k]
			if (pin.fingerprint == active[i] || (pin.tlsFingerprint != '' && pin.tlsFingerprint == active[i])) {
				name = pin.name
			}
		}
		out.connectedNames.push(name == '' ? '对端 ' + active[i].substring(0, 8) + '…' : name)
	}
	for (let i = 0; i < inbox.offers.length; i++) {
		const offer = inbox.offers[i]
		if (offer.awaiting) {
			out.pendingOfferIds.push(offer.offerId)
			out.pendingFrom.push(offer.fromName)
		}
		// The same clock spec §3 uses to take a session slot back, read here so a row can say what the
		// offer really is: still being filled, or waiting on a peer that has already left the network.
		const gone = !offer.awaiting && now - offer.touched >= SESSION_IDLE_S
		for (let k = 0; k < offer.files.length; k++) {
			const file = offer.files[k]
			if (file.verdict == 1 && hasArrival(inbox, file.land)) {
				// A finished offer has an arrival record for each file it delivered, and that record is
				// the row below. Counting the same bytes twice would inflate 已验证 while the offer is
				// still in memory. A file verified inside an offer that did not finish has no record -
				// its row stays the live one, or the card would lose a file that passed.
				continue
			}
			const row = new FileRow()
			row.offerId = offer.offerId
			row.fromName = offer.fromName
			row.relpath = file.relpath
			row.land = file.land
			row.size = file.size
			row.type = file.type
			row.dest = file.dest
			row.awaiting = offer.awaiting
			row.verdict = file.verdict
			row.have = file.chunks.size
			row.count = chunkCount(file.size)
			row.missingAt = file.missingAt
			row.senderGone = gone && file.verdict != 1
			out.rows.push(row)
			if (file.verdict == 1) {
				out.verifiedFiles = out.verifiedFiles + 1
			}
			if (file.verdict == 2) {
				out.rejectedFiles = out.rejectedFiles + 1
			}
		}
	}
	// The arrival record comes last: 传输页 reads rows[0] as the thing in progress, and a file that
	// already settled must not take that seat. Within the record the order is the order they landed.
	for (let i = 0; i < inbox.arrivals.length; i++) {
		const a = inbox.arrivals[i]
		const row = new FileRow()
		row.fromName = a.fromName
		row.relpath = a.relpath
		row.land = a.land
		row.size = a.size
		row.dest = a.dest
		row.verdict = 1
		row.landed = true
		out.rows.push(row)
		out.verifiedFiles = out.verifiedFiles + 1
	}
	return out
}

/** Say which of the landed rows the disk still agrees with. The state machine never touches a
 *  filesystem, so each platform runs this over its own receive root; a row it marks is the card's
 *  business from then on. */
export function markLanded(rows: FileRow[], exists: ExistsFn): void {
	for (let i = 0; i < rows.length; i++) {
		const row = rows[i]
		// A record written before offers had their own directory names the flat path, and that is where
		// those bytes still are - so an empty `land` means `relpath`, not a guess at the new shape.
		const where = landingOr(row.land, row.relpath)
		if (row.landed && !exists(where)) {
			row.gone = true
		}
	}
}

/* ------------------------------------------------------------------ interrupted offers */

/** The same document app/net/receive.py writes as .chuanshu.state.json, so a phone that dies
 *  mid-transfer re-adopts its own offers the way the PC does. */
export function stateJson(inbox: Inbox, offerId: string): string {
	const offer = offerById(inbox, offerId)
	if (offer == null) {
		return ''
	}
	const files: UTSJSONObject[] = []
	const received: UTSJSONObject = {}
	for (let i = 0; i < offer!.files.length; i++) {
		const file = offer!.files[i]
		const entry: UTSJSONObject = {
			id: file.id,
			relpath: file.relpath,
			land: file.land,
			size: file.size,
			sha256: file.sha256,
			mtime: file.mtime,
			type: file.type,
			/** A restart that re-adopts a finished transfer has to know it finished: without this the
			 *  row comes back with every chunk counted and no verdict, which the screen reads as a
			 *  transfer still running. */
			verdict: file.verdict,
			dest: file.dest
		}
		files.push(entry)
		const chunks: UTSJSONObject = {}
		for (let k = 0; k < chunkCount(file.size); k++) {
			const digest = file.chunks.get(k)
			if (digest != null) {
				chunks.set(k.toString(), digest!)
			}
		}
		received.set(file.id, chunks)
	}
	const body: UTSJSONObject = {
		offer_id: offer!.offerId,
		files: files,
		received: received,
		from_name: offer!.fromName,
		/** §4 counts both windows from the last evidence the transfer is alive, so both clocks have to be
		 *  in the document. Without them every restart rewinds the window and an offer whose sender died comes
		 *  back on the card forever, saying "还没收到分块" about a transfer nobody is resuming. */
		created: offer!.created,
		touched: offer!.touched,
		/** Written so a crash between finalize and this document going away cannot hand the next run
		 *  an unfinished offer - unfinished is the only state the idle reclaim is allowed to delete. */
		complete: offer!.complete
	}
	return JSON.stringify(body)
}

/** All offers a restart would have to re-adopt, one document each. A finished one is not on the list:
 *  the PC deletes its ledger at finalize for the same reason - a record of a transfer that cannot be
 *  resumed only invites the next run to treat it as one. */
export function stateAll(inbox: Inbox): string[] {
	const out: string[] = []
	for (let i = 0; i < inbox.offers.length; i++) {
		if (!inbox.offers[i].awaiting && !inbox.offers[i].complete) {
			out.push(stateJson(inbox, inbox.offers[i].offerId))
		}
	}
	return out
}

export function adopt(inbox: Inbox, text: string, now: number): boolean {
	const body = parseJson(text)
	if (body == null) {
		return false
	}
	if (body!.getBoolean('complete', false)) {
		// The document outlived its own deletion (a crash between the two). The bytes it describes are
		// already whole and verified, so re-adopting them would hand the reclaim a transfer it thinks
		// it may delete.
		return false
	}
	const offerId = body.getString('offer_id', '')
	const files = body.getArray<UTSJSONObject>('files')
	if (offerId == '' || files == null || files.length == 0) {
		return false
	}
	if (offerById(inbox, offerId) != null) {
		return true
	}
	const offer = new ROffer()
	offer.offerId = offerId
	offer.awaiting = false
	// The idle window belongs to the transfer, not to this process: read back the clocks the document
	// carries, so a restart an hour after the sender went silent is a stall rather than a fresh chance.
	// A document from a build that wrote neither has no honest answer, so it gets this moment.
	const stamped = body.getNumber('created', 0)
	const last = body.getNumber('touched', 0)
	offer.created = stamped > 0 ? stamped : now
	offer.touched = last > 0 ? last : (stamped > 0 ? stamped : now)
	offer.fromName = body.getString('from_name', '')
	const received = body.getJSON('received')
	for (let i = 0; i < files.length; i++) {
		const entry = files[i]
		const file = new RFile()
		file.id = entry.getString('id', '')
		file.relpath = entry.getString('relpath', '')
		// A ledger written before offers owned a directory describes flat bytes; resume it where those
		// bytes are, rather than moving the transfer out from under its own chunk list.
		file.land = landingOr(entry.getString('land', ''), file.relpath)
		file.size = Math.floor(entry.getNumber('size', 0))
		file.sha256 = entry.getString('sha256', '')
		file.mtime = Math.floor(entry.getNumber('mtime', 0))
		file.type = entry.getString('type', 'application/octet-stream')
		file.verdict = Math.floor(entry.getNumber('verdict', 0))
		file.dest = entry.getString('dest', '')
		if (file.dest == '') {
			file.dest = file.land
		}
		if (received != null) {
			const chunks = received!.getJSON(file.id)
			if (chunks != null) {
				for (let k = 0; k < chunkCount(file.size); k++) {
					const digest = chunks!.getString(k.toString(), '')
					if (digest != '') {
						file.chunks.set(k, digest)
					}
				}
			}
		}
		offer.files.push(file)
	}
	inbox.offers.push(offer)
	return true
}

export function adoptAll(inbox: Inbox, list: string[], now: number): number {
	let count = 0
	for (let i = 0; i < list.length; i++) {
		if (adopt(inbox, list[i], now)) {
			count = count + 1
		}
	}
	return count
}

/* ------------------------------------------------- the arrival record, read and written back */

/** One line per arrival, in the shape adoptArrivals reads back. */
export function arrivalsAll(inbox: Inbox): string[] {
	const out: string[] = []
	for (let i = 0; i < inbox.arrivals.length; i++) {
		const a = inbox.arrivals[i]
		out.push(JSON.stringify({
			relpath: a.relpath,
			land: a.land,
			size: a.size,
			dest: a.dest,
			from: a.fromName,
			at: a.at
		} as UTSJSONObject))
	}
	return out
}

/** Merge, not replace: a host that writes this file from two places (the card tick and an accept)
 *  must not lose the half the other one recorded. A record whose file the user deleted stays - the
 *  card says so rather than dropping the row, which is what the PC's （已经不在了） does. */
export function adoptArrivals(inbox: Inbox, list: string[]): number {
	let count = 0
	for (let i = 0; i < list.length; i++) {
		const line = list[i].trim()
		if (line == '') {
			continue
		}
		const body = parseJson(line)
		if (body == null) {
			continue
		}
		const relpath = body!.getString('relpath', '')
		if (relpath == '') {
			continue
		}
		// Keyed by where the bytes went, the same key recordArrivals uses: two offers may deliver the same
		// name, and the second one's copy is a second file rather than the first arriving again. A record
		// written before offers had their own directory is flat, under the sent name.
		const land = landingOr(body!.getString('land', ''), relpath)
		let known = false
		for (let k = 0; k < inbox.arrivals.length; k++) {
			if (inbox.arrivals[k].land == land) {
				known = true
			}
		}
		if (known) {
			continue
		}
		const arrival = new RArrival()
		arrival.relpath = relpath
		arrival.land = land
		arrival.size = body!.getNumber('size', 0)
		arrival.dest = body!.getString('dest', '')
		arrival.fromName = body!.getString('from', '')
		arrival.at = body!.getNumber('at', 0)
		inbox.arrivals.push(arrival)
		count = count + 1
	}
	return count
}

/** A process restart: sessions and pending transfers leave memory, the trust store does not. That
 *  asymmetry is the design - the peer re-pairs from its pinned key, so the user notices nothing.
 *  The pairing material survives too when the build is a static-code one: forgetting it would mint
 *  a fresh code behind a QR somebody already printed.
 *  The arrival record survives for the same reason as the trust store, and this function is only ever
 *  run by the browser harness: a phone reads its own files back instead, and there the receipts are a
 *  file beside the bytes they describe. */
export function restartLike(inbox: Inbox): void {
	inbox.tokens = []
	inbox.nonces = []
	inbox.fails = []
	inbox.offers = []
	inbox.heldBy = ''
	inbox.heldSeen = 0
	inbox.lostName = ''
	if (!PAIR_CODE_STATIC) {
		inbox.pairCode = ''
		inbox.passphrase = ''
		inbox.pairCodeUntil = 0
	}
}

/** The two secrets in the shape the PC writes as identity/pairing.json, so the same file means the
 *  same thing on both ends. */
export function pairingJson(inbox: Inbox, now: number): string {
	currentPairCode(inbox, now)
	const body: UTSJSONObject = { code: inbox.pairCode, passphrase: inbox.passphrase }
	return JSON.stringify(body)
}

/** Read that document back. Nothing is minted here: a host that has no pairing file simply calls
 *  currentPairCode(), which mints on the spot and persists whatever it produced. */
export function adoptPairing(inbox: Inbox, text: string): boolean {
	const body = parseJson(text)
	if (body == null) {
		return false
	}
	const code = body.getString('code', '')
	const passphrase = body.getString('passphrase', '')
	if (code == '' || passphrase == '') {
		return false
	}
	inbox.pairCode = code
	inbox.passphrase = passphrase
	inbox.pairCodeUntil = 0
	return true
}

/** The peers allowed to send into this device, in the shape the PC writes as identity/trusted.json:
 *  keyed by the identity fingerprint, with the TLS leaf digest only for the peers that serve one
 *  signed by another key. restartLike() deliberately leaves `trusted` in memory, and on a browser
 *  that is the process; on a phone the process ends when the app does, so the host writes this
 *  document out and reads it back before the listener opens. Without it every restart asks a person
 *  to retype a code whose whole purpose is to be typed once. */
export function trustJson(inbox: Inbox): string {
	const body: UTSJSONObject = {}
	for (let i = 0; i < inbox.trusted.length; i++) {
		const pin = inbox.trusted[i]
		const entry: UTSJSONObject = { peer_id: pin.peerId, name: pin.name, public_key: pin.publicKeyB64 }
		if (pin.tlsFingerprint != '') {
			entry.set('tls_fingerprint', pin.tlsFingerprint)
		}
		body.set(pin.fingerprint, entry)
	}
	return JSON.stringify(body)
}

/** Merged, not replaced: a host that loads last week's file after this process already pinned
 *  somebody new must not answer for the new one with a stale list. */
export function adoptTrust(inbox: Inbox, text: string): number {
	const body = parseJson(text)
	if (body == null) {
		return 0
	}
	let added = 0
	const keys = UTSJSONObject.keys(body!)
	for (let i = 0; i < keys.length; i++) {
		const fingerprint = keys[i]
		if (trustByFp(inbox, fingerprint) != null) {
			continue
		}
		const entry = body!.getJSON(fingerprint)
		if (entry == null) {
			continue
		}
		const pin = new Trust()
		pin.fingerprint = fingerprint
		pin.peerId = entry!.getString('peer_id', '')
		pin.name = entry!.getString('name', '')
		pin.publicKeyB64 = entry!.getString('public_key', '')
		pin.tlsFingerprint = entry!.getString('tls_fingerprint', '')
		inbox.trusted.push(pin)
		added = added + 1
	}
	return added
}
