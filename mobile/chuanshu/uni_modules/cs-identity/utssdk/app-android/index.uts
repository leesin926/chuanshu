import KeyPairGenerator from 'java.security.KeyPairGenerator'
import MessageDigest from 'java.security.MessageDigest'
import PrivateKey from 'java.security.PrivateKey'
import Security from 'java.security.Security'
import Signature from 'java.security.Signature'
import KeyStore from 'java.security.KeyStore'
import CertificateFactory from 'java.security.cert.CertificateFactory'
import Certificate from 'java.security.cert.Certificate'
import InputStream from 'java.io.InputStream'
import ByteArrayInputStream from 'java.io.ByteArrayInputStream'
import ByteArrayOutputStream from 'java.io.ByteArrayOutputStream'
import Base64 from 'java.util.Base64'
import BigInteger from 'java.math.BigInteger'
import Calendar from 'java.util.Calendar'
import Date from 'java.util.Date'
import Locale from 'java.util.Locale'
import Thread from 'java.lang.Thread'
import TimeZone from 'java.util.TimeZone'
import SecureRandom from 'java.security.SecureRandom'
import SimpleDateFormat from 'java.text.SimpleDateFormat'
import X509Certificate from 'java.security.cert.X509Certificate'
import System from 'java.lang.System'
import SSLContext from 'javax.net.ssl.SSLContext'
import KeyManagerFactory from 'javax.net.ssl.KeyManagerFactory'
import TrustManagerFactory from 'javax.net.ssl.TrustManagerFactory'
import SSLServerSocket from 'javax.net.ssl.SSLServerSocket'
import SSLSocket from 'javax.net.ssl.SSLSocket'
import Build from 'android.os.Build'
import Charsets from 'kotlin.text.Charsets'

/** One line per capability, appended as we go.
 *  The point of this file is not the result but the last line it managed to write: on a device
 *  where Ed25519 is missing we need to see "keygen failed", not a silent blank screen, because
 *  that line decides whether the phone signs with a BC-supplied key or a platform one. */
export function identityProbe(): string {
	let out = ''
	out = out + 'sdk=' + Build.VERSION.SDK_INT + ' release=' + Build.VERSION.RELEASE + '\n'

	const bc = Security.getProvider('BC')
	out = out + 'provider BC: ' + (bc == null ? 'absent' : bc!.getName() + ' v' + bc!.getVersion()) + '\n'
	const dc = Security.getProvider('Conscrypt')
	out = out + 'provider Conscrypt: ' + (dc == null ? 'absent' : dc!.getName()) + '\n'
	// 只报这两个名字是不够的：一台设备上「没有 Ed25519」有两种完全不同的原因——要么这个平台根本没带
	// 提供它的 provider，要么带了但排在 BC 后面、BC 先答了这个算法名。这两种情况要做的决定不一样，
	// 所以把整张 provider 表连版本号一起打出来。
	const all = Security.getProviders()
	let names = ''
	for (let i: Int = 0; i < all.size; i++) {
		names = names + all[i].getName() + '/' + all[i].getVersion() + ' '
	}
	out = out + 'providers: ' + names + '\n'
	out = out + tryKeygen('Ed25519', 'BC') + '\n'
	out = out + tryKeygen('EdDSA', 'BC') + '\n'
	out = out + tryKeygen('Ed25519', 'AndroidOpenSSL') + '\n'

	try {
		const gen = KeyPairGenerator.getInstance('Ed25519')
		const kp = gen.generateKeyPair()
		const pub = kp.getPublic()
		out = out + 'keygen ok: provider=' + gen.getProvider().getName()
			+ ' alg=' + pub.getAlgorithm() + ' fmt=' + pub.getFormat() + '\n'

		// getEncoded() on a public key is the SubjectPublicKeyInfo DER - the exact bytes the
		// PC side hashes (app/net/identity.py:_spki_der), so these two base64 strings must be
		// equal to what a desktop re-computation of the same key gives.
		const spki = pub.getEncoded()
		const enc = Base64.getEncoder()
		out = out + 'spki bytes=' + spki.size + ' b64=' + enc.encodeToString(spki) + '\n'

		const digest = MessageDigest.getInstance('SHA-256').digest(spki)
		out = out + 'fp b64=' + enc.encodeToString(digest) + '\n'

		const signer = Signature.getInstance('Ed25519')
		signer.initSign(kp.getPrivate())
		signer.update('chuanshu-probe'.toByteArray(Charsets.UTF_8))
		const signed = signer.sign()
		const checker = Signature.getInstance('Ed25519')
		checker.initVerify(pub)
		checker.update('chuanshu-probe'.toByteArray(Charsets.UTF_8))
		out = out + 'sign provider=' + signer.getProvider().getName() + ' verify=' + checker.verify(signed) + '\n'

		// The pieces a receiving phone needs later: a keystore to hold our own key, and the
		// factory that builds the server context. Both are checked here so a failure names the
		// one line that is missing instead of failing inside the transport months later.
		const ks = KeyStore.getInstance('PKCS12')
		ks.load(null, null)
		// setKeyEntry wants a certificate chain, not a key. UTS arrays are UTSArray<T>, so the
		// chain has to be typed as Certificate[] and then handed over as a native Kotlin array,
		// otherwise kotlinc sees UTSArray<Certificate> where Array<Certificate> is expected.
		const chain: Certificate[] = [pub as Certificate]
		ks.setKeyEntry('p', kp.getPrivate(), ''.toCharArray(), chain.toTypedArray())
		const kmf = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm())
		kmf.init(ks, ''.toCharArray())
		SSLContext.getInstance('TLS').init(kmf.getKeyManagers(), null, null)
		out = out + 'keystore+keymanager ok: kmf=' + kmf.getAlgorithm() + '\n'
		out = out + 'certfactory X.509 available\n'
	} catch (e : any) {
		out = out + 'stopped here: ' + e.toString() + '\n'
	}
	return out
}

/** Ask one provider for one algorithm by name, bypassing the fallback order.
 *  The providers table only says BC is installed; this says whether BC answers the name when it is
 *  asked directly. BC answering while the unqualified call threw means BC lost the lookup to another
 *  provider; BC throwing the same way means the jar on this base carries no Ed25519 entry. */
function tryKeygen(alg: string, prov: string): string {
	try {
		return 'ask ' + prov + ' for ' + alg + ': ok, answered by '
			+ KeyPairGenerator.getInstance(alg, prov).getProvider().getName()
	} catch (e : any) {
		return 'ask ' + prov + ' for ' + alg + ': ' + e.toString()
	}
}

// --------------------------------------------------------------------------- DER

/** Two OID/AlgorithmIdentifier blocks appear in every certificate we will ever make, so they are
 *  written out as their DER bytes instead of carrying a generic encoder: 1.3.101.112 (Ed25519)
 *  and 2.5.4.3 (commonName). */
const OID_ED25519: ByteArray = byteArrayOf(0x06, 0x03, 0x2b, 0x65, 0x70)
const OID_CN: ByteArray = byteArrayOf(0x06, 0x03, 0x55, 0x04, 0x03)

function cat(a: ByteArray, b: ByteArray): ByteArray {
	const out = new ByteArray(a.size + b.size)
	System.arraycopy(a, 0, out, 0, a.size)
	System.arraycopy(b, 0, out, a.size, b.size)
	return out
}

function join(parts: ByteArray[]): ByteArray {
	let out = new ByteArray(0)
	for (let i = 0; i < parts.length; i++) {
		out = cat(out, parts[i])
	}
	return out
}

function tlv(tag: Int, body: ByteArray): ByteArray {
	const n = body.size
	let head: ByteArray
	if (n < 0x80) {
		head = byteArrayOf(tag.toByte(), n.toByte())
	} else if (n < 0x100) {
		head = byteArrayOf(tag.toByte(), 0x81.toByte(), n.toByte())
	} else {
		head = byteArrayOf(tag.toByte(), 0x82.toByte(), (n >> 8).toByte(), (n & 0xff).toByte())
	}
	return cat(head, body)
}

function seqOf(parts: ByteArray[]): ByteArray {
	return tlv(0x30, join(parts))
}

function setOf(parts: ByteArray[]): ByteArray {
	return tlv(0x31, join(parts))
}

function algEd25519(): ByteArray {
	return seqOf([OID_ED25519])
}

function cnName(cn: string): ByteArray {
	return seqOf([setOf([seqOf([OID_CN, tlv(0x0c, cn.toByteArray(Charsets.UTF_8))])])])
}

function utcTime(millis: number): ByteArray {
	// UTCTime carries a two-digit year, and RFC 5280 resolves 00-69 to 20xx and 70-99 to 19xx, so an
	// expiry written past 2069 reads back as a date in the past. On the emulator "+3650 years" came back
	// as `Certificate expired at ... 1976`; keep whatever calls this inside that window.
	const f = new SimpleDateFormat("yyMMddHHmmss'Z'", Locale.US)
	f.setTimeZone(TimeZone.getTimeZone('UTC'))
	return tlv(0x17, f.format(new Date(millis.toLong())).toByteArray(Charsets.US_ASCII))
}

function yearLater(from: number, years: Int): number {
	const c = Calendar.getInstance()
	c.setTimeInMillis(from.toLong())
	c.add(Calendar.YEAR, years)
	return c.getTimeInMillis()
}

function tbsOf(peerId: string, spki: ByteArray, serial: BigInteger, notBefore: number, notAfter: number): ByteArray {
	return seqOf([
		tlv(0xa0, tlv(0x02, BigInteger.valueOf(2).toByteArray())),
		tlv(0x02, serial.toByteArray()),
		algEd25519(),
		cnName(peerId),
		seqOf([utcTime(notBefore), utcTime(notAfter)]),
		cnName(peerId),
		spki
	])
}

function certOf(tbs: ByteArray, sig: ByteArray): ByteArray {
	// BIT STRING: one leading unused-bits byte, always zero for Ed25519.
	return seqOf([tbs, algEd25519(), tlv(0x03, cat(new ByteArray(1), sig))])
}

const HEXD = '0123456789abcdef'

function hexOf(b: ByteArray): string {
	let s = ''
	for (let i: Int = 0; i < b.size; i++) {
		const v = b[i].toInt() & 0xff
		s = s + HEXD.charAt(v >> 4) + HEXD.charAt(v & 15)
	}
	return s
}

/** The node's own identity: a key it never sends and a certificate it hands out.
 *  Kept as one object because every later step (keystore, pinning, pairing UI) needs exactly
 *  these three things and nothing else. */
export class NodeKey {
	key: PrivateKey
	cert: ByteArray
	fp: string
	constructor(key: PrivateKey, cert: ByteArray, fp: string) {
		this.key = key
		this.cert = cert
		this.fp = fp
	}
}

export function buildNodeKey(peerId: string): NodeKey {
	const gen = KeyPairGenerator.getInstance('Ed25519')
	const kp = gen.generateKeyPair()
	const spki = kp.getPublic().getEncoded()
	const serial = new BigInteger(64, new SecureRandom())
	const now = System.currentTimeMillis()
	const tbs = tbsOf(peerId, spki, serial, now - 86400000, yearLater(now, 20))
	const signer = Signature.getInstance('Ed25519')
	signer.initSign(kp.getPrivate())
	signer.update(tbs)
	return new NodeKey(kp.getPrivate(), certOf(tbs, signer.sign()),
		hexOf(MessageDigest.getInstance('SHA-256').digest(spki)))
}

function readAll(ins: InputStream): ByteArray {
	const buf = new ByteArray(4096)
	const sink = new ByteArrayOutputStream()
	let n = ins.read(buf)
	while (n > 0) {
		sink.write(buf, 0, n)
		n = ins.read(buf)
	}
	return sink.toByteArray()
}

function certOfStream(der: ByteArray): X509Certificate {
	// Hand the keystore and the callers a certificate object produced by the platform parser. On
	// the PC side a builder-produced wrapper in the keystore made the handshake die with
	// "No available authentication scheme"; parsing here keeps that whole class of bug away.
	return CertificateFactory.getInstance('X.509')
		.generateCertificate(new ByteArrayInputStream(der)) as X509Certificate
}

/** A client that trusts exactly one certificate: the one we put in its trust store.
 *
 *  Deliberately not a trust-all TrustManager - UTS cannot express the Kotlin `Array<(out)
 *  X509Certificate!>` the interface declares, and even if it could, a client that accepts any
 *  chain proves nothing about pinning. This shape answers the question we actually have: does
 *  Android's own PKIX path building take a self-signed Ed25519 leaf? */
function pinContext(der: ByteArray): SSLContext {
	const tks = KeyStore.getInstance('PKCS12')
	tks.load(null, null)
	const pinned = certOfStream(der)
	const entry: Certificate[] = [pinned as Certificate]
	tks.setCertificateEntry('peer', entry[0])
	const tmf = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm())
	tmf.init(tks)
	const ctx = SSLContext.getInstance('TLS')
	ctx.init(null, tmf.getTrustManagers(), null)
	return ctx
}

var serverLog = ''

function serveRound(srv: SSLServerSocket, body: string) {
	const sk = srv.accept() as SSLSocket
	try {
		sk.startHandshake()
		// No client certificate exists in this protocol, so getPeerCertificates() would throw
		// SSLPeerUnverifiedException here - the client is the one that reports fingerprints.
		const n = sk.getInputStream().read(new ByteArray(2048))
		serverLog = serverLog + 'served req=' + n + ' proto=' + sk.getSession().getProtocol()
			+ ' cipher=' + sk.getSession().getCipherSuite() + '\n'
		if (n > 0) {
			// TLS 1.3 discards buffered records when the socket is closed outright, which looks to
			// the caller like a good handshake and an empty reply.
			sk.getOutputStream().write(body.toByteArray(Charsets.UTF_8))
			sk.getOutputStream().flush()
			sk.shutdownOutput()
		}
	} catch (e : any) {
		serverLog = serverLog + 'round ignored: ' + e.toString() + '\n'
	} finally {
		sk.close()
	}
}

function runServer(port: Int, nk: NodeKey, rounds: Int) {
	let srv: SSLServerSocket | null = null
	try {
		const ks = KeyStore.getInstance('PKCS12')
		ks.load(null, null)
		const parsed = certOfStream(nk.cert)
		const chain: Certificate[] = [parsed as Certificate]
		ks.setKeyEntry('p', nk.key, ''.toCharArray(), chain.toTypedArray())
		const kmf = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm())
		kmf.init(ks, ''.toCharArray())
		const ctx = SSLContext.getInstance('TLS')
		ctx.init(kmf.getKeyManagers(), null, null)
		srv = ctx.getServerSocketFactory().createServerSocket(port) as SSLServerSocket
		serverLog = serverLog + 'listening ' + port + '\n'
		const body = '{"peer_id":"' + nk.fp.substring(0, 8) + '","hello":"chuanshu"}'
		for (let i: Int = 0; i < rounds; i++) {
			serveRound(srv, body)
		}
	} catch (e : any) {
		serverLog = serverLog + 'server stopped: ' + e.toString() + '\n'
	} finally {
		if (srv != null) srv!.close()
	}
}

/** One pinned client run. Everything it does is conditional on the peer being the certificate we
 *  chose, so the caller can distinguish "handshake refused" from "handshake accepted the wrong
 *  thing" - the second is the only one that would be a security bug. */
function doClient(port: Int, expect: NodeKey, trustDer: ByteArray): string {
	let out = ''
	const sk = pinContext(trustDer).getSocketFactory().createSocket('127.0.0.1', port) as SSLSocket
	sk.getSSLParameters().setEndpointIdentificationAlgorithm('')
	sk.startHandshake()
	const peer = sk.getSession().getPeerCertificates()[0] as X509Certificate
	const got = hexOf(MessageDigest.getInstance('SHA-256').digest(peer.getPublicKey().getEncoded()))
	out = out + 'handshake: ' + sk.getSession().getProtocol() + ' ' + sk.getSession().getCipherSuite() + '\n'
	out = out + 'cert parses on android: subject=' + peer.getSubjectX500Principal().getName()
		+ ' sigAlg=' + peer.getSigAlgName() + '\n'
	out = out + 'pinned match: ' + (got == expect.fp) + ' seen=' + got + '\n'
	sk.getOutputStream().write('GET /v1/hello HTTP/1.1\r\nHost: chuanshu\r\n\r\n'.toByteArray(Charsets.UTF_8))
	sk.getOutputStream().flush()
	const resp = readAll(sk.getInputStream())
	out = out + 'reply: ' + resp.size + ' bytes\n'
	sk.close()
	return out
}

/** Probe B in one button: our own certificate, our own keystore, our own listener, and a client
 *  that only trusts the fingerprint - all inside the app over loopback.
 *
 *  It answers the three things a desktop cannot: does Android's X.509 parser take the DER we
 *  hand-built, does its TLS stack complete a handshake with a self-signed Ed25519 chain, and does
 *  the SPKI digest it presents equal the one we computed at keygen time. Loopback keeps the probe
 *  runnable with no second machine and no network configuration. */
export function tlsSelfCheck(peerId: string, port: number): string {
	let out = ''
	serverLog = ''
	let nk: NodeKey | null = null
	let other: NodeKey | null = null
	try {
		nk = buildNodeKey(peerId)
		other = buildNodeKey(peerId + '-stranger')
		out = out + 'fp=' + nk!.fp + ' der=' + nk!.cert.size + '\n'
		const p = port.toInt()
		UTSAndroid.getDispatcher('io').async(function (_) {
			runServer(p, nk!, 3)
		}, null)

		// The listener is opened on another dispatcher, so wait for it instead of assuming the
		// thread lost the race.
		let ready: SSLSocket | null = null
		for (let try_: Int = 0; try_ < 25 && ready == null; try_++) {
			Thread.sleep(120)
			try {
				ready = pinContext(nk!.cert).getSocketFactory().createSocket('127.0.0.1', p) as SSLSocket
			} catch (e : any) {
				ready = null
			}
		}
		if (ready == null) {
			out = out + 'connect never came up\n'
		} else {
			ready!.close()
		}

		// 1. our own certificate, trusted by our own fingerprint
		try {
			out = out + doClient(p, nk!, nk!.cert)
		} catch (e : any) {
			out = out + 'pin accepted FAILED: ' + e.toString() + '\n'
		}

		// 2. the same server, but this client only trusts a different key - the handshake has to
		//    fail, otherwise the pin is decorative.
		try {
			doClient(p, other!, other!.cert)
			out = out + 'stranger REJECTED: false\n'
		} catch (e : any) {
			out = out + 'stranger REJECTED: true, ' + e.toString() + '\n'
		}
	} catch (e : any) {
		out = out + 'client stopped: ' + e.toString() + '\n'
	}
	Thread.sleep(400)
	return out + '--- server ---\n' + serverLog
}

/** Probe B's offline half, on the phone: build a self-signed X.509 from raw DER with no
 *  BouncyCastle anywhere in sight, then read it back with the platform parser.
 *
 *  The fingerprint line is the one that matters - it has to match what the PC computes over the
 *  same SubjectPublicKeyInfo (app/net/identity.py:fingerprint_of), because pinning by SPKI digest
 *  is the entire trust model. */
export function certProbe(peerId: string): string {
	let out = ''
	try {
		const nk = buildNodeKey(peerId)
		out = out + 'cert der bytes=' + nk.cert.size + '\n'

		const parsed = certOfStream(nk.cert)
		parsed.checkValidity()
		out = out + 'parsed: sigAlg=' + parsed.getSigAlgName()
			+ ' subject=' + parsed.getSubjectX500Principal().getName() + '\n'

		parsed.verify(parsed.getPublicKey())
		out = out + 'verify with own pub: true\n'

		// A check that only ever passes proves nothing, so the same signature has to be refused by
		// a key that did not make it.
		const stranger = KeyPairGenerator.getInstance('Ed25519').generateKeyPair().getPublic()
		let rejected = 'no'
		try {
			parsed.verify(stranger)
		} catch (e2 : any) {
			rejected = 'yes'
		}
		out = out + 'stranger rejected: ' + rejected + '\n'

		const fpParsed = hexOf(MessageDigest.getInstance('SHA-256').digest(parsed.getPublicKey().getEncoded()))
		out = out + 'fp stable: ' + (nk.fp == fpParsed) + ' fp=' + nk.fp + '\n'
		out = out + 'b64=' + Base64.getEncoder().encodeToString(nk.cert) + '\n'
	} catch (e : any) {
		out = out + 'stopped here: ' + e.toString() + '\n'
	}
	return out
}

/** A probe that throws on a background dispatcher otherwise disappears without a trace, and the
 *  page has no way to learn that anything happened. Every async entry point goes through here. */
function guard(body: () => string): string {
	try {
		return body()
	} catch (e : any) {
		return 'crashed: ' + e.toString()
	}
}

/** The TLS self-check waits on a listener it starts itself, so it takes seconds; run it on the main
 *  thread and Android reports an ANR. Keeping the dispatchers inside the plugin also means the only
 *  thing a page has to get right is a callback, and the parts that can fail to compile live in a
 *  file the CLI is able to compile. */
function onIo(body: () => string, done: (text: string) => void) {
	UTSAndroid.getDispatcher('io').async(function (_) {
		const text = guard(body)
		UTSAndroid.getDispatcher('main').async(function (_) {
			done(text)
		}, null)
	}, null)
}

export function identityProbeAsync(done: (text: string) => void) {
	onIo(function (): string { return identityProbe() }, done)
}

export function certProbeAsync(done: (text: string) => void) {
	onIo(function (): string { return certProbe('android-probe-01') }, done)
}

export function tlsSelfCheckAsync(done: (text: string) => void) {
	onIo(function (): string { return tlsSelfCheck('android-probe-01', 43799) }, done)
}
