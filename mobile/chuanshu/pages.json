{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://doc.dcloud.net.cn/uni-app-x/collocation/pagesjson.html
		{
			/* 首页按设计图没有导航条，「传书」是页面内左对齐的超大标题，所以这一页用 custom。 */
			"path": "pages/home/home",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "传书"
			}
		},
		{
			"path": "pages/files/files",
			"style": {
				"navigationBarTitleText": "文件管理"
			}
		},
		{
			/* 设计图把「传输」当成第四个常驻分类，而不是某个动作的过程页：进度、速度和历史是用户
			   会反复回来看的东西，藏在二级页里等于每次都要从首页点进去。 */
			"path": "pages/detail/detail",
			"style": {
				"navigationBarTitleText": "传输详情"
			}
		},
		{
			"path": "pages/me/me",
			"style": {
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/send/send",
			"style": {
				"navigationBarTitleText": "发送文件"
			}
		},
		{
			"path": "pages/scan/scan",
			"style": {
				"navigationBarTitleText": "扫码连接"
			}
		},
		{
			"path": "pages/probe/probe",
			"style": {
				"navigationBarTitleText": "传书 · 探针"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "传书",
		/* 设计图的导航条和页面同色、中间没有分隔线，所以两处底色都是 #EEF0F5。 */
		"navigationBarBackgroundColor": "#EEF0F5",
		"backgroundColor": "#EEF0F5"
	},
	/* tabBar 在鸿蒙上要 4.61+ 才支持，且不支持 iconfont / midButton / backgroundImage；图标只能是
	   本地 png（81x81、40KB 以内），由 mobile/scripts/gen_tabbar.py 画出来。
	   设计图是未选中线框灰 #9CA3AF、选中实心蓝 #2F7CF6，所以每个字形都要出两张。 */
	"tabBar": {
		"color": "#9CA3AF",
		"selectedColor": "#2F7CF6",
		"backgroundColor": "#ffffff",
		"borderStyle": "white",
		"list": [
			{
				"pagePath": "pages/home/home",
				"text": "首页",
				"iconPath": "static/tabbar/home.png",
				"selectedIconPath": "static/tabbar/home-on.png"
			},
			{
				"pagePath": "pages/files/files",
				"text": "文件",
				"iconPath": "static/tabbar/files.png",
				"selectedIconPath": "static/tabbar/files-on.png"
			},
			{
				"pagePath": "pages/detail/detail",
				"text": "传输",
				"iconPath": "static/tabbar/transfer.png",
				"selectedIconPath": "static/tabbar/transfer-on.png"
			},
			{
				"pagePath": "pages/me/me",
				"text": "我的",
				"iconPath": "static/tabbar/me.png",
				"selectedIconPath": "static/tabbar/me-on.png"
			}
		]
	},
	"uniIdRouter": {}
}
