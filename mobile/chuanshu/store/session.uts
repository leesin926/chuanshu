/** The one session this device has, shared by every page.
 *
 *  The app used to be a single page holding all of it, which decided what the interface could be:
 *  a connection made on the send screen could not be seen anywhere else, so every question the user
 *  asked had to be answered on the same scroll. Moving the state here is what lets 首页 connect and
 *  发送文件 send without either one owning the socket.
 *
 *  Two halves live in this file, and they are deliberately different shapes. `s` is reactive and is
 *  what a template reads; everything the transport owns - the inbox, the live session, the picked
 *  files - is a plain module value, because a session is not a view model and a page must never be
 *  able to write half of one.
 */

import {
	TransferOptions,
	PeerSession,
	connectPeer,
	sendFiles,
	cancelSend,
	SelfCallback,
	SignCallback,
	ReplyCallback,
	MetaCallback,
	BufferCallback,
	HexCallback
} from '@/uni_modules/cs-transport/utssdk/cs-client.uts'
import { TRANSPORT_PORT, PAIR_CODE_DIGITS, PASSPHRASE_CHARS, SESSION_IDLE_S, codeReject, passReject, digitsOnly, formatSize, parsePairUrl } from '@/uni_modules/cs-transport/utssdk/cs-protocol.uts'
import { selfInfo, signPair, request, prepareFile, readChunk, digestHex, transportMocked, transportNote, lanCheck } from '@/uni_modules/cs-transport'
// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
import { pinnedFor, unpinPeer, receiveStart, receiveStop, receiveStatus } from '@/uni_modules/cs-transport'
// #endif
// #ifdef APP-ANDROID || APP-HARMONY
/** Only the phones have a request that can be forty seconds into a body when the user presses 取消: both
 *  write a chunk at the peer's pace, and the browser's peer answers as fast as the loop asks. The name is
 *  therefore this file's, not the pages', and iOS is out of scope, so it has no half to reach. */
import { abandonSend } from '@/uni_modules/cs-transport'
// #endif
// #ifdef WEB
import { demoPeer, demoQrUrl, demoExpireToken, setDemoFault, demoRestart, demoUnpin, pinnedFingerprint } from '@/uni_modules/cs-transport'
import { receiveWrongCode, demoPcConnect, demoPcSend, demoPcDisconnect, demoPcConnected, setSenderFault, setReceiveFault, receiveSelfReport, discoverySelfReport } from '@/uni_modules/cs-transport'
/** The same roster the three phones merge announcements into. The browser cannot hear the LAN, so what
 *  it feeds these functions is written by hand further down and labelled as demo data on the card. */
import { newRoster, applyAnnounce, applyTxt, buildAnnounce, buildTxt, sweepPeers, candidatesOf } from '@/uni_modules/cs-transport/utssdk/cs-discovery.uts'
// #endif
// #ifdef APP-ANDROID || APP-IOS || WEB
/** The receiving half, in the shape this platform can offer it: the browser keeps the inbox in
 *  memory, Android keeps it in the plugin's Kotlin. Harmony is the odd one and defines the same six
 *  names itself further down, because its ArkTS half cannot read the shared state machine at all -
 *  importing there would collide with those definitions. */
import { receiveCode, receivePassphrase, receiveRotatePairing, receiveHoldSlot, receiveSeen, receiveSnapshot, receiveDecide } from '@/uni_modules/cs-transport'
// #endif
// #ifdef APP-ANDROID || APP-IOS
/** Both phones keep their roster inside the plugin, because on both UTS does compile against the native
 *  language and the sockets run on their own threads; the six names below are the module's own. They are
 *  re-exported under one page-facing spelling so a page asks the same question on every phone - only
 *  Harmony has to build the same six in this file instead. */
import { discoverStart, discoverStop, discoverPeers, discoverStatus, discoverVerify, discoverySelfReport } from '@/uni_modules/cs-transport'
// #endif
// #ifdef APP-HARMONY
/** These two lists have no one place to merge into on this platform. The ArkTS half of the module
 *  cannot read ../cs-receive.uts at all, so here the state machine is imported from its own path and
 *  runs as JavaScript next to the page, and everything it needs from the device arrives as one of the
 *  plain functions below. Android keeps the same six names inside the module, because there UTS does
 *  compile against Kotlin; the pages call them identically either way. */
import {
	Inbox,
	Req,
	LocalPeer,
	ReceiveSnapshot,
	newInbox,
	handleReceive,
	resolveOffer,
	settleOffer,
	snapshot,
	adoptPairing,
	pairingJson,
	currentPairCode,
	passphraseOf,
	rotatePairing,
	holdSlotFor,
	seenNow,
	sweep,
	adoptPin,
	trustJson,
	adoptTrust,
	stateAll,
	adoptAll,
	arrivalsAll,
	adoptArrivals,
	markLanded
} from '@/uni_modules/cs-transport/utssdk/cs-receive.uts'
import {
	serveBind,
	serveReply,
	servedFingerprint,
	pinForAddress,
	storePrepareFile,
	storeWriteAt,
	storeDigestFile,
	storeDropFile,
	storeFileExists,
	digestBytes,
	fingerprintOfKey,
	verifySignature,
	peerIdText,
	deviceNameText,
	identityFingerprint,
	loadPairing,
	savePairing,
	loadTrustedPeers,
	saveTrustedPeers,
	loadOfferStates,
	saveOfferStates,
	loadArrivalStates,
	saveArrivalStates
} from '@/uni_modules/cs-transport'
/** The discovery model, by its own path for the same reason the receive machine above is: this is the
 *  one platform where the plugin cannot read it. A phone that merged candidates by its own rules would
 *  show a PC a different list than a browser shows the same PC. */
import {
	Roster,
	newRoster,
	prefixOf,
	forgetMdns,
	sweepPeers,
	candidatesOf,
	markVerified,
	buildAnnounce,
	buildTxt,
	applyAnnounce,
	applyTxt,
	channelNote,
	selfReport
} from '@/uni_modules/cs-transport/utssdk/cs-discovery.uts'
import {
	serveIsRunning,
	servePort,
	lanBind,
	lanOpen,
	lanClose,
	lanStatusText
} from '@/uni_modules/cs-transport'
// #endif
// #ifdef APP-ANDROID || APP-IOS
/** Both phones keep the state machine inside the plugin, so the only thing a page has to know there that
 *  it does not on Harmony is the second fingerprint: these two serve an RSA-2048 TLS leaf rather than
 *  the Ed25519 key that signs the pair message, and §3 says a pair message names the leaf. */
import { servedFingerprint } from '@/uni_modules/cs-transport'
// #endif
// #ifdef APP-ANDROID
/** The bench's own source file needs these two on this end as well as on Harmony - see probeSendTestFile. */
import { storePrepareFile, storeWriteAt } from '@/uni_modules/cs-transport'
// #endif

export type SessionState = {
	/* 本机 */
	selfName: string
	selfId: string
	selfFpShort: string
	mocked: boolean
	note: string

	/* 对端 */
	host: string
	port: string
	code: string
	secret: string
	codeHint: string
	passHint: string
	codeDigits: string
	passChars: string
	pinnedLabel: string
	pinnedFp: string
	showPaste: boolean
	showAdvanced: boolean
	pairText: string
	pasteLabel: string
	advancedLabel: string
	targetLabel: string
	scannedFp: string
	netLabel: string
	netClass: string
	connecting: boolean
	connected: boolean
	connectLabel: string
	sessionLabel: string
	peerName: string
	peerAttached: boolean

	/* 发送 */
	names: string[]
	meta: string[]
	states: string[]
	stateClass: string[]
	running: boolean
	canSend: boolean
	sendLabel: string
	progressLabel: string
	progressPct: string
	fillWidth: string

	/* 日志 */
	lines: string[]
	scrollTop: number

	/* 接收 */
	recvAsk: string
	recvCodeText: string
	recvPassText: string
	recvCodeLeft: string
	recvNames: string[]
	recvMeta: string[]
	recvStates: string[]
	recvStateClass: string[]
	recvSummary: string
	recvPeers: string
	recvNote: string
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	recvListening: boolean
	recvListen: string
	recvListenClass: string
	recvAddrs: string[]
	recvSelfFp: string
	recvServedFp: string
	// #endif
	/* 发现名单在四个平台上都画：手机画两条通道听到的，浏览器画同一套规则喂出来的演示数据。 */
	discButton: string
	discNote: string
	discSummary: string
	discNames: string[]
	discMeta: string[]
	// #ifdef WEB
	pcIn: boolean
	faultLabel: string
	sendFaultLabel: string
	recvFaultLabel: string
	// #endif
}

/** The screen reads this object; nothing else has to be told to repaint. */
export const s = reactive({
	selfName: '读取中…',
	selfId: '',
	selfFpShort: '',
	mocked: false,
	note: '',
	host: '',
	port: TRANSPORT_PORT.toString(),
	code: '',
	secret: '',
	codeHint: PAIR_CODE_DIGITS.toString() + ' 位配对码',
	passHint: PASSPHRASE_CHARS.toString() + ' 位配对密码',
	codeDigits: PAIR_CODE_DIGITS.toString(),
	passChars: PASSPHRASE_CHARS.toString(),
	pinnedLabel: '尚未固定任何对端',
	pinnedFp: '',
	showPaste: false,
	showAdvanced: false,
	pairText: '',
	pasteLabel: '粘贴配对信息',
	advancedLabel: '高级：地址 / 端口',
	targetLabel: '',
	scannedFp: '',
	netLabel: '',
	netClass: 'stateWait',
	connecting: false,
	connected: false,
	connectLabel: '连接',
	sessionLabel: '未连接',
	peerName: '',
	peerAttached: false,
	names: [] as string[],
	meta: [] as string[],
	states: [] as string[],
	stateClass: [] as string[],
	running: false,
	canSend: false,
	sendLabel: '发送',
	progressLabel: '未开始',
	progressPct: '—',
	fillWidth: '0%',
	lines: [] as string[],
	scrollTop: 0,
	recvAsk: '',
	recvCodeText: '',
	recvPassText: '',
	recvCodeLeft: '',
	recvNames: [] as string[],
	recvMeta: [] as string[],
	recvStates: [] as string[],
	recvStateClass: [] as string[],
	recvSummary: '',
	recvPeers: '现在没有对端连着',
	recvNote: '',
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	recvListening: false,
	recvListen: '还没开始监听',
	recvListenClass: 'sub mt8',
	recvAddrs: [] as string[],
	recvSelfFp: '',
	recvServedFp: '',
	// #endif
	discButton: '找局域网设备',
	// #ifdef WEB
	discNote: '浏览器进不了局域网：点一下只会摆两份演示数据，好让这张卡在电脑上也能看得见。',
	// #endif
	// #ifndef WEB
	discNote: '还没开始找：点一下会同时起广播和 mDNS 两条通道。',
	// #endif
	discSummary: '',
	discNames: [] as string[],
	discMeta: [] as string[],
	// #ifdef WEB
	pcIn: false,
	faultLabel: '正常',
	sendFaultLabel: '正常',
	recvFaultLabel: '正常',
	// #endif
} as SessionState)

/* ------------------------------------------------------------------ what is not a view model */

/** The picked files live here rather than in the rendered state so every list edit ends as one
 *  whole-array assignment - the views only ever see a new array. */
let pickedPaths: string[] = []
let pickedNames: string[] = []
let pickedRel: string[] = []
let pickedSizes: number[] = []
/** Held outside the reactive block on purpose: a session is a transport object, not a view model,
 *  and a page only ever mirrors its state into connected/sessionLabel. */
let activeSession: PeerSession | null = null
let activeOptions = new TransferOptions()
/** What this device's own interfaces said the last time a connect was asked for. The answer decides
 *  whether a handshake is worth spending, and the label showing it is a separate question. */
let netLevel = ''

/** The discovered candidates, in the four parallel arrays the list is painted from. They live here
 *  rather than in `s` because a row is a thing to dial, not a thing to read: the page shows name and
 *  address, and tapping one needs the host, the port and the fingerprint *prefix* it announced under.
 *  Every platform fills these: the browser has neither a broadcast socket nor a multicast group, so
 *  what it puts in them comes from the shared roster model fed with demo packets, and it says so. */
let discHosts: string[] = []
let discPorts: number[] = []
let discPrefixes: string[] = []
/** The prefix of the row this phone is connecting to, and '' for every target that did not come from
 *  the list. A hand-typed address or a scanned QR bypasses discovery (spec §2), and there is then no
 *  announcement to check the TLS digest against - nothing to verify, and nothing to refuse. */
let discPicked = ''
let discRunning = false
/** Whether this button has been pressed since the app started. Without it the card says "名单是上一次的"
 *  before there has been a first run, and a person reads that as a lost list rather than an untouched one. */
let discRanOnce = false

// #ifdef APP-HARMONY
const recvInbox: Inbox = newInbox()
let recvSelf: LocalPeer | null = null
/** The two documents as they were when last written, so a refresh that changed nothing writes nothing. */
let lastTrustText = ''
let lastOfferText = ''
let lastArrivalText = ''
// #endif

/* ------------------------------------------------------------------ small helpers
   These are first for a compiler reason rather than a readable one: JavaScript hoists a function
   above its use and Kotlin does not, so anything a body calls has to already have been declared. */

function filtered(src: string[], skip: number): string[] {
	const out: string[] = []
	for (let i = 0; i < src.length; i++) {
		if (i != skip) {
			out.push(src[i])
		}
	}
	return out
}

export function log(line: string) {
	const next: string[] = []
	for (let i = 0; i < s.lines.length; i++) {
		next.push(s.lines[i])
	}
	next.push(line)
	s.lines = next
	s.scrollTop = s.scrollTop + 400
}

export function syncSendable() {
	s.canSend = s.connected && pickedPaths.length > 0
}

function stateStyle(status: string): string {
	if (status == '对方已收下') {
		return 'stateOk'
	}
	if (status.indexOf('失败') >= 0 || status == '被拒绝') {
		return 'stateBad'
	}
	return 'stateRun'
}

export function refreshList() {
	const a: string[] = []
	const b: string[] = []
	const c: string[] = []
	const d: string[] = []
	for (let i = 0; i < pickedPaths.length; i++) {
		a.push(pickedNames[i])
		b.push(formatSize(pickedSizes[i]) + ' → ' + pickedRel[i])
		c.push(i < s.states.length ? s.states[i] : '等待中')
		d.push(i < s.stateClass.length ? s.stateClass[i] : 'stateWait')
	}
	s.names = a
	s.meta = b
	s.states = c
	s.stateClass = d
	syncSendable()
}

export function pickedCount(): number {
	return pickedPaths.length
}

export function clearFiles() {
	pickedPaths = []
	pickedNames = []
	pickedRel = []
	pickedSizes = []
	s.states = []
	s.stateClass = []
	refreshList()
}

export function removeFile(at: number) {
	pickedPaths = filtered(pickedPaths, at)
	pickedNames = filtered(pickedNames, at)
	pickedRel = filtered(pickedRel, at)
	s.states = filtered(s.states, at)
	s.stateClass = filtered(s.stateClass, at)
	const kept: number[] = []
	for (let i = 0; i < pickedSizes.length; i++) {
		if (i != at) {
			kept.push(pickedSizes[i])
		}
	}
	pickedSizes = kept
	refreshList()
}

/** The status a row shows is protocol state, so it belongs to the same array the relpath lives in:
 *  a directory pick can produce names the chooser never displayed. */
function onFileState(relpath: string, status: string, done: number, total: number) {
	let at = -1
	for (let i = 0; i < pickedRel.length; i++) {
		if (pickedRel[i] == relpath) {
			at = i
		}
	}
	if (at < 0) {
		return
	}
	const label = total > 0 ? status + ' ' + done.toString() + '/' + total.toString() + ' 块' : status
	const next: string[] = []
	const style: string[] = []
	for (let i = 0; i < pickedRel.length; i++) {
		next.push(i == at ? label : (i < s.states.length ? s.states[i] : '等待中'))
		style.push(i == at ? stateStyle(status) : (i < s.stateClass.length ? s.stateClass[i] : 'stateWait'))
	}
	s.states = next
	s.stateClass = style
}

function onProgress(done: number, total: number) {
	/* 分块还在走，这条会话就没有停摆：本机拨出去的那一半也要在接收内核里留下心跳，否则一次超过
	   闲置窗口的传输会被自己的计时器收回名额（spec §3）。 */
	const session = activeSession
	if (session != null) {
		receiveSeen(session!.peerFingerprint)
	}
	if (total <= 0) {
		s.fillWidth = '0%'
		s.progressPct = '—'
		s.progressLabel = done.toString() + ' 块'
		return
	}
	/* A percentage, not a pixel count: the design puts the bar and the big blue number on one line,
	   so the bar only gets whatever width is left after the number and cannot be a fixed 240px. */
	const pct = Math.floor(done * 100 / total)
	s.fillWidth = pct.toString() + '%'
	s.progressPct = pct.toString() + '%'
	s.progressLabel = done.toString() + ' / ' + total.toString() + ' 块 · ' + pct.toString() + '%'
}

/* ------------------------------------------------------------------ receiving */

// #ifdef APP-HARMONY
/** The id a POST /v1/offer carries, read before the state machine is asked to register it: the guard
 *  that keeps one dialog on screen needs it to tell a second delivery apart from the same delivery
 *  being asked about again. */
function offerIdOf(json: string): string {
	const made = JSON.parse(json) as UTSJSONObject | null
	return made == null ? '' : made!.getString('offer_id', '')
}

function nowSecs(): number {
	return Math.floor(Date.now() / 1000)
}

/** The pairing material is this device's decision but the device's storage: read it back, mint a
 *  pair if this phone never had one, write down whatever came out. */
function syncPairing(): void {
	const saved = loadPairing()
	if (saved != '' && !adoptPairing(recvInbox, saved)) {
		log('本机配对文件读不出内容，已重新生成一对码和密码')
	}
	currentPairCode(recvInbox, nowSecs())
	savePairing(pairingJson(recvInbox, nowSecs()))
}

/** The receiver's three memories: which peers may send here, which offers this inbox already took, and
 *  which files actually landed. restartLike() says out loud that the trust store is not supposed to
 *  leave memory - on a browser it does not, because the process is the page - but a phone that is
 *  closed and reopened loses it, and then the peer that pinned its key is refused and a person is
 *  asked to type a code whose entire job is to be typed once. The offer list is the same story one
 *  level down, and it is only half the story: a finished offer is deliberately left out of the resume
 *  ledger, because a document of a transfer that cannot be resumed invites the next run to treat it as
 *  one. So the arrivals have their own file - that is what lets a card titled 收到的文件 outlive the
 *  process that filled it, which is the least the same words on the PC mean.
 *  Read once, before the listener opens; written by saveReceiveMemory() whenever any of them changes. */
function syncReceiveMemory(): void {
	const peers = loadTrustedPeers()
	if (peers != '') {
		adoptTrust(recvInbox, peers)
	}
	const offers = loadOfferStates()
	if (offers != '') {
		adoptAll(recvInbox, offers.split('\n'), nowSecs())
	}
	const landed = loadArrivalStates()
	if (landed != '') {
		adoptArrivals(recvInbox, landed.split('\n'))
	}
	lastTrustText = trustJson(recvInbox)
	lastOfferText = stateAll(recvInbox).join('\n')
	lastArrivalText = arrivalsAll(recvInbox).join('\n')
}

/** Cheap by design: all three documents are rewritten only when their own serialisation moved, so the
 *  one-second refresh that watches a transfer costs nothing while nothing is being written. */
function saveReceiveMemory(): void {
	const peers = trustJson(recvInbox)
	if (peers != lastTrustText) {
		lastTrustText = peers
		saveTrustedPeers(peers)
	}
	const offers = stateAll(recvInbox).join('\n')
	if (offers != lastOfferText) {
		lastOfferText = offers
		saveOfferStates(offers)
	}
	const landed = arrivalsAll(recvInbox).join('\n')
	if (landed != lastArrivalText) {
		lastArrivalText = landed
		if (landed != '') {
			saveArrivalStates(landed)
		}
	}
}

/** The peer this device is to the rest of the network, filled in on the first request: the identity
 *  key in `fingerprint`, the certificate this listener answers with in `served`, and the name the user
 *  gave this phone. A pair reply carries the first to whoever asked; a hello carries both, because the
 *  one a QR or a broadcast promises is the second. */
function receiverSelf(): LocalPeer {
	if (recvSelf == null) {
		const made = new LocalPeer()
		made.peerId = peerIdText()
		made.name = deviceNameText()
		made.fingerprint = identityFingerprint()
		made.served = servedFingerprint()
		made.port = TRANSPORT_PORT
		// Measured on this platform's TLS server: a 4 MiB body written faster than one 4 KiB record
		// every 40 ms either arrives whole and wrong (full speed) or dies mid-body (15 and 25 ms, both
		// inside 1.5 s, on 2026-10-25). Declaring it in /v1/hello is what keeps the sender from finding
		// that out the hard way, once per transfer. The number was measured on the emulator over
		// `hdc fport`; the real phone has never been run at 40, so a phone that turns out to hold 15 on
		// the LAN would be allowed to say so - until then this is the only floor with two passes behind it.
		made.chunkPaceMs = 40
		recvSelf = made
	}
	return recvSelf!
}

/** One request off the listener. Every primitive the state machine asks for is a synchronous ArkTS
 *  call, which is the reason this half exists: a browser keeps an offer in memory, and this phone
 *  writes the same offer into its own files. */
function harmonyReceive(
	index: number,
	method: string,
	path: string,
	token: string,
	sha: string,
	client: string,
	json: string,
	body: ArrayBuffer | null
): void {
	const req = new Req()
	req.method = method
	req.path = path
	req.json = json
	req.token = token
	req.sha = sha
	req.client = client
	req.body = body
	const now = nowSecs()
	if (method == 'POST' && path == '/v1/offer') {
		// One offer waits for the user at a time, but the same manifest is not a new request: the
		// sender is polling this door for an answer it cannot get on a parked connection, and the
		// state machine already answers a known offer_id instead of opening a second dialog.
		const waiting = snapshot(recvInbox, now).pendingOfferIds
		if (waiting.length > 0 && offerIdOf(json) != waiting[waiting.length - 1]) {
			serveReply(index, 429, '{"code":"PEER_BUSY","detail":{"reason":"上一条清单还在等人决定"}}')
			return
		}
	}
	if (method == 'POST' && path == '/v1/pair' && client != '') {
		// Both directions, one answer. The address this phone dialled out to is the peer it already
		// trusts, and that same machine dials in from a port it never chose - so without this the
		// caller which keeps its pin over a restart sends no code, and this door asks for one it
		// cannot get. Nothing is trusted on an address alone: pairReply still refuses the pair unless
		// the key behind it signs its own claim.
		const known = pinForAddress(client, TRANSPORT_PORT)
		if (known != '') adoptPin(recvInbox, known, '', '')
	}
	const reply = handleReceive(recvInbox, receiverSelf(), now, req,
		digestBytes, fingerprintOfKey, verifySignature,
		storePrepareFile, storeWriteAt, storeDigestFile, storeDropFile)
	if (!reply.pending) {
		serveReply(index, reply.status, reply.body)
		refreshReceive()
		return
	}
	const ids = snapshot(recvInbox, now).pendingOfferIds
	if (ids.length == 0) {
		serveReply(index, 403, '{"code":"DECLINED","detail":{"reason":"状态机没有登记这条清单"}}')
		return
	}
	// The offer is registered and the card is showing it, but this connection is not held open
	// for the answer: it is told right now that nobody has decided, and the sender asks again on a
	// fresh connection until the card is answered.
	serveReply(index, 200, '{"offer_id":"' + ids[ids.length - 1] + '","accepted":false}')
	refreshReceive()
}

function receiveCode(): string {
	syncPairing()
	return currentPairCode(recvInbox, nowSecs())
}

function receivePassphrase(): string {
	syncPairing()
	return passphraseOf(recvInbox, nowSecs())
}

function receiveRotatePairing(): string {
	rotatePairing(recvInbox, nowSecs())
	savePairing(pairingJson(recvInbox, nowSecs()))
	return '已换一组配对码和密码'
}

function receiveHoldSlot(fingerprint: string): void {
	holdSlotFor(recvInbox, fingerprint, nowSecs())
}

/** The peer this phone dialled out to never appears in an inbound request, so this is the only place
 *  its half of the session slot can be kept honest - the sender calls it as chunks land (spec §3).
 *  Same name on every platform, because onProgress below is shared code. */
function receiveSeen(fingerprint: string): void {
	seenNow(recvInbox, fingerprint, nowSecs())
}

/** Every read of the card is also the local tick that spec §3 and §4 need: a peer that stopped
 *  talking sends no request for the wire to sweep against, so only this timer can notice it. */
function receiveSnapshot(): ReceiveSnapshot {
	const now = nowSecs()
	sweep(recvInbox, now, storeDropFile, storeDigestFile)
	const made = snapshot(recvInbox, now)
	// The ledger says a file landed; this is the only thing that says whether it is still here.
	markLanded(made.rows, storeFileExists)
	return made
}

/** The user's answer. Nothing is written back on the connection that asked: this platform has already
 *  freed that TLS session by the time a person taps, so the answer sits in the inbox until the sender
 *  asks again on a new connection, which it does every second while the card is up. */
function receiveDecide(accepted: boolean): string {
	const waiting = snapshot(recvInbox, nowSecs()).pendingOfferIds
	if (waiting.length == 0) {
		return '现在没有等待决定的传输'
	}
	const offerId = waiting[waiting.length - 1]
	const reply = resolveOffer(recvInbox, offerId, accepted, storePrepareFile, storeDropFile)
	if (reply.status != 200) {
		// Remembered by id so the next POST answers the same way instead of asking the user again.
		settleOffer(recvInbox, offerId, reply.status, reply.body)
	}
	const ack = JSON.parse(reply.body) as UTSJSONObject | null
	const code = ack == null ? '' : ack!.getString('code', '')
	refreshReceive()
	return code == '' ? '已应答 ' + reply.status.toString() : code + '（' + reply.status.toString() + '）'
}
// #endif

/** The receive card mirrors the kernel's snapshot. Every number and status word here is what
 *  the state machine reported - the store keeps no progress idea of its own, so a row cannot
 *  say "done" before the whole-file digest has actually been re-read. */
export function refreshReceive() {
	const snap = receiveSnapshot()
	s.recvCodeText = snap.pairCode == '' ? '还没有' : snap.pairCode
	s.recvPassText = snap.passphrase == '' ? '还没有' : snap.passphrase
	s.recvCodeLeft = snap.staticCode
		? '固定的一组，点「更换配对码和密码」才会换'
		: '有效还剩 ' + snap.codeSecondsLeft.toString() + ' 秒，过期自动换一个'
	s.recvAsk = snap.pendingOfferIds.length > 0
		? '来自 ' + (snap.pendingFrom[0] == '' ? '对端' : snap.pendingFrom[0]) + ' 的传输在等你决定。对面每秒问一次决定好了没有，所以你点的这一下下一秒就到它那边。'
		: ''
	const a: string[] = []
	const b: string[] = []
	const c: string[] = []
	const d: string[] = []
	/** How many of the arrival records the receive root no longer holds; the count line has to say
	 *  which number it is quoting. */
	let goneFiles = 0
	for (let i = 0; i < snap.rows.length; i++) {
		const row = snap.rows[i]
		a.push(row.relpath)
		b.push(formatSize(row.size) + ' · 来自 ' + (row.fromName == '' ? '对端' : row.fromName))
		let label = ''
		let style = 'stateWait'
		if (row.awaiting) {
			label = '等你决定'
		} else if (row.verdict == 1) {
			/* 台账记得文件，磁盘才是它还在不在的地方。人可以从接收目录里删掉一个收过的文件，那一行
			   不能跟着一起消失——列表悄悄少一项，人只能猜是应用忘了还是自己删的；也不能继续说「落到」，
			   那是一句会让人去点开一个不存在的东西的话。PC 的 arrivals.json 同一件事说成（已经不在了）。 */
			label = row.gone
				? '已校验过，这个文件已经不在了（原落在 ' + row.dest + '）'
				: '已校验' + (row.dest == '' ? '' : '，落到 ' + row.dest)
			style = row.gone ? 'stateWait' : 'stateOk'
			if (row.gone) {
				goneFiles = goneFiles + 1
			}
		} else if (row.verdict == 2) {
			label = '整文件校验没过' + (row.missingAt > 0 ? '（还缺 ' + row.missingAt.toString() + ' 块）' : '')
			style = 'stateBad'
		} else if (row.senderGone) {
			/* 这句话不能省成「还没收到分块」：那个说法描述的是一件马上会动的事，而 §3 的会话窗口已经过完，
			   对方早就不在这张网里了。人看到「还在等分块」会等下去，看到「对方断了」会去叫它重连——
			   单子还在，它带同一个 offer id 回来就能接着传，所以这里不说失败，只说没有动静。 */
			label = '已接受，但对方已经 ' + Math.floor(SESSION_IDLE_S / 60).toString() + ' 分钟没有动静（它重新连上这一单还能接着传）'
		} else if (row.have <= 0) {
			label = '已接受，还没收到分块'
		} else if (row.have < row.count) {
			label = '收到 ' + row.have.toString() + '/' + row.count.toString() + ' 块'
			style = 'stateRun'
		} else {
			label = '收齐了，等整文件校验'
			style = 'stateRun'
		}
		c.push(label)
		d.push(style)
	}
	s.recvNames = a
	s.recvMeta = b
	s.recvStates = c
	s.recvStateClass = d
	s.recvSummary = '已验证 ' + (snap.verifiedFiles - goneFiles).toString() + ' 个'
		+ (goneFiles > 0 ? '（' + goneFiles.toString() + ' 个已经不在了）' : '')
		+ ' · 没通过 ' + snap.rejectedFiles.toString() + ' 个 · 固定对端 ' + snap.peers.toString() + ' 台'
	/* 接收内核收回的是本机拨出去那条会话的名额，而发送那一头的连接还挂在页面上。不跟着断一次，
	   两张卡片就会一件说没对端、一件说已连接；断了也不算丢人——密钥还在，点一次连接就自己配回来。 */
	if (s.connected && snap.lostName != '' && snap.lostName == s.peerName) {
		// #ifdef WEB
		demoPcDisconnect()
		// #endif
		onDisconnect()
	}
	/* 名额被闲置回收时，卡片必须说出是谁的窗口关了。只写「现在没有对端连着」会让人去找一个自己
	   根本没按过的断开按钮；这句话和 PC 端状态栏同一说法，两端读到的规则是一样的。 */
	s.recvPeers = snap.connectedNames.length > 0
		? '连着这台设备的对端：' + snap.connectedNames.join('、')
		: (snap.lostName == '' ? '现在没有对端连着'
			: snap.lostName + ' 已经 ' + Math.floor(SESSION_IDLE_S / 60).toString() + ' 分钟没有动静，本机把会话名额收回了；它的密钥还在，重连不用再报配对码。')
	/* 对端也可能是从它那一头拨过来的：本机没有拨号会话，但单对端名额已经被占住。首页 banner
	   和发送页的设备卡问的都是「现在有没有对端连着」，这个问题只有接收内核答得准。 */
	s.peerAttached = snap.connectedNames.length > 0
	if (s.peerAttached && s.peerName == '') {
		s.peerName = snap.connectedNames[0]
	}
	// #ifdef WEB
	s.pcIn = demoPcConnected()
	// #endif
	// #ifdef APP-HARMONY
	// Every action and every tick ends here, so this is where a peer that just paired and an offer
	// that just landed get written down.
	saveReceiveMemory()
	// #endif
}

/** 列表行的右列只放一个词（已收到 / 传输中 / 没通过），整句留给传输详情页。
 *  这不是审美问题：右列写整句会把 .rowmain 挤到零宽，文件名和大小直接消失（模拟器实测）。 */
export function shortState(text: string): string {
	if (text.indexOf('已经不在了') > 0) {
		// 已校验过 is true of this row and 「已收到」 would send a person to a file that is not there.
		return '已不在'
	}
	if (text.indexOf('已校验') == 0) {
		return '已收到'
	}
	if (text.indexOf('收到 ') == 0 || text.indexOf('收齐了') == 0) {
		return '传输中'
	}
	if (text.indexOf('对方已收下') == 0) {
		return '已完成'
	}
	if (text.indexOf('等你决定') == 0) {
		return '等你决定'
	}
	if (text.indexOf('已接受，但对方已经') == 0) {
		return '对方断了'
	}
	if (text.indexOf('失败') == 0 || text.indexOf('没过') > 0) {
		return '没通过'
	}
	return text == '' ? '等待中' : text
}

/** The offer parks inside a call that returns before anyone has read the screen, so the state is
 *  refreshed at the end of every action as well. This ticker is only the fallback: a hidden tab or a
 *  suspended app throttles it to about one tick a minute. */
function recvTimerTick() {
	setTimeout(function (): void {
		recvTimerTick()
	}, 1000)
	try {
		refreshReceive()
	} catch (e) {
		log('刷新接收面板失败：' + e)
	}
}

export function onRecvAccept() {
	log(receiveDecide(true))
	refreshReceive()
}

export function onRecvRefuse() {
	log(receiveDecide(false))
	refreshReceive()
}

// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
/** The address a peer would type, pulled out of the interface list the listener reported - that
 *  list is formatted for reading (addr/prefix（iface）), not for the wire. */
function lanIp(): string {
	if (s.recvAddrs.length == 0) {
		return ''
	}
	const raw = s.recvAddrs[0]
	const slash = raw.indexOf('/')
	const head = slash >= 0 ? raw.substring(0, slash) : raw
	const paren = head.indexOf('（')
	return paren >= 0 ? head.substring(0, paren) : head
}
// #endif

/** What this device promises the other side, in one line the user can hand over. There is no QR
 *  image on the phone yet, so this is the same payload a scan would give - address, port, the key
 *  to pin, code and password - and the desktop can paste it into 添加设备 instead.
 *
 *  `f` is the leaf the listener serves, not the identity fingerprint above it: spec §2 has whoever
 *  dials read a digest off the TLS socket and compare it with this, and on every platform that socket
 *  presents a certificate signed by another key. Putting the identity here is what made a phone
 *  undiallable (#115); the identity number travels inside the signed pair message instead. */
export function copyPairing() {
	let text = '配对码 ' + s.recvCodeText + '　密码 ' + s.recvPassText
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	if (s.recvListening) {
		for (let i = 0; i < s.recvAddrs.length; i++) {
			text = text + '　地址 ' + s.recvAddrs[i]
		}
		text = text + '　端口 ' + TRANSPORT_PORT.toString()
		const ip = lanIp()
		if (ip != '' && s.recvServedFp != '' && s.recvPassText != '还没有') {
			text = 'chuanshu://p?h=' + ip + '&p=' + TRANSPORT_PORT.toString() +
				'&v=1&f=' + s.recvServedFp + '&c=' + s.recvCodeText + '&k=' + s.recvPassText
		}
	}
	// #endif
	uni.setClipboardData({
		data: text,
		success: () => {
			log('已复制本机配对信息：' + text)
		},
		fail: (err) => {
			log('复制没成功：' + err.errMsg + '　' + text)
		}
	})
}

/** Fresh material by the user's hand only. Pinned peers and a live session keep working - this
 *  changes what a stranger has to get right, not what this device already vouched for. */
export function onRotatePairing() {
	log(receiveRotatePairing())
	refreshReceive()
}

// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
/** The listener's own words, mirrored onto the card. The addresses are what the PC has to type, so
 *  this is the line the user reads out across the desk - and it is only honest because CsWire.lan()
 *  enumerated the real interfaces rather than guessing. */
function applyListen(text: string) {
	const made = JSON.parse(text) as UTSJSONObject | null
	if (made == null) {
		return
	}
	s.recvListening = made!.getBoolean('listening') ?? false
	const root = made!.getString('root', '') ?? ''
	const fp = made!.getString('fingerprint', '') ?? ''
	// Two numbers for one machine: the identity key the pair message signs, and the leaf the socket
	// presents. The card keeps telling the first, because that is the device; the pairing string carries
	// the second, because that is what the peer who dials us has to pin on the wire.
	const served = made!.getString('served', '') ?? ''
	s.recvSelfFp = fp
	s.recvServedFp = served == '' ? fp : served
	s.recvListen = s.recvListening
		? '正在监听 ' + (made!.getNumber('port') ?? 0).toString() + '，收到的文件落在 ' + root
		: '没有监听：' + (made!.getString('note', '') ?? '')
	s.recvListenClass = s.recvListening ? 'sub mt8 stateOk' : 'sub mt8 stateBad'
	s.recvNote = '本机指纹 ' + (fp == '' ? '读不出来' : fp.substring(0, 16) + '…') + '，对端首次配对时固定它。'
	const list = made!.getArray('addrs')
	const out: string[] = []
	if (list != null) {
		for (let i = 0; i < list!.length; i++) {
			out.push(list![i].toString())
		}
	}
	s.recvAddrs = out
}

export function onRecvListen() {
	receiveStart(function (ok: boolean, message: string): void {
		log((ok ? '接收已打开：' : '接收没能打开：') + message)
		applyListen(receiveStatus())
	})
}

export function onRecvListenStop() {
	log(receiveStop())
	applyListen(receiveStatus())
}

export function unpin() {
	const where = s.host.trim()
	if (where == '') {
		log('还没有对端地址，没有可解除的固定')
		return
	}
	unpinPeer(where, buildOptions().port, function (dropped: boolean, message: string): void {
		if (message != '') {
			log('解除固定失败：' + message)
			return
		}
		log(dropped ? '已解除 ' + where + ' 的固定：下次配对要重新核对配对码' : where + ' 本来就没有固定过')
		refreshPinned()
		if (dropped) {
			markDisconnected('已解除固定，下次连接重新核对配对码')
		}
	})
}
// #endif

/* ------------------------------------------------------------------ the peer */

function buildOptions(): TransferOptions {
	const opts = new TransferOptions()
	opts.host = s.host.trim()
	const declaredPort = parseFloat(s.port)
	opts.port = declaredPort > 0 ? Math.floor(declaredPort) : TRANSPORT_PORT
	opts.code = digitsOnly(s.code)
	// Whitespace either side is a paste artifact; the case is not touched, because the peer
	// compares these bytes for equality.
	opts.secret = s.secret.trim()
	opts.pinPrefix = s.scannedFp
	// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
	// This phone's TLS listener answers under an RSA leaf, not under the Ed25519 identity that
	// signed the pair message, so §3 says both numbers: the peer pins the first and knows to
	// expect the second on the socket. '' on the ends whose own key signs its certificate.
	opts.tlsFingerprint = servedFingerprint()
	// #endif
	return opts
}

/** Every request goes through here so the fingerprint the QR promised is the one the transport
 *  pins - a typed address has none, and that difference is exactly what the user is warned about.
 *  A `const` rather than a `function` because the transport takes this as a value, and Kotlin only
 *  treats a top-level `fun` name as one with `::`, which UTS does not emit. */
const callWire = (
	method: string,
	path: string,
	jsonBody: string,
	token: string,
	body: ArrayBuffer,
	sha: string,
	escape: string,
	cb: ReplyCallback
): void => {
	request(method, activeOptions.host, activeOptions.port, path, jsonBody, token, s.scannedFp, body, sha, escape, cb)
}

/** The address the 「同一网络」 sentence under the button was answered for. The answer is about one
 *  machine, and the 地址 field can be edited into a sentence about another one, so the check that
 *  produced it is remembered with it. */
let netWhere = ''

function checkNet(host: string, after: (level: string) => void): void {
	netWhere = host
	lanCheck(host, function (level: string, text: string): void {
		showNet(level, text)
		after(level)
	})
}

/** A check whose only job is the sentence it draws. */
const noOp: (level: string) => void = (level: string): void => {}

// #ifdef WEB
/** The browser's trust store is the demo peer's, so it has one answer for every address. */
function refreshPinned() {
	const fp = pinnedFingerprint()
	s.pinnedFp = fp
	s.pinnedLabel = fp == '' ? '尚未固定对端：首次配对时固定' : '已固定对端 ' + fp.substring(0, 16) + '…'
	s.codeHint = fp == '' ? PAIR_CODE_DIGITS.toString() + ' 位配对码' : '配对码（已固定过，留空即可用密钥重连）'
	s.passHint = fp == ''
		? PASSPHRASE_CHARS.toString() + ' 位配对密码'
		: '配对密码（已固定过，留空即可）'
}
// #endif

// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
/** The two lines that answer "what does this phone already trust about that address". They are one
 *  sentence and a hint, and they only mean something for the address they were read for - so the
 *  address is remembered next to them, and a hand-edited 地址 is detected rather than relabelled blind. */
let pinnedWhere = ''

function labelPinned(where: string, fp: string): void {
	pinnedWhere = where
	s.pinnedFp = fp
	// An address that was typed away to nothing has no sentence to make about itself, and the callers
	// read this field straight - a bare " 还没有固定过" is the same self-contradicting card as a
	// 「已固定」 about the machine that used to be in the box.
	if (where == '') {
		s.pinnedLabel = '尚未固定对端：首次配对时固定'
		s.codeHint = PAIR_CODE_DIGITS.toString() + ' 位配对码'
		s.passHint = PASSPHRASE_CHARS.toString() + ' 位配对密码'
		return
	}
	s.pinnedLabel = fp == ''
		? where + ' 还没有固定过：首次配对时固定它的证书指纹'
		: '已固定 ' + where + ' 的指纹 ' + fp.substring(0, 16) + '…'
	s.codeHint = fp == ''
		? PAIR_CODE_DIGITS.toString() + ' 位配对码'
		: '配对码（已固定过，留空即可用密钥重连）'
	// Once a peer is pinned, its key alone is enough to reconnect - the code and the password
	// only stand between us and a stranger, so leaving either out is not an error here.
	s.passHint = fp == ''
		? PASSPHRASE_CHARS.toString() + ' 位配对密码'
		: '配对密码（已固定过，留空即可）'
}

/** The card is opened on a discovered row and the address is then edited by hand. Until the next read
 *  the two sentences under the button talk about the machine that used to be in the field - and a
 *  「还没有固定过」 next to an enabled 解除固定, or 「不在同一网络」 about an address that is no longer
 *  there, is a card that contradicts itself. The page asks once a second, the same beat the roster
 *  is redrawn on. */
export function syncTargetCard(): void {
	const where = s.host.trim()
	if (where != pinnedWhere) {
		refreshPinned()
	}
	if (where != netWhere) {
		if (where == '') {
			// An address typed away to nothing has no answer to give, and the page that opens with an
			// empty card shows no sentence about the network - so take the stale one back out.
			netWhere = ''
			showNet('', '')
		} else {
			checkNet(where, noOp)
		}
	}
}

/** On the phone the pin is per address, and reading it is a round trip to the keystore, so this
 *  is a callback rather than a value: the labels only change once the answer arrives. */
function refreshPinned() {
	const where = s.host.trim()
	if (where == '') {
		labelPinned('', '')
		return
	}
	pinnedFor(where, buildOptions().port, function (fp: string): void {
		labelPinned(where, fp)
	})
}
// #endif

function markConnected(session: PeerSession, message: string) {
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	/* The re-check spec §2 asks for: a candidate in the list is only a machine that shouted a fingerprint
	   prefix, and this is the first moment this phone holds the whole digest behind it. The prefix names the
	   certificate the socket hands out - the transport pins that one while dialling - so the number it is
	   compared against is the peer's declared leaf, not its identity key. A mismatch means whoever answered
	   is not whoever announced, and the session is dropped rather than reported: the pair code would not
	   have caught an on-LAN machine that hijacked the announcement and knows the code. */
	if (discPicked != '') {
		const wanted = discPicked
		discPicked = ''
		if (!lanVerify(wanted, session.peerServed)) {
			markDisconnected('这台对端在 TLS 上不是它广播的那把密钥，已断开')
			log('连接被拒：广播里报的前缀是 ' + wanted + '，TLS 上递出来的证书对不上')
			return
		}
		log('已核对：' + wanted + ' 这台机器在 TLS 上就是它自己（' + session.peerServed.substring(0, 16) + '…）')
	}
	// #endif
	activeSession = session
	s.connected = true
	s.connectLabel = '已连接'
	s.sessionLabel = message
	/* 对端自己报的名字。页面要把它单独显示在设备卡上，从 sessionLabel 那句人话里截是不可靠的：
	   那是一句给人看的句子，不是一个字段。 */
	s.peerName = session.peerName
	// This end dialled out, so our own receiver has to know who already occupies the single
	// session slot - the inbound half never sees this handshake (spec §3).
	receiveHoldSlot(session.peerFingerprint)
	refreshPinned()
	syncSendable()
}

function markDisconnected(message: string) {
	activeSession = null
	s.connected = false
	s.connectLabel = '连接'
	s.sessionLabel = message
	s.peerName = ''
	receiveHoldSlot('')
	// The line about what this phone already trusts has to describe the address that was just refused,
	// and it is read from the pin store - otherwise a refusal prints next to 「还没有固定过」.
	refreshPinned()
	syncSendable()
}

/** The handshake itself, one step past every check the button makes. */
function startConnect() {
	s.connecting = true
	s.connectLabel = '连接中…'
	log('→ 连接 ' + activeOptions.host + ':' + activeOptions.port.toString())
	connectPeer(
		activeOptions,
		(cb: SelfCallback): void => {
			selfInfo(cb)
		},
		(message: string, cb: SignCallback): void => {
			signPair(message, cb)
		},
		callWire,
		(line: string): void => {
			log(line)
		},
		(ok: boolean, message: string, session: PeerSession | null): void => {
			s.connecting = false
			if (!ok || session == null) {
				markDisconnected(message)
				log('连接失败：' + message)
				return
			}
			markConnected(session, message)
			log(message)
		}
	)
}

/** A refusal the connect button owes an answer to. `log()` writes into the 传输 page's list, which is not
 *  the page the tap happened on, so the line under the button has to say it too: measured here, a pair
 *  string whose 密码 was lowercase left 连接 with no visible answer at all, and three probe rounds read
 *  that silence as a dial that never started. */
function refuse(why: string) {
	log(why)
	s.sessionLabel = why
}

/** The second half of the connect button, once the store knows what the pin store says about this
 *  address. */
function checkCodeAndNetwork() {
	if (activeOptions.code != '' || s.pinnedFp == '') {
		const why = codeReject(activeOptions.code)
		if (why != '') {
			refuse('配对码：' + why)
			return
		}
	} else {
		log('留空配对码：用已固定的密钥重连')
	}
	const passWhy = passReject(activeOptions.secret)
	if (passWhy != '') {
		refuse('配对密码：' + passWhy)
		return
	}
	checkNet(activeOptions.host, function (level: string): void {
		if (level == 'bad') {
			refuse('没有连接：' + s.netLabel)
			return
		}
		startConnect()
	})
}

/** The connect button: check the code, check the network, then spend a handshake. In that order,
 *  because a phone on the wrong network would otherwise wait out a TLS timeout for a peer it could
 *  never have reached. */
export function onConnect() {
	if (s.connecting || s.connected) {
		return
	}
	activeOptions = buildOptions()
	// Whether a blank code is enough is the pin store's answer, not this device's memory of the last
	// handshake: the peer stays pinned across a restart, and 留空重连 has to work for it then too.
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	pinnedFor(activeOptions.host, activeOptions.port, function (fp: string): void {
		labelPinned(activeOptions.host, fp)
		checkCodeAndNetwork()
	})
	// #endif
	// #ifdef WEB
	s.pinnedFp = pinnedFingerprint()
	checkCodeAndNetwork()
	// #endif
}

export function onDisconnect() {
	const session = activeSession
	if (session == null) {
		return
	}
	/** The two halves of the promise 传输详情 makes when it says 取消 is 断开这条连接.
	 *
	 *  The flag in the state machine stops the steps that were only queued - the chunks behind the
	 *  current one, the finalize - and the phones' own handle stops the one whose bytes are already on
	 *  their way out, which at a paced peer was up to forty seconds of writing per chunk that a pressed
	 *  button could not reach. Without the second half the screen said 已断开 while the file carried on
	 *  arriving, and the user had no way to tell that the transfer they cancelled had completed. */
	cancelSend()
	// #ifdef APP-ANDROID || APP-HARMONY
	const dropped = abandonSend('用户按下了取消')
	if (dropped > 0) {
		log('取消了 ' + dropped.toString() + ' 条还没写完的请求')
	}
	// #endif
	markDisconnected(s.pinnedFp == ''
		? '已断开：本机还没有固定这台对端，下次连上要重新核对配对码'
		: '已断开：指纹仍然固定，下次连上不用再核对配对码')
	log('已断开 ' + session.peerName)
}

/* ------------------------------------------------------------------ the target */

/** Four answers, and the screen shows all of them: same network, provably not, reachable but odd,
 *  or nothing to compare against. Collapsing the last one into "fine" would let the phone sit on
 *  a cellular connection while the label claims the peer looks reachable. */
function showNet(level: string, text: string) {
	netLevel = level
	s.netLabel = text
	if (level == 'ok') {
		s.netClass = 'stateOk'
	} else if (level == 'bad') {
		s.netClass = 'stateBad'
	} else {
		s.netClass = 'stateWait'
	}
}

export function netLevelOf(): string {
	return netLevel
}

export function togglePaste() {
	s.showPaste = !s.showPaste
	s.pasteLabel = s.showPaste ? '收起粘贴' : '粘贴配对信息'
}

export function toggleAdvanced() {
	s.showAdvanced = !s.showAdvanced
	s.advancedLabel = s.showAdvanced ? '收起地址 / 端口' : '高级：地址 / 端口'
}

/** One parser for both ways in: the camera on a phone, a pasted string everywhere. */
export function applyConnectText(text: string): boolean {
	const target = parsePairUrl(text)
	if (target.reject != '') {
		log('配对信息读不出来：' + target.reject)
		return false
	}
	s.host = target.host
	s.port = target.port == '' ? TRANSPORT_PORT.toString() : target.port
	if (target.code != '') {
		s.code = target.code
	}
	if (target.secret != '') {
		s.secret = target.secret
	}
	s.scannedFp = target.fingerprint
	s.targetLabel = '来自配对二维码：' + target.host + ':' + s.port + '　指纹 ' + target.fingerprint.substring(0, 16) + '…'
	s.showAdvanced = false
	log(target.secret == ''
		? '已读入配对信息，核对配对码后点连接'
		: '已读入配对信息（含密码），核对后点连接')
	checkNet(target.host, noOp)
	syncSendable()
	return true
}

// #ifndef WEB
export function onScan() {
	uni.scanCode({
		success: (res) => {
			applyConnectText(res.result)
		},
		fail: (err) => {
			// ScanCodeFail has no fields on Android - the camera either gives a result or it does not.
			log('扫码没成功（可改用粘贴）')
		}
	})
}
// #endif

export function onPaste() {
	applyConnectText(s.pairText.trim())
}

export function clearTarget() {
	s.host = ''
	s.port = TRANSPORT_PORT.toString()
	s.code = ''
	s.secret = ''
	s.scannedFp = ''
	s.pairText = ''
	s.targetLabel = ''
	s.netLabel = ''
	netLevel = ''
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	// The row this phone was about to dial is gone with the target, and a stale prefix would make the
	// next hand-typed connect answer to an announcement it never saw.
	discPicked = ''
	// #endif
	syncSendable()
}

/* ------------------------------------------------------------------ sending */

function onFinished(ok: boolean, summary: string) {
	s.running = false
	s.sendLabel = '发送'
	s.progressLabel = (ok ? '完成：' : '失败：') + summary
	refreshPinned()
	syncSendable()
}

/** 分段控件的三类对应 uni.chooseFile 的 type。App 端三个平台都支持这个字段（只有 count 在
 *  Android 上被降级成单选/多选），所以这里直接透传，而不是自己按扩展名过滤。 */
/** 文件 / 图片 / 视频 三段各自透传给 `uni.chooseFile` 的 type。
 *  文档里 options.type 只列了 image|video|audio|all，'file' 是结果里那个 type 的取值；
 *  Android 与鸿蒙都照这个值筛出了文件面板，iOS（4.61 起支持 chooseFile）第一次上机时
 *  要核对的就是这一段：若 'file' 被拒，把这里改成 'all'，代价是图片也会出现在文件页里。 */
export function chooseKind(kind: string) {
	uni.chooseFile({
		count: 20,
		type: kind,
		success: (res) => {
			const list = res.tempFiles
			for (let i = 0; i < list.length; i++) {
				const f = list[i]
				pickedPaths.push(f.path)
				pickedNames.push(f.name)
				pickedRel.push(f.name)
				pickedSizes.push(f.size)
			}
			refreshList()
			log('已选择 ' + list.length.toString() + ' 个文件')
		},
		fail: (err) => {
			log('选择文件失败：' + err.errMsg)
		}
	})
}

export function onSend() {
	if (s.running) {
		return
	}
	const session = activeSession
	if (session == null) {
		log('先连上对端')
		return
	}
	if (pickedPaths.length == 0) {
		log('先选择文件')
		return
	}
	s.running = true
	s.sendLabel = '传输中…'
	s.progressLabel = '准备中'
	s.fillWidth = '0%'
	syncSendable()

	activeOptions = buildOptions()
	for (let i = 0; i < pickedPaths.length; i++) {
		activeOptions.paths.push(pickedPaths[i])
		activeOptions.relpaths.push(pickedRel[i])
	}
	for (let i = 0; i < pickedRel.length; i++) {
		onFileState(pickedRel[i], '排队中', 0, 0)
	}

	sendFiles(
		session,
		activeOptions,
		(cb: SelfCallback): void => {
			selfInfo(cb)
		},
		(message: string, cb: SignCallback): void => {
			signPair(message, cb)
		},
		callWire,
		(path: string, relpath: string, cb: MetaCallback): void => {
			prepareFile(path, relpath, cb)
		},
		(path: string, offset: number, length: number, cb: BufferCallback): void => {
			readChunk(path, offset, length, cb)
		},
		(buf: ArrayBuffer, cb: HexCallback): void => {
			digestHex(buf, cb)
		},
		(line: string): void => {
			log(line)
		},
		(done: number, total: number): void => {
			onProgress(done, total)
		},
		(relpath: string, status: string, done: number, total: number): void => {
			onFileState(relpath, status, done, total)
		},
		(ok: boolean, summary: string): void => {
			onFinished(ok, summary)
		}
	)
}

/* ------------------------------------------------------------------ the demo peer (WEB) */

// #ifdef WEB
export function loadDemo() {
	const d = demoPeer()
	s.code = d.getString('code', '')
	s.secret = d.getString('passphrase', '')
	s.host = d.getString('host', '127.0.0.1')
	s.port = d.getNumber('port', TRANSPORT_PORT).toString()
	log('演示机配对码 ' + s.code + '　密码 ' + s.secret + '（手输路径，没有预先核对的指纹）')
	syncSendable()
}

/** The same string a phone would get out of the camera, so the browser exercises the parse-and-pin
 *  path rather than only the happy typed one. */
export function pasteDemoQr() {
	s.pairText = demoQrUrl()
	applyConnectText(s.pairText)
}

export function expireDemoToken() {
	demoExpireToken()
	log('演示机丢了会话令牌：下一次发送应当静默重新配对，日志里不该再问你要配对码')
}

export function restartDemo() {
	demoRestart()
	const d = demoPeer()
	s.code = d.getString('code', '')
	log('演示机已重启：新指纹 ' + d.getString('fingerprint', '').substring(0, 16) + '…，本机固定仍是旧的')
	refreshPinned()
}

export function unpin() {
	demoUnpin()
	refreshPinned()
	markDisconnected('已解除固定，下次连接重新核对配对码')
	log('已解除固定，下次配对重新固定')
}

export function setFault(fault: string) {
	setDemoFault(fault)
	s.faultLabel = fault == '' ? '正常' : fault
}

export function pcPairGood() {
	demoPcConnect(receiveCode(), (line: string): void => {
		log('PC：' + line)
	}, function (ok: boolean, message: string, session: PeerSession | null): void {
		log((ok ? 'PC 已配对：' : 'PC 配对失败：') + message)
		refreshReceive()
	})
}

export function pcPairWrong() {
	demoPcConnect(receiveWrongCode(), (line: string): void => {
		log('PC：' + line)
	}, function (ok: boolean, message: string, session: PeerSession | null): void {
		log((ok ? '不对：PC 用错配对码也连上了 ' : 'PC 配对被拒（预期）：' + message) + '　多点几次应当变成 PEER_BUSY')
		refreshReceive()
	})
}

/** The signature-only repair the contract allows a peer whose key this end already pinned: no code
 *  crosses the wire, and the answer says 沿用旧指纹. This is the whole reason a phone that dropped
 *  and reconnected should never ask the user to read out six digits again. */
export function pcPairResume() {
	demoPcConnect('', (line: string): void => {
		log('PC：' + line)
	}, function (ok: boolean, message: string, session: PeerSession | null): void {
		log((ok ? 'PC 用已固定的密钥重连：' : 'PC 重连失败：') + message)
		refreshReceive()
	})
}

export function pcSend() {
	log('PC 开始发两个文件，清单会在接收那一页等你决定')
	demoPcSend(
		(line: string): void => {
			log('PC：' + line)
		},
		(done: number, total: number): void => {
			if (total > 0 && done == total) {
				log('PC 推完 ' + total.toString() + ' 块')
			}
		},
		(relpath: string, status: string, done: number, total: number): void => {
			// 发送端的逐文件状态在接收这一侧都由内核的行状态体现，这里不重复刷屏。
		},
		function (ok: boolean, summary: string): void {
			log('PC → 本机：' + (ok ? '完成 ' : '失败 ') + summary)
			refreshReceive()
		}
	)
	// The offer parks inside that call, so the decision has to be on screen the moment it
	// returns. The 1 s ticker is only a fallback.
	refreshReceive()
}

export function pcBreak() {
	demoPcDisconnect()
	s.pcIn = false
	log('PC 已断开：本机对它的固定还在，重连不用再核对配对码')
}

export function pickSendFault(fault: string) {
	setSenderFault(fault)
	s.sendFaultLabel = fault == '' ? '正常' : fault
	log('发送端故障 = ' + s.sendFaultLabel)
}

export function pickRecvFault(fault: string) {
	setReceiveFault(fault)
	s.recvFaultLabel = fault == '' ? '正常' : fault
	log('接收端故障 = ' + s.recvFaultLabel + '（影响下一次点接受，或下一次写分块）')
}

export function runRecvSelf() {
	const parts = receiveSelfReport().split('\n')
	for (let i = 0; i < parts.length; i++) {
		log(parts[i])
	}
}

/** 发现模型的自检：浏览器发不出广播，所以这里喂的是合成报文，验证的是名单的合并、过期、
 *  自过滤这些规则本身，不是某台机器的网卡。真机上那半边要证的只有 socket。 */
export function runDiscSelf() {
	const parts = discoverySelfReport().split('\n')
	for (let i = 0; i < parts.length; i++) {
		log(parts[i])
	}
}
// #endif

// #ifdef APP-ANDROID || APP-HARMONY
/** A phone with nothing it can send. The emulator has no camera roll and no photos, and the debug shell
 *  cannot write into its media library, so a phone-to-phone run has no source file at all unless this end
 *  makes one. The bytes are a counter, so the digest the other end computes is checkable by anyone who
 *  has both logs.
 *
 *  The file joins the same 待发送 list a gallery photo joins and leaves through the same button: what this
 *  measures is the kernel, not a lane built around it. */
export function probeSendTestFile(sizeMB: number): string {
	const rel = 'chuanshu-probe-' + sizeMB.toString() + 'mb.bin'
	const total = sizeMB * 1024 * 1024
	const abs = storePrepareFile(rel, total)
	if (abs == '') {
		return '测试文件没能落盘'
	}
	const step = 64 * 1024
	const block = new ArrayBuffer(step)
	const view = new Uint8Array(block)
	for (let i = 0; i < step; i++) {
		view[i] = i % 251
	}
	let at = 0
	while (at < total) {
		const why = storeWriteAt(rel, at, block)
		if (why != '') {
			return '测试文件写到 ' + at.toString() + ' 字节失败：' + why
		}
		at = at + step
	}
	clearFiles()
	pickedPaths.push(abs)
	pickedNames.push(rel)
	pickedRel.push(rel)
	pickedSizes.push(total)
	refreshList()
	syncSendable()
	log('测试文件已备好：' + rel + '　' + formatSize(total))
	return ''
}

/** One offer carrying several files, all of them under a Chinese subdirectory. PC covers this shape in
 *  `protocol_selftest.py`; no phone has ever run it, which is why the sizes are picked to hit the three
 *  cases that matter on the wire - one file of exactly one chunk (so the last chunk is a full 4 MiB and
 *  not a remainder), one smaller than a chunk, and one whose tail is not a multiple of the 64 KiB writing
 *  block. The names carry spaces and full-width brackets because a gallery picker never hands those over.
 *
 *  Same counter bytes as `probeSendTestFile` - the 64 KiB pattern repeated and then truncated - so the
 *  other end's digest is recomputable from the rule alone. */
export function probeSendTestBatch(): string {
	const rels = ['传书测试/一块整.bin', '传书测试/中文目录/零头.bin', '传书测试/中文目录/两层嵌套/带空格 与（括号）.bin']
	const totals = [4194304, 1023, 1048576]
	const step = 64 * 1024
	const block = new ArrayBuffer(step)
	const view = new Uint8Array(block)
	for (let i = 0; i < step; i++) {
		view[i] = i % 251
	}
	clearFiles()
	for (let f = 0; f < rels.length; f++) {
		const rel = rels[f]
		const total = totals[f]
		const abs = storePrepareFile(rel, total)
		if (abs == '') {
			return '测试文件没能落盘：' + rel
		}
		let at = 0
		while (at < total) {
			const n = (total - at < step) ? (total - at) : step
			let piece = block
			if (n != step) {
				const cut = new ArrayBuffer(n)
				const cv = new Uint8Array(cut)
				for (let i = 0; i < n; i++) {
					cv[i] = i % 251
				}
				piece = cut
			}
			const why = storeWriteAt(rel, at, piece)
			if (why != '') {
				return '测试文件写到 ' + at.toString() + ' 字节失败：' + why
			}
			at = at + n
		}
		pickedPaths.push(abs)
		pickedNames.push(rel)
		pickedRel.push(rel)
		pickedSizes.push(total)
		log('测试文件已备好：' + rel + '　' + formatSize(total))
	}
	refreshList()
	syncSendable()
	return ''
}
// #endif

/* ------------------------------------------------------------------ start up */

// #ifdef WEB
function initReceivePanel() {
	s.recvNote = '这一端的落盘是内存里的模拟：浏览器既不能监听 43720，也不能写文件。接收状态机本身在 cs-receive.uts，和 app-android 那半边共用同一份。'
	recvTimerTick()
}
// #endif

// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
function initReceivePanel() {
	// #ifdef APP-HARMONY
	// The listener refuses to open with nobody to hand requests to, and it must be able to answer a
	// pair the moment the port is up - so the handler and the code both come first.
	serveBind(harmonyReceive)
	syncPairing()
	syncReceiveMemory()
	// #endif
	onRecvListen()
	recvTimerTick()
}
// #endif

/** Open the listener and start reading the kernel. Called by the first page that mounts, and
 *  guarded, because with a tabBar every page can be the one that arrives here first. */
let started = false

export function initSession() {
	if (started) {
		return
	}
	started = true
	selfInfo(function (peerId: string, name: string, fp: string): void {
		s.selfId = peerId
		s.selfName = name
		// A device whose Ed25519 provider is missing has no fingerprint to show, and saying so here is
		// better than a blank line the user reads as "still loading".
		s.selfFpShort = fp == '' ? '读不出来：这台机器做不了本机密钥' : fp.substring(0, 16) + '…'
	})
	s.mocked = transportMocked()
	s.note = transportNote()
	refreshPinned()
	initReceivePanel()
	syncSendable()
	log('就绪')
}

/* ------------------------------------------------------------------ 局域网发现 */

// #ifdef APP-ANDROID || APP-IOS
/** Both phones answer these from the plugin: the roster lives there, next to the threads that fill it.
 *  The page asks the same six questions on every phone, so the store is the one place they are named. */
export function lanStart(cb: (ok: boolean, message: string) => void): void {
	discoverStart(cb)
}

export function lanStop(cb: (ok: boolean, message: string) => void): void {
	discoverStop(cb)
}

export function lanPeers(): string {
	return discoverPeers()
}

export function lanStatus(): string {
	return discoverStatus()
}

export function lanVerify(prefix: string, fingerprint: string): boolean {
	return discoverVerify(prefix, fingerprint)
}

export function lanSelfReport(): string {
	return discoverySelfReport()
}
// #endif

// #ifdef APP-HARMONY
/** The same six answers, built here instead of in the module: on this platform the plugin cannot read
 *  the shared model, so the roster is a plain value of the app and the ArkTS half only moves bytes.
 *  Nothing on this page runs on another thread, so the mutations need no gate - the callbacks land on
 *  the same JavaScript turn that reads the list. */

let discRoster: Roster = newRoster('')
let discId = ''
let discName = ''
let discPrefix = ''
let discSince: number = 0
let discOpen = false

/** Read when a packet is due rather than pushed by a timer that dies with the screen: the port in the
 *  announcement has to be the one actually open, and `ts` the moment discovery started - the PC keeps
 *  both of those as the peer's own words rather than as this phone's guess. */
function discServicePort(): number {
	return serveIsRunning() ? servePort() : TRANSPORT_PORT
}

const discAnnounceText: () => string = (): string => {
	if (discPrefix == '') {
		return ''
	}
	return buildAnnounce(discId, discServicePort(), discName, discPrefix, discSince)
}

const discTxtEntries: () => string[] = (): string[] => buildTxt(discName, discPrefix, discSince)
const discLabel: () => string = (): string => 'chuanshu-' + discId.substring(0, 8)
/* A const arrow, not a `function`: this file already learned that a module-level function declaration
 *  cannot be handed over as a callback value on this platform. */
const discPortOf: () => number = (): number => discServicePort()

const discPacket: (host: string, text: string) => void = (host: string, text: string): void => {
	applyAnnounce(discRoster, text, host, nowSecs())
}

const discAnswer: (kind: string, host: string, port: number, entries: string[], prefix: string) => void =
	(kind: string, host: string, port: number, entries: string[], prefix: string): void => {
		if (kind == 'lost') {
			if (prefix != '') {
				forgetMdns(discRoster, prefix)
			}
			return
		}
		applyTxt(discRoster, entries, host, port, nowSecs())
	}

/** The socket's own account of the two channels, written into the model so `channelNote` can name the
 *  path that died instead of showing an empty list. */
function discChannels(text: string): void {
	const made = JSON.parse(text) as UTSJSONObject | null
	if (made == null) {
		return
	}
	const read = (key: string): UTSJSONObject | null => {
		const raw = made!.get(key)
		return raw == null ? null : raw as UTSJSONObject
	}
	const udp = read('udp')
	if (udp != null) {
		discRoster.udp.state = udp!.getString('state', 'stopped')
		discRoster.udp.detail = udp!.getString('detail', '')
	}
	const dns = read('mdns')
	if (dns != null) {
		discRoster.mdns.state = dns!.getString('state', 'stopped')
		discRoster.mdns.detail = dns!.getString('detail', '')
	}
}

export function lanStart(cb: (ok: boolean, message: string) => void): void {
	if (discOpen) {
		cb(true, '局域网发现已经在跑')
		return
	}
	discId = peerIdText()
	discName = deviceNameText()
	// Spec §2: whoever hears this announcement dials the socket and reads a digest off the live TLS
	// session, and that digest is the leaf's. Announcing the identity key's prefix would make every
	// honest candidate fail its own re-check.
	discPrefix = prefixOf(servedFingerprint())
	if (discPrefix == '') {
		cb(false, '本机指纹读不出来，发现层发不出可信的公告')
		return
	}
	discSince = nowSecs()
	// A fresh roster per session: a candidate left from the last run is silent now, and expiry measured
	// against that old `seen` would either keep a ghost or drop a real machine.
	discRoster = newRoster(discPrefix)
	lanBind(discAnnounceText, discTxtEntries, discLabel, discPortOf, discPacket, discAnswer)
	discChannels(lanOpen())
	discOpen = true
	cb(true, channelNote(discRoster))
}

export function lanStop(cb: (ok: boolean, message: string) => void): void {
	if (!discOpen) {
		cb(true, '局域网发现没在跑')
		return
	}
	discChannels(lanClose())
	discOpen = false
	cb(true, channelNote(discRoster))
}

export function lanPeers(): string {
	// The sockets answer when they are ready, not when lanStart() returned, so the channel states are
	// read here rather than trusted from the moment the button was pressed. Without this the list can
	// show a machine heard over 广播 while the same snapshot still says 广播：未启动.
	discChannels(lanStatusText())
	const now = nowSecs()
	sweepPeers(discRoster, now)
	const out = new UTSJSONObject()
	const rows: UTSJSONObject[] = []
	const list = candidatesOf(discRoster)
	for (let i = 0; i < list.length; i++) {
		const one = list[i]
		const row = new UTSJSONObject()
		row['prefix'] = one.prefix
		row['host'] = one.host
		row['port'] = one.port
		row['peer_id'] = one.peerId
		row['name'] = one.name
		row['version'] = one.version
		row['fingerprint'] = one.fingerprint
		row['via'] = one.via
		row['age'] = now - one.seen
		rows.push(row)
	}
	out['peers'] = rows
	out['total'] = list.length
	out['running'] = discOpen
	out['note'] = channelNote(discRoster)
	return JSON.stringify(out)
}

export function lanStatus(): string {
	const text = lanStatusText()
	const made = JSON.parse(text) as UTSJSONObject | null
	if (made == null) {
		return '{"note":"' + channelNote(discRoster) + '"}'
	}
	discChannels(text)
	made!['note'] = channelNote(discRoster)
	made!['running'] = discOpen
	return JSON.stringify(made!)
}

/** Presence is not trust: this is where a candidate stops being a broadcast and becomes a peer, and
 *  only the digest read off the TLS connection may arrive here. */
export function lanVerify(prefix: string, fingerprint: string): boolean {
	return markVerified(discRoster, prefix, fingerprint)
}

export function lanSelfReport(): string {
	return selfReport()
}
// #endif

/* ------------------------------------------------------------------ 发现列表接到连接 */
/** The shared half of #93: a card on 扫码连接 that lists what the two channels heard and lets a tap fill
 *  the target the 连接 button already reads.
 *
 *  What is deliberately *not* here: a pair code. An announcement carries a name, an address and a
 *  fingerprint prefix (spec §2) and nothing that authorises a session, so picking a row only fills in
 *  where to dial - the code and the password still come off the other screen, and the digest is checked
 *  against the announced prefix in markConnected() once TLS has answered. A list you could connect to by
 *  tapping alone would be a list of things to trust because somebody shouted about them.
 *
 *  The browser has no part in that check and no sockets to hear the LAN with, so it supplies demo rows
 *  through the same model and says which of its two promises it cannot keep. */

function viaText(one: UTSJSONObject): string {
	const list = one.getArray('via')
	if (list == null || list.length == 0) {
		return '没说到通道'
	}
	let text = ''
	for (let i = 0; i < list.length; i++) {
		const one2 = (list[i] as string) == 'mdns' ? 'mDNS' : '广播'
		text = text == '' ? one2 : text + '+' + one2
	}
	return text
}

/** One snapshot of the roster, painted. `rows` are the candidate objects the platform's `discSnapshot()`
 *  spelled out, in the shape `lanPeers()` returns them on a phone, so the card cannot tell a live
 *  machine from the browser's demo rows. */
function paintDisc(rows: UTSJSONObject[], note: string, total: number): void {
	const names: string[] = []
	const meta: string[] = []
	const hosts: string[] = []
	const ports: number[] = []
	const prefixes: string[] = []
	for (let i = 0; i < rows.length; i++) {
		const one = rows[i]
		const prefix = one.getString('prefix', '')
		const name = one.getString('name', '')
		names.push(name == '' ? '未命名 · ' + prefix.substring(0, 8) : name)
		meta.push(one.getString('host', '') + ':' + (one.getNumber('port') ?? 0).toString() +
			'　' + viaText(one) + '　' + (one.getNumber('age') ?? 0).toString() + ' 秒前')
		hosts.push(one.getString('host', ''))
		ports.push(one.getNumber('port') ?? 0)
		prefixes.push(prefix)
	}
	// Whole-array assignments again: the view sees a new list, never a half-written one.
	discHosts = hosts
	discPorts = ports
	discPrefixes = prefixes
	s.discNames = names
	s.discMeta = meta
	s.discNote = note
	s.discSummary = discRunning
		? (total == 0 ? '两条通道都没听到设备。可以改用扫码或手输地址。' : '找到 ' + total.toString() + ' 台，点一台填进下面的连接。')
		: (discRanOnce ? '发现没在跑，下面这份名单是上一次的。' : '')
}

// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
/** What the two channels heard, as the plugin's own JSON. */
function discSnapshot(): string {
	return lanPeers()
}

function discStartChannels(cb: (ok: boolean, message: string) => void): void {
	lanStart(cb)
}

function discStopChannels(cb: (ok: boolean, message: string) => void): void {
	lanStop(cb)
}
// #endif

// #ifdef WEB
/** A browser can join no multicast group and send no limited broadcast, so there is nothing here for
 *  the two channels to hear and this card can only ever show demo rows. They go through the same roster
 *  the phones paint from - `applyAnnounce` and `applyTxt` with two canned packets, re-offered on every
 *  read the way a live machine re-announces every three seconds - so the expiry, the via-merge and the
 *  sort a reviewer sees in the browser are the real rules. What is invented is only the traffic, and the
 *  note says so. */
let discDemo = newRoster('0000000000000000')
let discDemoNote = ''

function discSnapshot(): string {
	const now = Math.floor(Date.now() / 1000)
	if (discRunning) {
		applyAnnounce(discDemo, buildAnnounce('demo-4f2a', TRANSPORT_PORT, '客厅的笔记本', 'c5410bb27d9e3f86', now), '192.168.1.31', now)
		applyTxt(discDemo, buildTxt('书房的那台 PC', '9f2c1d77a4b8e013', now), '192.168.1.12', TRANSPORT_PORT, now)
	}
	sweepPeers(discDemo, now)
	const out = new UTSJSONObject()
	const rows: UTSJSONObject[] = []
	const list = candidatesOf(discDemo)
	for (let i = 0; i < list.length; i++) {
		const one = list[i]
		const row = new UTSJSONObject()
		row['prefix'] = one.prefix
		row['host'] = one.host
		row['port'] = one.port
		row['peer_id'] = one.peerId
		row['name'] = one.name
		row['version'] = one.version
		row['fingerprint'] = one.fingerprint
		row['via'] = one.via
		row['age'] = now - one.seen
		rows.push(row)
	}
	out['peers'] = rows
	out['total'] = list.length
	out['running'] = discRunning
	out['note'] = discDemoNote
	return JSON.stringify(out)
}

function discStartChannels(cb: (ok: boolean, message: string) => void): void {
	discDemo = newRoster('0000000000000000')
	discDemoNote = '浏览器没有广播套接字，也进不了 mDNS：这两台是演示数据，连上去的还是那个模拟对端。'
	cb(true, '两条通道在浏览器里都起不来，名单改成演示数据')
}

function discStopChannels(cb: (ok: boolean, message: string) => void): void {
	discDemoNote = '演示名单已经清掉：浏览器本来也听不见真的局域网。'
	cb(true, '浏览器没有可停的通道')
}
// #endif

/** The roster, painted. Called once when the page shows and then once a second while it is open: a
 *  candidate expires 15 seconds after the last packet, so a list refreshed less often than that is a
 *  list of machines that are no longer there. */
export function refreshDiscovery(): void {
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	syncTargetCard()
	// #endif
	const made = JSON.parse(discSnapshot()) as UTSJSONObject | null
	if (made == null) {
		return
	}
	const rows = made!.getArray<UTSJSONObject>('peers')
	paintDisc(rows == null ? [] : rows, made!.getString('note', ''), made!.getNumber('total') ?? 0)
}

/** Start or stop both channels with one button, because the user has no reason to know there are two.
 *  The answer comes back on the page's own thread - a socket callback on a phone, synchronously in the
 *  browser - so the labels are written in the callback rather than after the call. */
export function toggleDiscovery(): void {
	if (discRunning) {
		discStopChannels(function (ok: boolean, message: string): void {
			discRunning = false
			s.discButton = '找局域网设备'
			s.discNote = message
			refreshDiscovery()
		})
		return
	}
	s.discNote = '正在起广播端口 43721 和 mDNS……'
	discStartChannels(function (ok: boolean, message: string): void {
		discRunning = ok
		if (ok) {
			discRanOnce = true
		}
		s.discButton = ok ? '停止找设备' : '找局域网设备'
		refreshDiscovery()
		if (!ok) {
			log('发现起不来：' + message)
		}
	})
}

/** What this platform can promise about the digest once the connection is up. The browser's peer is a
 *  mock with no TLS handshake behind it, so it must not claim the §2 re-check it cannot run. */
function discPromise(): string {
	// #ifdef WEB
	return '　浏览器里的对端本来就是模拟的，这一步核对不到'
	// #endif
	// #ifndef WEB
	return '，连上后按 TLS 上的完整指纹核对'
	// #endif
}

/** A row is a place to dial, not a reason to trust. The port comes from the announcement because the
 *  desktop's TLS listener may not be on 43720 - the same reason the phone's own announcement carries the
 *  port it actually opened. */
export function pickPeer(at: number): void {
	if (at < 0 || at >= discHosts.length) {
		return
	}
	if (s.connecting || s.connected) {
		log('先断开当前连接，再换一台对端')
		return
	}
	const host = discHosts[at]
	const port = discPorts[at]
	discPicked = discPrefixes[at]
	s.host = host
	s.port = port.toString()
	s.scannedFp = ''
	s.targetLabel = '来自局域网发现：' + host + ':' + port.toString() +
		'　前缀 ' + discPicked + discPromise()
	s.showAdvanced = false
	refreshPinned()
	checkNet(host, noOp)
	syncSendable()
	log('已选中 ' + s.discNames[at] + '（' + host + ':' + port.toString() +
		'），照着它屏幕上的配对码和密码点连接')
}
