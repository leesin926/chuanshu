		margin-right: 6px;
	}

	.icoSearch {
		width: 20px;
		height: 20px;
		margin-right: 8px;
	}

	.icoAvatar {
		width: 44px;
		height: 44px;
	}

	.rowmain {
		flex: 1;
		flex-direction: column;
	}

	.rowright {
		flex-direction: column;
		align-items: flex-end;
	}

	.fname {
		font-size: 17px;
		color: #1f2937;
	}

	.fsize {
		font-size: 14px;
		color: #6b7280;
		margin-top: 4px;
	}

	.fdate {
		font-size: 13px;
		color: #9ca3af;
	}

	.fstate {
		font-size: 14px;
		margin-top: 4px;
	}

	.stateWait {
		color: #9ca3af;
	}

	.stateRun {
		color: #2f7cf6;
	}

	.stateOk {
		color: #16a34a;
	}

	.stateBad {
		color: #ef4444;
	}

	/* ---- 按钮：一切按钮都是胶囊（圆角 = 高度的一半），方角在这套设计里不存在 ---- */
	.mini {
		height: 36px;
		line-height: 36px;
		font-size: 15px;
		background-color: #e5e7eb;
		color: #4b5563;
		border-radius: 18px;
		padding: 0 18px;
		margin: 0 10px 10px 0;
		border-width: 0;
	}

	.primary {
		height: 46px;
		line-height: 46px;
		font-size: 17px;
		background-color: #2f7cf6;
		color: #ffffff;
		border-radius: 23px;
		border-width: 0;
	}

	/* 破坏性动作在设计图里只出现一次：橙→红渐变，比次按钮更醒目。 */
	.danger {
		height: 46px;
		line-height: 46px;
		font-size: 17px;
		color: #ffffff;
		border-radius: 23px;
		border-width: 0;
		background-image: linear-gradient(to right, #f6a609, #ef4444);
	}

	/* 选中态用描边表达（发送页的设备卡），而不是改底色。 */
	.selected {
		border-width: 2px;
		border-style: solid;
		border-color: #2f7cf6;
	}

	/* ---- 进度条：详情页 8px 粗条 + 右侧蓝色大号百分比；行内 4px 细条 + 灰色百分比 ---- */
	.bar {
		height: 8px;
		background-color: #e5e7eb;
		border-radius: 4px;
		width: 100%;
	}

	.fill {
		height: 8px;
		background-color: #2f7cf6;
		border-radius: 4px;
	}

	.barthin {
		height: 4px;
		background-color: #e5e7eb;
		border-radius: 2px;
		flex: 1;
	}

	.fillthin {
		height: 4px;
		background-color: #2f7cf6;
		border-radius: 2px;
	}

	.pct {
		font-size: 22px;
		font-weight: bold;
		color: #2f7cf6;
		width: 70px;
		text-align: right;
	}

	/* ---- 首页的连接状态 banner：蓝→浅蓝渐变，右上角一个绿点 ---- */
	.banner {
		flex-direction: row;
		align-items: center;
		height: 64px;
		border-radius: 16px;
		padding: 0 20px;
		margin-bottom: 16px;
		background-image: linear-gradient(to right, #3b82f6, #8fc0fa);
	}

	.bannertext {
		flex: 1;
		font-size: 17px;
		font-weight: bold;
		color: #ffffff;
	}

	.bannerwait {
		background-image: linear-gradient(to right, #94a3b8, #cbd5e1);
	}

	.dot {
		width: 14px;
		height: 14px;
		border-radius: 7px;
		background-color: #22c55e;
	}

	.dotoff {
		background-color: #9ca3af;
	}

	/* ---- 四宫格入口 ---- */
	.grid {
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: space-between;
	}

	.cell {
		width: 48%;
		height: 110px;
		background-color: #ffffff;
		border-radius: 16px;
		align-items: center;
		justify-content: center;
		margin-bottom: 14px;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
	}

	.celllabel {
		font-size: 16px;
		color: #1f2937;
		margin-top: 10px;
	}

	/* ---- 我的页：蓝→紫渐变用户卡 + 设置行 ---- */
	.avatarcard {
		flex-direction: row;
		align-items: center;
		height: 130px;
		border-radius: 20px;
		padding: 0 20px;
		margin-bottom: 16px;
		background-image: linear-gradient(to right, #60a5fa, #a78bfa);
