	}

	.avatarsub {
		font-size: 15px;
		color: #ffffff;
		margin-top: 6px;
	}

	/* 设计图「通知」那一行右边是个开关。这里不用 <switch> 组件而是自己画：一是它的 change 事件在
	   UTS 里要带平台事件类型，二是自己画的那颗能精确按设计图的 52x30 / 蓝底白圆点来。 */
	.switch {
		width: 52px;
		height: 30px;
		border-radius: 15px;
		background-color: #e5e7eb;
	}

	.switchon {
		background-color: #2f7cf6;
	}

	.knob {
		width: 26px;
		height: 26px;
		border-radius: 13px;
		background-color: #ffffff;
		margin: 2px;
	}

	.knobon {
		margin-left: 24px;
	}

	/* 设计图里「通知」那一行是开关、其他行是「值 + chevron」，同一张卡里两种右端控件混排，照抄。 */
	.setrow {
		flex-direction: row;
		align-items: center;
		min-height: 58px;
	}

	.setlabel {
		flex: 1;
		font-size: 16px;
		color: #1f2937;
		margin-left: 14px;
	}

	.setval {
		font-size: 14px;
		color: #9ca3af;
	}

	.chevron {
		font-size: 16px;
		color: #9ca3af;
		margin-left: 6px;
	}

	/* ---- 胶囊 chip：分类筛选和分段控件，选中蓝底白字，未选中灰底深灰字 ---- */
	.chip {
		height: 34px;
		line-height: 34px;
		font-size: 15px;
		background-color: #e2e5ea;
		color: #374151;
		border-radius: 17px;
		padding: 0 18px;
		margin-right: 10px;
	}

	.chipon {
		background-color: #2f7cf6;
		color: #ffffff;
	}

	/* ---- 日志 ---- */
	.log {
		height: 240px;
		background-color: #f7f8fa;
		border-radius: 12px;
		padding: 12px;
	}

	.logline {
