<script setup lang="uts">
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('App Launch')
	})

	onAppShow(() => {
		console.log('App Show')
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style>
	/* 每个页面公共 css。放在这里而不是各页的 style 块里，是因为六个页面用的是同一套卡片和字级：
	   一个类在两个页面里长得不一样，用户读出来就是两个产品。
	   色值、圆角、字号取自设计图（手机 6 张），不是自己定的：主色 #2F7CF6 承担所有「可点/选中/进行中」，
	   灰阶只有 #1F2937 / #6B7280 / #9CA3AF 三档，圆角只有 16 / 20 / 全圆三档。 */

	/* ---- 容器 ---- */
	.page {
		flex-direction: column;
		/*  Both, because neither alone bounds the scroll-view on Harmony: the page container is
		    sized by its content, so `100%` resolves to that content and nothing scrolls, and `flex: 1`
		    has no definite parent height to grow into. Together they give the scroll-view the viewport. */
		flex: 1;
		height: 100%;
		padding: 20px;
		background-color: #eef0f5;
	}

	.card {
		flex-direction: column;
		background-color: #ffffff;
		border-radius: 20px;
		padding: 20px;
		margin-bottom: 16px;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
	}

	/* 设计图里小卡（入口格、设置组）用 16，大内容卡（列表、详情）用 20，不是随手分的。 */
	.card16 {
		border-radius: 16px;
	}

	.head {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	/* 页面级超大标题（首页的「传书」）。设计图里它不是导航条标题，是页面内第一个视觉重量。 */
	.title {
		font-size: 30px;
		font-weight: bold;
		color: #1e293b;
	}

	/* 区块标题：「最近传输」「本次传输历史」「选择目标设备」都是这一档。 */
	.h {
		font-size: 20px;
		font-weight: bold;
		color: #1e293b;
	}

	.badge {
		font-size: 12px;
		color: #d46b08;
		background-color: #fff7e8;
		border-radius: 6px;
		padding: 3px 8px;
	}

	.big {
		margin-top: 8px;
		font-size: 17px;
		color: #1f2937;
	}

	.hero {
		margin-top: 8px;
		font-size: 18px;
		font-weight: bold;
		color: #1f2937;
	}

	.divider {
