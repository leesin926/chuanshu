		background-color: #eef0f4;
		margin-top: 16px;
	}

	.sub {
		margin-top: 6px;
		font-size: 15px;
		color: #6b7280;
	}

	.note {
		margin-top: 8px;
		font-size: 15px;
		color: #6b7280;
		line-height: 22px;
	}

	.row {
		flex-direction: row;
		align-items: center;
	}

	.rowtop {
		flex-direction: row;
		align-items: flex-start;
	}

	.wrap {
		flex-wrap: wrap;
	}

	.between {
		justify-content: space-between;
	}

	.mt8 {
		margin-top: 8px;
	}

	.mt16 {
		margin-top: 16px;
	}

	.col1 {
		flex: 1;
		flex-direction: column;
	}

	.col2 {
		width: 90px;
		flex-direction: column;
	}

	/* ---- 输入 ---- */
	.input {
		height: 44px;
		font-size: 15px;
		background-color: #f5f6f8;
		border-radius: 22px;
		padding: 0 16px;
		margin-right: 10px;
		color: #1f2937;
	}

	/* ---- 列表行：一整张白卡里多行 + 行间 hairline，行结构是「图标 + 主文本(+副文本) + 右状态」 ---- */
	.filerow {
		flex-direction: row;
		align-items: center;
		min-height: 60px;
	}

	/* 列表行里图标和文字之间要留 14；四宫格里的图标是居中的，所以间距单独立一个类。 */
	.tilegap {
		margin-right: 14px;
	}

	/* 设计图里的图标是有形状的（上传箭头、文件夹、放大镜、显示器…），不是一个色块。形状用 .probe/mkicons.py 栅格成 PNG 放进 static/icons，这里只管尺寸：
	   鸿蒙的 <image> 不认 SVG，只认位图，tabBar 那八个已经是这条路的证据。 */
	.icoHome {
		width: 40px;
		height: 40px;
	}

	.icoRow {
		width: 34px;
		height: 34px;
	}

	.icoMe {
		width: 26px;
		height: 26px;
		margin-right: 14px;
	}

	.icoBig {
		width: 56px;
		height: 56px;
		margin-right: 16px;
	}

	.icoChip {
		width: 18px;
