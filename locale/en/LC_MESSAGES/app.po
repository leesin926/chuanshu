msgstr "Pairing code: {code}"

#: app/ui/transfer.py:1512
#, python-brace-format
msgid "密码：{secret}"
msgstr "Password: {secret}"

#: app/ui/transfer.py:1516
msgid "本机接收端口没有打开。"
msgstr "This machine is not listening on a receive port."

#: app/ui/transfer.py:1518
