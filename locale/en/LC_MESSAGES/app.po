msgstr "Receiving is off, so nobody can connect."

#: app/ui/transfer.py:1519
#, python-brace-format
msgid "端口：{port}"
msgstr "Port: {port}"

#: app/ui/transfer.py:1527
msgid "发现通道：mDNS 与 UDP 都可用。"
msgstr "Discovery: mDNS and UDP are both working."

#: app/ui/transfer.py:1528
msgid "mDNS"
msgstr "mDNS"

#: app/ui/transfer.py:1528
msgid "UDP 广播"
msgstr "UDP broadcast"

#: app/ui/transfer.py:1531
#, python-brace-format
msgid "发现通道：{which} 都不可用，只能手输地址或粘贴配对串。"
msgstr ""
"Discovery: {which} are both unavailable, so type an address or paste a "
"pairing string."

#: app/ui/transfer.py:1532
#, python-brace-format
msgid "发现通道：{which} 不可用，仍可手输地址或粘贴配对串。"
msgstr ""
"Discovery: {which} is unavailable; you can still type an address or paste"
" a pairing string."

#: app/ui/transfer.py:1546
msgid "入站：防火墙放行了，别人连得进来。"
msgstr "Inbound: the firewall allows it, so other devices can connect."

#: app/ui/transfer.py:1548
#, python-brace-format
msgid "入站：防火墙挡着——本机在听 {port}，但这个程序名下留着阻止入站的规则，对方连不进来。"
msgstr ""
"Inbound: the firewall is blocking - this machine listens on {port}, but a"
" block rule is set against this program, so peers cannot connect."

#: app/ui/transfer.py:1552
#, python-brace-format
msgid "入站：防火墙没放行——本机在听 {port}，但没有任何规则让对端连进来。"
msgstr ""
"Inbound: the firewall lets nothing in - this machine listens on {port}, "
"but no rule allows a peer to connect."

#: app/ui/transfer.py:1553
msgid "入站：读不到防火墙的状态，所以这句话给不了保证。"
msgstr ""
"Inbound: the firewall's state could not be read, so this line is no "
"guarantee."

#: app/ui/transfer.py:1570
msgid "要放行，自己提权跑这几条（传书不替你写规则）："
msgstr ""
"To allow it, run these yourself from an elevated prompt (ChuanShu does "
"not write firewall rules for you):"

#: app/ui/transfer.py:1604
#, python-brace-format
msgid "这台机器开不了接收端口，但仍能主动发出去：{error}"
msgstr "This machine cannot open a receive port, but can still send: {error}"

#: app/ui/transfer.py:1606
#, python-brace-format
msgid "上次有 {n} 个传输没传完，对方接着传就会续上。"
msgstr ""
"{n} transfer(s) stopped halfway last time; the sender resumes them by "
"itself."

#: app/ui/transfer.py:1641
