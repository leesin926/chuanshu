msgid "更早"
msgstr "Earlier"

#: app/ui/transfer.py:2757
msgid "传输中"
msgstr "Transferring"

#: app/ui/transfer.py:2813
#, python-brace-format
msgid "发给 {who}"
msgstr "Sent to {who}"

#: app/ui/transfer.py:2815
#, python-brace-format
