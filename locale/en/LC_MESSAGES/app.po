msgstr "{title} (sending {name})"

#: app/ui/transfer.py:2539
#, python-brace-format
msgid "正在发送：{name}"
msgstr "Sending: {name}"

#: app/ui/transfer.py:2544
msgid "未开始"
msgstr "Not started"

