#: app/ui/settings_dialog.py:245
msgid "上面这几项由 protocol/protocol.json 冻结，手机端按同一份契约校验，改了就配不上对。"
msgstr ""
"The values above are frozen in protocol/protocol.json and the phone app "
"checks the same contract, so changing one breaks pairing."

#: app/ui/settings_dialog.py:254
msgid "撤销这台设备"
msgstr "Forget this device"

#: app/ui/settings_dialog.py:256
msgid "已配对设备"
msgstr "Paired devices"

#: app/ui/settings_dialog.py:258
msgid "配对成功过的设备记在这里，下次传文件不再问配对码。怀疑对方换过密钥就撤销它。"
msgstr ""
"Devices that paired successfully stay on this list, so the next transfer "
"asks for no code. Remove one if you think its key was replaced."

#: app/ui/settings_dialog.py:274
msgid "打开日志目录"
msgstr "Open log folder"

#: app/ui/settings_dialog.py:276
msgid "关于"
msgstr "About"

#: app/ui/settings_dialog.py:277
