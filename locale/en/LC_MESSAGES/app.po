#, python-brace-format
msgid ""
"{addr}\n"
"指纹前缀 {fp}；发现于 {via}。{state}"
msgstr ""
"{addr}\n"
"Fingerprint prefix {fp}; found via {via}. {state}"

#: app/ui/transfer.py:1868
msgid "未知"
msgstr "Unknown"

#: app/ui/transfer.py:1889
msgid "（对方连进来，只能收）"
msgstr "(dialed in, receive only)"

#: app/ui/transfer.py:1892
#, python-brace-format
