msgstr "Choose the receive folder"

#: app/ui/settings_dialog.py:409
msgid "这台设备已经不在名单里了。"
msgstr "That device is no longer on the list."

#: app/ui/settings_dialog.py:416
#, python-brace-format
msgid "已撤销 {name}，它已从已连接的设备里移出，下次传文件要重新配对。"
msgstr ""
"Revoked {name}; it left the connected list and has to pair again before any "
"transfer."

#: app/ui/settings_dialog.py:428
msgid "这台设备对别人显示的名字"
msgstr "The name other devices see for this one"

#: app/ui/settings_dialog.py:429
