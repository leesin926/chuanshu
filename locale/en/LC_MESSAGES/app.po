#, python-brace-format
msgid "已收到 {who} 发来的 {n} 个文件（{size}），逐个校验通过。"
msgstr "Received {n} file(s) from {who} ({size}), every one verified."

#: app/ui/transfer.py:2650
msgid "（已经不在了）"
msgstr " (missing)"

#: app/ui/transfer.py:2659
msgid "时间未知"
msgstr "Unknown time"

