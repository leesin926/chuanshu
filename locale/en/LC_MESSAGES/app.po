#: app/crash.py:43
msgid "程序遇到未处理的错误。操作可以继续，但请查看日志。"
msgstr ""
"The program hit an unhandled error. You can keep going, but please check the"
" log."

#: app/crash.py:44
msgid "日志文件"
msgstr "Log file"

#: app/crash.py:59
msgid "未处理的异常"
msgstr "Unhandled exception"

#: app/crash.py:67
msgid "后台线程异常"
msgstr "Background thread error"

#: app/crash.py:95
msgid "界面处理异常"
msgstr "UI event error"

#: app/net/errors.py:13
msgid "对端版本不兼容"
msgstr "The other device uses an incompatible version."

#: app/net/errors.py:14
msgid "尚未与这台设备配对"
msgstr "You have not paired with this device yet."

#: app/net/errors.py:15
msgid "配对码不正确或已过期"
msgstr "The pairing code is wrong or has expired."

#: app/net/errors.py:16
msgid "对方拒绝了这次传输"
msgstr "The other side declined this transfer."

#: app/net/errors.py:17
msgid "传输请求不存在或已结束"
msgstr "This transfer no longer exists or has ended."

#: app/net/errors.py:18
msgid "分块序号超出文件范围"
msgstr "The chunk number is outside this file."

#: app/net/errors.py:19
msgid "分块校验失败"
msgstr "A chunk failed its checksum."

#: app/net/errors.py:20
msgid "文件校验失败"
msgstr "The file failed its checksum."

#: app/net/errors.py:21
msgid "文件名被接收方拒绝"
msgstr "The receiver rejected this file name."

#: app/net/errors.py:22
msgid "接收方存储空间不足"
msgstr "The receiver does not have enough free space."

#: app/net/errors.py:23
msgid "对方正在处理另一个传输"
msgstr "The other side is busy with another transfer."

