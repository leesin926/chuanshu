msgstr ""
"The sender stopped waiting for an answer, so this confirmation card "
"closed."

#: app/ui/transfer.py:1762
#, python-brace-format
msgid "正在连接 {name}（{host}）…"
msgstr "Connecting to {name} ({host})…"

#: app/ui/transfer.py:1767
#, python-brace-format
msgid "已选择 {name}（{host}）。本机存过它的密钥，留空配对码点连接。"
msgstr ""
"Selected {name} ({host}). This machine has its key, so connect with an "
"empty code."

#: app/ui/transfer.py:1768
#, python-brace-format
msgid "已选择 {name}（{host}）。输入它屏幕上的 {n} 位配对码{extra}，再点连接。"
msgstr ""
"Selected {name} ({host}). Type the {n}-digit code{extra} on its screen, "
"then press Connect."

#: app/ui/transfer.py:1769
#, python-brace-format
msgid "和 {m} 位密码"
msgstr " and its {m}-character password"

#: app/ui/transfer.py:1773
#, python-brace-format
msgid "一次只连一台，现在连着 {name}。要换设备先点「断开」。"
msgstr ""
"One device at a time; {name} holds the connection. Press Disconnect "
"before switching."

#: app/ui/transfer.py:1775
msgid "自动发现没有运行。点「手输地址…」填对方地址，或粘贴它的配对串。"
msgstr ""
"Auto discovery is not running. Use Enter address for its address, or "
"paste its pairing string."

#: app/ui/transfer.py:1778
msgid "附近暂时没有广播出来的设备。点「手输地址…」填对方地址，或让它扫上面的码。"
msgstr ""
"Nothing is broadcasting nearby right now. Use Enter address, or have it "
"scan the code above."

#: app/ui/transfer.py:1779
msgid "点上面一台设备选中它，再填配对码连接；没广播出来的点「手输地址…」。"
msgstr ""
"Click a device above to select it, then type its pairing code. For one "
"that never broadcasts, use Enter address."

#: app/ui/transfer.py:1858 app/ui/transfer.py:1870
msgid "已连接"
msgstr "Connected"

#: app/ui/transfer.py:1858 app/ui/transfer.py:1870 app/ui/transfer.py:1888
msgid "在线"
msgstr "Online"

