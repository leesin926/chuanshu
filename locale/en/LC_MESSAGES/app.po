#, python-brace-format
msgid "原本落在：{path}"
msgstr "Was saved to: {path}"

#: app/ui/transfer.py:2676
msgid "没有符合条件的文件。"
msgstr "No files match."

#: app/ui/transfer.py:2676
msgid "还没有收到校验通过的文件。"
msgstr "Nothing verified has arrived yet."

#: app/ui/transfer.py:2688
#, python-brace-format
