#, python-brace-format
msgid "连不上 {addr}：{error}"
msgstr "Cannot reach {addr}: {error}"

#: app/ui/transfer.py:2005
#, python-brace-format
msgid "一次只连一台。先断开 {name}，再连新设备。"
msgstr "One device at a time. Disconnect {name} before connecting another."

#: app/ui/transfer.py:2006
msgid "用上面的配对码和密码连接选中的设备。"
msgstr "Connects the selected device with the code and password above."

#: app/ui/transfer.py:2018
msgid "先在「附近设备」里点一台，或点「手输地址…」填它的地址。"
msgstr "First click a device under Nearby, or use Enter address for its address."

#: app/ui/transfer.py:2023
#, python-brace-format
msgid "本机一次只连一台，现在连着 {name}。要先点「断开」再连它。"
msgstr ""
"This machine keeps one connection at a time; {name} holds it. Press "
"Disconnect first."

#: app/ui/transfer.py:2028
#, python-brace-format
msgid "还差对方屏幕上那 {n} 位配对码。"
msgstr "The {n}-digit code on the other screen is still missing."

#: app/ui/transfer.py:2052
#, python-brace-format
msgid "配对码或密码不对。请照着对方屏幕上现在的 {n} 位码和 {m} 位密码再输一次。"
msgstr ""
"That pairing code or password is wrong. Retype the {n}-digit code and "
"{m}-character password now on the other screen."

#: app/ui/transfer.py:2061
#, python-brace-format
msgid "它已经连着 {peer}，一次只允许一台。请那边先断开。"
msgstr ""
"It is already connected to {peer}; only one peer is allowed. Disconnect "
"on that side first."

#: app/ui/transfer.py:2064 app/ui/transfer.py:2518
#, python-brace-format
msgid "对方说：{text}"
msgstr "The other side said: {text}"

#: app/ui/transfer.py:2097
#, python-brace-format
msgid "已连接 {name}，指纹前缀 {fp}。核对无误再发。"
msgstr "Connected to {name}, fingerprint prefix {fp}. Check it before sending."

#: app/ui/transfer.py:2123
#, python-brace-format
msgid "已断开 {name}。它的密钥还留在本机，留空配对码就能重连；要彻底撤销请去设置。"
msgstr ""
"Disconnected {name}. Its key stays on this machine, so an empty code "
"reconnects it; revoke it in Settings to forget it."

#: app/ui/transfer.py:2156
#, python-brace-format
msgid "{name} 已经 {minutes} 分钟没有动静，本机把会话名额收回了；它的密钥还在，重连不用再报配对码。"
msgstr ""
"{name} has said nothing for {minutes} minutes, so this machine took the "
"session slot back; its key is still pinned, so reconnecting needs no pair"
" code."

#: app/ui/transfer.py:2170
msgid "这台设备是连进来的，本机没有可回拨的地址。要发给它，请改由它连接本机。"
msgstr ""
"This device dialed in, so there is no address to call back. To send to "
"it, have it connect to this machine instead."

#: app/ui/transfer.py:2181
msgid "还没有选定接收设备。到「接收」页连一台，或在附近列表里点一台。"
msgstr ""
"No receiving device is selected yet. Connect one on the Receive page, or "
"click one in the nearby list."

#: app/ui/transfer.py:2183
#, python-brace-format
msgid "当前对端：{name}（{addr}，指纹前缀 {fp}）"
msgstr "Current peer: {name} ({addr}, fingerprint prefix {fp})"

#: app/ui/transfer.py:2198
msgid "这台设备还没有连接会话，点「连接」建立一条。"
msgstr "This device has no connection session yet; press Connect to start one."

#: app/ui/transfer.py:2201
#, python-brace-format
msgid "对方要求每 {ms} 毫秒写一条 TLS 记录，所以这台设备比局域网正常水平慢，这不是网络故障。"
msgstr ""
"The peer asks for one TLS record every {ms} ms, so this device runs "
"slower than the usual LAN speed. That is not a network fault."

