#: app/ui/transfer.py:161
msgid "连接设备"
msgstr "Connect a device"

#: app/ui/transfer.py:188 app/ui/transfer.py:737
msgid "连接"
msgstr "Connect"

#: app/ui/transfer.py:199
msgid "下面是广播出来的候选设备。选中一台，回到主界面填它的配对码和密码，再点连接。"
msgstr ""
"These are the devices that announced themselves. Pick one, type its pairing "
"code and password on the main page, then press Connect."

#: app/ui/transfer.py:200
msgid "手输地址…"
msgstr "Type an address…"

#: app/ui/transfer.py:201
msgid "没在局域网里广播出来的设备，可以输入它的地址，或粘贴 chuanshu:// 配对串。"
msgstr ""
"For a device that never showed up on the LAN, type its address or paste its "
"chuanshu:// pairing string."

#: app/ui/transfer.py:202
msgid "刷新"
msgstr "Refresh"

#: app/ui/transfer.py:211
msgid "（已连接）"
msgstr " (connected)"

#: app/ui/transfer.py:214 app/ui/transfer.py:215
msgid "手动添加"
msgstr "typed in"

#: app/ui/transfer.py:215
#, python-brace-format
msgid "发现于 {via}；指纹前缀 {fp}"
msgstr "Found via {via}; fingerprint prefix {fp}"

#: app/ui/transfer.py:220
msgid "没找到设备。手输对方地址，或粘贴它的配对串。"
msgstr "No devices found. Type its address, or paste its pairing string."

#: app/ui/transfer.py:225
msgid "手动添加设备"
msgstr "Add a device by address"

#: app/ui/transfer.py:225
#, python-brace-format
msgid "输入对方地址（{example}）或配对串："
msgstr "Type the address ({example}) or paste the pairing string:"

#: app/ui/transfer.py:235
#, python-brace-format
msgid "已确认 {name}，指纹前缀 {fp}。选中它点连接。"
msgstr "Reached {name}, fingerprint prefix {fp}. Select it and press Connect."

#: app/ui/transfer.py:242
msgid "先选中一台设备，再点连接。"
msgstr "Select a device first, then press Connect."

#: app/ui/transfer.py:513 app/ui/transfer.py:740
msgid "让对方扫这个码，就能带着配对码和密码连过来。"
msgstr ""
"The other side scans this and connects with the pairing code and password in"
" hand."

#: app/ui/transfer.py:693
msgid "我的设备"
msgstr "My device"

#: app/ui/transfer.py:694
msgid "已连接的设备"
msgstr "Connected devices"

#: app/ui/transfer.py:695
msgid "把文件或文件夹拖到这里"
msgstr "Drop files or folders here"

#: app/ui/transfer.py:697
msgid "也可以点下面的按钮挑选。对方要先接受，文件才会落到它的接收目录。"
msgstr ""
"Or pick them with the buttons below. Nothing is written until the other side"
" accepts."

#: app/ui/transfer.py:699
msgid "本次会话的传输"
msgstr "This session's transfers"

#: app/ui/transfer.py:700
msgid "全部"
msgstr "All"

#: app/ui/transfer.py:701
msgid "今天"
msgstr "Today"

#: app/ui/transfer.py:702
msgid "近 7 天"
msgstr "Last 7 days"

#: app/ui/transfer.py:704
msgid "大小"
msgstr "Size"

#: app/ui/transfer.py:704
msgid "时间"
msgstr "Time"

#: app/ui/transfer.py:704
msgid "来源设备"
msgstr "From device"

#: app/ui/transfer.py:709 app/ui/transfer.py:949
#, python-brace-format
msgid "保存到：{path}"
msgstr "Saves to: {path}"

#: app/ui/transfer.py:710
msgid "更换配对码和密码"
msgstr "Change code and password"

#: app/ui/transfer.py:712
msgid "换一组新的固定配对码和密码，二维码跟着变。已经连上的设备不受影响。"
msgstr ""
"Mints a new fixed pairing code and password; the QR changes with them. A "
"device already connected is not affected."

#: app/ui/transfer.py:714
msgid "打开"
msgstr "Open"

#: app/ui/transfer.py:716
msgid "编辑"
msgstr "Edit"

#: app/ui/transfer.py:717
#, python-brace-format
msgid "本机：{name}"
msgstr "This device: {name}"

#: app/ui/transfer.py:718
msgid "收到的文件都校验通过、已经落盘。记录存在本机，重启也还在。"
msgstr ""
"Every received file was verified and written to disk. The list is kept on "
"this machine and survives a restart."

#: app/ui/transfer.py:719
msgid "选择文件…"
msgstr "Choose files…"

#: app/ui/transfer.py:720
msgid "选择文件夹…"
msgstr "Choose folder…"

#: app/ui/transfer.py:721
msgid "清空"
msgstr "Clear"

#: app/ui/transfer.py:722
msgid "从附近选择…"
msgstr "Pick from nearby…"

#: app/ui/transfer.py:723
msgid "列出广播出来的候选设备，也可以手输地址或粘贴配对串。"
msgstr ""
"Lists the devices that announced themselves; you can also type an address or"
" paste a pairing string."

#: app/ui/transfer.py:724
msgid "断开"
msgstr "Disconnect"

#: app/ui/transfer.py:726
#, python-brace-format
msgid "{n} 位配对码"
msgstr "{n}-digit pairing code"

#: app/ui/transfer.py:728
#, python-brace-format
msgid "输入对方屏幕上显示的 {n} 位配对码。本机存过它的密钥时留空即可，用签名重连。"
msgstr ""
"Type the {n}-digit code shown on the other screen. Leave it empty if this "
"machine already has its key; the signature reconnects."

#: app/ui/transfer.py:730
msgid "连接密码（可留空）"
msgstr "Password (optional)"

#: app/ui/transfer.py:733
#, python-brace-format
msgid "输入对方屏幕上显示的 {n} 位连接密码。对方是还没有密码的旧版本时留空，这时只用配对码完成首次配对。"
msgstr ""
"Type the {n}-character password shown on the other screen. Leave it empty "
"for a build that has no password yet; the first pairing then rests on the "
"code alone."

#: app/ui/transfer.py:739
msgid "发送给所选设备"
msgstr "Send to the selected device"

#: app/ui/transfer.py:829
msgid "已换成新的配对码和密码，旧二维码作废。已连接的设备不受影响。"
msgstr ""
"New pairing code and password are in force; the old QR no longer works. "
"Connected devices are unaffected."

#: app/ui/transfer.py:834
msgid "配对码要等接收端口打开才有"
msgstr "The pairing code appears once the receiving port is open"

#: app/ui/transfer.py:835
#, python-brace-format
msgid "配对码：{code}"
msgstr "Pairing code: {code}"

#: app/ui/transfer.py:840
#, python-brace-format
msgid "密码：{secret}"
msgstr "Password: {secret}"

#: app/ui/transfer.py:844
msgid "本机接收端口没有打开。"
msgstr "This machine is not listening on a receive port."

#: app/ui/transfer.py:846
msgid "接收已停止，对方连不进来。"
msgstr "Receiving is off, so nobody can connect."

#: app/ui/transfer.py:847
#, python-brace-format
msgid "端口：{port}"
msgstr "Port: {port}"

#: app/ui/transfer.py:855
msgid "发现通道：mDNS 与 UDP 都可用。"
msgstr "Discovery: mDNS and UDP are both working."

#: app/ui/transfer.py:856
msgid "mDNS"
msgstr "mDNS"

#: app/ui/transfer.py:856
msgid "UDP 广播"
msgstr "UDP broadcast"

#: app/ui/transfer.py:859
#, python-brace-format
msgid "发现通道：{which} 都不可用，只能手输地址或粘贴配对串。"
msgstr ""
"Discovery: {which} are both unavailable, so type an address or paste a "
"pairing string."

#: app/ui/transfer.py:860
#, python-brace-format
msgid "发现通道：{which} 不可用，仍可手输地址或粘贴配对串。"
msgstr ""
"Discovery: {which} is unavailable; you can still type an address or paste a "
"pairing string."

#: app/ui/transfer.py:864
#, python-brace-format
msgid "这台机器开不了接收端口，但仍能主动发出去：{error}"
msgstr "This machine cannot open a receive port, but can still send: {error}"

#: app/ui/transfer.py:866
#, python-brace-format
msgid "上次有 {n} 个传输没传完，对方接着传就会续上。"
msgstr "{n} transfer(s) stopped halfway last time; the sender resumes them by itself."

#: app/ui/transfer.py:897
msgid "这台设备对别人显示的名字："
msgstr "The name other devices see for this one:"

#: app/ui/transfer.py:945
#, python-brace-format
msgid "…共 {n} 个文件"
msgstr "…{n} files in total"

#: app/ui/transfer.py:947
#, python-brace-format
msgid "接收来自 {who} 的文件？"
msgstr "Accept files from {who}?"

#: app/ui/transfer.py:948
#, python-brace-format
msgid ""
"对方：{who}\n"
"\n"
"{listing}"
msgstr ""
"From: {who}\n"
"\n"
"{listing}"

#: app/ui/transfer.py:950
msgid "接收"
msgstr "Accept"

#: app/ui/transfer.py:951
msgid "拒绝"
msgstr "Decline"

#: app/ui/transfer.py:998
#, python-brace-format
msgid "正在连接 {name}（{host}）…"
msgstr "Connecting to {name} ({host})…"

#: app/ui/transfer.py:1003
#, python-brace-format
msgid "已选择 {name}（{host}）。本机存过它的密钥，留空配对码点连接。"
msgstr ""
"Selected {name} ({host}). This machine has its key, so connect with an empty"
" code."

#: app/ui/transfer.py:1004
#, python-brace-format
msgid "已选择 {name}（{host}）。输入它屏幕上的 {n} 位配对码{extra}，再点连接。"
msgstr ""
"Selected {name} ({host}). Type the {n}-digit code{extra} on its screen, then"
" press Connect."

#: app/ui/transfer.py:1005
#, python-brace-format
msgid "和 {m} 位密码"
msgstr " and its {m}-character password"

#: app/ui/transfer.py:1009
#, python-brace-format
msgid "一次只连一台，现在连着 {name}。要换设备先点「断开」。"
msgstr ""
"One device at a time; {name} holds the connection. Press Disconnect before "
"switching."

#: app/ui/transfer.py:1011
msgid "自动发现没有运行。点「从附近选择…」手输对方地址。"
msgstr "Auto-discovery is not running. Use \"Pick from nearby…\" to type its address."

#: app/ui/transfer.py:1014
msgid "附近暂时没有广播出来的设备。点「从附近选择…」手输地址。"
msgstr ""
"Nothing is announcing itself right now. Use \"Pick from nearby…\" to type an"
" address."

#: app/ui/transfer.py:1015
#, python-brace-format
msgid "附近发现 {n} 台设备，点「从附近选择…」连接。"
msgstr "{n} device(s) nearby. Use \"Pick from nearby…\" to connect."

#: app/ui/transfer.py:1026
msgid "（对方连进来，只能收）"
msgstr "(dialed in, receive only)"

#: app/ui/transfer.py:1039
#, python-brace-format
msgid "指纹前缀 {fp}。它主动连进来，本机没有可回拨的地址，所以只能收它的文件。要发给它，请由它来连本机。"
msgstr ""
"Fingerprint prefix {fp}. It dialed us, and this machine has no address to "
"call back on, so only its files can arrive. To send to it, let it connect "
"here."

#: app/ui/transfer.py:1043
#, python-brace-format
msgid "指纹前缀 {fp}。已配对，会话保留到点断开为止。"
msgstr ""
"Fingerprint prefix {fp}. Paired; the session lasts until you press "
"Disconnect."

#: app/ui/transfer.py:1048
msgid "还没有已连接的设备。点下面「从附近选择…」挑一台，或手输它的地址。"
msgstr ""
"No connected devices yet. Press \"Pick from nearby…\" below, or type a "
"device's address."

#: app/ui/transfer.py:1077
#, python-brace-format
msgid "{name} 已连上本机（{ip}），现在只等它发文件过来。"
msgstr "{name} connected to this machine from {ip}; waiting for it to send files."

#: app/ui/transfer.py:1100
#, python-brace-format
msgid "{name} 已经连着，选文件发送即可。"
msgstr "{name} is already connected - just pick files and send."

#: app/ui/transfer.py:1116
#, python-brace-format
msgid "{addr} 应答了，但不是能配的版本：{why}"
msgstr "{addr} answered, but not on a compatible version: {why}"

#: app/ui/transfer.py:1119 app/ui/transfer.py:1209
#, python-brace-format
msgid "连不上 {addr}：{error}"
msgstr "Cannot reach {addr}: {error}"

#: app/ui/transfer.py:1146
#, python-brace-format
msgid "一次只连一台。先断开 {name}，再连新设备。"
msgstr "One device at a time. Disconnect {name} before connecting another."

#: app/ui/transfer.py:1147
msgid "用上面的配对码和密码连接选中的设备。"
msgstr "Connects the selected device with the code and password above."

#: app/ui/transfer.py:1159
msgid "先在「从附近选择…」里挑一台设备，或手输它的地址。"
msgstr "Choose a device with \"Pick from nearby…\" first, or type its address."

#: app/ui/transfer.py:1164
#, python-brace-format
msgid "本机一次只连一台，现在连着 {name}。要先点「断开」再连它。"
msgstr ""
"This machine keeps one connection at a time; {name} holds it. Press "
"Disconnect first."

#: app/ui/transfer.py:1169
#, python-brace-format
msgid "还差对方屏幕上那 {n} 位配对码。"
msgstr "The {n}-digit code on the other screen is still missing."

#: app/ui/transfer.py:1193
#, python-brace-format
msgid "配对码或密码不对。请照着对方屏幕上现在的 {n} 位码和 {m} 位密码再输一次。"
msgstr ""
"That pairing code or password is wrong. Retype the {n}-digit code and "
"{m}-character password now on the other screen."

#: app/ui/transfer.py:1202
#, python-brace-format
msgid "它已经连着 {peer}，一次只允许一台。请那边先断开。"
msgstr ""
"It is already connected to {peer}; only one peer is allowed. Disconnect on "
"that side first."

#: app/ui/transfer.py:1205 app/ui/transfer.py:1569
#, python-brace-format
msgid "对方说：{text}"
msgstr "The other side said: {text}"

#: app/ui/transfer.py:1238
#, python-brace-format
msgid "已连接 {name}，指纹前缀 {fp}。核对无误再发。"
msgstr "Connected to {name}, fingerprint prefix {fp}. Check it before sending."

#: app/ui/transfer.py:1264
#, python-brace-format
msgid "已断开 {name}。它的密钥还留在本机，留空配对码就能重连；要彻底撤销请去设置。"
msgstr ""
"Disconnected {name}. Its key stays on this machine, so an empty code "
"reconnects it; revoke it in Settings to forget it."

#: app/ui/transfer.py:1295
msgid "这台设备是连进来的，本机没有可回拨的地址。要发给它，请改由它连接本机。"
msgstr ""
"This device dialed in, so there is no address to call back. To send to it, "
"have it connect to this machine instead."

#: app/ui/transfer.py:1310
msgid "还没有选定接收设备。到「设备」页连一台，或在附近列表里选一台。"
msgstr ""
"No receiving device is selected yet. Connect one on the Devices page, or "
"pick one from the nearby list."

#: app/ui/transfer.py:1315
#, python-brace-format
msgid "当前对端：{name}（{addr}，指纹前缀 {fp}）"
msgstr "Current peer: {name} ({addr}, fingerprint prefix {fp})"

#: app/ui/transfer.py:1321
msgid "这台设备还没有连接会话，点「连接」建立一条。"
msgstr "This device has no connection session yet; press Connect to start one."

#: app/ui/transfer.py:1324
#, python-brace-format
msgid "对方要求每 {ms} 毫秒写一条 TLS 记录，所以这台设备比局域网正常水平慢，这不是网络故障。"
msgstr ""
"The peer asks for one TLS record every {ms} ms, so this device runs slower "
"than the usual LAN speed. That is not a network fault."

#: app/ui/transfer.py:1329
msgid "对方没有要求放慢写入，本机按最快速度发。"
msgstr "The peer asked for no write delay, so this machine sends at full speed."

#: app/ui/transfer.py:1361
msgid "选择要发送的文件夹"
msgstr "Choose a folder to send"

#: app/ui/transfer.py:1370
msgid "选择要发送的文件"
msgstr "Choose files to send"

#: app/ui/transfer.py:1382
msgid "这些文件不在同一个文件夹下，请分开发送。"
msgstr "These files share no parent folder, so please send them separately."

#: app/ui/transfer.py:1397
msgid "还没选要发送的内容。"
msgstr "Nothing selected to send yet."

#: app/ui/transfer.py:1402
#, python-brace-format
msgid "已选：{name}（整个文件夹，约 {size}）"
msgstr "Selected: {name} (whole folder, about {size})"

#: app/ui/transfer.py:1403
#, python-brace-format
msgid "已选 {n} 个文件，共 {size}"
msgstr "Selected {n} files, {size} in total"

#: app/ui/transfer.py:1413
msgid "准备中…"
msgstr "Preparing…"

#: app/ui/transfer.py:1416
#, python-brace-format
msgid "{what} → {who}"
msgstr "{what} → {who}"

#: app/ui/transfer.py:1447
msgid "停下这次传输，并让对方扔掉已经收到的半件。"
msgstr "Stop this transfer and make the peer discard the half-finished file."

#: app/ui/transfer.py:1492
msgid "（正在取消…）"
msgstr " (cancelling…)"

#: app/ui/transfer.py:1511
msgid "完成"
msgstr "Done"

#: app/ui/transfer.py:1511
msgid "失败"
msgstr "Failed"

#: app/ui/transfer.py:1524
msgid "这台设备已经没有连接会话，请重新连接它。"
msgstr "That device has no live session any more. Connect it again."

#: app/ui/transfer.py:1529
msgid "这里没有可发的文件。"
msgstr "There is nothing to send here."

#: app/ui/transfer.py:1551
#, python-brace-format
msgid "已发给 {name}：{n} 个文件（{size}），对方逐个校验通过。"
msgstr "Sent to {name}: {n} file(s), {size}, every one verified by the peer."

#: app/ui/transfer.py:1564
#, python-brace-format
msgid "已取消发给 {name}：本机停止发送，对方那半件也撤掉了。"
msgstr ""
"Cancelled the send to {name}: this machine stopped, and the peer withdrew "
"its half-finished file."

#: app/ui/transfer.py:1567
msgid "对方不再认识本机的密钥。选中它，输入它屏幕上新显示的配对码再连接。"
msgstr ""
"The peer no longer recognises this machine's key. Select it, type the new "
"code on its screen and connect."

#: app/ui/transfer.py:1571
#, python-brace-format
msgid "有文件已经不在了：{path}"
msgstr "A file is no longer there: {path}"

#: app/ui/transfer.py:1576
#, python-brace-format
msgid "连不上对方，它可能已经退出或换了端口：{error}"
msgstr "Cannot reach that device - it may have quit or moved ports: {error}"

#: app/ui/transfer.py:1579
#, python-brace-format
msgid "传输中断：{error}"
msgstr "The transfer was interrupted: {error}"

#: app/ui/transfer.py:1587
#, python-brace-format
msgid "{title}（正在发送 {name}）"
msgstr "{title} (sending {name})"

#: app/ui/transfer.py:1590
#, python-brace-format
msgid "正在发送：{name}"
msgstr "Sending: {name}"

#: app/ui/transfer.py:1595
msgid "未开始"
msgstr "Not started"

#: app/ui/transfer.py:1616
#, python-brace-format
msgid "已收到 {who} 发来的 {n} 个文件（{size}），逐个校验通过。"
msgstr "Received {n} file(s) from {who} ({size}), every one verified."

#: app/ui/transfer.py:1681
msgid "（已经不在了）"
msgstr " (missing)"

#: app/ui/transfer.py:1685
msgid "时间未知"
msgstr "Unknown time"

#: app/ui/transfer.py:1689
#, python-brace-format
msgid "原本落在：{path}"
msgstr "Was saved to: {path}"

#: app/ui/transfer.py:1699
msgid "还没有收到校验通过的文件。"
msgstr "Nothing verified has arrived yet."

#: app/ui/transfer.py:1701
msgid "这个时间里没有收到的文件。"
msgstr "No received files in this time range."

#: app/ui/transfer.py:1713
#, python-brace-format
msgid "这条记录还在，文件已经不在这个位置了：{path}"
msgstr "The record is still here, but the file no longer lives at: {path}"

#: app/ui/tray.py:28 app/ui/tray.py:60
msgid "打开主界面"
msgstr "Open main window"

#: app/ui/tray.py:29 app/ui/tray.py:61
msgid "开机自动启动"
msgstr "Start automatically at sign-in"

#: app/ui/tray.py:52
msgid "无法开启开机自动启动"
msgstr "Could not enable autostart"

#: app/ui/tray.py:53
#, python-brace-format
msgid ""
"仅打包后的 Windows 版本可以注册开机自启。\n"
"当前命令：{cmd}"
msgstr ""
"Only the packaged Windows build can register itself for autostart.\n"
"Current command: {cmd}"

#: app/ui/tray.py:70
msgid ""
"已最小化到托盘，仍在后台运行。\n"
"双击托盘图标可重新打开。"
msgstr ""
"Minimized to the tray and still running.\n"
"Double-click the tray icon to open it again."

