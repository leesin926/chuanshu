msgid "（正在取消…）"
msgstr " (cancelling…)"

#: app/ui/transfer.py:2420
#, python-brace-format
msgid "已用 {clock}。"
msgstr "Elapsed {clock}."

#: app/ui/transfer.py:2437
msgid "完成"
msgstr "Done"

