#: app/ui/transfer.py:161
msgid "连接设备"
msgstr "Conectar dispositivo"

#: app/ui/transfer.py:188 app/ui/transfer.py:737
msgid "连接"
msgstr "Conectar"

#: app/ui/transfer.py:199
msgid "下面是广播出来的候选设备。选中一台，回到主界面填它的配对码和密码，再点连接。"
msgstr ""
"Estos son los dispositivos anunciados. Elige uno, rellena su código y "
"contraseña en la página principal y pulsa Conectar."

#: app/ui/transfer.py:200
msgid "手输地址…"
msgstr "Escribir dirección…"

#: app/ui/transfer.py:201
msgid "没在局域网里广播出来的设备，可以输入它的地址，或粘贴 chuanshu:// 配对串。"
msgstr ""
"Si un dispositivo no se anuncia en la red, escribe su dirección o pega su "
"cadena chuanshu://."

#: app/ui/transfer.py:202
msgid "刷新"
msgstr "Actualizar"

#: app/ui/transfer.py:211
msgid "（已连接）"
msgstr " (conectado)"

#: app/ui/transfer.py:214 app/ui/transfer.py:215
msgid "手动添加"
msgstr "añadido a mano"

#: app/ui/transfer.py:215
#, python-brace-format
msgid "发现于 {via}；指纹前缀 {fp}"
msgstr "Encontrado por {via}; huella {fp}"

#: app/ui/transfer.py:220
msgid "没找到设备。手输对方地址，或粘贴它的配对串。"
msgstr ""
"No se encontró ningún dispositivo. Escribe su dirección o pega su cadena de "
"emparejamiento."

#: app/ui/transfer.py:225
msgid "手动添加设备"
msgstr "Añadir dispositivo por dirección"

#: app/ui/transfer.py:225
#, python-brace-format
msgid "输入对方地址（{example}）或配对串："
msgstr "Dirección del otro ({example}) o cadena de emparejamiento:"

#: app/ui/transfer.py:235
#, python-brace-format
msgid "已确认 {name}，指纹前缀 {fp}。选中它点连接。"
msgstr "{name} confirmado, prefijo de huella {fp}. Selecciónalo y pulsa Conectar."

#: app/ui/transfer.py:242
msgid "先选中一台设备，再点连接。"
msgstr "Selecciona primero un dispositivo y luego pulsa Conectar."

#: app/ui/transfer.py:513 app/ui/transfer.py:740
msgid "让对方扫这个码，就能带着配对码和密码连过来。"
msgstr ""
"La otra parte escanea este código y se conecta ya con el código y la "
"contraseña."

#: app/ui/transfer.py:693
msgid "我的设备"
msgstr "Mi dispositivo"

#: app/ui/transfer.py:694
msgid "已连接的设备"
msgstr "Dispositivos conectados"

#: app/ui/transfer.py:695
msgid "把文件或文件夹拖到这里"
msgstr "Arrastra aquí archivos o carpetas"

#: app/ui/transfer.py:697
msgid "也可以点下面的按钮挑选。对方要先接受，文件才会落到它的接收目录。"
msgstr ""
"O elíjalos con los botones de abajo. El archivo no se escribe en la carpeta "
"de recepción del otro equipo hasta que este lo acepte."

#: app/ui/transfer.py:699
msgid "本次会话的传输"
msgstr "Transferencias de esta sesión"

#: app/ui/transfer.py:700
msgid "全部"
msgstr "Todos"

#: app/ui/transfer.py:701
msgid "今天"
msgstr "Hoy"

#: app/ui/transfer.py:702
msgid "近 7 天"
msgstr "Últimos 7 días"

#: app/ui/transfer.py:704
msgid "大小"
msgstr "Tamaño"

#: app/ui/transfer.py:704
msgid "时间"
msgstr "Hora"

#: app/ui/transfer.py:704
msgid "来源设备"
msgstr "Dispositivo de origen"

#: app/ui/transfer.py:709 app/ui/transfer.py:949
#, python-brace-format
msgid "保存到：{path}"
msgstr "Guardar en: {path}"

#: app/ui/transfer.py:710
msgid "更换配对码和密码"
msgstr "Cambiar código y contraseña"

#: app/ui/transfer.py:712
msgid "换一组新的固定配对码和密码，二维码跟着变。已经连上的设备不受影响。"
msgstr ""
"Genera un código de emparejamiento y una contraseña fijos nuevos; el código "
"QR cambia con ellos. Un dispositivo ya conectado no se ve afectado."

#: app/ui/transfer.py:714
msgid "打开"
msgstr "Abrir"

#: app/ui/transfer.py:716
msgid "编辑"
msgstr "Editar"

#: app/ui/transfer.py:717
#, python-brace-format
msgid "本机：{name}"
msgstr "Este equipo: {name}"

#: app/ui/transfer.py:718
msgid "收到的文件都校验通过、已经落盘。记录存在本机，重启也还在。"
msgstr ""
"Todos los archivos recibidos se verificaron y guardaron. La lista se "
"conserva en este equipo y sobrevive a un reinicio."

#: app/ui/transfer.py:719
msgid "选择文件…"
msgstr "Elegir archivos…"

#: app/ui/transfer.py:720
msgid "选择文件夹…"
msgstr "Elegir carpeta…"

#: app/ui/transfer.py:721
msgid "清空"
msgstr "Vaciar"

#: app/ui/transfer.py:722
msgid "从附近选择…"
msgstr "Elegir entre cercanos…"

#: app/ui/transfer.py:723
msgid "列出广播出来的候选设备，也可以手输地址或粘贴配对串。"
msgstr ""
"Enumera los dispositivos anunciados; también puedes escribir una dirección o"
" pegar una cadena de emparejamiento."

#: app/ui/transfer.py:724
msgid "断开"
msgstr "Desconectar"

#: app/ui/transfer.py:726
#, python-brace-format
msgid "{n} 位配对码"
msgstr "Código de emparejamiento de {n} dígitos"

#: app/ui/transfer.py:728
#, python-brace-format
msgid "输入对方屏幕上显示的 {n} 位配对码。本机存过它的密钥时留空即可，用签名重连。"
msgstr ""
"Escribe el código de {n} dígitos que muestra la otra pantalla. Si esta "
"máquina ya tiene su clave, déjalo vacío y reconecta con la firma."

#: app/ui/transfer.py:730
msgid "连接密码（可留空）"
msgstr "Contraseña (opcional)"

#: app/ui/transfer.py:733
#, python-brace-format
msgid "输入对方屏幕上显示的 {n} 位连接密码。对方是还没有密码的旧版本时留空，这时只用配对码完成首次配对。"
msgstr ""
"Escribe la contraseña de conexión de {n} caracteres que muestra la otra "
"pantalla. Déjala vacía para una versión anterior sin contraseña: el primer "
"emparejamiento usará solo el código."

#: app/ui/transfer.py:739
msgid "发送给所选设备"
msgstr "Enviar al dispositivo seleccionado"

#: app/ui/transfer.py:829
msgid "已换成新的配对码和密码，旧二维码作废。已连接的设备不受影响。"
msgstr ""
"Ya están en vigor el nuevo código y la contraseña; el QR anterior ya no "
"vale. Los dispositivos conectados no se ven afectados."

#: app/ui/transfer.py:834
msgid "配对码要等接收端口打开才有"
msgstr ""
"El código de emparejamiento aparece cuando el puerto de recepción está "
"abierto"

#: app/ui/transfer.py:835
#, python-brace-format
msgid "配对码：{code}"
msgstr "Código de emparejamiento: {code}"

#: app/ui/transfer.py:840
#, python-brace-format
msgid "密码：{secret}"
msgstr "Contraseña: {secret}"

#: app/ui/transfer.py:844
msgid "本机接收端口没有打开。"
msgstr "Este equipo no tiene un puerto de recepción abierto."

#: app/ui/transfer.py:846
msgid "接收已停止，对方连不进来。"
msgstr "La recepción está detenida; nadie puede conectar."

#: app/ui/transfer.py:847
#, python-brace-format
msgid "端口：{port}"
msgstr "Puerto: {port}"

#: app/ui/transfer.py:855
msgid "发现通道：mDNS 与 UDP 都可用。"
msgstr "Descubrimiento: mDNS y UDP funcionan los dos."

#: app/ui/transfer.py:856
msgid "mDNS"
msgstr "mDNS"

#: app/ui/transfer.py:856
msgid "UDP 广播"
msgstr "Difusión UDP"

#: app/ui/transfer.py:859
#, python-brace-format
msgid "发现通道：{which} 都不可用，只能手输地址或粘贴配对串。"
msgstr ""
"Descubrimiento: {which} no funcionan; escribe una dirección o pega una "
"cadena de emparejamiento."

#: app/ui/transfer.py:860
#, python-brace-format
msgid "发现通道：{which} 不可用，仍可手输地址或粘贴配对串。"
msgstr ""
"Descubrimiento: {which} no funciona; aún puedes escribir una dirección o "
"pegar la cadena."

#: app/ui/transfer.py:864
#, python-brace-format
msgid "这台机器开不了接收端口，但仍能主动发出去：{error}"
msgstr ""
"Este equipo no puede abrir un puerto de recepción, pero aún puede enviar: "
"{error}"

#: app/ui/transfer.py:866
#, python-brace-format
msgid "上次有 {n} 个传输没传完，对方接着传就会续上。"
msgstr ""
"{n} transferencias quedaron a medias la última vez; el emisor las reanuda "
"solo."

#: app/ui/transfer.py:897
msgid "这台设备对别人显示的名字："
msgstr "El nombre que otros dispositivos ven:"

#: app/ui/transfer.py:945
#, python-brace-format
msgid "…共 {n} 个文件"
msgstr "… {n} archivos en total"

#: app/ui/transfer.py:947
#, python-brace-format
msgid "接收来自 {who} 的文件？"
msgstr "¿Recibir archivos de {who}?"

#: app/ui/transfer.py:948
#, python-brace-format
msgid ""
"对方：{who}\n"
"\n"
"{listing}"
msgstr ""
"De: {who}\n"
"\n"
"{listing}"

#: app/ui/transfer.py:950
msgid "接收"
msgstr "Recibir"

#: app/ui/transfer.py:951
msgid "拒绝"
msgstr "Rechazar"

#: app/ui/transfer.py:998
#, python-brace-format
msgid "正在连接 {name}（{host}）…"
msgstr "Conectando con {name} ({host})…"

#: app/ui/transfer.py:1003
#, python-brace-format
msgid "已选择 {name}（{host}）。本机存过它的密钥，留空配对码点连接。"
msgstr ""
"{name} ({host}) seleccionado. Esta máquina tiene su clave; conecta con el "
"código vacío."

#: app/ui/transfer.py:1004
#, python-brace-format
msgid "已选择 {name}（{host}）。输入它屏幕上的 {n} 位配对码{extra}，再点连接。"
msgstr ""
"{name} ({host}) seleccionado. Escribe el código de {n} dígitos{extra} de su "
"pantalla y pulsa Conectar."

#: app/ui/transfer.py:1005
#, python-brace-format
msgid "和 {m} 位密码"
msgstr " y la contraseña de {m} caracteres"

#: app/ui/transfer.py:1009
#, python-brace-format
msgid "一次只连一台，现在连着 {name}。要换设备先点「断开」。"
msgstr ""
"Solo un dispositivo a la vez; {name} está conectado. Pulsa «Desconectar» "
"antes de cambiar."

#: app/ui/transfer.py:1011
msgid "自动发现没有运行。点「从附近选择…」手输对方地址。"
msgstr ""
"El descubrimiento automático no está activo. Usa «Elegir entre cercanos…» "
"para escribir la dirección."

#: app/ui/transfer.py:1014
msgid "附近暂时没有广播出来的设备。点「从附近选择…」手输地址。"
msgstr ""
"Nada se anuncia por ahora. Usa «Elegir entre cercanos…» para escribir una "
"dirección."

#: app/ui/transfer.py:1015
#, python-brace-format
msgid "附近发现 {n} 台设备，点「从附近选择…」连接。"
msgstr "{n} dispositivo(s) cercanos. Conecta con «Elegir entre cercanos…»."

#: app/ui/transfer.py:1026
msgid "（对方连进来，只能收）"
msgstr "(conexión entrante, solo recepción)"

#: app/ui/transfer.py:1039
#, python-brace-format
msgid "指纹前缀 {fp}。它主动连进来，本机没有可回拨的地址，所以只能收它的文件。要发给它，请由它来连本机。"
msgstr ""
"Prefijo de huella {fp}. La otra parte se conectó a nosotros; este equipo no "
"tiene dirección de retorno, así que solo puede recibir. Para enviar, que se "
"conecte ella."

#: app/ui/transfer.py:1043
#, python-brace-format
msgid "指纹前缀 {fp}。已配对，会话保留到点断开为止。"
msgstr ""
"Prefijo de huella {fp}. Emparejado; la sesión dura hasta que pulses "
"Desconectar."

#: app/ui/transfer.py:1048
msgid "还没有已连接的设备。点下面「从附近选择…」挑一台，或手输它的地址。"
msgstr ""
"Todavía no hay dispositivos conectados. Usa «Elegir entre cercanos…» abajo o"
" escribe su dirección."

#: app/ui/transfer.py:1077
#, python-brace-format
msgid "{name} 已连上本机（{ip}），现在只等它发文件过来。"
msgstr "{name} se ha conectado desde {ip}; a la espera de que envíe los archivos."

#: app/ui/transfer.py:1100
#, python-brace-format
msgid "{name} 已经连着，选文件发送即可。"
msgstr "{name} ya está conectado: solo elige archivos y envía."

#: app/ui/transfer.py:1116
#, python-brace-format
msgid "{addr} 应答了，但不是能配的版本：{why}"
msgstr "{addr} respondió, pero con una versión incompatible: {why}"

#: app/ui/transfer.py:1119 app/ui/transfer.py:1209
#, python-brace-format
msgid "连不上 {addr}：{error}"
msgstr "No se puede contactar con {addr}: {error}"

#: app/ui/transfer.py:1146
#, python-brace-format
msgid "一次只连一台。先断开 {name}，再连新设备。"
msgstr "Solo un dispositivo a la vez. Desconecta antes a {name}."

#: app/ui/transfer.py:1147
msgid "用上面的配对码和密码连接选中的设备。"
msgstr "Conecta el dispositivo seleccionado con el código y la contraseña de arriba."

#: app/ui/transfer.py:1159
msgid "先在「从附近选择…」里挑一台设备，或手输它的地址。"
msgstr ""
"Primero elige un dispositivo con «Elegir entre cercanos…» o escribe su "
"dirección."

#: app/ui/transfer.py:1164
#, python-brace-format
msgid "本机一次只连一台，现在连着 {name}。要先点「断开」再连它。"
msgstr ""
"Este equipo mantiene una sola conexión; ahora {name}. Pulsa antes "
"«Desconectar»."

#: app/ui/transfer.py:1169
#, python-brace-format
msgid "还差对方屏幕上那 {n} 位配对码。"
msgstr "Falta el código de {n} dígitos que muestra la otra pantalla."

#: app/ui/transfer.py:1193
#, python-brace-format
msgid "配对码或密码不对。请照着对方屏幕上现在的 {n} 位码和 {m} 位密码再输一次。"
msgstr ""
"El código o la contraseña no son correctos. Vuelve a escribir el código de "
"{n} dígitos y la contraseña de {m} caracteres de la otra pantalla."

#: app/ui/transfer.py:1202
#, python-brace-format
msgid "它已经连着 {peer}，一次只允许一台。请那边先断开。"
msgstr "Ya está conectado a {peer}; solo se permite una. Desconecta allí primero."

#: app/ui/transfer.py:1205 app/ui/transfer.py:1569
#, python-brace-format
msgid "对方说：{text}"
msgstr "El otro dijo: {text}"

#: app/ui/transfer.py:1238
#, python-brace-format
msgid "已连接 {name}，指纹前缀 {fp}。核对无误再发。"
msgstr "Conectado con {name}, prefijo de huella {fp}. Compruébalo antes de enviar."

#: app/ui/transfer.py:1264
#, python-brace-format
msgid "已断开 {name}。它的密钥还留在本机，留空配对码就能重连；要彻底撤销请去设置。"
msgstr ""
"{name} desconectado. Su clave sigue en esta máquina, con el código vacío "
"reconecta; para borrarla revócala en Ajustes."

#: app/ui/transfer.py:1295
msgid "这台设备是连进来的，本机没有可回拨的地址。要发给它，请改由它连接本机。"
msgstr ""
"Este dispositivo se conectó a nosotros; no hay dirección de retorno. Para "
"enviarle, que se conecte él a este equipo."

#: app/ui/transfer.py:1310
msgid "还没有选定接收设备。到「设备」页连一台，或在附近列表里选一台。"
msgstr ""
"Aún no hay dispositivo receptor seleccionado. Conecte uno en la página "
"Dispositivos o elija uno de la lista cercana."

#: app/ui/transfer.py:1315
#, python-brace-format
msgid "当前对端：{name}（{addr}，指纹前缀 {fp}）"
msgstr "Par actual: {name} ({addr}, prefijo de huella {fp})"

#: app/ui/transfer.py:1321
msgid "这台设备还没有连接会话，点「连接」建立一条。"
msgstr ""
"Este dispositivo aún no tiene sesión de conexión; pulse Conectar para abrir "
"una."

#: app/ui/transfer.py:1324
#, python-brace-format
msgid "对方要求每 {ms} 毫秒写一条 TLS 记录，所以这台设备比局域网正常水平慢，这不是网络故障。"
msgstr ""
"El par pide un registro TLS cada {ms} ms; por eso esta transferencia va más "
"despacio de lo normal en la red local. No es una avería de red."

#: app/ui/transfer.py:1329
msgid "对方没有要求放慢写入，本机按最快速度发。"
msgstr ""
"El par no pidió ralentizar la escritura; este equipo envía a la máxima "
"velocidad."

#: app/ui/transfer.py:1361
msgid "选择要发送的文件夹"
msgstr "Elegir la carpeta a enviar"

#: app/ui/transfer.py:1370
msgid "选择要发送的文件"
msgstr "Elegir los archivos a enviar"

#: app/ui/transfer.py:1382
msgid "这些文件不在同一个文件夹下，请分开发送。"
msgstr "Estos archivos no comparten carpeta; envíalos por separado."

#: app/ui/transfer.py:1397
msgid "还没选要发送的内容。"
msgstr "Aún no has elegido nada que enviar."

#: app/ui/transfer.py:1402
#, python-brace-format
msgid "已选：{name}（整个文件夹，约 {size}）"
msgstr "Seleccionado: {name} (carpeta completa, unos {size})"

#: app/ui/transfer.py:1403
#, python-brace-format
msgid "已选 {n} 个文件，共 {size}"
msgstr "{n} archivos seleccionados, {size} en total"

#: app/ui/transfer.py:1413
msgid "准备中…"
msgstr "Preparando…"

#: app/ui/transfer.py:1416
#, python-brace-format
msgid "{what} → {who}"
msgstr "{what} → {who}"

#: app/ui/transfer.py:1447
msgid "停下这次传输，并让对方扔掉已经收到的半件。"
msgstr "Detiene esta transferencia y hace que el par descarte el archivo incompleto."

#: app/ui/transfer.py:1492
msgid "（正在取消…）"
msgstr " (cancelando…)"

#: app/ui/transfer.py:1511
msgid "完成"
msgstr "Completado"

#: app/ui/transfer.py:1511
msgid "失败"
msgstr "Fallido"

#: app/ui/transfer.py:1524
msgid "这台设备已经没有连接会话，请重新连接它。"
msgstr "Ese dispositivo ya no tiene sesión. Vuelve a conectarlo."

#: app/ui/transfer.py:1529
msgid "这里没有可发的文件。"
msgstr "No hay nada que enviar aquí."

#: app/ui/transfer.py:1551
#, python-brace-format
msgid "已发给 {name}：{n} 个文件（{size}），对方逐个校验通过。"
msgstr "Enviado a {name}: {n} archivo(s), {size}, cada uno verificado por el par."

#: app/ui/transfer.py:1564
#, python-brace-format
msgid "已取消发给 {name}：本机停止发送，对方那半件也撤掉了。"
msgstr ""
"Envío a {name} cancelado: este equipo dejó de enviar y el archivo incompleto"
" del par se retiró."

#: app/ui/transfer.py:1567
msgid "对方不再认识本机的密钥。选中它，输入它屏幕上新显示的配对码再连接。"
msgstr ""
"El otro ya no reconoce la clave de esta máquina. Selecciónalo, escribe el "
"código nuevo de su pantalla y conecta."

#: app/ui/transfer.py:1571
#, python-brace-format
msgid "有文件已经不在了：{path}"
msgstr "Un archivo ya no está: {path}"

#: app/ui/transfer.py:1576
#, python-brace-format
msgid "连不上对方，它可能已经退出或换了端口：{error}"
msgstr "No se contacta al otro; quizá cerró o cambió de puerto: {error}"

#: app/ui/transfer.py:1579
#, python-brace-format
msgid "传输中断：{error}"
msgstr "Transferencia interrumpida: {error}"

#: app/ui/transfer.py:1587
#, python-brace-format
msgid "{title}（正在发送 {name}）"
msgstr "{title} (enviando {name})"

#: app/ui/transfer.py:1590
#, python-brace-format
msgid "正在发送：{name}"
msgstr "Enviando a: {name}"

#: app/ui/transfer.py:1595
msgid "未开始"
msgstr "Sin comenzar"

#: app/ui/transfer.py:1616
#, python-brace-format
msgid "已收到 {who} 发来的 {n} 个文件（{size}），逐个校验通过。"
msgstr "Recibidos {n} archivo(s) de {who} ({size}), todos verificados."

#: app/ui/transfer.py:1681
msgid "（已经不在了）"
msgstr " (ya no existe)"

#: app/ui/transfer.py:1685
msgid "时间未知"
msgstr "Hora desconocida"

#: app/ui/transfer.py:1689
#, python-brace-format
msgid "原本落在：{path}"
msgstr "Se guardó originalmente en: {path}"

#: app/ui/transfer.py:1699
msgid "还没有收到校验通过的文件。"
msgstr "Todavía no ha llegado ningún archivo verificado."

#: app/ui/transfer.py:1701
msgid "这个时间里没有收到的文件。"
msgstr "No hay archivos recibidos en este periodo."

#: app/ui/transfer.py:1713
#, python-brace-format
msgid "这条记录还在，文件已经不在这个位置了：{path}"
msgstr "El registro sigue aquí, pero el archivo ya no está en esta ubicación: {path}"

#: app/ui/tray.py:28 app/ui/tray.py:60
msgid "打开主界面"
msgstr "Abrir la ventana principal"

#: app/ui/tray.py:29 app/ui/tray.py:61
msgid "开机自动启动"
msgstr "Iniciar con la sesión"

#: app/ui/tray.py:52
msgid "无法开启开机自动启动"
msgstr "No se pudo activar el inicio automático"

#: app/ui/tray.py:53
#, python-brace-format
msgid ""
"仅打包后的 Windows 版本可以注册开机自启。\n"
"当前命令：{cmd}"
msgstr ""
"Solo la versión de Windows empaquetada puede registrar el inicio automático."
"\n"
"Comando actual: {cmd}"

#: app/ui/tray.py:70
msgid ""
"已最小化到托盘，仍在后台运行。\n"
"双击托盘图标可重新打开。"
msgstr ""
"Minimizado a la bandeja, sigue en segundo plano.\n"
"Haz doble clic en el icono de la bandeja para abrirlo otra vez."

