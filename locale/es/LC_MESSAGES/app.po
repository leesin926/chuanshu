#: app/crash.py:43
msgid "程序遇到未处理的错误。操作可以继续，但请查看日志。"
msgstr ""
"El programa encontró un error no controlado. Puede continuar, pero revise"
" el registro."

#: app/crash.py:44
msgid "日志文件"
msgstr "Archivo de registro"

#: app/crash.py:59
msgid "未处理的异常"
msgstr "Excepción no controlada"

#: app/crash.py:67
msgid "后台线程异常"
msgstr "Error del hilo en segundo plano"

#: app/crash.py:95
msgid "界面处理异常"
msgstr "Error de la interfaz"

#: app/net/errors.py:13
msgid "对端版本不兼容"
msgstr "El otro dispositivo usa una versión incompatible."

#: app/net/errors.py:14
msgid "尚未与这台设备配对"
msgstr "Todavía no has emparejado este dispositivo."

#: app/net/errors.py:15
msgid "配对码不正确或已过期"
msgstr "El código de emparejamiento es incorrecto o ha caducado."

#: app/net/errors.py:16
msgid "对方拒绝了这次传输"
msgstr "La otra parte rechazó esta transferencia."

#: app/net/errors.py:17
msgid "传输请求不存在或已结束"
msgstr "La solicitud de transferencia ya no existe o terminó."

#: app/net/errors.py:18
msgid "分块序号超出文件范围"
msgstr "El número de bloque está fuera del archivo."

#: app/net/errors.py:19
msgid "分块校验失败"
msgstr "La comprobación de un bloque falló."

#: app/net/errors.py:20
msgid "文件校验失败"
msgstr "La comprobación del archivo falló."

#: app/net/errors.py:21
msgid "文件名被接收方拒绝"
msgstr "El receptor rechazó este nombre de archivo."

#: app/net/errors.py:22
msgid "接收方存储空间不足"
msgstr "El receptor no tiene espacio suficiente."

#: app/net/errors.py:23
msgid "对方正在处理另一个传输"
msgstr "La otra parte está ocupada con otra transferencia."

