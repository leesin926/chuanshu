msgstr "Biblioteca de interfaz"

#: app/ui/settings_dialog.py:280
msgid "协议"
msgstr "Protocolo"

#: app/ui/settings_dialog.py:281
msgid "数据目录"
msgstr "Carpeta de datos"

#: app/ui/settings_dialog.py:282
msgid "日志"
msgstr "Registro"

#: app/ui/settings_dialog.py:308
#, python-brace-format
