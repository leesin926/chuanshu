"{listing}"

#: app/ui/transfer.py:711
msgid "接收"
msgstr "受信"

#: app/ui/transfer.py:712
msgid "拒绝"
msgstr "拒否"

#: app/ui/transfer.py:759
#, python-brace-format
msgid "正在连接 {name}（{host}）…"
msgstr "{name}（{host}）に接続中…"

#: app/ui/transfer.py:764
#, python-brace-format
msgid "已选择 {name}（{host}）。本机存过它的密钥，留空配对码点连接。"
msgstr "{name}（{host}）を選択しました。このマシンに鍵があるため、空欄のまま「接続」を押せます。"

#: app/ui/transfer.py:765
#, python-brace-format
msgid "已选择 {name}（{host}）。输入它屏幕上的 {n} 位配对码{extra}，再点连接。"
msgstr "{name}（{host}）を選択しました。相手の画面の{n}桁のコード{extra}を入力して「接続」を押してください。"

#: app/ui/transfer.py:766
#, python-brace-format
msgid "和 {m} 位密码"
msgstr "と{m}桁のパスワード"

#: app/ui/transfer.py:770
#, python-brace-format
msgid "一次只连一台，现在连着 {name}。要换设备先点「断开」。"
msgstr "同時に接続できるのは1台だけで、現在は {name} です。機器を替えるには「切断」を押してください。"

#: app/ui/transfer.py:772
msgid "自动发现没有运行。点「从附近选择…」手输对方地址。"
msgstr "自動検出は実行されていません。「近くから選択…」で相手のアドレスを入力してください。"

#: app/ui/transfer.py:775
msgid "附近暂时没有广播出来的设备。点「从附近选择…」手输地址。"
msgstr "現在、通知しているデバイスはありません。「近くから選択…」でアドレスを入力してください。"

#: app/ui/transfer.py:776
#, python-brace-format
msgid "附近发现 {n} 台设备，点「从附近选择…」连接。"
msgstr "近くで {n} 台のデバイスを見つけました。「近くから選択…」で接続してください。"

#: app/ui/transfer.py:787
msgid "（对方连进来，只能收）"
msgstr "（相手から接続、受信のみ）"

#: app/ui/transfer.py:800
#, python-brace-format
msgid "指纹前缀 {fp}。它主动连进来，本机没有可回拨的地址，所以只能收它的文件。要发给它，请由它来连本机。"
msgstr ""
"指紋プレフィックス "
"{fp}。相手から接続してきたため、このマシンには折り返すアドレスがなく、相手のファイルを受信するだけです。送るなら相手から本機に接続してください。"

#: app/ui/transfer.py:804
#, python-brace-format
msgid "指纹前缀 {fp}。已配对，会话保留到点断开为止。"
msgstr "指紋プレフィックス {fp}。ペアリング済みで、切断するまでセッションは維持されます。"

#: app/ui/transfer.py:809
msgid "还没有已连接的设备。点下面「从附近选择…」挑一台，或手输它的地址。"
msgstr "まだ接続済みのデバイスはありません。下の「近くから選択…」で選ぶか、アドレスを手入力してください。"

#: app/ui/transfer.py:838
#, python-brace-format
msgid "{name} 已连上本机（{ip}），现在只等它发文件过来。"
msgstr "{name} が本機に接続しました（{ip}）。相手からファイルが送られるのを待っています。"

#: app/ui/transfer.py:861
#, python-brace-format
msgid "{name} 已经连着，选文件发送即可。"
msgstr "{name} は接続済みです。ファイルを選ぶだけで送信できます。"

#: app/ui/transfer.py:877
#, python-brace-format
msgid "{addr} 应答了，但不是能配的版本：{why}"
msgstr "{addr} は応答しましたが、組み合わせできるバージョンではありません：{why}"

#: app/ui/transfer.py:880 app/ui/transfer.py:970
#, python-brace-format
msgid "连不上 {addr}：{error}"
msgstr "{addr} に接続できません：{error}"

#: app/ui/transfer.py:907
#, python-brace-format
msgid "一次只连一台。先断开 {name}，再连新设备。"
msgstr "同時に接続できるのは1台だけです。先に {name} を切断してください。"

#: app/ui/transfer.py:908
msgid "用上面的配对码和密码连接选中的设备。"
msgstr "上のペアリングコードとパスワードで選択中のデバイスに接続します。"

#: app/ui/transfer.py:920
msgid "先在「从附近选择…」里挑一台设备，或手输它的地址。"
msgstr "まず「近くから選択…」でデバイスを選ぶか、アドレスを手入力してください。"

#: app/ui/transfer.py:925
#, python-brace-format
msgid "本机一次只连一台，现在连着 {name}。要先点「断开」再连它。"
msgstr "本機は同時に1台だけ接続できます。現在は {name} です。「切断」を押してから再接続してください。"

#: app/ui/transfer.py:930
#, python-brace-format
msgid "还差对方屏幕上那 {n} 位配对码。"
msgstr "相手の画面に出ている {n} 桁のペアリングコードが入力されていません。"

#: app/ui/transfer.py:954
#, python-brace-format
msgid "配对码或密码不对。请照着对方屏幕上现在的 {n} 位码和 {m} 位密码再输一次。"
msgstr "ペアリングコードまたはパスワードが違います。相手画面に表示されている {n} 桁のコードと {m} 桁のパスワードをもう一度入力してください。"

#: app/ui/transfer.py:963
#, python-brace-format
msgid "它已经连着 {peer}，一次只允许一台。请那边先断开。"
msgstr "相手はすでに {peer} と接続中です。同時に1台のみです。そちらで先に切断してください。"

#: app/ui/transfer.py:966 app/ui/transfer.py:1158
#, python-brace-format
msgid "对方说：{text}"
msgstr "相手のメッセージ：{text}"

#: app/ui/transfer.py:999
#, python-brace-format
msgid "已连接 {name}，指纹前缀 {fp}。核对无误再发。"
msgstr "{name} に接続しました（指紋プレフィックス {fp}）。確認してから送信してください。"

#: app/ui/transfer.py:1025
#, python-brace-format
msgid "已断开 {name}。它的密钥还留在本机，留空配对码就能重连；要彻底撤销请去设置。"
msgstr "{name} を切断しました。鍵はこのマシンに残るので、空欄なら再接続できます。完全に消すには設定で取り消してください。"

#: app/ui/transfer.py:1056
msgid "这台设备是连进来的，本机没有可回拨的地址。要发给它，请改由它连接本机。"
msgstr "このデバイスは相手から接続してきたため、折り返すアドレスがありません。送るなら相手から本機へ接続してください。"

#: app/ui/transfer.py:1065
msgid "选择要发送的文件夹"
msgstr "送信するフォルダーを選択"

#: app/ui/transfer.py:1072
msgid "选择要发送的文件"
msgstr "送信するファイルを選択"

#: app/ui/transfer.py:1082
msgid "这些文件不在同一个文件夹下，请分开发送。"
msgstr "これらのファイルは同じフォルダーにないため、分けて送信してください。"

#: app/ui/transfer.py:1097
msgid "还没选要发送的内容。"
msgstr "送信するものが選ばれていません。"

#: app/ui/transfer.py:1102
#, python-brace-format
msgid "已选：{name}（整个文件夹，约 {size}）"
msgstr "選択中：{name}（フォルダー全体、約 {size}）"

#: app/ui/transfer.py:1103
#, python-brace-format
msgid "已选 {n} 个文件，共 {size}"
msgstr "{n} 個のファイルを選択中、合計 {size}"

#: app/ui/transfer.py:1113
msgid "准备中…"
msgstr "準備中…"

#: app/ui/transfer.py:1129
msgid "这台设备已经没有连接会话，请重新连接它。"
msgstr "このデバイスには接続セッションがありません。再接続してください。"

#: app/ui/transfer.py:1134
msgid "这里没有可发的文件。"
msgstr "送信できるファイルがありません。"

#: app/ui/transfer.py:1151
#, python-brace-format
msgid "已发给 {name}：{n} 个文件（{size}），对方逐个校验通过。"
msgstr "{name} に送信しました：{n} ファイル（{size}）、すべて相手で検証済み。"

#: app/ui/transfer.py:1156
msgid "对方不再认识本机的密钥。选中它，输入它屏幕上新显示的配对码再连接。"
msgstr "相手はこのマシンの鍵を認識しなくなりました。選択して、相手の画面に出た新しいコードを入力し、再接続してください。"

#: app/ui/transfer.py:1160
#, python-brace-format
msgid "有文件已经不在了：{path}"
msgstr "存在しないファイルがあります：{path}"

#: app/ui/transfer.py:1165
#, python-brace-format
msgid "连不上对方，它可能已经退出或换了端口：{error}"
msgstr "相手に接続できません。終了したかポートが変わった可能性があります：{error}"

#: app/ui/transfer.py:1168
#, python-brace-format
msgid "传输中断：{error}"
msgstr "転送が中断されました：{error}"

#: app/ui/transfer.py:1176
#, python-brace-format
msgid "正在发送：{name}"
msgstr "送信中：{name}"

#: app/ui/transfer.py:1181
msgid "未开始"
msgstr "開始されていません"

#: app/ui/transfer.py:1197
#, python-brace-format
msgid "已收到 {who} 发来的 {n} 个文件（{size}），逐个校验通过。"
msgstr "{who} から {n} ファイル（{size}）を受信しました。すべて検証済みです。"

#: app/ui/transfer.py:1207
#, python-brace-format
msgid ""
"来自 {who}\n"
"双击打开：{path}"
msgstr ""
"{who} から\n"
"ダブルクリックで開く：{path}"

#: app/ui/transfer.py:1210
msgid "这次还没有收到校验通过的文件；以前收过的都在接收目录里。"
msgstr "このセッションで検証済みの受信ファイルはまだありません。以前のファイルは受信フォルダにあります。"

#: app/ui/tray.py:28 app/ui/tray.py:60
msgid "打开主界面"
msgstr "メイン画面を開く"

#: app/ui/tray.py:29 app/ui/tray.py:61
msgid "开机自动启动"
msgstr "ログオン時に自動起動"

#: app/ui/tray.py:52
msgid "无法开启开机自动启动"
msgstr "自動起動を有効にできません"

#: app/ui/tray.py:53
#, python-brace-format
msgid ""
"仅打包后的 Windows 版本可以注册开机自启。\n"
"当前命令：{cmd}"
msgstr ""
"パッケージ化した Windows 版のみ、自動起動を登録できます。\n"
"現在のコマンド：{cmd}"

#: app/ui/tray.py:70
msgid ""
"已最小化到托盘，仍在后台运行。\n"
"双击托盘图标可重新打开。"
msgstr ""
"トレイに最小化しました。バックグラウンドで動作を続けています。\n"
"トレイのアイコンをダブルクリックすると再度開けます。"

