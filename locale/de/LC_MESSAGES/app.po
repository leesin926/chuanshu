#: app/crash.py:43
msgid "程序遇到未处理的错误。操作可以继续，但请查看日志。"
msgstr ""
"Das Programm ist auf einen nicht behandelten Fehler gestoßen. Sie können "
"weiterarbeiten, prüfen Sie aber das Protokoll."

#: app/crash.py:44
msgid "日志文件"
msgstr "Protokolldatei"

#: app/crash.py:59
msgid "未处理的异常"
msgstr "Nicht behandelter Fehler"

#: app/crash.py:67
msgid "后台线程异常"
msgstr "Fehler im Hintergrundthread"

#: app/crash.py:95
msgid "界面处理异常"
msgstr "Fehler in der Benutzeroberfläche"

#: app/net/errors.py:13
msgid "对端版本不兼容"
msgstr "Die Gegenseite nutzt eine inkompatible Version."

#: app/net/errors.py:14
msgid "尚未与这台设备配对"
msgstr "Mit diesem Gerät ist noch nichts gekoppelt."

#: app/net/errors.py:15
msgid "配对码不正确或已过期"
msgstr "Der Kopplungscode ist falsch oder abgelaufen."

#: app/net/errors.py:16
msgid "对方拒绝了这次传输"
msgstr "Die Gegenseite hat diese Übertragung abgelehnt."

#: app/net/errors.py:17
msgid "传输请求不存在或已结束"
msgstr "Diese Übertragungsanfrage existiert nicht mehr oder ist beendet."

#: app/net/errors.py:18
msgid "分块序号超出文件范围"
msgstr "Die Blocknummer liegt außerhalb der Datei."

#: app/net/errors.py:19
msgid "分块校验失败"
msgstr "Die Prüfsumme eines Blocks ist falsch."

#: app/net/errors.py:20
msgid "文件校验失败"
msgstr "Die Prüfsumme der Datei ist falsch."

#: app/net/errors.py:21
msgid "文件名被接收方拒绝"
msgstr "Der Empfänger hat diesen Dateinamen abgelehnt."

#: app/net/errors.py:22
msgid "接收方存储空间不足"
msgstr "Der Empfänger hat zu wenig Speicherplatz."

#: app/net/errors.py:23
msgid "对方正在处理另一个传输"
msgstr "Die Gegenseite ist mit einer anderen Übertragung beschäftigt."

