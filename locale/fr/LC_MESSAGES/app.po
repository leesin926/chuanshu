#: app/crash.py:43
msgid "程序遇到未处理的错误。操作可以继续，但请查看日志。"
msgstr ""
"Le programme a rencontré une erreur non gérée. Vous pouvez continuer, mais "
"vérifiez le journal."

#: app/crash.py:44
msgid "日志文件"
msgstr "Fichier journal"

#: app/crash.py:59
msgid "未处理的异常"
msgstr "Erreur non gérée"

#: app/crash.py:67
msgid "后台线程异常"
msgstr "Erreur du thread d'arrière-plan"

#: app/crash.py:95
msgid "界面处理异常"
msgstr "Erreur de l'interface"

#: app/net/errors.py:13
msgid "对端版本不兼容"
msgstr "L'autre appareil utilise une version incompatible."

#: app/net/errors.py:14
msgid "尚未与这台设备配对"
msgstr "Cet appareil n'est pas encore associé."

#: app/net/errors.py:15
msgid "配对码不正确或已过期"
msgstr "Code d'association incorrect ou expiré."

#: app/net/errors.py:16
msgid "对方拒绝了这次传输"
msgstr "L'autre partie a refusé ce transfert."

#: app/net/errors.py:17
msgid "传输请求不存在或已结束"
msgstr "Cette demande de transfert n'existe plus ou est terminée."

#: app/net/errors.py:18
msgid "分块序号超出文件范围"
msgstr "Le numéro de bloc dépasse la taille du fichier."

#: app/net/errors.py:19
msgid "分块校验失败"
msgstr "La somme de contrôle d'un bloc a échoué."

#: app/net/errors.py:20
msgid "文件校验失败"
msgstr "La somme de contrôle du fichier a échoué."

#: app/net/errors.py:21
msgid "文件名被接收方拒绝"
msgstr "Le destinataire a refusé ce nom de fichier."

#: app/net/errors.py:22
msgid "接收方存储空间不足"
msgstr "Espace insuffisant chez le destinataire."

#: app/net/errors.py:23
msgid "对方正在处理另一个传输"
msgstr "L'autre partie est occupée par un autre transfert."

