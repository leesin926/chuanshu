msgstr "Fichiers reçus (vérifiés cette session)"

#: app/ui/transfer.py:483
msgid "选择文件…"
msgstr "Choisir des fichiers…"

#: app/ui/transfer.py:484
msgid "选择文件夹…"
msgstr "Choisir un dossier…"

#: app/ui/transfer.py:485
msgid "清空"
msgstr "Effacer"

#: app/ui/transfer.py:486
msgid "从附近选择…"
msgstr "Choisir dans les alentours…"

#: app/ui/transfer.py:487
msgid "列出广播出来的候选设备，也可以手输地址或粘贴配对串。"
msgstr ""
"Liste les appareils annoncés ; vous pouvez aussi saisir une adresse ou "
"coller une chaîne d'appariement."

#: app/ui/transfer.py:488
msgid "断开"
msgstr "Déconnecter"

#: app/ui/transfer.py:490
#, python-brace-format
msgid "{n} 位配对码"
msgstr "Code d'appariement à {n} chiffres"

#: app/ui/transfer.py:492
#, python-brace-format
msgid "输入对方屏幕上显示的 {n} 位配对码。本机存过它的密钥时留空即可，用签名重连。"
msgstr ""
"Saisissez le code à {n} chiffres affiché sur l'autre écran. Si cette "
"machine connaît déjà sa clé, laissez le champ vide : la signature "
"reconnecte."

