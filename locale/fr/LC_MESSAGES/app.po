msgstr "Trouvé via {via} ; empreinte {fp}"

#: app/ui/transfer.py:179
msgid "没找到设备。手输对方地址，或粘贴它的配对串。"
msgstr ""
"Aucun appareil trouvé. Saisissez son adresse ou collez sa chaîne "
"d'appariement."

