#: app/ui/transfer.py:147 app/ui/transfer.py:501
msgid "连接"
msgstr "Connecter"

#: app/ui/transfer.py:158
msgid "下面是广播出来的候选设备。选中一台，回到主界面填它的配对码和密码，再点连接。"
msgstr ""
"Voici les appareils annoncés. Sélectionnez-en un, saisissez son code de "
"jumelage et son mot de passe sur la page principale, puis cliquez sur "
"Connecter."

#: app/ui/transfer.py:159
msgid "手输地址…"
msgstr "Saisir une adresse…"

#: app/ui/transfer.py:160
msgid "没在局域网里广播出来的设备，可以输入它的地址，或粘贴 chuanshu:// 配对串。"
msgstr ""
"Pour un appareil qui ne s'annonce pas sur le réseau, saisissez son "
"adresse ou collez sa chaîne chuanshu://."

#: app/ui/transfer.py:161
msgid "刷新"
msgstr "Actualiser"

#: app/ui/transfer.py:170
msgid "（已连接）"
msgstr " (connecté)"

#: app/ui/transfer.py:173 app/ui/transfer.py:174
msgid "手动添加"
msgstr "ajouté manuellement"

#: app/ui/transfer.py:174
#, python-brace-format
