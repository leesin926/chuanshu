msgid "连接密码（可留空）"
msgstr "Mot de passe (facultatif)"

#: app/ui/transfer.py:497
#, python-brace-format
msgid "输入对方屏幕上显示的 {n} 位连接密码。对方是还没有密码的旧版本时留空，这时只用配对码完成首次配对。"
msgstr ""
"Saisissez le mot de passe à {n} caractères affiché sur l’autre écran. "
"Laissez-le vide pour une version ancienne sans mot de passe : le premier "
"jumelage repose alors uniquement sur le code."

#: app/ui/transfer.py:503
msgid "发送给所选设备"
msgstr "Envoyer à l'appareil sélectionné"

#: app/ui/transfer.py:590
msgid "已换成新的配对码和密码，旧二维码作废。已连接的设备不受影响。"
msgstr ""
"Nouveau code de jumelage et nouveau mot de passe en vigueur ; l’ancien "
"code QR ne vaut plus. Les appareils connectés ne sont pas touchés."

#: app/ui/transfer.py:595
msgid "配对码要等接收端口打开才有"
msgstr "Le code de jumelage s’affiche quand le port de réception est ouvert"

#: app/ui/transfer.py:596
#, python-brace-format
msgid "配对码：{code}"
msgstr "Code d'association : {code}"

#: app/ui/transfer.py:601
#, python-brace-format
msgid "密码：{secret}"
msgstr "Mot de passe : {secret}"

#: app/ui/transfer.py:605
msgid "本机接收端口没有打开。"
msgstr "Aucun port de réception n'est ouvert sur cet appareil."

#: app/ui/transfer.py:607
msgid "接收已停止，对方连不进来。"
msgstr "La réception est arrêtée, personne ne peut se connecter."

#: app/ui/transfer.py:608
#, python-brace-format
msgid "端口：{port}"
msgstr "Port : {port}"

#: app/ui/transfer.py:616
msgid "发现通道：mDNS 与 UDP 都可用。"
msgstr "Découverte : mDNS et UDP fonctionnent tous les deux."

#: app/ui/transfer.py:617
msgid "mDNS"
msgstr "mDNS"

#: app/ui/transfer.py:617
msgid "UDP 广播"
msgstr "Diffusion UDP"

#: app/ui/transfer.py:620
#, python-brace-format
msgid "发现通道：{which} 都不可用，只能手输地址或粘贴配对串。"
msgstr ""
"Découverte : {which} sont indisponibles ; saisissez une adresse ou collez"
" une chaîne d'association."

#: app/ui/transfer.py:621
#, python-brace-format
msgid "发现通道：{which} 不可用，仍可手输地址或粘贴配对串。"
msgstr ""
"Découverte : {which} indisponible ; l'adresse saisie ou la chaîne collée "
"fonctionnent toujours."

#: app/ui/transfer.py:625
#, python-brace-format
msgid "这台机器开不了接收端口，但仍能主动发出去：{error}"
msgstr ""
"Cet appareil ne peut pas ouvrir de port de réception mais peut encore "
"envoyer : {error}"

#: app/ui/transfer.py:627
#, python-brace-format
msgid "上次有 {n} 个传输没传完，对方接着传就会续上。"
msgstr ""
"{n} transfert(s) interrompu(s) la dernière fois ; l'expéditeur reprend de"
" lui-même."

#: app/ui/transfer.py:658
msgid "这台设备对别人显示的名字："
msgstr "Le nom visible par les autres appareils :"

#: app/ui/transfer.py:706
#, python-brace-format
msgid "…共 {n} 个文件"
msgstr "… {n} fichiers au total"

#: app/ui/transfer.py:708
#, python-brace-format
msgid "接收来自 {who} 的文件？"
msgstr "Recevoir les fichiers de {who} ?"

#: app/ui/transfer.py:709
#, python-brace-format
msgid ""
"对方：{who}\n"
"\n"
"{listing}"
msgstr ""
"De : {who}\n"
"\n"
"{listing}"

#: app/ui/transfer.py:711
msgid "接收"
msgstr "Recevoir"

#: app/ui/transfer.py:712
msgid "拒绝"
msgstr "Refuser"

#: app/ui/transfer.py:759
#, python-brace-format
msgid "正在连接 {name}（{host}）…"
msgstr "Connexion à {name} ({host})…"

#: app/ui/transfer.py:764
#, python-brace-format
msgid "已选择 {name}（{host}）。本机存过它的密钥，留空配对码点连接。"
msgstr ""
"{name} ({host}) sélectionné. Cette machine a sa clé, connectez avec un "
"code vide."

#: app/ui/transfer.py:765
#, python-brace-format
