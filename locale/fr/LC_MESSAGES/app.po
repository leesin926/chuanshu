#, python-brace-format
msgid "已确认 {name}，指纹前缀 {fp}。选中它点连接。"
msgstr "{name} joint, empreinte {fp}. Sélectionnez-le puis cliquez sur Connecter."

#: app/ui/transfer.py:201
msgid "先选中一台设备，再点连接。"
msgstr "Sélectionnez d'abord un appareil, puis cliquez sur Connecter."

#: app/ui/transfer.py:321 app/ui/transfer.py:504
msgid "让对方扫这个码，就能带着配对码和密码连过来。"
msgstr ""
"L’autre côté scanne ce code et se connecte avec le code de jumelage et le"
" mot de passe en main."

#: app/ui/transfer.py:467
msgid "我的设备"
msgstr "Mon appareil"

#: app/ui/transfer.py:468
