msgstr "Адрес собеседника ({example}) или строка сопряжения:"

#: app/ui/transfer.py:194
#, python-brace-format
msgid "已确认 {name}，指纹前缀 {fp}。选中它点连接。"
msgstr ""
"{name} подтверждён, префикс отпечатка {fp}. Выберите и нажмите "
"«Подключить»."

#: app/ui/transfer.py:201
msgid "先选中一台设备，再点连接。"
msgstr "Сначала выберите устройство, затем нажмите «Подключить»."

#: app/ui/transfer.py:321 app/ui/transfer.py:504
msgid "让对方扫这个码，就能带着配对码和密码连过来。"
msgstr "Собеседник сканирует этот код и подключается сразу с кодом и паролем."

#: app/ui/transfer.py:467
msgid "我的设备"
msgstr "Моё устройство"

#: app/ui/transfer.py:468
msgid "已连接的设备"
msgstr "Подключённые устройства"

#: app/ui/transfer.py:473 app/ui/transfer.py:710
#, python-brace-format
msgid "保存到：{path}"
msgstr "Сохранять в: {path}"

#: app/ui/transfer.py:474
msgid "更换配对码和密码"
msgstr "Сменить код и пароль"

#: app/ui/transfer.py:476
msgid "换一组新的固定配对码和密码，二维码跟着变。已经连上的设备不受影响。"
msgstr ""
"Выдаёт новый постоянный код сопряжения и пароль; QR-код меняется следом. "
"Уже подключённое устройство не затронется."

#: app/ui/transfer.py:478
msgid "打开"
msgstr "Открыть"

#: app/ui/transfer.py:480
msgid "编辑"
msgstr "Изменить"

#: app/ui/transfer.py:481
#, python-brace-format
msgid "本机：{name}"
msgstr "Это устройство: {name}"

#: app/ui/transfer.py:482
msgid "接收到的文件（本次会话已校验）"
msgstr "Принятые файлы (проверены в этой сессии)"

#: app/ui/transfer.py:483
msgid "选择文件…"
msgstr "Выбрать файлы…"

#: app/ui/transfer.py:484
msgid "选择文件夹…"
msgstr "Выбрать папку…"

#: app/ui/transfer.py:485
msgid "清空"
msgstr "Очистить"

#: app/ui/transfer.py:486
msgid "从附近选择…"
msgstr "Выбрать из ближайших…"

#: app/ui/transfer.py:487
msgid "列出广播出来的候选设备，也可以手输地址或粘贴配对串。"
msgstr ""
"Показывает объявленные устройства; можно также ввести адрес или вставить "
"строку сопряжения."

#: app/ui/transfer.py:488
msgid "断开"
msgstr "Отключить"

#: app/ui/transfer.py:490
#, python-brace-format
msgid "{n} 位配对码"
msgstr "{n}-значный код сопряжения"

#: app/ui/transfer.py:492
#, python-brace-format
msgid "输入对方屏幕上显示的 {n} 位配对码。本机存过它的密钥时留空即可，用签名重连。"
msgstr ""
"Введите {n}-значный код с экрана собеседника. Если ключ уже сохранён на "
"этой машине, оставьте поле пустым — переподойдёт по подписи."

#: app/ui/transfer.py:494
msgid "连接密码（可留空）"
msgstr "Пароль (необязательно)"

#: app/ui/transfer.py:497
#, python-brace-format
msgid "输入对方屏幕上显示的 {n} 位连接密码。对方是还没有密码的旧版本时留空，这时只用配对码完成首次配对。"
msgstr ""
"Введите пароль соединения из {n} символов с экрана собеседника. Оставьте "
"пустым для старой версии без пароля: тогда первое сопряжение будет только"
" по коду."

#: app/ui/transfer.py:503
msgid "发送给所选设备"
msgstr "Отправить выбранному устройству"

#: app/ui/transfer.py:590
msgid "已换成新的配对码和密码，旧二维码作废。已连接的设备不受影响。"
msgstr ""
"Новые код сопряжения и пароль активны; прежний QR-код больше не "
"действует. Подключённые устройства не затронуты."

#: app/ui/transfer.py:595
msgid "配对码要等接收端口打开才有"
msgstr "Код сопряжения появится, когда порт приёма будет открыт"

#: app/ui/transfer.py:596
#, python-brace-format
msgid "配对码：{code}"
msgstr "Код сопряжения: {code}"

#: app/ui/transfer.py:601
#, python-brace-format
msgid "密码：{secret}"
msgstr "Пароль: {secret}"

#: app/ui/transfer.py:605
msgid "本机接收端口没有打开。"
msgstr "На этом устройстве не открыт порт приёма."

#: app/ui/transfer.py:607
msgid "接收已停止，对方连不进来。"
msgstr "Приём остановлен, подключиться нельзя."

#: app/ui/transfer.py:608
#, python-brace-format
msgid "端口：{port}"
msgstr "Порт: {port}"

#: app/ui/transfer.py:616
msgid "发现通道：mDNS 与 UDP 都可用。"
msgstr "Обнаружение: mDNS и UDP работают."

#: app/ui/transfer.py:617
msgid "mDNS"
msgstr "mDNS"

#: app/ui/transfer.py:617
msgid "UDP 广播"
msgstr "UDP-рассылка"

#: app/ui/transfer.py:620
#, python-brace-format
msgid "发现通道：{which} 都不可用，只能手输地址或粘贴配对串。"
msgstr ""
"Обнаружение: {which} недоступны, остаётся ввести адрес или вставить "
"строку сопряжения."

#: app/ui/transfer.py:621
#, python-brace-format
msgid "发现通道：{which} 不可用，仍可手输地址或粘贴配对串。"
msgstr ""
"Обнаружение: {which} недоступно; адрес или строку сопряжения всё ещё "
"можно ввести."

#: app/ui/transfer.py:625
#, python-brace-format
msgid "这台机器开不了接收端口，但仍能主动发出去：{error}"
msgstr "Устройство не может открыть порт приёма, но отправлять может: {error}"

#: app/ui/transfer.py:627
#, python-brace-format
msgid "上次有 {n} 个传输没传完，对方接着传就会续上。"
msgstr "В прошлый раз {n} передач не завершились; отправитель продолжит сам."

#: app/ui/transfer.py:658
msgid "这台设备对别人显示的名字："
msgstr "Имя, которое видят другие устройства:"

#: app/ui/transfer.py:706
#, python-brace-format
msgid "…共 {n} 个文件"
msgstr "… всего {n} файлов"

#: app/ui/transfer.py:708
#, python-brace-format
msgid "接收来自 {who} 的文件？"
msgstr "Принять файлы от {who}?"

#: app/ui/transfer.py:709
#, python-brace-format
msgid ""
"对方：{who}\n"
"\n"
"{listing}"
msgstr ""
"От: {who}\n"
"\n"
"{listing}"

#: app/ui/transfer.py:711
msgid "接收"
msgstr "Принять"

#: app/ui/transfer.py:712
msgid "拒绝"
msgstr "Отклонить"

#: app/ui/transfer.py:759
#, python-brace-format
msgid "正在连接 {name}（{host}）…"
msgstr "Подключение к {name} ({host})…"

#: app/ui/transfer.py:764
#, python-brace-format
msgid "已选择 {name}（{host}）。本机存过它的密钥，留空配对码点连接。"
msgstr ""
"Выбрано {name} ({host}). Ключ уже здесь, можно подключиться с пустым "
"кодом."

#: app/ui/transfer.py:765
#, python-brace-format
msgid "已选择 {name}（{host}）。输入它屏幕上的 {n} 位配对码{extra}，再点连接。"
msgstr ""
"Выбрано {name} ({host}). Введите {n}-значный код{extra} с его экрана и "
"нажмите «Подключить»."

#: app/ui/transfer.py:766
#, python-brace-format
msgid "和 {m} 位密码"
msgstr " и пароль из {m} символов"

#: app/ui/transfer.py:770
#, python-brace-format
msgid "一次只连一台，现在连着 {name}。要换设备先点「断开」。"
msgstr ""
"Одно устройство за раз; сейчас подключено {name}. Чтобы сменить, сначала "
"нажмите «Отключить»."

#: app/ui/transfer.py:772
msgid "自动发现没有运行。点「从附近选择…」手输对方地址。"
msgstr "Автопоиск не работает. Введите адрес через «Выбрать из ближайших…»."

#: app/ui/transfer.py:775
msgid "附近暂时没有广播出来的设备。点「从附近选择…」手输地址。"
msgstr ""
"Сейчас никто себя не объявляет. Введите адрес через «Выбрать из "
"ближайших…»."

#: app/ui/transfer.py:776
#, python-brace-format
msgid "附近发现 {n} 台设备，点「从附近选择…」连接。"
msgstr "Рядом найдено {n} устройств. Подключайте через «Выбрать из ближайших…»."

#: app/ui/transfer.py:787
msgid "（对方连进来，只能收）"
msgstr "(входящее соединение, только приём)"

#: app/ui/transfer.py:800
#, python-brace-format
msgid "指纹前缀 {fp}。它主动连进来，本机没有可回拨的地址，所以只能收它的文件。要发给它，请由它来连本机。"
msgstr ""
"Префикс отпечатка {fp}. Соединение входящее, обратного адреса у этого "
"устройства нет, поэтому можно только принимать. Чтобы отправить, пусть "
"подключится с той стороны."

#: app/ui/transfer.py:804
#, python-brace-format
msgid "指纹前缀 {fp}。已配对，会话保留到点断开为止。"
msgstr "Префикс отпечатка {fp}. Сопряжено; сессия живёт до нажатия «Отключить»."

#: app/ui/transfer.py:809
msgid "还没有已连接的设备。点下面「从附近选择…」挑一台，或手输它的地址。"
msgstr ""
"Подключённых устройств пока нет. Нажмите «Выбрать из ближайших…» ниже или"
" введите адрес."

#: app/ui/transfer.py:838
#, python-brace-format
msgid "{name} 已连上本机（{ip}），现在只等它发文件过来。"
msgstr "{name} подключился с {ip}; ждём отправки файлов."

#: app/ui/transfer.py:861
#, python-brace-format
msgid "{name} 已经连着，选文件发送即可。"
msgstr "{name} уже подключён — просто выберите файлы и отправьте."

#: app/ui/transfer.py:877
#, python-brace-format
msgid "{addr} 应答了，但不是能配的版本：{why}"
msgstr "{addr} ответил, но версия не подходит: {why}"

#: app/ui/transfer.py:880 app/ui/transfer.py:970
#, python-brace-format
msgid "连不上 {addr}：{error}"
msgstr "Не связаться с {addr}: {error}"

#: app/ui/transfer.py:907
#, python-brace-format
msgid "一次只连一台。先断开 {name}，再连新设备。"
msgstr "Только одно устройство за раз. Сначала отключите {name}."

#: app/ui/transfer.py:908
msgid "用上面的配对码和密码连接选中的设备。"
msgstr "Подключает выбранное устройство по коду и паролю выше."

#: app/ui/transfer.py:920
msgid "先在「从附近选择…」里挑一台设备，或手输它的地址。"
msgstr ""
"Сначала выберите устройство через «Выбрать из ближайших…» или введите его"
" адрес."

#: app/ui/transfer.py:925
#, python-brace-format
msgid "本机一次只连一台，现在连着 {name}。要先点「断开」再连它。"
msgstr ""
"Это устройство держит только одно соединение; сейчас {name}. Сначала "
"нажмите «Отключить»."

#: app/ui/transfer.py:930
#, python-brace-format
msgid "还差对方屏幕上那 {n} 位配对码。"
msgstr "Не хватает {n}-значного кода с экрана собеседника."

#: app/ui/transfer.py:954
#, python-brace-format
msgid "配对码或密码不对。请照着对方屏幕上现在的 {n} 位码和 {m} 位密码再输一次。"
msgstr ""
"Неверный код сопряжения или пароль. Введите заново {n}-значный код и "
"пароль из {m} символов с экрана собеседника."

#: app/ui/transfer.py:963
#, python-brace-format
msgid "它已经连着 {peer}，一次只允许一台。请那边先断开。"
msgstr ""
"Он уже подключён к {peer}; разрешено только одно соединение. Сначала "
"отключите с той стороны."

#: app/ui/transfer.py:966 app/ui/transfer.py:1158
#, python-brace-format
msgid "对方说：{text}"
msgstr "Собеседник ответил: {text}"

#: app/ui/transfer.py:999
#, python-brace-format
msgid "已连接 {name}，指纹前缀 {fp}。核对无误再发。"
msgstr "Подключено к {name}, префикс отпечатка {fp}. Проверьте перед отправкой."

#: app/ui/transfer.py:1025
#, python-brace-format
msgid "已断开 {name}。它的密钥还留在本机，留空配对码就能重连；要彻底撤销请去设置。"
msgstr ""
"{name} отключён. Ключ остался на этой машине, с пустым кодом подключится "
"снова; чтобы забыть совсем — отзовите в настройках."

#: app/ui/transfer.py:1056
msgid "这台设备是连进来的，本机没有可回拨的地址。要发给它，请改由它连接本机。"
msgstr ""
"Это устройство подключилось к нам, обратного адреса нет. Чтобы отправить,"
" пусть оно подключится к этому устройству."

#: app/ui/transfer.py:1065
msgid "选择要发送的文件夹"
msgstr "Выберите папку для отправки"

#: app/ui/transfer.py:1072
msgid "选择要发送的文件"
msgstr "Выберите файлы для отправки"

#: app/ui/transfer.py:1082
msgid "这些文件不在同一个文件夹下，请分开发送。"
msgstr "У этих файлов нет общей папки, отправляйте по отдельности."

#: app/ui/transfer.py:1097
msgid "还没选要发送的内容。"
msgstr "Ничего не выбрано для отправки."

#: app/ui/transfer.py:1102
#, python-brace-format
msgid "已选：{name}（整个文件夹，约 {size}）"
msgstr "Выбрано: {name} (папка целиком, примерно {size})"

#: app/ui/transfer.py:1103
#, python-brace-format
msgid "已选 {n} 个文件，共 {size}"
msgstr "Выбрано файлов: {n}, всего {size}"

#: app/ui/transfer.py:1113
msgid "准备中…"
msgstr "Подготовка…"

#: app/ui/transfer.py:1129
msgid "这台设备已经没有连接会话，请重新连接它。"
msgstr "У этого устройства нет сессии. Подключите его заново."

#: app/ui/transfer.py:1134
msgid "这里没有可发的文件。"
msgstr "Здесь нечего отправлять."

#: app/ui/transfer.py:1151
#, python-brace-format
msgid "已发给 {name}：{n} 个文件（{size}），对方逐个校验通过。"
msgstr "Отправлено {name}: файлов {n} ({size}), каждый проверен собеседником."

#: app/ui/transfer.py:1156
msgid "对方不再认识本机的密钥。选中它，输入它屏幕上新显示的配对码再连接。"
msgstr ""
"Собеседник больше не узнаёт ключ этой машины. Выберите его, введите новый"
" код с его экрана и подключите."

#: app/ui/transfer.py:1160
#, python-brace-format
msgid "有文件已经不在了：{path}"
msgstr "Файл больше не существует: {path}"

#: app/ui/transfer.py:1165
#, python-brace-format
msgid "连不上对方，它可能已经退出或换了端口：{error}"
msgstr ""
"Собеседник недоступен — возможно, закрыл программу или сменил порт: "
"{error}"

#: app/ui/transfer.py:1168
#, python-brace-format
msgid "传输中断：{error}"
msgstr "Передача прервана: {error}"

#: app/ui/transfer.py:1176
#, python-brace-format
msgid "正在发送：{name}"
msgstr "Отправка: {name}"

#: app/ui/transfer.py:1181
msgid "未开始"
msgstr "Не начато"

#: app/ui/transfer.py:1197
#, python-brace-format
msgid "已收到 {who} 发来的 {n} 个文件（{size}），逐个校验通过。"
msgstr "Принято {n} файлов от {who} ({size}), каждый проверен."

#: app/ui/transfer.py:1207
#, python-brace-format
msgid ""
"来自 {who}\n"
"双击打开：{path}"
msgstr ""
"От {who}\n"
"Двойной клик, чтобы открыть: {path}"

#: app/ui/transfer.py:1210
msgid "这次还没有收到校验通过的文件；以前收过的都在接收目录里。"
msgstr ""
"В этой сессии проверенных файлов пока нет; прежние лежат в папке "
"получения."

#: app/ui/tray.py:28 app/ui/tray.py:60
msgid "打开主界面"
msgstr "Открыть главное окно"

#: app/ui/tray.py:29 app/ui/tray.py:61
msgid "开机自动启动"
msgstr "Запускать при входе в систему"

#: app/ui/tray.py:52
msgid "无法开启开机自动启动"
msgstr "Не удалось включить автозапуск"

#: app/ui/tray.py:53
#, python-brace-format
msgid ""
"仅打包后的 Windows 版本可以注册开机自启。\n"
"当前命令：{cmd}"
msgstr ""
"Автозапуск может зарегистрировать только собранная версия для Windows.\n"
"Текущая команда: {cmd}"

#: app/ui/tray.py:70
msgid ""
"已最小化到托盘，仍在后台运行。\n"
"双击托盘图标可重新打开。"
msgstr ""
"Свёрнуто в трей, программа продолжает работать.\n"
"Двойной щелчок по значку в трее снова откроет окно."

