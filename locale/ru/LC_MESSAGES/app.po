msgid "分块校验失败"
msgstr "Блок не прошёл проверку контрольной суммы."

#: app/net/errors.py:20
msgid "文件校验失败"
msgstr "Файл не прошёл проверку контрольной суммы."

#: app/net/errors.py:21
msgid "文件名被接收方拒绝"
msgstr "Получатель отверг это имя файла."

#: app/net/errors.py:22
msgid "接收方存储空间不足"
msgstr "У получателя мало свободного места."

#: app/net/errors.py:23
msgid "对方正在处理另一个传输"
msgstr "Собеседник занят другой передачей."

