#: app/ui/transfer.py:147 app/ui/transfer.py:501
msgid "连接"
msgstr "Подключить"

#: app/ui/transfer.py:158
msgid "下面是广播出来的候选设备。选中一台，回到主界面填它的配对码和密码，再点连接。"
msgstr ""
"Это объявленные устройства-кандидаты. Выберите одно, введите его код и "
"пароль на главной странице и нажмите «Подключить»."

#: app/ui/transfer.py:159
msgid "手输地址…"
msgstr "Ввести адрес…"

#: app/ui/transfer.py:160
msgid "没在局域网里广播出来的设备，可以输入它的地址，或粘贴 chuanshu:// 配对串。"
msgstr ""
"Если устройство не объявляется в сети, введите его адрес или вставьте "
"строку сопряжения chuanshu://."

#: app/ui/transfer.py:161
msgid "刷新"
msgstr "Обновить"

#: app/ui/transfer.py:170
msgid "（已连接）"
msgstr " (подключено)"

#: app/ui/transfer.py:173 app/ui/transfer.py:174
