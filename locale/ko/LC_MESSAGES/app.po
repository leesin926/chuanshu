msgstr "시작하지 않음"

#: app/ui/transfer.py:1197
#, python-brace-format
msgid "已收到 {who} 发来的 {n} 个文件（{size}），逐个校验通过。"
msgstr "{who}에게서 파일 {n}개({size})를 받았습니다. 모두 검증되었습니다."

#: app/ui/transfer.py:1207
#, python-brace-format
msgid ""
"来自 {who}\n"
"双击打开：{path}"
msgstr ""
"보낸 사람: {who}\n"
"더블클릭으로 열기: {path}"

